+/* 8 pixels of colour 0xRRGGBB: byte k is component k % 3 (B, G, R) of pixel k / 3 */
+static void
+vc24_pattern(uint32_t rgb, uint64_t pat[3])
+{
+	unsigned int k;
+
+	pat[0] = pat[1] = pat[2] = 0;
+	for (k = 0; k < 24; k++) {
+		uint64_t byte = (rgb >> (8 * (k % 3))) & 0xFF;
+		pat[k / 8] |= byte << (8 * (k % 8));
+	}
