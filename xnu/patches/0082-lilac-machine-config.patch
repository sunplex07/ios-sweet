+    source = 'typedef unsigned long long uint64_t; static uint64_t smpt_lock;\n'
+    source += 'static uint64_t\n' + vct + '\nstatic uint64_t\n' + pct
+    source += '\nuint64_t check_vct(void) { return smpt_counter_read(); }\n'
+    source += 'uint64_t check_pct(void) { return smpt_physical_read(); }\n'
+    source += 'void check_drain(void) { ' + drain + ' }\n'
+    source += 'void check_at(void) { ' + at + ' }\n'
