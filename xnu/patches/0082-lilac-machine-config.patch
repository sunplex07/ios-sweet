+static void
+vc_clear_screen_24(unsigned int xx, unsigned int yy, unsigned int scrreg_top,
+    unsigned int scrreg_bottom, int which)
+{
+	switch (which) {
+	case 0:         /* To end of screen	 */
+		gc_clear_line(xx, yy, 0);
+		if (yy < scrreg_bottom - 1) {
+			vc24_fill_lines((yy + 1) * ISO_CHAR_HEIGHT, scrreg_bottom * ISO_CHAR_HEIGHT);
+		}
+		break;
+	case 1:         /* To start of screen	 */
+		gc_clear_line(xx, yy, 1);
+		if (yy > scrreg_top) {
+			vc24_fill_lines(scrreg_top * ISO_CHAR_HEIGHT, yy * ISO_CHAR_HEIGHT);
+		}
+		break;
+	case 2:         /* Whole screen		 */
+		vc24_fill_lines(scrreg_top * ISO_CHAR_HEIGHT,
+		    (scrreg_bottom == vinfo.v_rows) ? vinfo.v_height : scrreg_bottom * ISO_CHAR_HEIGHT);
+		break;
+	}
+}
