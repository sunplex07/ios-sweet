diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index a20a764..dcd54ad 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1040,6 +1040,133 @@ sweet_sample_task(const char *name, int pid, task_t task)
 	task_unlock(task);
 }
 
+/*
+ * LILAC sampler walk (bsd/dev/sweet_sample.c sweet_sample_lilac_start, boot-arg
+ * gated): like sweet_sample_task, but 12 backtrace frames, the shared-region
+ * slide and main Mach-O header logged once per process, and per thread also the
+ * kernel wait state: thread state (W blocked in the kernel, R runnable or
+ * running), the wait event, the continuation, and for a blocked thread the
+ * context-switch-saved kernel fp/lr plus a short kernel frame-pointer walk.
+ * Kernel addresses are VM_KERNEL_UNSLIDE()d so they symbolicate against the
+ * built kernel like LILAC PROF pcs (tools/prof-sym.py); a mach_msg trap,
+ * kevent or psynch wait shows its stub in the user pc and its kernel frames
+ * (and continuation) here. Kernel frames are only read while the thread is
+ * blocked (TH_WAIT, not TH_RUN) and only inside its own kernel stack, which
+ * is always mapped, so a running thread's moving frames are never chased.
+ */
+static struct {
+	int      pid;
+	uint64_t slide, mh;
+	char     name[32];
+} sweet_sample_seen[24];
+static int sweet_sample_seen_n;
+
+void sweet_sample_task_lilac(const char *name, int pid, task_t task);
+
+void
+sweet_sample_task_lilac(const char *name, int pid, task_t task)
+{
+	vm_map_t map = get_task_map(task);
+	uint64_t slide = 0, mh = task->mach_header_vm_address;
+	int i, tn = 0;
+	thread_t thread;
+	vm_shared_region_t sr = vm_shared_region_get(task);
+
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	for (i = 0; i < sweet_sample_seen_n; i++) {
+		if (sweet_sample_seen[i].pid == pid && sweet_sample_seen[i].slide == slide &&
+		    sweet_sample_seen[i].mh == mh &&
+		    strncmp(sweet_sample_seen[i].name, name, sizeof(sweet_sample_seen[0].name)) == 0) {
+			break;
+		}
+	}
+	if (i == sweet_sample_seen_n) {
+		if (sweet_sample_seen_n < (int)(sizeof(sweet_sample_seen) / sizeof(sweet_sample_seen[0]))) {
+			sweet_sample_seen[sweet_sample_seen_n].pid = pid;
+			sweet_sample_seen[sweet_sample_seen_n].slide = slide;
+			sweet_sample_seen[sweet_sample_seen_n].mh = mh;
+			strlcpy(sweet_sample_seen[sweet_sample_seen_n].name, name,
+			    sizeof(sweet_sample_seen[0].name));
+			sweet_sample_seen_n++;
+		}
+		printf("SMP %s[%d] slide 0x%llx mh 0x%llx\n", name, pid, slide, mh);
+	}
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(thread);
+		bool waiting = (thread->state & TH_WAIT) != 0;
+		bool running = (thread->state & TH_RUN) != 0;
+		char line[400];
+		int n;
+		uint64_t fp;
+
+		if (ss == NULL || !is_saved_state64(ss)) {
+			continue;
+		}
+		fp = get_saved_state_fp(ss);
+		n = snprintf(line, sizeof(line), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt", name, tn++,
+		    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss));
+		for (int j = 0; j < 12 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 24; j++) {
+			uint64_t frame[2];
+			if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		if (n < (int)sizeof(line) - 24) {
+			n += snprintf(line + n, sizeof(line) - n, " st %s",
+			    waiting ? "W" : (running ? "R" : "-"));
+		}
+		if (thread->wait_event != 0 && n < (int)sizeof(line) - 24) {
+			n += snprintf(line + n, sizeof(line) - n, " wevt 0x%llx", (uint64_t)thread->wait_event);
+		}
+		if (thread->continuation != NULL && n < (int)sizeof(line) - 24) {
+			n += snprintf(line + n, sizeof(line) - n, " cont 0x%llx",
+			    (uint64_t)VM_KERNEL_UNSLIDE(thread->continuation));
+		}
+		if (waiting && !running && thread->kernel_stack != 0) {
+			arm_kernel_saved_state_t *ks = &thread_get_kernel_state(thread)->machine.ss;
+			if (!ks->pc_was_in_userspace && ks->fp != 0 && (ks->fp & 7) == 0 &&
+			    ks->fp > thread->kernel_stack &&
+			    ks->fp < thread->kernel_stack + kernel_stack_size) {
+				uint64_t kfp = ks->fp, prev = 0;
+				if (n < (int)sizeof(line) - 24) {
+					n += snprintf(line + n, sizeof(line) - n, " klr 0x%llx",
+					    (uint64_t)VM_KERNEL_UNSLIDE(ks->lr));
+				}
+				if (n < (int)sizeof(line) - 24) {
+					n += snprintf(line + n, sizeof(line) - n, " kbt");
+				}
+				for (int j = 0; j < 6 && kfp != 0 && (kfp & 7) == 0 && kfp > prev &&
+				    kfp >= thread->kernel_stack &&
+				    kfp < thread->kernel_stack + kernel_stack_size &&
+				    n < (int)sizeof(line) - 24; j++) {
+					uint64_t frame[2];
+					frame[0] = ((uint64_t *)kfp)[0];
+					frame[1] = ((uint64_t *)kfp)[1];
+					n += snprintf(line + n, sizeof(line) - n, " 0x%llx",
+					    (uint64_t)VM_KERNEL_UNSLIDE(frame[1]));
+					if (frame[0] <= kfp) {
+						break;
+					}
+					prev = kfp;
+					kfp = frame[0];
+				}
+			}
+		}
+		printf("%s\n", line);
+	}
+	task_unlock(task);
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
 kern_return_t
