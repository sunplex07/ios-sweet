+#define THREAD_UNINT 0
+#define THREAD_CONTINUE_NULL 0
+#define NSEC_PER_MSEC 1000000LL
+typedef int thread_t; typedef int wait_result_t; typedef int kern_return_t;
+#define KERN_SUCCESS 0
