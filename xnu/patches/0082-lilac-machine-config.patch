+static void
+sweet_sample_lilac_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+
+	(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+	for (int i = 0; i < 49; i++) {
+		printf("SMP --- sample %d t+%ds\n", i, 120 + 10 * i);
+		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, (void *)(uintptr_t)true, NULL, NULL);
+		if (i < 48) {
+			(void)tsleep(&chan, PZERO, "sweetsmp", 10 * hz);
