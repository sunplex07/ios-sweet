+#if defined(LILAC)
+/*
+ * Wall-clock seconds at loader handoff, from /chosen "lilac-utc-secs" (LE u64,
+ * written by the UEFI loader); 0 (1970) when absent.
+ */
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	long secs = 0;
+	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	if (chosen != NULL) {
+		OSData *d = OSDynamicCast(OSData, chosen->getProperty("lilac-utc-secs"));
+		if (d != NULL && d->getLength() == sizeof(uint64_t)) {
+			uint64_t v;
+			memcpy(&v, d->getBytesNoCopy(), sizeof(v));
+			secs = (long)v;
+		}
+		chosen->release();
+	}
+	return secs;
+}
+#endif
