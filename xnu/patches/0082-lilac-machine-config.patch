+	/* ARMv8.0 (no LSE): single-shot CAS 0->1 with acquire via LL/SC.
+	 * w10 = observed value (0 on success), like casa. */
+1:
+	ldaxr	w10, [x2]
+	cbnz	w10, 2f
+	stxr	w12, w11, [x2]
+	cbnz	w12, 1b
+	b	3f
+2:
+	clrex
+3:
+#else
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
