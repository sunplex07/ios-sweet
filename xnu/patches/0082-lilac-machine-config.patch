diff --git a/osfmk/arm64/lilac_diag.c b/osfmk/arm64/lilac_diag.c
new file mode 100644
index 0000000..4301927
--- /dev/null
+++ b/osfmk/arm64/lilac_diag.c
@@ -0,0 +1,329 @@
+/*
+ * LILAC (Sony Xperia XZ1 Compact, MSM8998) boot-progress channel.
+ *
+ * The board has no usable serial port and the command-mode panel does not show
+ * post-ExitBootServices framebuffer writes, so progress is encoded in the time
+ * until a PSCI SYSTEM_RESET returns the phone to Android:
+ *   lilac_stop=N  reaching stage N resets after LILAC_STOP_SECS (20 s)
+ *   early vectors start.s LOW_VECTOR_TRAP resets after 45 s (no stack)
+ *   panic / halt  resets after LILAC_FATAL_BASE + LILAC_FATAL_STEP * last stage
+ *   probes        lilac_event(N) stops at N without changing last_stage:
+ *                 33 any IRQ, 34 ICC_SRE set, 35 vtimer armed, 36 GICD RWP done,
+ *                 37 vtimer asserted >1 s with no IRQ pending at the CPU
+ *   idle hang     lilac_idle_wait() replaces WFI; once LILAC_HANG_SECS have passed
+ *                 since lilac_diag_init it resets after LILAC_HANG_STEP * last stage
+ *                 (a kernel blocked with no wakeup source recovers by itself)
+ *   watchdog      lilac_wd_word (stage | LILAC_WD_FATAL | LILAC_WD_IDLE) is cleaned to
+ *                 PoC on every change. The G8 loader finds it by symbol and leaves a
+ *                 secondary CPU polling it MMU-off. Once the word has been unchanged
+ *                 for 30 s with neither flag set, that CPU resets at jump + 60 s + 6 s *
+ *                 stage, so busy or interrupts-masked hangs recover too (stage 22: 192 s,
+ *                 52: 372 s; below the panic delay 90 + 15 * stage >= 420 s for stage >= 22).
+ *                 A set flag defers to the paths above; the loader caps the run at 1000 s.
+ *                 Bits 32-63 carry a beat counter (the stub uses only bits 0-17 for the
+ *                 stage and flags): lilac_heartbeat(), called each second by a kernel thread
+ *                 (lilac_hb.c), changes the word, so the stub fires only when that thread
+ *                 can no longer run (deadlocked with interrupts or preemption off, or
+ *                 starved). The idle-hang budget above is unchanged and still ends a live
+ *                 run with an SD log flush. Beats stop once any reset delay has started.
+ *   stages 39-52  finer marks between kernel_bootstrap (22) and bsd_init (24), startup.c
+ *   stages 53-61  after PE_lockdown_iokit: pe_init.c, startup.c, SweetCPU.cpp
+ *   stages 70-74  pe_init_fiq GIC/timer probes (lilac_report): only when lilac_stop selects
+ *                 them; reset after 20 + 4 * nibble s, so one run returns 4 bits
+ *   stage 62      transient: published while cpu_idle spins in wfe_to_deadline_or_interrupt
+ *                 (proximate-timer path, which bypasses lilac_idle_wait); restored on exit
+ * The steps exceed the ~9 s jitter of the UEFI-to-adb path seen in G1-G3.
+ * No allocation, locks or per-CPU state: usable from arm_init entry on.
+ *
+ * SMP (cpus=N > 1, SMP phase 1):
+ *   - Only the boot CPU (MPIDR Aff2-0 == 0, which SweetCPU::startAll requires to be
+ *     logical CPU 0) runs the idle publish, the probes and the hang deadline in
+ *     lilac_idle_wait and the stage-62 WFE hooks; other CPUs idle with plain WFI.
+ *   - The first CPU to start a reset delay owns it (lilac_reset_claim); any other CPU
+ *     that reaches a reset path parks with IRQ/FIQ masked. After a claim only the owner
+ *     changes lilac_wd_word, so the watchdog sees the delay that will actually run.
+ *   - lilac_wd_word is updated with an LL/SC compare-exchange: the stage/flag half and the
+ *     beat half never tear, and LILAC_WD_FATAL, once set, is never cleared.
+ */
+#include <arm64/sweet_early.h>
+
+#if defined(LILAC)
+#include <stdint.h>
+
+#define LILAC_STOP_SECS         20u
+#define LILAC_FATAL_BASE        90u
+#define LILAC_FATAL_STEP        15u
+#define LILAC_HANG_SECS         600u
+#define LILAC_HANG_STEP         5u
+#define PSCI_SYSTEM_RESET       0x84000009ull
+#define ISR_EL1_IRQ_FIQ         0xC0ull
+
+static unsigned int lilac_stop_stage;   /* 0: no stop requested */
+static unsigned int lilac_last_stage;
+static uint64_t lilac_hang_deadline;    /* CNTVCT value; 0 before lilac_diag_init */
+
+#define LILAC_WD_FATAL          0x10000ull
+#define LILAC_WD_IDLE           0x20000ull
+/* Read by the loader's watchdog CPU with its MMU off: keep it alone in its cache line. */
+__attribute__((used, aligned(128))) volatile uint64_t lilac_wd_word;
+static volatile int lilac_wd_latched;
+/* 0: no reset delay running; else LILAC_OWNER_VALID | MPIDR Aff2-0 of the CPU running it. */
+static uint64_t lilac_reset_owner;
+#define LILAC_OWNER_VALID       (1ull << 63)
+
+static inline uint64_t
+lilac_mpidr_aff(void)
+{
+	return __builtin_arm_rsr64("MPIDR_EL1") & 0xffffffull;
+}
+
+/* The boot CPU: MPIDR 0 (/cpus/cpu0 "running", loader G2; checked by SweetCPU::startAll). */
+static inline int
+lilac_is_boot_cpu(void)
+{
+	return lilac_mpidr_aff() == 0;
+}
+
+/*
+ * Atomically replace the stage/flag half (beat = 0) or add one to the beat half (beat = 1)
+ * of lilac_wd_word. FATAL is sticky; once a reset delay is claimed only its owner writes.
+ */
+static void
+lilac_wd_update(uint64_t v, int beat)
+{
+	uint64_t owner = __atomic_load_n(&lilac_reset_owner, __ATOMIC_ACQUIRE);
+	if (owner != 0 && owner != (LILAC_OWNER_VALID | lilac_mpidr_aff())) {
+		return;
+	}
+	uint64_t old = __atomic_load_n(&lilac_wd_word, __ATOMIC_RELAXED), nv;
+	do {
+		if (old & LILAC_WD_FATAL) {
+			if (beat || !(v & LILAC_WD_FATAL)) {
+				return;
+			}
+		}
+		if (beat && lilac_wd_latched) {
+			return;
+		}
+		nv = beat ? old + (1ull << 32) : ((old & ~0xffffffffull) | (v & 0xffffffffull));
+	} while (!__atomic_compare_exchange_n(&lilac_wd_word, &old, nv, 1, __ATOMIC_RELEASE, __ATOMIC_RELAXED));
+	__asm__ volatile ("dc civac, %0\n\tdsb sy" :: "r"(&lilac_wd_word) : "memory");
+}
+
+static void
+lilac_wd_publish(uint64_t v)
+{
+	lilac_wd_update(v, 0);
+}
+
+static uint64_t
+lilac_counter(void)
+{
+	uint64_t v;
+	__asm__ volatile ("isb\n\tmrs %0, CNTVCT_EL0" : "=r"(v) :: "memory");
+	return v;
+}
+
+/* Run once at the start of a reset delay, inside it (lilac_sd.c SD log flush). */
+void (*volatile lilac_reset_hook)(uint32_t budget_secs);
+
+/*
+ * One reset delay per boot: the first CPU to get here owns it (re-entry on the owner CPU,
+ * e.g. a panic inside the hook, proceeds as on one CPU). Any other CPU parks for good with
+ * IRQ/FIQ masked, so the reset time encodes the first event only.
+ */
+static void
+lilac_reset_claim(void)
+{
+	uint64_t me = LILAC_OWNER_VALID | lilac_mpidr_aff(), expected = 0;
+	if (__atomic_compare_exchange_n(&lilac_reset_owner, &expected, me, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE) ||
+	    expected == me) {
+		return;
+	}
+	__asm__ volatile ("msr DAIFSet, #3" ::: "memory");
+	for (;;) {
+		__asm__ volatile ("wfe");
+	}
+}
+
+/* Returns only if PSCI SYSTEM_RESET returns. */
+static void
+lilac_reset_after(uint64_t secs)
+{
+	uint64_t freq;
+	lilac_reset_claim();
+	__asm__ volatile ("mrs %0, CNTFRQ_EL0" : "=r"(freq));
+	uint64_t end = lilac_counter() + secs * freq;
+	lilac_wd_latched = 1;
+	void (*hook)(uint32_t) = __atomic_exchange_n(&lilac_reset_hook, (void (*)(uint32_t))0, __ATOMIC_ACQ_REL);
+	if (hook != 0 && secs <= 4) {
+		lilac_reset_hook = hook;        /* not run: leave it for a later, longer delay (as before) */
+		hook = 0;
+	}
+	if (hook != 0) {
+		hook((uint32_t)secs - 4);
+	}
+	while (lilac_counter() < end) {
+		__asm__ volatile ("yield");
+	}
+	register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_RESET;
+	__asm__ volatile ("dsb sy\n\tsmc #0" : "+r"(x0) ::
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+	    "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+}
+
+void
+lilac_diag_init(const char *cmdline)
+{
+	static const char key[] = "lilac_stop=";
+	uint64_t freq;
+	__asm__ volatile ("mrs %0, CNTFRQ_EL0" : "=r"(freq));
+	lilac_hang_deadline = lilac_counter() + (uint64_t)LILAC_HANG_SECS * freq;
+	for (unsigned int i = 0; i < 608 && cmdline[i]; i++) {
+		if (i != 0 && cmdline[i - 1] != ' ') {
+			continue;
+		}
+		unsigned int k = 0;
+		while (key[k] && cmdline[i + k] == key[k]) {
+			k++;
+		}
+		if (key[k]) {
+			continue;
+		}
+		unsigned int n = 0;
+		for (unsigned int j = i + k; cmdline[j] >= '0' && cmdline[j] <= '9' && n < 1000; j++) {
+			n = n * 10 + (unsigned int)(cmdline[j] - '0');
+		}
+		lilac_stop_stage = n;
+	}
+}
+
+void
+lilac_mark(unsigned int stage)
+{
+	lilac_last_stage = stage;
+	lilac_wd_publish(stage);
+	if (stage == lilac_stop_stage) {
+		lilac_reset_after(LILAC_STOP_SECS);
+	}
+}
+
+int
+lilac_stop_is(unsigned int stage)
+{
+	return stage == lilac_stop_stage;
+}
+
+void
+lilac_report(unsigned int stage, unsigned int nibble)
+{
+	if (stage == lilac_stop_stage) {
+		lilac_reset_after(LILAC_STOP_SECS + 4u * (uint64_t)(nibble & 15u));
+	}
+}
+
+/* A probe that may stop the boot but does not change the recorded stage. */
+void
+lilac_event(unsigned int stage)
+{
+	if (stage == lilac_stop_stage) {
+		lilac_reset_after(LILAC_STOP_SECS);
+	}
+}
+
+/*
+ * Idle in place of WFI: return as soon as an IRQ or FIQ is pending (ISR_EL1
+ * reports it even while PSTATE masks it, which is what wakes WFI).
+ */
+static void
+lilac_idle_checks(void)
+{
+	static uint64_t fired_since;
+	{
+		uint64_t ctl = __builtin_arm_rsr64("CNTV_CTL_EL0");
+		if ((ctl & 3) == 1) {
+			lilac_event(35);        /* virtual timer enabled and unmasked */
+		}
+		if ((ctl & 7) == 5) {           /* ENABLE, !IMASK, ISTATUS: timer asserted */
+			uint64_t now = lilac_counter(), f;
+			__asm__ volatile ("mrs %0, CNTFRQ_EL0" : "=r"(f));
+			if (fired_since == 0) {
+				fired_since = now;
+			} else if (now - fired_since > f) {
+				lilac_event(37);        /* asserted >1 s, never reached the CPU: GIC routing */
+			}
+		} else {
+			fired_since = 0;
+		}
+		if (lilac_hang_deadline != 0 && lilac_counter() >= lilac_hang_deadline) {
+			lilac_reset_after(LILAC_HANG_STEP * (uint64_t)lilac_last_stage);
+		}
+	}
+}
+
+void
+lilac_idle_wait(void)
+{
+	if (!lilac_is_boot_cpu()) {
+		__builtin_arm_wfi();            /* secondary CPUs: the normal idle path (cpu_idle) */
+		return;
+	}
+	lilac_wd_publish(lilac_last_stage | LILAC_WD_IDLE);
+	while ((__builtin_arm_rsr64("ISR_EL1") & ISR_EL1_IRQ_FIQ) == 0) {
+		lilac_idle_checks();
+		__asm__ volatile ("yield");
+	}
+	lilac_wd_publish(lilac_last_stage);
+}
+
+#define LILAC_WFE_STAGE         62u
+
+void
+lilac_wfe_enter(void)
+{
+	if (!lilac_is_boot_cpu()) {
+		return;
+	}
+	lilac_wd_publish(LILAC_WFE_STAGE);
+	lilac_event(LILAC_WFE_STAGE);
+}
+
+void
+lilac_wfe_poll(void)
+{
+	if (!lilac_is_boot_cpu()) {
+		return;
+	}
+	lilac_idle_checks();
+}
+
+void
+lilac_wfe_exit(void)
+{
+	if (!lilac_is_boot_cpu()) {
+		return;
+	}
+	lilac_wd_publish(lilac_last_stage);
+}
+
+void
+lilac_fatal_reset(void)
+{
+	lilac_reset_claim();            /* another CPU's delay already runs: park here */
+	lilac_wd_latched = 1;           /* before the publish: no beat may clear FATAL */
+	lilac_wd_publish(lilac_last_stage | LILAC_WD_FATAL);
+	lilac_reset_after(LILAC_FATAL_BASE + LILAC_FATAL_STEP * (uint64_t)lilac_last_stage);
+}
+/*
+ * Thread context, once per second (lilac_hb.c), on any CPU. IRQ/FIQ masked so this CPU's idle
+ * and fatal publishes cannot interleave; other CPUs are excluded by the compare-exchange.
+ */
+void
+lilac_heartbeat(void)
+{
+	uint64_t daif = __builtin_arm_rsr64("DAIF");
+	__asm__ volatile ("msr DAIFSet, #3" ::: "memory");
+	lilac_wd_update(0, 1);
+	__builtin_arm_wsr64("DAIF", daif);
+}
+#endif /* LILAC */
diff --git a/osfmk/arm64/lilac_hb.c b/osfmk/arm64/lilac_hb.c
new file mode 100644
index 0000000..a37e773
--- /dev/null
+++ b/osfmk/arm64/lilac_hb.c
@@ -0,0 +1,198 @@
+/*
+ * LILAC: watchdog heartbeat and timer-interrupt PC sampler.
+ *
+ * Heartbeat: a kernel thread at MAXPRI_KERNEL calls lilac_heartbeat() (lilac_diag.c) every
+ * second, so the G8 watchdog CPU sees lilac_wd_word change while the kernel can still
+ * schedule, and resets only on real hangs. Started from bsd_init after the SD log.
+ *
+ * Sampler: sleh_irq calls lilac_pc_sample() for every virtual-timer IRQ (quantum and
+ * timer deadlines, so a CPU-bound thread is sampled about every 10 ms). Samples are
+ * counted as idle, user or kernel; kernel samples are binned by (pc, pid). Every
+ * HB_REPORT_SECS the thread prints the busiest bins to the console (and so to the SD
+ * log) as unslid addresses, to be symbolicated against the CI kernel.development.
+ * SMP: the per-CPU counters and the bin table are only touched with interrupts masked and
+ * hb_lock held (the sampler runs in IRQ context on every CPU, the report on the HB thread's
+ * CPU). Kernel bins are keyed by (pc, pid, cpu). The totals line keeps its format
+ * (tools/prof-sym.py); with more than one CPU, per-CPU lines "LILAC PROF cpuN: ..." follow
+ * it and bin lines end in " cpu N" (prof-sym.py's regexes still match / skip them).
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(LILAC)
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <kern/kern_types.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <kern/processor.h>
+#include <kern/sched.h>
+#include <kern/sched_prim.h>
+#include <kern/misc_protos.h>
+#include <kern/locks.h>
+#include <kern/cpu_number.h>
+#include <arm/cpu_internal.h>
+#include <machine/machine_routines.h>
+#include <arm64/proc_reg.h>
+#include <arm64/sweet_early.h>
+
+#define HB_SLOTS        64u
+#define HB_PROBE        8u
+#define HB_TOP          8u
+#define HB_REPORT_SECS  20u
+
+struct hb_slot {
+	uint64_t pc;
+	uint64_t lr;            /* of the latest sample in this bin */
+	uint32_t n;
+	int32_t  pid;
+	uint32_t cpu;
+};
+
+struct hb_cpu_cnt {
+	uint32_t user, kern, idle;
+};
+
+static LCK_GRP_DECLARE(hb_lck_grp, "lilac_hb");
+static LCK_SPIN_DECLARE(hb_lock, &hb_lck_grp);
+static struct hb_slot hb_tab[HB_SLOTS];
+static struct hb_cpu_cnt hb_cnt[MAX_CPUS];
+static uint32_t hb_drop;
+static volatile int hb_on;
+static int hb_wait_chan;
+
+void lilac_pc_sample(arm_saved_state_t *state);
+
+/* Timer IRQ context, interrupts masked. */
+void
+lilac_pc_sample(arm_saved_state_t *state)
+{
+	if (!hb_on) {
+		return;
+	}
+	thread_t th = current_thread();
+	uint32_t cpu = (uint32_t)cpu_number();
+	if (cpu >= MAX_CPUS) {
+		return;
+	}
+	if (th == current_processor()->idle_thread) {
+		lck_spin_lock(&hb_lock);
+		hb_cnt[cpu].idle++;
+		lck_spin_unlock(&hb_lock);
+		return;
+	}
+	if (!PSR64_IS_KERNEL(get_saved_state_cpsr(state))) {
+		lck_spin_lock(&hb_lock);
+		hb_cnt[cpu].user++;
+		lck_spin_unlock(&hb_lock);
+		return;
+	}
+	uint64_t pc = get_saved_state_pc(state), lr = get_saved_state_lr(state);
+	task_t task = get_threadtask(th);
+	int32_t pid = task ? task_pid(task) : -1;
+	uint32_t h = (uint32_t)((pc >> 2) ^ (uint32_t)pid ^ (cpu * 0x9E3779B1u)) % HB_SLOTS;
+	lck_spin_lock(&hb_lock);
+	hb_cnt[cpu].kern++;
+	for (uint32_t i = 0; i < HB_PROBE; i++) {
+		struct hb_slot *s = &hb_tab[(h + i) % HB_SLOTS];
+		if (s->n == 0) {
+			s->pc = pc;
+			s->pid = pid;
+			s->cpu = cpu;
+		}
+		if (s->pc == pc && s->pid == pid && s->cpu == cpu) {
+			s->n++;
+			s->lr = lr;
+			lck_spin_unlock(&hb_lock);
+			return;
+		}
+	}
+	hb_drop++;
+	lck_spin_unlock(&hb_lock);
+}
+
+static void
+hb_report(uint32_t secs)
+{
+	static struct hb_slot snap[HB_SLOTS];
+	static struct hb_cpu_cnt cnt[MAX_CPUS];
+	uint32_t user = 0, kern = 0, idle = 0, drop;
+
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	lck_spin_lock(&hb_lock);
+	for (uint32_t i = 0; i < HB_SLOTS; i++) {
+		snap[i] = hb_tab[i];
+		hb_tab[i].n = 0;
+	}
+	for (uint32_t c = 0; c < MAX_CPUS; c++) {
+		cnt[c] = hb_cnt[c];
+		hb_cnt[c] = (struct hb_cpu_cnt){ 0, 0, 0 };
+	}
+	drop = hb_drop;
+	hb_drop = 0;
+	lck_spin_unlock(&hb_lock);
+	ml_set_interrupts_enabled(istate);
+
+	for (uint32_t c = 0; c < MAX_CPUS; c++) {
+		user += cnt[c].user; kern += cnt[c].kern; idle += cnt[c].idle;
+	}
+	const int smp = real_ncpus > 1;
+	printf("LILAC PROF t+%us: idle %u user %u kern %u (unbinned %u)\n", secs, idle, user, kern, drop);
+	for (uint32_t c = 0; smp && c < MAX_CPUS; c++) {
+		if (cnt[c].idle | cnt[c].user | cnt[c].kern) {
+			printf("LILAC PROF cpu%u: idle %u user %u kern %u\n", c, cnt[c].idle, cnt[c].user, cnt[c].kern);
+		}
+	}
+	for (uint32_t k = 0; k < HB_TOP; k++) {
+		uint32_t best = HB_SLOTS;
+		for (uint32_t i = 0; i < HB_SLOTS; i++) {
+			if (snap[i].n != 0 && (best == HB_SLOTS || snap[i].n > snap[best].n)) {
+				best = i;
+			}
+		}
+		if (best == HB_SLOTS) {
+			break;
+		}
+		if (smp) {
+			printf("LILAC PROF  %u pid %d pc 0x%lx lr 0x%lx cpu %u\n", snap[best].n, snap[best].pid,
+			    (unsigned long)VM_KERNEL_UNSLIDE(snap[best].pc),
+			    (unsigned long)VM_KERNEL_UNSLIDE(snap[best].lr), snap[best].cpu);
+		} else {
+			printf("LILAC PROF  %u pid %d pc 0x%lx lr 0x%lx\n", snap[best].n, snap[best].pid,
+			    (unsigned long)VM_KERNEL_UNSLIDE(snap[best].pc),
+			    (unsigned long)VM_KERNEL_UNSLIDE(snap[best].lr));
+		}
+		snap[best].n = 0;
+	}
+	extern void lilac_sd_report(void);
+	lilac_sd_report();      /* bsd/dev/lilac_sd.c: SD requests, KiB, time, naps for the same interval */
+}
+
+static void
+lilac_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t secs = 0;
+	for (;;) {
+		lilac_heartbeat();
+		if (++secs % HB_REPORT_SECS == 0) {
+			hb_report(secs);
+		}
+		assert_wait_timeout((event_t)&hb_wait_chan, THREAD_UNINT, 1000, (uint32_t)NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void lilac_hb_start(void);
+
+void
+lilac_hb_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start_priority(lilac_hb_thread, NULL, MAXPRI_KERNEL, &thread) != KERN_SUCCESS) {
+		printf("LILAC HB: thread start failed\n");
+		return;
+	}
+	thread_deallocate(thread);
+	hb_on = 1;
+	printf("LILAC HB: watchdog heartbeat 1 s, PC sampler report every %u s\n", HB_REPORT_SECS);
+}
+#endif /* LILAC */
