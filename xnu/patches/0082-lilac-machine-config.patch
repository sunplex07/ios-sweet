+#!/usr/bin/env python3
+"""Execute the real lilac_ufs.c against a sparse LU0/UFSHCI model under ASan/UBSan.
+Only kernel API shims, MMIO primitives and the ARM barrier are replaced. Neither
+command builders, GPT parsing, policy, phases nor BSD entry points are replaced.
+No device access. Scratch defaults to the explicitly designated SSD directory.
+"""
+import os
