diff --git a/bsd/dev/lilac_disp.c b/bsd/dev/lilac_disp.c
new file mode 100644
index 0000000..3c3a2dd
--- /dev/null
+++ b/bsd/dev/lilac_disp.c
@@ -0,0 +1,165 @@
+/*
+ * LILAC (Xperia XZ1 Compact, MSM8998): display probe, stage 85 (lilac_stop=85).
+ *
+ * The panel is a 720x1280 DSI command-mode panel (somc lilac dtsi:
+ * qcom,mdss-dsi-panel-type = "dsi_cmd_mode"); UEFI's SimpleFbDxe draws into
+ * the continuous-splash RAM at 0x9D400000 (RGB888, stride 2160) and the
+ * bootloader-programmed MDP refreshes the panel from it. Whether that refresh
+ * survives into xnu decides whether a RAM framebuffer can show anything.
+ *
+ * Nothing here runs unless lilac_stop=85. MDSS/MMCC/GCC registers are only
+ * read, and only after the clocks that gate them read as running:
+ *   GCC  0x00100000 + 0x9004  gcc_mmss_noc_cfg_ahb_clk CBCR (any MMSS access depends on it)
+ *   MMCC 0x0C8C0000 + 0x2304  MDSS GDSCR (bit31 PWR_ON)
+ *                   + 0x2308/0x2310/0x231C  mdss_ahb/axi/mdp CBCR (bit31 CLK_OFF)
+ *   MDP  0x0C901000: pingpong_0 +0x70000 (+0x14 read pointer, +0x2C write pointer line,
+ *        +0x30 autorefresh config), SSPP VIG0-3 +0x4000.. / DMA0-3 +0x24000.. (+0x14 SRC0_ADDR,
+ *        +0x24 YSTRIDE0)  (Linux dpu_3_0_msm8998.h, dpu_hw_pingpong.c, dpu_hw_sspp.c).
+ * The only write is to the splash RAM itself (below xnu's physBase 0xA0000000,
+ * mapped device-nGnRE so no cache maintenance is needed): eight vertical
+ * colour bars, written once the MDSS clocks read as running, during the 20 s +
+ * 4 * nibble stop delay, so they are on screen if the panel is refreshing.
+ *
+ * Nibble: bit0 GCC MMSS NoC AHB clock running; bit1 MDSS GDSC on and AHB/AXI/MDP
+ * clocks running; bit2 pingpong_0 pointers move over 100 ms (frames are being
+ * sent); bit3 an SSPP scans out 0x9D400000 with stride 2160.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <libkern/libkern.h>
+#include <arm64/sweet_early.h>
+
+#if defined(ARM64_BOARD_CONFIG_LILAC)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define GCC_MMSS_NOC_PA         0x00109000ULL
+#define GCC_MMSS_NOC_CBCR       0x004
+#define MMCC_MDSS_PA            0x0C8C2000ULL
+#define MMCC_MDSS_GDSCR         0x304
+#define MMCC_MDSS_AHB_CBCR      0x308
+#define MMCC_MDSS_AXI_CBCR      0x310
+#define MMCC_MDSS_MDP_CBCR      0x31C
+#define MDP_PA                  0x0C901000ULL
+#define MDP_PP0                 0x70000
+#define MDP_LEN                 0x72000
+#define PP_INT_COUNT_VAL        0x14
+#define PP_LINE_COUNT           0x2C
+#define PP_AUTOREFRESH_CONFIG   0x30
+#define SSPP_SRC0_ADDR          0x14
+#define SSPP_SRC_YSTRIDE0       0x24
+
+#define FB_PA                   0x9D400000ULL
+#define FB_W                    720u
+#define FB_H                    1280u
+#define FB_STRIDE               2160u
+
+static const uint32_t sspp_off[8] = {
+	0x4000, 0x6000, 0x8000, 0xa000, 0x24000, 0x26000, 0x28000, 0x2a000,
+};
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+lilac_disp_bars(void)
+{
+	static const uint8_t col[8][3] = {   /* bytes in memory order B, G, R (PixelBitMask R=0xFF0000) */
+		{ 0xFF, 0xFF, 0xFF }, { 0x00, 0xFF, 0xFF }, { 0xFF, 0xFF, 0x00 }, { 0x00, 0xFF, 0x00 },
+		{ 0xFF, 0x00, 0xFF }, { 0x00, 0x00, 0xFF }, { 0xFF, 0x00, 0x00 }, { 0x00, 0x00, 0x00 },
+	};
+	vm_offset_t fb = ml_io_map(FB_PA, (vm_size_t)FB_STRIDE * FB_H);
+	if (!fb) {
+		return;
+	}
+	for (uint32_t y = 0; y < FB_H; y++) {
+		volatile uint8_t *row = (volatile uint8_t *)(fb + (vm_offset_t)y * FB_STRIDE);
+		for (uint32_t x = 0; x < FB_W; x++) {
+			const uint8_t *c = col[(x * 8) / FB_W];
+			row[3 * x] = c[0];
+			row[3 * x + 1] = c[1];
+			row[3 * x + 2] = c[2];
+		}
+	}
+	__builtin_arm_dsb(0xF);
+}
+
+void lilac_disp_probe(void);
+
+void
+lilac_disp_probe(void)
+{
+	unsigned int nib = 0;
+
+	if (!lilac_stop_is(85)) {
+		return;
+	}
+	vm_offset_t gcc = ml_io_map(GCC_MMSS_NOC_PA, PAGE_SIZE);
+	uint32_t noc = gcc ? rd(gcc, GCC_MMSS_NOC_CBCR) : 0xFFFFFFFFu;
+	printf("LILAC DISP: gcc_mmss_noc_cfg_ahb CBCR 0x%08x\n", noc);
+	if (!gcc || (noc & 0x80000000u)) {
+		lilac_report(85, nib);
+		return;
+	}
+	nib |= 1;
+
+	vm_offset_t mmcc = ml_io_map(MMCC_MDSS_PA, PAGE_SIZE);
+	if (!mmcc) {
+		lilac_report(85, nib);
+		return;
+	}
+	uint32_t gdsc = rd(mmcc, MMCC_MDSS_GDSCR), ahb = rd(mmcc, MMCC_MDSS_AHB_CBCR);
+	uint32_t axi = rd(mmcc, MMCC_MDSS_AXI_CBCR), mdp = rd(mmcc, MMCC_MDSS_MDP_CBCR);
+	printf("LILAC DISP: MDSS GDSCR 0x%08x ahb 0x%08x axi 0x%08x mdp 0x%08x\n", gdsc, ahb, axi, mdp);
+	if (!(gdsc & 0x80000000u) || ((ahb | axi | mdp) & 0x80000000u)) {
+		lilac_report(85, nib);
+		return;
+	}
+	nib |= 2;
+
+	vm_offset_t m = ml_io_map(MDP_PA, MDP_LEN);
+	if (!m) {
+		lilac_report(85, nib);
+		return;
+	}
+	uint32_t rp0 = rd(m, MDP_PP0 + PP_INT_COUNT_VAL), wp0 = rd(m, MDP_PP0 + PP_LINE_COUNT);
+	uint32_t ar = rd(m, MDP_PP0 + PP_AUTOREFRESH_CONFIG);
+	unsigned int rp_changes = 0, wp_changes = 0;
+	uint32_t rp = rp0, wp = wp0;
+	for (unsigned int i = 0; i < 1000; i++) {
+		delay(97 + (int)(i % 7));
+		uint32_t r = rd(m, MDP_PP0 + PP_INT_COUNT_VAL), w = rd(m, MDP_PP0 + PP_LINE_COUNT);
+		if (r != rp) {
+			rp_changes++;
+		}
+		if (w != wp) {
+			wp_changes++;
+		}
+		rp = r;
+		wp = w;
+	}
+	printf("LILAC DISP: pp0 autorefresh 0x%08x rdptr 0x%08x->0x%08x (%u changes) wrptr 0x%08x->0x%08x (%u changes)\n",
+	    ar, rp0, rp, rp_changes, wp0, wp, wp_changes);
+	if (wp_changes > 0 || (rp >> 16) != (rp0 >> 16)) {
+		nib |= 4;
+	}
+	for (unsigned int i = 0; i < 8; i++) {
+		uint32_t a = rd(m, sspp_off[i] + SSPP_SRC0_ADDR), s = rd(m, sspp_off[i] + SSPP_SRC_YSTRIDE0);
+		printf("LILAC DISP: sspp 0x%05x src0 0x%08x ystride0 0x%08x\n", sspp_off[i], a, s);
+		if (a == (uint32_t)FB_PA && (s & 0xFFFFu) == FB_STRIDE) {
+			nib |= 8;
+		}
+	}
+	/* RAM only (no MDSS access), so also when no motion was seen: the screen is the ground truth. */
+	lilac_disp_bars();
+	printf("LILAC DISP: colour bars written to 0x%llx\n", FB_PA);
+	lilac_report(85, nib);
+}
+
+#endif /* ARM64_BOARD_CONFIG_LILAC */
diff --git a/bsd/dev/lilac_sd.c b/bsd/dev/lilac_sd.c
new file mode 100644
index 0000000..568f9eb
--- /dev/null
+++ b/bsd/dev/lilac_sd.c
@@ -0,0 +1,1607 @@
+/*
+ * LILAC microSD (MSM8998 SDHC2): ADMA2 strategy I/O, PIO probe/log/fallback.
+ *
+ * Hardware (mainline msm8998.dtsi sdhc2, qcom,sdhci-msm-v4): standard SDHCI
+ * registers at 0x0c0a4900, MSM core registers at 0x0c0a4000. No SMMU.
+ * UEFI SdccDxe leaves the card selected in transfer state, 4-bit bus, clocks
+ * running and interrupt signals off (G17-SDP register dump), so this code
+ * reuses that state: it never touches clocks, power, bus width or the card's
+ * identification. Probes and the SD log use PIO; sdroot0 strategy uses ADMA2
+ * unless sddma=0 or unavailable. Only the guarded paths below may write.
+ *
+ * Probe (bsd_init, only when lilac_stop is 65, 66 or 67):
+ *   65: read LBA 0          expect nibble 0xF
+ *   66: read LBA 2048       FAT32 boot sector: nibble from its bytes (see EXPERIMENTS.md G17)
+ *   67: read LBA 0x8000000  past the end of the card: expect nibble 0x0
+ * nibble bit0 = CMD17 completed without error, bit1 = 0x55AA signature,
+ * bit2 = partition 1 type 0x0C (FAT32 LBA), bit3 = partition 1 starts at 2048.
+ *
+ * Step 2: read-only BSD disk sdroot0 / rsdroot0 over one MBR partition of the
+ * card (boot-arg sdpart=N, 1-4, default 2; it must have type 0xAF, Apple HFS),
+ * so rd=sdroot0 roots on it (IOFindBSDRoot, iokit/bsddev/IOKitBSDInit.cpp).
+ * Without boot-arg sdrw=1 there is no write path: opens for writing and write
+ * requests fail with EROFS. With sdrw=1 the partition must also not overlap
+ * LBA 0 or any other MBR entry; strategy writes use CMD25/CMD24 ADMA2 with
+ * PIO CMD24 fallback (synchronous: wait for card busy to end) and may only hit
+ * LBAs inside that partition (sd_lba_writable). Stage 84 (lilac_stop=84,
+ * sdrw=1) is a write self-check on the partition's last block, see
+ * lilac_sd_write_check().
+ * Stage 68 reports the setup: bit0 MBR read, bit1 0x55AA, bit2 partition type
+ * 0xAF with a non-empty extent, bit3 device nodes created.
+ */
+#if defined(ARM64_BOARD_CONFIG_LILAC)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <sys/kernel.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/debug.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+#include <libkern/crc.h>
+#include <arm64/sweet_early.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include "lilac_sd_adma.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);   /* as bsd/dev/sweet_ufs.c */
+
+#define SD_MAP_PA       0x0c0a4000ULL   /* MSM core; SDHCI at +0x900 */
+#define SD_MAP_SIZE     0x1000
+#define SD_HC           0x900
+
+/* SDHCI standard registers (offsets from SD_HC) */
+#define HC_BLKSZ_CNT    0x04            /* [15:0] block size, [31:16] block count */
+#define HC_ARG          0x08
+#define HC_XFER_CMD     0x0C            /* [15:0] transfer mode, [31:16] command */
+#define HC_RESP0        0x10
+#define HC_BUFFER       0x20
+#define HC_PRESENT      0x24
+#define HC_RESET        0x2C            /* byte 3 (0x2F): software reset */
+#define HC_INT_STATUS   0x30            /* [15:0] normal, [31:16] error */
+#define HC_INT_ENABLE   0x34            /* status enables (latching), not IRQ signals */
+#define INT_ENABLE_UEFI 0x07FF803Fu     /* value UEFI SdccDxe leaves (G17-SDP) */
+#define R1_ERRORS       0xFDF90008u     /* R1 card-status error bits */
+
+#define PS_CMD_INHIBIT  (1u << 0)
+#define PS_DAT_INHIBIT  (1u << 1)
+
+#define INT_CMD_DONE    (1u << 0)
+#define INT_XFER_DONE   (1u << 1)
+#define INT_BUF_WR      (1u << 4)
+#define INT_BUF_RD      (1u << 5)
+#define PS_WRITABLE     (1u << 19)      /* write-protect pin: 1 = writable */
+#define PS_DAT0         (1u << 20)      /* DAT[0] level; low while the card is busy programming */
+#define INT_ERROR       (1u << 15)
+#define INT_ERR_MASK    0xFFFF0000u
+
+#define XFER_BLKCNT_EN  (1u << 1)
+#define XFER_READ       (1u << 4)
+#define XFER_MULTI      (1u << 5)
+#define CMD_RESP48      0x02
+#define CMD_RESP48_BUSY 0x03
+#define CMD_TYPE_ABORT  (3u << 6)
+#define CMD_CRC_CHECK   (1u << 3)
+#define CMD_IDX_CHECK   (1u << 4)
+#define CMD_DATA        (1u << 5)
+
+#define RESET_CMD       (1u << 25)      /* bits of the 32-bit word at 0x2C */
+#define RESET_DAT       (1u << 26)
+
+#define SD_BLOCK        512u
+#define SD_MULTI_MAX    128u            /* blocks per CMD18 (64 KiB) */
+
+/* Register encodings: Linux 4.14 drivers/mmc/host/sdhci.h:35-45,83-89,
+ * 122-123,211-219,254-259,276-283. Byte accesses preserve power/clock state.
+ */
+#define HC_CONTROL      0x28
+#define HC_CAPS         0x40
+#define HC_ADMA_ERROR   0x54
+#define HC_ADMA_LO      0x58
+#define HC_ADMA_HI      0x5c
+#define HC_VERSION      0xfe
+#define CAP_ADMA2       (1u << 19)
+#define CAP_64BIT       (1u << 28)
+#define CTRL_DMA_MASK   0x18u
+#define CTRL_ADMA32     0x10u
+#define CTRL_ADMA64     0x18u
+#define XFER_DMA        1u
+#define XFER_AUTO12     (1u << 2)
+#define R1_ILLEGAL_CMD  (1u << 22)
+#define SD_DMA_BYTES    (SD_MULTI_MAX * SD_BLOCK)
+#define SD_DMA_NAP_US   150
+
+static vm_offset_t sd_regs;
+static bool sd_dma_fatal; /* failed line reset: no subsequent controller command */
+static struct {
+	vm_offset_t mem;
+	uint64_t pa;
+	bool initialized, enabled, wide, writes, verified, cmd25;
+} sda;
+
+static void sd_dma_init(void);
+static int sd_dma_hw(bool rd, uint32_t first, uint32_t count,
+    uint32_t lba, uint32_t n, uint8_t *buf, uint32_t *stp);
+static int sd_strategy_transfer(bool rd, uint32_t lba, uint32_t n, uint8_t *buf,
+    bool *used_dma, bool *used_pio);
+
+static void
+sd_map(void)
+{
+	if (!sd_regs) {
+		sd_regs = ml_io_map(SD_MAP_PA, SD_MAP_SIZE);
+	}
+}
+
+static inline uint32_t
+sd_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sd_regs + SD_HC + off);
+}
+
+static inline void
+sd_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(sd_regs + SD_HC + off) = v;
+}
+
+static uint64_t
+sd_deadline(uint32_t usec)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)usec * 1000, &abs);
+	return mach_absolute_time() + abs;
+}
+
+/*
+ * Polling without holding the CPU. The controller is driven without
+ * interrupts, and a card programming a CMD24 block or fetching a CMD17/18
+ * block keeps the caller waiting for hundreds of microseconds to
+ * milliseconds; spinning through that charged the whole wait to the caller
+ * and starved everything else on the single CPU (G29-HB: logd_helper spent
+ * ~90 s of system time in sd_write_block_hw's XFER_DONE wait). After
+ * SD_SPIN_US of polling, a caller that may block sleeps SD_NAP_US between
+ * polls: delay() blocks the thread when interrupts and preemption are
+ * enabled and spins otherwise, so the reset-time log flush (interrupts may be
+ * masked) and panic keep polling.
+ */
+#define SD_SPIN_US      20u
+#define SD_NAP_US       50u
+
+/*
+ * Data-phase waits (command response, next PIO buffer of a transfer the card is
+ * already streaming) spin up to SD_DATA_SPIN_US before napping: at ~5.8 MB/s a 512-byte block arrives every
+ * ~90 us, and a nap per block (block, idle, timer IRQ, wake) left the single CPU
+ * ~85% idle while HFS reads crawled (G30m2 t+120-420 s, pid 91 in sd_read_blocks).
+ * Card-busy waits (write programming, XFER_DONE) keep the short SD_SPIN_US.
+ */
+#define SD_DATA_SPIN_US 500u
+
+/* Per-report-interval I/O statistics, printed by lilac_sd_report() (lilac_hb.c). */
+#define SDS_PIDS        6u
+static struct {
+	uint32_t rd_req, rd_blk, wr_req, wr_blk;
+	uint64_t rd_abs, wr_abs, max_abs;
+	uint32_t dma, pio, err; /* strategy requests; fallback counts in both */
+	uint32_t naps;
+	uint64_t nap_abs;
+	struct { int32_t pid; uint32_t blk; char name[17]; } top[SDS_PIDS];
+} sds;
+
+static void
+sd_poll_pause(uint64_t spin_end)
+{
+	if (mach_absolute_time() > spin_end && !panic_active()) {
+		uint64_t t0 = mach_absolute_time();
+		delay(SD_NAP_US);
+		os_atomic_inc(&sds.naps, relaxed);
+		os_atomic_add(&sds.nap_abs, mach_absolute_time() - t0, relaxed);
+	}
+}
+
+/* One sdroot0 strategy request of nblk blocks that took abs (lilac_sd_lock held). */
+static void
+sd_stat_request(bool rd, uint32_t nblk, uint64_t abs)
+{
+	if (rd) {
+		sds.rd_req++;
+		sds.rd_blk += nblk;
+		sds.rd_abs += abs;
+	} else {
+		sds.wr_req++;
+		sds.wr_blk += nblk;
+		sds.wr_abs += abs;
+	}
+	if (abs > sds.max_abs) {
+		sds.max_abs = abs;
+	}
+	int32_t pid = proc_selfpid();
+	uint32_t slot = SDS_PIDS;
+	for (uint32_t i = 0; i < SDS_PIDS; i++) {
+		if (sds.top[i].blk != 0 && sds.top[i].pid == pid) {
+			slot = i;
+			break;
+		}
+		if (slot == SDS_PIDS && sds.top[i].blk == 0) {
+			slot = i;
+		}
+	}
+	if (slot == SDS_PIDS) {
+		return;
+	}
+	if (sds.top[slot].blk == 0) {
+		sds.top[slot].pid = pid;
+		proc_selfname(sds.top[slot].name, sizeof(sds.top[slot].name));
+	}
+	sds.top[slot].blk += nblk;
+}
+
+static uint32_t
+sd_abs_ms(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return (uint32_t)(ns / NSEC_PER_MSEC);
+}
+
+static int sd_wait_int_spin(uint32_t want, uint32_t usec, uint32_t spin_us, uint32_t *status);
+
+/* Wait until any bit of want is set in the interrupt status, or an error. */
+static int
+sd_wait_int(uint32_t want, uint32_t usec, uint32_t *status)
+{
+	return sd_wait_int_spin(want, usec,
+	           (want & (INT_CMD_DONE | INT_BUF_RD | INT_BUF_WR)) ? SD_DATA_SPIN_US : SD_SPIN_US, status);
+}
+
+static int
+sd_wait_int_spin(uint32_t want, uint32_t usec, uint32_t spin_us, uint32_t *status)
+{
+	uint64_t end = sd_deadline(usec), spin_end = sd_deadline(spin_us);
+	for (;;) {
+		uint32_t s = sd_rd(HC_INT_STATUS);
+		if (s & (INT_ERROR | INT_ERR_MASK)) {
+			*status = s;
+			return EIO;
+		}
+		if (s & want) {
+			*status = s;
+			return 0;
+		}
+		if (mach_absolute_time() > end) {
+			*status = s;
+			return ETIMEDOUT;
+		}
+		sd_poll_pause(spin_end);
+	}
+}
+
+/* Wait until none of the HC_PRESENT bits in mask is set. */
+static int
+sd_wait_present_clear(uint32_t mask, uint32_t usec)
+{
+	if (sd_dma_fatal) {
+		return EIO;
+	}
+	uint64_t end = sd_deadline(usec), spin_end = sd_deadline(SD_SPIN_US);
+	while (sd_rd(HC_PRESENT) & mask) {
+		if (mach_absolute_time() > end) {
+			return EBUSY;
+		}
+		sd_poll_pause(spin_end);
+	}
+	return 0;
+}
+
+/* Software reset of the CMD and DAT state machines after an error (card state untouched). */
+static bool
+sd_reset_lines(void)
+{
+	/* Write ONLY reset CMD/DAT, never echo a full-reset bit or clock bits. */
+	volatile uint8_t *reset = (volatile uint8_t *)(sd_regs + SD_HC + HC_RESET + 3);
+	*reset = 6;
+	uint64_t end = sd_deadline(100000);
+	while ((*reset & 6) && mach_absolute_time() < end) {
+	}
+	bool ok = (*reset & 6) == 0;
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	return ok;
+}
+
+/* CMD17 for one 512-byte block (SDHC/SDXC block addressing), polled PIO. */
+static int
+sd_read_block_hw(uint32_t lba, uint8_t *buf, uint32_t *stp)
+{
+	uint32_t st = 0;
+	*stp = 0;
+	if (sd_wait_present_clear(PS_CMD_INHIBIT | PS_DAT_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	if ((sd_rd(HC_INT_ENABLE) & (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_RD)) != (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_RD)) {
+		sd_wr(HC_INT_ENABLE, INT_ENABLE_UEFI);
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_BLKSZ_CNT, (1u << 16) | SD_BLOCK);
+	sd_wr(HC_ARG, lba);
+	sd_wr(HC_XFER_CMD, ((17u << 8 | CMD_DATA | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48) << 16) | XFER_READ);
+
+	int error = sd_wait_int(INT_CMD_DONE, 100000, &st);
+	if (!error && (sd_rd(HC_RESP0) & R1_ERRORS)) {
+		st = sd_rd(HC_RESP0);
+		error = ERANGE;
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_CMD_DONE);
+		error = sd_wait_int(INT_BUF_RD, 500000, &st);
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_BUF_RD);
+		for (uint32_t i = 0; i < SD_BLOCK; i += 4) {
+			uint32_t w = sd_rd(HC_BUFFER);
+			buf[i] = (uint8_t)w;
+			buf[i + 1] = (uint8_t)(w >> 8);
+			buf[i + 2] = (uint8_t)(w >> 16);
+			buf[i + 3] = (uint8_t)(w >> 24);
+		}
+		error = sd_wait_int(INT_XFER_DONE, 500000, &st);
+	}
+	if (error) {
+		*stp = st;
+		sd_reset_lines();
+		return error;
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	return 0;
+}
+
+/*
+ * CMD12 STOP_TRANSMISSION (R1b), as UEFI SdccDxe ends its multi-block reads on
+ * this controller (G17-SDP: last command CMD12). Returns 0 once the card has
+ * released DAT0.
+ */
+static int
+sd_stop_transmission(uint32_t *stp)
+{
+	if (sd_wait_present_clear(PS_CMD_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_ARG, 0);
+	sd_wr(HC_XFER_CMD, (12u << 8 | CMD_TYPE_ABORT | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48_BUSY) << 16);
+	int error = sd_wait_int(INT_CMD_DONE, 100000, stp);
+	if (!error) {
+		/* R1b: transfer complete marks the end of the busy signal. */
+		error = sd_wait_int(INT_XFER_DONE, 1000000, stp);
+	}
+	return error;
+}
+
+/*
+ * CMD18 for n (2..SD_MULTI_MAX) consecutive 512-byte blocks, polled PIO, then
+ * an explicit CMD12. Read-only: no write command can be issued from here.
+ */
+static int
+sd_read_multi_hw(uint32_t lba, uint32_t n, uint8_t *buf, uint32_t *stp)
+{
+	uint32_t st = 0;
+	*stp = 0;
+	if (n < 2 || n > SD_MULTI_MAX) {
+		return EINVAL;
+	}
+	if (sd_wait_present_clear(PS_CMD_INHIBIT | PS_DAT_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	if ((sd_rd(HC_INT_ENABLE) & (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_RD)) != (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_RD)) {
+		sd_wr(HC_INT_ENABLE, INT_ENABLE_UEFI);
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_BLKSZ_CNT, (n << 16) | SD_BLOCK);
+	sd_wr(HC_ARG, lba);
+	sd_wr(HC_XFER_CMD, ((18u << 8 | CMD_DATA | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48) << 16) |
+	    XFER_MULTI | XFER_READ | XFER_BLKCNT_EN);
+
+	int error = sd_wait_int(INT_CMD_DONE, 100000, &st);
+	if (!error && (sd_rd(HC_RESP0) & R1_ERRORS)) {
+		st = sd_rd(HC_RESP0);
+		error = ERANGE;
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_CMD_DONE);
+	}
+	for (uint32_t b = 0; !error && b < n; b++) {
+		error = sd_wait_int(INT_BUF_RD, 500000, &st);
+		if (error) {
+			break;
+		}
+		sd_wr(HC_INT_STATUS, INT_BUF_RD);
+		uint8_t *p = buf + b * SD_BLOCK;
+		for (uint32_t i = 0; i < SD_BLOCK; i += 4) {
+			uint32_t w = sd_rd(HC_BUFFER);
+			p[i] = (uint8_t)w;
+			p[i + 1] = (uint8_t)(w >> 8);
+			p[i + 2] = (uint8_t)(w >> 16);
+			p[i + 3] = (uint8_t)(w >> 24);
+		}
+	}
+	if (!error) {
+		error = sd_wait_int(INT_XFER_DONE, 500000, &st);
+	}
+	/* Always end the open-ended read, also after an error, so the card returns to tran. */
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	uint32_t st12 = 0;
+	int stop = sd_stop_transmission(&st12);
+	if (error || stop) {
+		*stp = error ? st : st12;
+		sd_reset_lines();
+		return error ? error : stop;
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	return 0;
+}
+
+/*
+ * One controller transaction at a time. Interrupts stay enabled (a polled
+ * transfer can take far longer than the 35 ms interrupt-masked limit of
+ * DEVELOPMENT kernels), so a transaction can be preempted. Thread-context
+ * callers wait for the controller, sleeping between attempts; the reset-time
+ * log flush, which may run in a panic or with interrupts masked, only tries
+ * once and skips its flush if a transaction is in progress.
+ */
+static uint32_t _Atomic sd_busy;
+
+static bool
+sd_claim(bool wait)
+{
+	while (!os_atomic_cmpxchg(&sd_busy, 0u, 1u, acquire)) {
+		if (!wait) {
+			return false;
+		}
+		delay(100);
+	}
+	return true;
+}
+
+static void
+sd_release(void)
+{
+	os_atomic_store(&sd_busy, 0u, release);
+}
+
+static int
+sd_read_block(uint32_t lba, uint8_t *buf)
+{
+	uint32_t st;
+	(void)sd_claim(true);
+	int error = sd_read_block_hw(lba, buf, &st);
+	sd_release();
+	if (error) {
+		printf("LILAC SD: CMD17 lba 0x%x failed %d, int 0x%08x\n", lba, error, st);
+	}
+	return error;
+}
+
+/* n consecutive blocks; CMD18 for runs of 2+, CMD17 for a single block. */
+static int
+sd_read_blocks(uint32_t lba, uint32_t n, uint8_t *buf)
+{
+	uint32_t st;
+	int error = 0;
+	while (n && !error) {
+		uint32_t k = MIN(n, SD_MULTI_MAX);
+		(void)sd_claim(true);
+		error = (k == 1) ? sd_read_block_hw(lba, buf, &st) : sd_read_multi_hw(lba, k, buf, &st);
+		sd_release();
+		if (error) {
+			printf("LILAC SD: CMD%u lba 0x%x n %u failed %d, int 0x%08x\n", k == 1 ? 17 : 18, lba, k, error, st);
+		}
+		lba += k;
+		buf += k * SD_BLOCK;
+		n -= k;
+	}
+	return error;
+}
+
+/*
+ * Stage 69: CMD18 self-check on the first 4 MiB of MBR partition 2 (the
+ * G15 getpid.hfs image, CRC32 0x794a64d2). bit0 all CMD18 reads succeeded,
+ * bit1 CRC32 matches, bit2 the first 64 KiB equal CMD17 reads of the same
+ * blocks, bit3 CMD18 at least 4x faster than CMD17 over those 64 KiB.
+ */
+#define SD69_BYTES      (4u << 20)
+#define SD69_CRC        0x794a64d2u
+
+static void
+lilac_sd_multi_check(void)
+{
+	static uint8_t chunk[SD_MULTI_MAX * SD_BLOCK], single[SD_MULTI_MAX * SD_BLOCK];
+	unsigned int nib = 0;
+	uint32_t crc = 0, first, p2_count;
+	uint64_t t0, t1, t2, multi_ns = 0, single_ns = 0;
+	bool ok = true;
+
+	sd_map();
+	if (sd_read_blocks(0, 1, chunk) || chunk[510] != 0x55 || chunk[511] != 0xAA || chunk[446 + 16 + 4] != 0xAF) {
+		lilac_report(69, 0);
+		return;
+	}
+	first = chunk[446 + 16 + 8] | chunk[446 + 16 + 9] << 8 | chunk[446 + 16 + 10] << 16 | (uint32_t)chunk[446 + 16 + 11] << 24;
+	p2_count = chunk[474] | chunk[475] << 8 | chunk[476] << 16 | (uint32_t)chunk[477] << 24;
+	if (!sd_adma_range(first, p2_count, first, SD69_BYTES / SD_BLOCK)) {
+		lilac_report(69, 0);
+		return;
+	}
+	t0 = mach_absolute_time();
+	for (uint32_t off = 0; off < SD69_BYTES && ok; off += sizeof(chunk)) {
+		ok = sd_read_blocks(first + off / SD_BLOCK, SD_MULTI_MAX, chunk) == 0;
+		if (ok) {
+			crc = crc32(crc, chunk, sizeof(chunk));
+		}
+	}
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &multi_ns);
+	if (ok) {
+		nib |= 1;
+		if (crc == SD69_CRC) {
+			nib |= 2;
+		}
+		/* Same 64 KiB both ways. */
+		t0 = mach_absolute_time();
+		ok = sd_read_blocks(first, SD_MULTI_MAX, chunk) == 0;
+		t1 = mach_absolute_time();
+		for (uint32_t b = 0; ok && b < SD_MULTI_MAX; b++) {
+			ok = sd_read_blocks(first + b, 1, single + b * SD_BLOCK) == 0;
+		}
+		t2 = mach_absolute_time();
+		uint64_t m64 = 0;
+		absolutetime_to_nanoseconds(t1 - t0, &m64);
+		absolutetime_to_nanoseconds(t2 - t1, &single_ns);
+		if (ok && memcmp(chunk, single, sizeof(chunk)) == 0) {
+			nib |= 4;
+		}
+		if (ok && m64 * 4 <= single_ns) {
+			nib |= 8;
+		}
+		printf("LILAC SD: CMD18 check: 4 MiB in %llu us (%llu KiB/s), crc32 0x%08x; 64 KiB: CMD18 %llu us, CMD17 %llu us\n",
+		    multi_ns / 1000, multi_ns ? (4096ull * 1000000000ull) / multi_ns : 0, crc, m64 / 1000, single_ns / 1000);
+	}
+	printf("LILAC SD: CMD18 check nibble 0x%x\n", nib);
+	sd_dma_init();
+	if (sda.enabled) {
+		uint32_t dma_crc = 0, st = 0;
+		bool dma_ok = (nib & 1) && sd_adma_range(first, p2_count, first, SD69_BYTES / SD_BLOCK);
+		t0 = mach_absolute_time();
+		for (uint32_t off = 0; dma_ok && off < SD69_BYTES; off += sizeof(chunk)) {
+			(void)sd_claim(true);
+			dma_ok = sd_dma_hw(true, first, p2_count, first + off / SD_BLOCK,
+			    SD_MULTI_MAX, chunk, &st) == 0;
+			sd_release();
+			if (dma_ok) {
+				dma_crc = crc32(dma_crc, chunk, sizeof(chunk));
+			}
+		}
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		bool match = dma_ok && dma_crc == crc;
+		printf("LILAC SD: DMA check: 4 MiB in %llu us (%llu KiB/s) crc 0x%08x pio crc 0x%08x %s\n",
+		    ns / 1000, ns ? 4096ull * NSEC_PER_SEC / ns : 0, dma_crc, crc, match ? "match" : "MISMATCH");
+		if (!match) {
+			sda.enabled = sda.writes = false;
+			printf("LILAC SD: DMA disabled for this boot (check failed)\n");
+		}
+	}
+	lilac_report(69, nib);
+}
+
+void lilac_sd_probe(void);
+
+void
+lilac_sd_probe(void)
+{
+	static const struct {
+		unsigned int stage;
+		uint32_t lba;
+	} t[] = { { 65, 0 }, { 66, 2048 }, { 67, 0x8000000 } };
+	static uint8_t blk[SD_BLOCK];
+
+	if (lilac_stop_is(69)) {
+		lilac_sd_multi_check();
+	}
+	for (unsigned int i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+		if (!lilac_stop_is(t[i].stage)) {
+			continue;
+		}
+		sd_map();
+		unsigned int nib = 0;
+		if (sd_read_block(t[i].lba, blk) == 0) {
+			nib |= 1;
+			if (blk[510] == 0x55 && blk[511] == 0xAA) {
+				nib |= 2;
+			}
+			if (blk[446 + 4] == 0x0C) {
+				nib |= 4;
+			}
+			if ((blk[446 + 8] | blk[446 + 9] << 8 | blk[446 + 10] << 16 | (uint32_t)blk[446 + 11] << 24) == 2048) {
+				nib |= 8;
+			}
+		}
+		printf("LILAC SD: probe stage %u lba 0x%x nibble 0x%x\n", t[i].stage, t[i].lba, nib);
+		lilac_report(t[i].stage, nib);
+	}
+}
+
+/* ---- step 2: read-only BSD disk over one MBR partition ---- */
+
+static LCK_GRP_DECLARE(lilac_sd_grp, "lilac_sd");
+static LCK_MTX_DECLARE(lilac_sd_lock, &lilac_sd_grp);
+
+static struct {
+	bool     ready;
+	bool     writable;      /* sdrw=1 and the partition passed the overlap check */
+	uint32_t first;         /* partition start, card LBA (512-byte blocks) */
+	uint32_t nblocks;       /* partition length in 512-byte blocks */
+	uint32_t secsize;       /* logical sector size presented to BSD */
+	int      bmajor, cmajor;
+	dev_t    bdev;
+	uint8_t  bounce[SD_MULTI_MAX * SD_BLOCK];
+} sdd;
+
+static int
+lilac_sd_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!sdd.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !sdd.writable) ? EROFS : 0;
+}
+
+static int sd_write_blocks(uint32_t lba, uint32_t n, const uint8_t *buf);
+static void lilac_sd_write_check(void);
+
+static int
+lilac_sd_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+lilac_sd_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * sdd.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = (uint64_t)sdd.nblocks * SD_BLOCK;
+
+	bool rd = (buf_flags(bp) & B_READ) != 0;
+
+	buf_setresid(bp, count);
+	if (!rd && !sdd.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (buf_blkno(bp) < 0 || (off % SD_BLOCK) || (count % SD_BLOCK) || off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+	uint64_t t_req = mach_absolute_time();
+	bool used_dma = false, used_pio = false;
+	lck_mtx_lock(&lilac_sd_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint32_t k = MIN((count - done) / SD_BLOCK, SD_MULTI_MAX);
+		uint64_t lba = (off + done) / SD_BLOCK;
+		error = sd_strategy_transfer(rd, sdd.first + (uint32_t)lba, k,
+		    (uint8_t *)vaddr + done, &used_dma, &used_pio);
+		if (error) {
+			break;
+		}
+		done += k * SD_BLOCK;
+		buf_setresid(bp, count - done);
+	}
+	sds.dma += used_dma ? 1u : 0u;
+	sds.pio += used_pio ? 1u : 0u;
+	sd_stat_request(rd, count / SD_BLOCK, mach_absolute_time() - t_req);
+	lck_mtx_unlock(&lilac_sd_lock);
+	buf_unmap(bp);
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+void lilac_sd_report(void);
+
+/* Called every LILAC PROF report (lilac_hb.c) from the heartbeat thread. */
+void
+lilac_sd_report(void)
+{
+	if (!sdd.nblocks) {
+		return;
+	}
+	lck_mtx_lock(&lilac_sd_lock);
+	__typeof__(sds) s = sds;
+	bzero(&sds.rd_req, offsetof(__typeof__(sds), naps));
+	bzero(&sds.top, sizeof(sds.top));
+	lck_mtx_unlock(&lilac_sd_lock);
+	uint32_t naps = os_atomic_xchg(&sds.naps, 0u, relaxed);
+	uint64_t nap_abs = os_atomic_xchg(&sds.nap_abs, 0ull, relaxed);
+
+	printf("LILAC SDSTAT rd %u req %u KiB %u ms | wr %u req %u KiB %u ms | max %u ms | naps %u %u ms | dma %u pio %u err %u\n",
+	    s.rd_req, s.rd_blk / 2, sd_abs_ms(s.rd_abs), s.wr_req, s.wr_blk / 2, sd_abs_ms(s.wr_abs),
+	    sd_abs_ms(s.max_abs), naps, sd_abs_ms(nap_abs), s.dma, s.pio, s.err);
+	for (uint32_t i = 0; i < SDS_PIDS; i++) {
+		if (s.top[i].blk != 0) {
+			printf("LILAC SDSTAT  pid %d %s %u KiB\n", s.top[i].pid, s.top[i].name, s.top[i].blk / 2);
+		}
+	}
+}
+
+static int
+lilac_sd_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = sdd.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > 4096 || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		sdd.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = SD_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = (uint64_t)sdd.nblocks * SD_BLOCK / sdd.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = sdd.writable ? 1 : 0;
+		return 0;
+	case DKIOCGETFEATURES:
+		*f = 0;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE:
+		/*
+		 * Every write has completed on the card (busy released) before
+		 * its buf is done, and the SD cache (CMD48/49 enable) is never
+		 * turned on, so there is nothing to flush.
+		 */
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = (SD_MULTI_MAX * SD_BLOCK) / sdd.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = sdd.writable ? (SD_MULTI_MAX * SD_BLOCK) / sdd.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+lilac_sd_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return lilac_sd_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+lilac_sd_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return lilac_sd_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+lilac_sd_psize(__unused dev_t dev)
+{
+	return sdd.ready ? (int)MIN((uint64_t)sdd.nblocks * SD_BLOCK / sdd.secsize, (uint64_t)INT32_MAX) : -1;
+}
+
+static int
+lilac_sd_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(lilac_sd_strategy, NULL, dev, B_READ, minphys, uio, (int)sdd.secsize);
+}
+
+static int
+lilac_sd_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!sdd.writable) {
+		return EROFS;
+	}
+	return physio(lilac_sd_strategy, NULL, dev, B_WRITE, minphys, uio, (int)sdd.secsize);
+}
+
+static const struct bdevsw lilac_sd_bdevsw = {
+	.d_open     = lilac_sd_open,
+	.d_close    = lilac_sd_close,
+	.d_strategy = lilac_sd_strategy,
+	.d_ioctl    = lilac_sd_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = lilac_sd_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw lilac_sd_cdevsw = {
+	.d_open       = lilac_sd_open,
+	.d_close      = lilac_sd_close,
+	.d_read       = lilac_sd_read,
+	.d_write      = lilac_sd_write,
+	.d_ioctl      = lilac_sd_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+lilac_sd_init(void)
+{
+	unsigned int part = 2, nib = 0;
+	uint32_t sdrw = 0;
+	int error;
+
+	PE_parse_boot_argn("sdpart", &part, sizeof(part));
+	PE_parse_boot_argn("sdrw", &sdrw, sizeof(sdrw));
+	if (part < 1 || part > 4) {
+		return EINVAL;
+	}
+	sd_map();
+	lck_mtx_lock(&lilac_sd_lock);
+	error = sd_read_block(0, sdd.bounce);
+	lck_mtx_unlock(&lilac_sd_lock);
+	if (!error) {
+		nib |= 1;
+		const uint8_t *e = sdd.bounce + 446 + 16 * (part - 1);
+		uint32_t first = e[8] | e[9] << 8 | e[10] << 16 | (uint32_t)e[11] << 24;
+		uint32_t n = e[12] | e[13] << 8 | e[14] << 16 | (uint32_t)e[15] << 24;
+		if (sdd.bounce[510] == 0x55 && sdd.bounce[511] == 0xAA) {
+			nib |= 2;
+		}
+		if (e[4] == 0xAF && first != 0 && n != 0 && (uint64_t)first + n <= UINT32_MAX) {
+			nib |= 4;
+			sdd.first = first;
+			sdd.nblocks = n;
+			/* Writable only if no other used MBR entry overlaps it (LBA 0 is excluded by first != 0). */
+			bool alone = (nib & 2) != 0;
+			for (unsigned int i = 0; i < 4 && alone; i++) {
+				const uint8_t *o = sdd.bounce + 446 + 16 * i;
+				uint32_t of = o[8] | o[9] << 8 | o[10] << 16 | (uint32_t)o[11] << 24;
+				uint32_t on = o[12] | o[13] << 8 | o[14] << 16 | (uint32_t)o[15] << 24;
+				if (i == part - 1 || o[4] == 0 || on == 0) {
+					continue;
+				}
+				if ((uint64_t)of + on > (uint64_t)first && (uint64_t)first + n > (uint64_t)of) {
+					alone = false;
+				}
+			}
+			if (sdrw && !alone) {
+				printf("LILAC SD: sdrw refused: partition %u overlaps another MBR entry\n", part);
+			}
+			/* Partition 1 stays protected even with a forged HFS type. */
+			sdd.writable = sdrw == 1 && alone && part != 1;
+		}
+	}
+	if (nib == 7) {
+		sdd.secsize = SD_BLOCK;
+		sdd.bmajor = bdevsw_add(-1, &lilac_sd_bdevsw);
+		if (sdd.bmajor >= 0) {
+			sdd.cmajor = cdevsw_add_with_bdev(-1, &lilac_sd_cdevsw, sdd.bmajor);
+		}
+		if (sdd.bmajor >= 0 && sdd.cmajor >= 0) {
+			sdd.bdev = makedev(sdd.bmajor, 0);
+			int mode = sdd.writable ? 0640 : 0440;
+			devfs_make_node(sdd.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, mode, "sdroot0");
+			devfs_make_node(makedev(sdd.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, mode, "rsdroot0");
+			sdd.ready = true;
+			nib |= 8;
+		}
+	}
+	if (!sdd.ready) {
+		sdd.writable = false;
+	}
+	printf("LILAC SD: partition %u: first 0x%x, %u blocks, setup 0x%x%s\n",
+	    part, sdd.first, sdd.nblocks, nib,
+	    !sdd.ready ? "" : sdd.writable ? ", sdroot0 read-write (sdrw=1)" : ", sdroot0 read-only");
+	if (sdd.ready) {
+		sd_dma_init();
+	}
+	lilac_report(68, nib);
+	if (sdd.ready && lilac_stop_is(84)) {
+		lilac_sd_write_check();
+	}
+	if (!sdd.ready) {
+		return error ? error : ENXIO;
+	}
+	return 0;
+}
+
+/* Root device for rd=sdroot0 (IOFindBSDRoot). */
+int lilac_sd_rootdev(dev_t *dev);
+
+int
+lilac_sd_rootdev(dev_t *dev)
+{
+	if (!sdd.ready) {
+		int error = lilac_sd_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = sdd.bdev;
+	return 0;
+}
+
+/*
+ * ---- step 3: kernel console log on a dedicated SD partition ("sdlog") ----
+ *
+ * All console output is kept in the 4 MiB ring of sweet_ufs.c (_cnputs). It
+ * is copied to an MBR partition of type 0xDA, but only if the host armed that
+ * partition: its block 0 must hold "LILAC-SDLOG-ARM1" and the partition's own
+ * first LBA and length (u32 LE at bytes 16 and 20). The partition must not
+ * overlap the MBR area or any other partition. Layout:
+ *   block 0  arm block (written by the host, never by the kernel)
+ *   block 1  header: "LILACLOG", u32 version 1, u32 ring size, u64 bytes
+ *            written, u64 flush sequence, u64 boot UTC seconds, u32 boot
+ *            microseconds, u32 reason (0 periodic, 1 at reset)
+ *   block 2+ ring; console byte n is at ring offset n % ring size
+ * Every write goes through sd_write_block_hw(), which refuses any LBA outside
+ * blocks 1.. of the armed partition. A thread flushes every 5 s and
+ * lilac_diag.c calls a final flush inside every timed reset (stage report,
+ * fatal reset, panic). Boot-arg sdlog=0 disables it.
+ */
+#define SDLOG_TYPE      0xDA
+#define SDLOG_SECS      5
+#define SDLOG_RING_LBA  2u
+
+extern uint32_t sweet_log_ring_size(void);
+extern void sweet_log_ring_read(uint32_t off, char *out, uint32_t n);
+extern uint64_t sweet_log_position(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+
+static struct {
+	bool     armed;
+	uint32_t first, nblocks, ring_size;
+	uint64_t flushed, seq;
+	clock_sec_t boot_sec;
+	clock_usec_t boot_usec;
+	uint8_t  buf[SD_BLOCK], hook_buf[SD_BLOCK];
+} sl;
+
+struct sdlog_header {
+	char     magic[8];
+	uint32_t version, ring_size;
+	uint64_t total, seq, boot_sec;
+	uint32_t boot_usec, reason;
+};
+
+/*
+ * After a failed CMD24 the card may still be receiving (a partly filled
+ * buffer) or programming. Reset the host CMD/DAT lines, send CMD12 (valid in
+ * the card's rcv state; an illegal command, and so harmless, in tran), and
+ * wait for the card to release DAT0. The log is then stopped for this boot
+ * (sdlog_thread), so no further write is ever issued.
+ */
+static void
+sd_write_abort(void)
+{
+	uint32_t st;
+	sd_reset_lines();
+	uint64_t end = sd_deadline(100000);
+	while ((sd_rd(HC_PRESENT) & PS_CMD_INHIBIT) && mach_absolute_time() < end) {
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_ARG, 0);
+	sd_wr(HC_XFER_CMD, (12u << 8 | CMD_TYPE_ABORT | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48_BUSY) << 16);
+	if (sd_wait_int(INT_CMD_DONE, 100000, &st) == 0) {
+		(void)sd_wait_int(INT_XFER_DONE, 1000000, &st);
+	}
+	sd_reset_lines();
+	end = sd_deadline(1000000);
+	while (!(sd_rd(HC_PRESENT) & PS_DAT0) && mach_absolute_time() < end) {
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+}
+
+/*
+ * The only LBAs the kernel may ever write: blocks 1.. of the armed log
+ * partition, and, with sdrw=1, the selected sdroot0 partition (which then
+ * overlaps no other MBR entry, so never LBA 0, partition 1 or the log).
+ */
+static bool
+sd_lba_writable(uint32_t lba)
+{
+	if (sl.armed && lba > sl.first && lba - sl.first < sl.nblocks) {
+		return true;
+	}
+	return sdd.writable && lba >= sdd.first && lba - sdd.first < sdd.nblocks;
+}
+
+/* CMD24 for one 512-byte block, polled PIO; only LBAs allowed by sd_lba_writable(). */
+static int
+sd_write_block_hw(uint32_t lba, const uint8_t *buf, uint32_t *stp)
+{
+	uint32_t st = 0;
+	*stp = 0;
+	if (!sd_lba_writable(lba)) {
+		return EPERM;
+	}
+	if (!(sd_rd(HC_PRESENT) & PS_WRITABLE)) {
+		return EROFS;
+	}
+	if (sd_wait_present_clear(PS_CMD_INHIBIT | PS_DAT_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	if ((sd_rd(HC_INT_ENABLE) & (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_WR)) != (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_WR)) {
+		sd_wr(HC_INT_ENABLE, INT_ENABLE_UEFI);
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_BLKSZ_CNT, (1u << 16) | SD_BLOCK);
+	sd_wr(HC_ARG, lba);
+	/* Transfer mode 0: single block, host to card, no DMA. */
+	sd_wr(HC_XFER_CMD, (24u << 8 | CMD_DATA | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48) << 16);
+
+	int error = sd_wait_int(INT_CMD_DONE, 100000, &st);
+	if (!error && (sd_rd(HC_RESP0) & R1_ERRORS)) {
+		st = sd_rd(HC_RESP0);
+		error = ERANGE;
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_CMD_DONE);
+		error = sd_wait_int(INT_BUF_WR, 500000, &st);
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_BUF_WR);
+		for (uint32_t i = 0; i < SD_BLOCK; i += 4) {
+			sd_wr(HC_BUFFER, buf[i] | buf[i + 1] << 8 | buf[i + 2] << 16 | (uint32_t)buf[i + 3] << 24);
+		}
+		/* Transfer complete for a write is signalled after the card's busy ends. */
+		error = sd_wait_int(INT_XFER_DONE, 1000000, &st);
+	}
+	if (error) {
+		*stp = st;
+		sd_write_abort();
+		return error;
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	return 0;
+}
+
+static int
+sd_write_block(uint32_t lba, const uint8_t *buf, bool wait)
+{
+	uint32_t st;
+	if (!sd_claim(wait)) {
+		return EBUSY;
+	}
+	int error = sd_write_block_hw(lba, buf, &st);
+	sd_release();
+	if (error && wait) {
+		printf("LILAC SDLOG: CMD24 lba 0x%x failed %d, int 0x%08x\n", lba, error, st);
+	}
+	return error;
+}
+
+/* sdroot0 writes: n blocks, one CMD24 each, claiming the controller per block. */
+static int
+sd_write_blocks(uint32_t lba, uint32_t n, const uint8_t *buf)
+{
+	uint32_t st;
+	for (uint32_t i = 0; i < n; i++) {
+		(void)sd_claim(true);
+		int error = sd_write_block_hw(lba + i, buf + i * SD_BLOCK, &st);
+		sd_release();
+		if (error) {
+			printf("LILAC SD: CMD24 lba 0x%x failed %d, int 0x%08x\n", lba + i, error, st);
+			return error;
+		}
+	}
+	return 0;
+}
+
+/*
+ * ADMA design/source audit (paths relative to the named Linux trees):
+ * downstream 4.14 arch/arm64/boot/dts/qcom/msm8998.dtsi:1617-1658 and
+ * msm8998-yoshino-common.dtsi:3223-3227; mainline 6.18.58 msm8998.dtsi:
+ * 2268-2283 and msm8998-sony-xperia-yoshino.dtsi:661-671: no iommus and
+ * no dma-coherent for SDCC2. This is a physical-address DMA master, not an
+ * SMMU stream requiring an unproven UEFI bypass assumption.
+ *
+ * downstream drivers/mmc/host/sdhci-msm.c:4993-5014: preserve HC mode,
+ * enable length-error reporting only (VENDOR_SPEC bit7); do NOT replay POR,
+ * clock, power, DLL or capability overrides. Offsets: :258-264, HC_MODE :67.
+ * :5061 requires END on TRAN, :4613-4618 reset workaround is 8916/8992 only.
+ * mainline sdhci-msm.c:2493-2494 broken 64-bit DMA is 8916 only, not 8998;
+ * :2140-2181 distinguishes 12-byte legacy ADMA from 16-byte CQE descriptors.
+ * We do not enable CQE or SDHCI v4 mode. :2474 requests auto-CMD12 reads.
+ *
+ * One wired, contiguous allocation: a whole VM page for descriptors, then
+ * 64 KiB of data, serialized by sd_claim. Copying normal RAM once is simpler
+ * than DMA into arbitrary buf pages (unaligned cache lines, 16K VM/4K MMU
+ * granules). No CPU touches these cache lines while hardware owns them.
+ * flush_dcache64 is clean+invalidate to PoC plus dsb sy (arm64/caches_asm.s:
+ * 363-448), before both directions and after reads. This also cleans table
+ * fetches. No coherency assumption, no virtual addresses given to hardware.
+ *
+ * Completion: at most 20 us initial spin, then 150 us delay, which blocks
+ * with interrupts/preemption enabled (kern/clock.c:1584-1600); panic spins.
+ * Expected saving is removal of 16384 MMIO loads/stores per 64 KiB plus
+ * per-block polling; actual CPU-time/throughput savings require an A/B boot.
+ */
+static void
+sd_dma_init(void)
+{
+	uint32_t on = 1, caps, mode;
+	uint16_t host_version, ctrl2;
+	vm_size_t size = PAGE_SIZE + SD_DMA_BYTES;
+	ppnum_t pn, max_pnum;
+	if (sda.initialized) {
+		return;
+	}
+	sda.initialized = true;
+	PE_parse_boot_argn("sddma", &on, sizeof(on));
+	if (!on) {
+		printf("LILAC SD: ADMA disabled (sddma=0)\n");
+		return;
+	}
+	host_version = *(volatile uint16_t *)(sd_regs + SD_HC + HC_VERSION);
+	caps = sd_rd(HC_CAPS);
+	mode = *(volatile uint32_t *)(sd_regs + 0x78);
+	/* Refuse unsupported modes rather than change firmware's bus setup.
+	 * Mainline sdhci.h:246,384: v4 mode needs a different descriptor format.
+	 */
+	ctrl2 = *(volatile uint16_t *)(sd_regs + SD_HC + 0x3e);
+	if (!(caps & CAP_ADMA2) || (host_version & 0xff) < 2 || !(mode & 1) || (ctrl2 & (1u << 12))) {
+		printf("LILAC SD: ADMA unavailable cap 0x%x ver 0x%x hc 0x%x\n", caps, host_version, mode);
+		return;
+	}
+	sda.wide = (caps & CAP_64BIT) != 0;
+	/* max_pnum is in VM pages, not 4K hardware granules. */
+	max_pnum = sda.wide ? 0 : (ppnum_t)(UINT32_MAX >> PAGE_SHIFT);
+	if (kmem_alloc_contig(kernel_map, &sda.mem, size, PAGE_MASK, max_pnum, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("LILAC SD: ADMA allocation failed, PIO only\n");
+		return;
+	}
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)sda.mem);
+	sda.pa = ptoa_64(pn);
+	if (!pn || (sda.pa & PAGE_MASK) ||
+	    (!sda.wide && sda.pa + size - 1 > UINT32_MAX)) {
+		printf("LILAC SD: ADMA physical address rejected, PIO only\n");
+		return;
+	}
+	/* Assert the allocator's contiguity at VM-page increments, not MMU PFNs. */
+	for (vm_size_t off = 0; off < size; off += PAGE_SIZE) {
+		if (ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)(sda.mem + off))) != sda.pa + off) {
+			printf("LILAC SD: ADMA noncontiguous allocation, PIO only\n");
+			return;
+		}
+	}
+	sda.enabled = sda.writes = sda.cmd25 = true;
+	printf("LILAC SD: ADMA%u ready cap 0x%x ver 0x%x pa 0x%llx, 64 KiB bounce\n",
+	    sda.wide ? 64u : 32u, caps, host_version, sda.pa);
+}
+
+static int
+sd_dma_wait(uint32_t want, uint32_t usec, uint32_t *stp)
+{
+	uint64_t end = sd_deadline(usec), spin_end = sd_deadline(SD_SPIN_US);
+	for (;;) {
+		uint32_t st = sd_rd(HC_INT_STATUS);
+		*stp = st;
+		if (st & (INT_ERROR | INT_ERR_MASK)) {
+			return EIO;
+		}
+		if (st & want) {
+			return 0;
+		}
+		if (mach_absolute_time() > end) {
+			return ETIMEDOUT;
+		}
+		if (mach_absolute_time() > spin_end && !panic_active()) {
+			uint64_t t0 = mach_absolute_time();
+			delay(SD_DMA_NAP_US);
+			os_atomic_inc(&sds.naps, relaxed);
+			os_atomic_add(&sds.nap_abs, mach_absolute_time() - t0, relaxed);
+		}
+	}
+}
+
+/* sd_claim held. Range and write guards precede ALL commands, including STOP.
+ * Read range is either sdd or the MBR-validated p2 extent at stage 69.
+ * Only strategy/write-check callers reach DMA; the log never does.
+ */
+static int
+sd_dma_hw(bool rd, uint32_t first, uint32_t count, uint32_t lba,
+    uint32_t n, uint8_t *buf, uint32_t *stp)
+{
+	*stp = 0;
+	if (!sda.enabled || (!rd && !sda.writes) || sd_dma_fatal) {
+		return ENXIO;
+	}
+	if (n > SD_MULTI_MAX || !sd_adma_range(first, count, lba, n)) {
+		return EINVAL;
+	}
+	if (!rd) {
+		if (!sdd.writable || !sd_adma_range(sdd.first, sdd.nblocks, lba, n)) {
+			return EPERM;
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			if (lba + i == 0 || !sd_lba_writable(lba + i)) {
+				return EPERM;
+			}
+		}
+		if (!(sd_rd(HC_PRESENT) & PS_WRITABLE)) {
+			return EROFS;
+		}
+	}
+	if (sd_wait_present_clear(PS_CMD_INHIBIT | PS_DAT_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	uint32_t bytes = n * SD_BLOCK;
+	uint8_t *data = (uint8_t *)(sda.mem + PAGE_SIZE);
+	size_t table_bytes = sd_adma_build((uint8_t *)sda.mem, PAGE_SIZE, sda.pa,
+	    sda.pa + PAGE_SIZE, bytes, PAGE_SIZE, sda.wide);
+	if (!table_bytes) {
+		return EINVAL;
+	}
+	if (!rd) {
+		memcpy(data, buf, bytes);
+	}
+	flush_dcache64(sda.pa + PAGE_SIZE, bytes, TRUE);
+	flush_dcache64(sda.pa, (unsigned int)table_bytes, TRUE);
+
+	volatile uint8_t *ctrl = (volatile uint8_t *)(sd_regs + SD_HC + HC_CONTROL);
+	uint8_t old_ctrl = *ctrl;
+	uint32_t old_enable = sd_rd(HC_INT_ENABLE);
+	uint32_t old_vendor = sd_rd(0x10c);
+	*ctrl = (uint8_t)((old_ctrl & ~CTRL_DMA_MASK) | (sda.wide ? CTRL_ADMA64 : CTRL_ADMA32));
+	sd_wr(0x10c, old_vendor | (1u << 7)); /* length-mismatch ADMA error */
+	/* Status latching only; never enable IRQ signals at 0x38. */
+	sd_wr(HC_INT_ENABLE, old_enable | INT_CMD_DONE | INT_XFER_DONE | INT_ERROR | 0x03ff0000u);
+	sd_wr(HC_INT_STATUS, 0xffffffffu);
+	sd_wr(HC_ADMA_LO, (uint32_t)sda.pa);
+	if (sda.wide) {
+		sd_wr(HC_ADMA_HI, (uint32_t)(sda.pa >> 32));
+	}
+	/* Linux 4.14 sdhci.c:926-934: ADMA uses SDMA boundary bits = 0. */
+	sd_wr(HC_BLKSZ_CNT, n << 16 | SD_BLOCK);
+	sd_wr(HC_ARG, lba);
+	uint32_t cmd = rd ? (n == 1 ? 17u : 18u) : (n == 1 ? 24u : 25u);
+	uint32_t xfer = XFER_DMA | XFER_BLKCNT_EN | (rd ? XFER_READ : 0u);
+	if (n > 1) {
+		xfer |= XFER_MULTI | XFER_AUTO12;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	sd_wr(HC_XFER_CMD, ((cmd << 8 | CMD_DATA | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48) << 16) | xfer);
+	int error = sd_dma_wait(INT_CMD_DONE, 100000, stp);
+	if (!error) {
+		uint32_t r1 = sd_rd(HC_RESP0);
+		if (r1 & R1_ERRORS) {
+			*stp = r1;
+			error = (!rd && n > 1 && (r1 & R1_ERRORS) == R1_ILLEGAL_CMD) ? ENOTSUP : EIO;
+		}
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_CMD_DONE);
+		error = sd_dma_wait(INT_XFER_DONE, 1000000, stp);
+	}
+	if (!error && !rd) {
+		/* Also require DAT0 high and the host out of DATA inhibit. */
+		uint64_t end = sd_deadline(1000000);
+		while (!(sd_rd(HC_PRESENT) & PS_DAT0) || (sd_rd(HC_PRESENT) & PS_DAT_INHIBIT)) {
+			if (mach_absolute_time() > end) {
+				error = ETIMEDOUT;
+				break;
+			}
+			if (!panic_active()) {
+				delay(SD_DMA_NAP_US);
+			}
+		}
+	}
+	if (error) {
+		uint32_t adma = sd_rd(HC_ADMA_ERROR), status = sd_rd(HC_INT_STATUS);
+		/* Quiesce DMA before any PIO retry or touching the bounce buffer. */
+		bool reset = sd_reset_lines();
+		if (reset) {
+			uint32_t stop_st = 0;
+			/* An interrupted transfer may leave the card in data/rcv state. */
+			int stop = sd_stop_transmission(&stop_st);
+			reset = sd_reset_lines();
+			/* Never retry a write while the card is still programming. */
+			reset = reset && stop == 0 && (sd_rd(HC_PRESENT) & PS_DAT0) != 0;
+		}
+		if (!reset) {
+			sd_dma_fatal = true; /* Permanent allocation quarantined; no new I/O. */
+			sda.enabled = false;
+		}
+		printf("LILAC SD: ADMA err %d CMD%u lba 0x%x n %u int 0x%x resp 0x%x adma 0x%x reset %s\n",
+		    error, cmd, lba, n, status, *stp, adma, reset ? "ok" : "FAILED");
+	}
+	/* PIO selection restored before releasing sd_claim (including panic log). */
+	*ctrl = (uint8_t)(old_ctrl & ~CTRL_DMA_MASK);
+	sd_wr(0x10c, old_vendor);
+	sd_wr(HC_INT_ENABLE, old_enable);
+	sd_wr(HC_INT_STATUS, 0xffffffffu);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (!error && rd) {
+		flush_dcache64(sda.pa + PAGE_SIZE, bytes, TRUE);
+		memcpy(buf, data, bytes);
+	}
+	return error;
+}
+
+/* Called with lilac_sd_lock held, except single-threaded boot write check. */
+static int
+sd_strategy_transfer(bool rd, uint32_t lba, uint32_t n, uint8_t *buf,
+    bool *used_dma, bool *used_pio)
+{
+	if (!sd_adma_range(sdd.first, sdd.nblocks, lba, n)) {
+		return EINVAL;
+	}
+	if (!rd && !sdd.writable) {
+		return EROFS;
+	}
+	int error = 0;
+	bool dma = sda.enabled && (rd || sda.writes) && !panic_active();
+	if (dma) {
+		uint32_t st = 0;
+		*used_dma = true;
+		(void)sd_claim(true);
+		if (rd || n == 1 || sda.cmd25) {
+			error = sd_dma_hw(rd, sdd.first, sdd.nblocks, lba, n, buf, &st);
+			if (error == ENOTSUP && !rd && n > 1) {
+				sda.cmd25 = false;
+				printf("LILAC SD: CMD25 rejected, future DMA writes use CMD24 batches\n");
+			}
+		} else {
+			for (uint32_t i = 0; i < n && !error; i++) {
+				error = sd_dma_hw(false, sdd.first, sdd.nblocks, lba + i, 1, buf + i * SD_BLOCK, &st);
+			}
+		}
+		if (!error && !rd && !sda.verified) {
+			/* PIO, still owning controller: no log write can interleave. */
+			error = n == 1 ? sd_read_block_hw(lba, sdd.bounce, &st) :
+			    sd_read_multi_hw(lba, n, sdd.bounce, &st);
+			if (!error && memcmp(buf, sdd.bounce, n * SD_BLOCK)) {
+				error = EIO;
+			}
+			sda.verified = !error;
+			if (error) {
+				sda.writes = false;
+			}
+			printf("LILAC SD: DMA write verify: %s%s\n", error ? "MISMATCH/error" : "match",
+			    error ? ", DMA writes disabled" : "");
+		}
+		sd_release();
+		if (!error) {
+			return 0;
+		}
+		sds.err++;
+		if (sd_dma_fatal) {
+			return EIO;
+		}
+	}
+	/* Exactly one PIO retry; its own error propagates. No recursive DMA. */
+	*used_pio = true;
+	return rd ? sd_read_blocks(lba, n, buf) : sd_write_blocks(lba, n, buf);
+}
+
+/*
+ * Stage 84 (sdrw=1, lilac_stop=84): write path self-check on the last block of
+ * the selected partition (outside HFS+ structures: the alternate volume header
+ * is the second-to-last 512-byte block). bit0 the guard (sd_lba_writable)
+ * allows the partition's first and last block and refuses LBA 0 and the
+ * blocks just before and after it; bit1 rewriting the block's own data succeeds and reads back equal; bit2 a
+ * complemented pattern written there reads back; bit3 the original data is
+ * restored and reads back.
+ */
+static void
+lilac_sd_write_check(void)
+{
+	static uint8_t orig[SD_BLOCK], pat[SD_BLOCK], back[SD_BLOCK];
+	uint32_t lba = sdd.first + sdd.nblocks - 1;
+	unsigned int nib = 0;
+
+	/*
+	 * The guard alone, without issuing any command. A neighbour block may
+	 * still be writable through the log path when the armed log partition is
+	 * adjacent (on the G20 card p4 ends where p3 starts), so test it against
+	 * that range rather than expect a refusal.
+	 */
+	uint32_t before = sdd.first - 1, after = sdd.first + sdd.nblocks;
+	bool before_log = sl.armed && before > sl.first && before - sl.first < sl.nblocks;
+	bool after_log = sl.armed && after > sl.first && after - sl.first < sl.nblocks;
+	if (sdd.writable && sd_lba_writable(sdd.first) && sd_lba_writable(lba) && !sd_lba_writable(0) &&
+	    sd_lba_writable(before) == before_log && sd_lba_writable(after) == after_log) {
+		nib |= 1;
+	}
+	if (sdd.writable && sd_read_blocks(lba, 1, orig) == 0) {
+		bool used_dma = false, used_pio = false;
+		if (sd_strategy_transfer(false, lba, 1, orig, &used_dma, &used_pio) == 0 && sd_read_blocks(lba, 1, back) == 0 &&
+		    memcmp(orig, back, SD_BLOCK) == 0) {
+			nib |= 2;
+		}
+		for (uint32_t i = 0; i < SD_BLOCK; i++) {
+			pat[i] = (uint8_t)~orig[i];
+		}
+		if ((nib & 2) && sd_write_blocks(lba, 1, pat) == 0 && sd_read_blocks(lba, 1, back) == 0 &&
+		    memcmp(pat, back, SD_BLOCK) == 0) {
+			nib |= 4;
+		}
+		if (sd_write_blocks(lba, 1, orig) == 0 && sd_read_blocks(lba, 1, back) == 0 &&
+		    memcmp(orig, back, SD_BLOCK) == 0) {
+			nib |= 8;
+		}
+	}
+	printf("LILAC SD: write check lba 0x%x nibble 0x%x\n", lba, nib);
+	lilac_report(84, nib);
+}
+
+/* Copy console bytes not yet on the card, then the header. */
+static int
+sdlog_flush(uint8_t *buf, uint64_t deadline, uint32_t reason)
+{
+	bool wait = (reason == 0);
+	uint64_t total = sweet_log_position();
+	uint64_t pos = (total - sl.flushed > sl.ring_size) ? total - sl.ring_size : sl.flushed;
+	int error = 0;
+
+	while (pos < total) {
+		if (deadline && mach_absolute_time() > deadline) {
+			break;
+		}
+		uint32_t off = (uint32_t)(pos % sl.ring_size);
+		off -= off % SD_BLOCK;
+		sweet_log_ring_read(off, (char *)buf, SD_BLOCK);
+		error = sd_write_block(sl.first + SDLOG_RING_LBA + off / SD_BLOCK, buf, wait);
+		if (error) {
+			return error;
+		}
+		pos = pos - pos % SD_BLOCK + SD_BLOCK;
+	}
+	uint64_t done = MIN(pos, total);
+	struct sdlog_header h = {
+		.magic = { 'L', 'I', 'L', 'A', 'C', 'L', 'O', 'G' },
+		.version = 1, .ring_size = sl.ring_size, .total = done, .seq = sl.seq + 1,
+		.boot_sec = (uint64_t)sl.boot_sec, .boot_usec = (uint32_t)sl.boot_usec, .reason = reason,
+	};
+	bzero(buf, SD_BLOCK);
+	memcpy(buf, &h, sizeof(h));
+	error = sd_write_block(sl.first + 1, buf, wait);
+	if (!error) {
+		sl.seq++;
+		sl.flushed = done;
+	}
+	return error;
+}
+
+static void
+sdlog_reset_hook(uint32_t budget_secs)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime((uint64_t)budget_secs * NSEC_PER_SEC, &deadline);
+	(void)sdlog_flush(sl.hook_buf, mach_absolute_time() + deadline, 1);
+}
+
+static int sdlog_chan;
+
+static void
+sdlog_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		int error = sdlog_flush(sl.buf, 0, 0);
+		if (error) {
+			lilac_reset_hook = 0;
+			sl.armed = false;
+			printf("LILAC SDLOG: write failed (%d), log stopped\n", error);
+			return;
+		}
+		(void)tsleep(&sdlog_chan, PZERO, "sdlog", hz * SDLOG_SECS);
+	}
+}
+
+static inline uint32_t
+le32(const uint8_t *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+void lilac_sd_log_init(void);
+
+void
+lilac_sd_log_init(void)
+{
+	uint32_t on = 1;
+	int found = -1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sdlog", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	sd_map();
+	if (sd_read_block(0, sl.buf) || sl.buf[510] != 0x55 || sl.buf[511] != 0xAA) {
+		return;
+	}
+	for (int i = 0; i < 4; i++) {
+		if (sl.buf[446 + 16 * i + 4] == SDLOG_TYPE) {
+			if (found >= 0) {
+				return;                 /* more than one log partition: refuse */
+			}
+			found = i;
+		}
+	}
+	if (found != 3) { /* Only p4 may be armed for SD logging. */
+		return;
+	}
+	uint32_t first = le32(sl.buf + 446 + 16 * found + 8), n = le32(sl.buf + 446 + 16 * found + 12);
+	uint32_t ring = sweet_log_ring_size();
+	if (first < 2048 || ring % SD_BLOCK || n < SDLOG_RING_LBA + ring / SD_BLOCK ||
+	    (uint64_t)first + n > UINT32_MAX) {
+		return;
+	}
+	for (int i = 0; i < 4; i++) {
+		const uint8_t *e = sl.buf + 446 + 16 * i;
+		uint32_t f = le32(e + 8), m = le32(e + 12);
+		if (i != found && e[4] != 0 && m != 0 && (uint64_t)f < (uint64_t)first + n && (uint64_t)first < (uint64_t)f + m) {
+			return;                         /* overlaps another partition */
+		}
+	}
+	if (sd_read_block(first, sl.buf) || memcmp(sl.buf, "LILAC-SDLOG-ARM1", 16) != 0 ||
+	    le32(sl.buf + 16) != first || le32(sl.buf + 20) != n) {
+		printf("LILAC SDLOG: partition %d at 0x%x is not armed\n", found + 1, first);
+		return;
+	}
+	sl.first = first;
+	sl.nblocks = n;
+	sl.ring_size = ring;
+	clock_get_calendar_microtime(&sl.boot_sec, &sl.boot_usec);
+	sl.armed = true;
+	printf("LILAC SDLOG: console log to SD partition %d (LBA 0x%x, %u blocks), ring %u KiB\n",
+	    found + 1, first, n, ring >> 10);
+	printf("LILAC VM: page size %u (hardware granule 4096)\n", (unsigned)PAGE_SIZE);
+	lilac_reset_hook = sdlog_reset_hook;
+	if (kernel_thread_start(sdlog_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_LILAC */
diff --git a/bsd/dev/lilac_sd_adma.h b/bsd/dev/lilac_sd_adma.h
new file mode 100644
index 0000000..d9a6dae
--- /dev/null
+++ b/bsd/dev/lilac_sd_adma.h
@@ -0,0 +1,61 @@
+/* Pure ADMA2 encoder, shared with tools/lilac_sd_adma_test.c.
+ * Caller supplies uint*_t, bool and size_t. All descriptor fields are LE.
+ * Linux 4.14 drivers/mmc/host/sdhci.h:299-325: 8/12-byte strides;
+ * sdhci.c:665-767 and sdhci-msm.c:5061: END on final TRAN, not a NOP.
+ */
+#ifndef LILAC_SD_ADMA_H
+#define LILAC_SD_ADMA_H
+
+static bool
+sd_adma_range(uint32_t first, uint32_t count, uint32_t lba, uint32_t n)
+{
+	return first != 0 && count != 0 && n != 0 &&
+	       (uint64_t)first + count <= UINT32_MAX &&
+	       lba >= first && lba - first < count && n <= count - (lba - first);
+}
+
+/* Contiguous data, split at VM page boundaries and at 64 KiB. Zero means
+ * invalid input/capacity; callers must NEVER publish a failed table.
+ * A 64-bit table base must be 8-aligned, but its standard stride is 12,
+ * NOT 16 (CQE/v4 mode is deliberately not enabled by this driver).
+ */
+static size_t
+sd_adma_build(uint8_t *table, size_t capacity, uint64_t table_pa,
+    uint64_t data_pa, uint32_t bytes, uint32_t vm_page_bytes, bool wide)
+{
+	uint32_t align = wide ? 8u : 4u;
+	size_t stride = wide ? 12u : 8u, used = 0;
+	if (!bytes || vm_page_bytes < align || (vm_page_bytes & (vm_page_bytes - 1)) ||
+	    (table_pa & (align - 1)) || (data_pa & (align - 1)) ||
+	    data_pa > UINT64_MAX - (bytes - 1u) ||
+	    (!wide && (data_pa + bytes - 1u > UINT32_MAX || table_pa > UINT32_MAX))) {
+		return 0;
+	}
+	while (bytes) {
+		uint8_t *d = table + used;
+		uint32_t len = vm_page_bytes - (uint32_t)(data_pa & (vm_page_bytes - 1));
+		if (len > 65536u) {
+			len = 65536u;
+		}
+		if (len > bytes) {
+			len = bytes;
+		}
+		if (used > capacity || stride > capacity - used ||
+		    table_pa > UINT64_MAX - used - (stride - 1) ||
+		    (!wide && table_pa + used + stride - 1 > UINT32_MAX)) {
+			return 0;
+		}
+		d[0] = (uint8_t)(0x21u | (len == bytes ? 2u : 0u)); /* VALID | TRAN | END */
+		d[1] = 0;
+		d[2] = (uint8_t)len; /* 0 encodes 65536 */
+		d[3] = (uint8_t)(len >> 8);
+		for (uint32_t i = 0; i < (wide ? 8u : 4u); i++) {
+			d[4 + i] = (uint8_t)(data_pa >> (8 * i));
+		}
+		used += stride;
+		bytes -= len;
+		data_pa += len;
+	}
+	return used;
+}
+#endif
diff --git a/bsd/dev/lilac_ufs.c b/bsd/dev/lilac_ufs.c
new file mode 100644
index 0000000..b3fb907
--- /dev/null
+++ b/bsd/dev/lilac_ufs.c
@@ -0,0 +1,410 @@
+/*
+ * LILAC (Xperia XZ1 Compact, MSM8998): read-only UFS probe, stages 80-83.
+ *
+ * Reuses the UFS host controller exactly as the bootloader/UEFI left it and
+ * repeats, from xnu, the command set the UEFI app UfsReadRo already ran on this
+ * phone (lilac-uefi log/UFSREAD-run-20261021.md). Nothing here runs unless
+ * lilac_stop selects one of the stages below.
+ *
+ * Safety allow-list (enforced in code, see ufs_wr() and ufs_cmd()):
+ *  - UFSHCI register writes only to IS (write-1-to-clear), UTRLBA, UTRLBAU,
+ *    UTRLDBR (slot 0) and UTRLRSR. No HCE, UIC command, UTRLCLR, task
+ *    management, interrupt enable, auto-hibernate or vendor registers.
+ *  - SCSI CDBs only INQUIRY (0x12), READ CAPACITY(10) (0x25), READ(10) (0x28)
+ *    of one block, built here; LUN 0 (user data, sda) only. No QUERY UPIU, no
+ *    WRITE/UNMAP/SYNC/FORMAT/START STOP, no boot or well-known LUs.
+ *  - GCC (clock controller) registers are only read.
+ *
+ * Stage nibbles (lilac_report):
+ *  80 gate, register reads only:
+ *     bit0 GDSC_UFS PWR_ON and UFS AHB clock running
+ *     bit1 HCE enabled
+ *     bit2 HCS device present, UTRL ready, UIC command ready
+ *     bit3 no request outstanding (UTRLDBR 0) and interrupts disabled (IE 0)
+ *  81 (gate must be 0xF) INQUIRY + READ CAPACITY(10):
+ *     bit0 INQUIRY completed, bit1 'TOSHIBA ' 'THGAF4G8N2LBAIRB',
+ *     bit2 READ CAPACITY completed, bit3 last LBA 7810047, block 4096
+ *  82 READ(10) LBA 1, GPT header checks:
+ *     bit0 read completed, bit1 'EFI PART', bit2 header CRC32 valid,
+ *     bit3 MyLBA 1, AlternateLBA 7810047, PartitionEntryLBA 2
+ *  83 control: the stage-82 checks on LBA 0 (protective MBR); expected 0x1
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <libkern/libkern.h>
+#include <libkern/crc.h>
+#include <arm64/sweet_early.h>
+
+#if defined(ARM64_BOARD_CONFIG_LILAC)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);   /* as bsd/dev/sweet_ufs.c */
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+#define UFS_PA          0x01DA4000ULL
+#define GCC_UFS_PA      0x00175000ULL
+#define GDSC_UFS        0x004           /* bit31 PWR_ON */
+#define GCC_UFS_AHB     0x00C           /* bit31 CLK_OFF */
+
+#define REG_CAP         0x00
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLRSR     0x60
+#define CAP_64AS        (1u << 24)
+#define HCS_READY       0x0Bu           /* DP | UTRLRDY | UCRDY */
+
+#define UFS_BLOCK       4096u
+#define EXP_LAST_LBA    7810047u
+#define DMA_UTRL        0x0000
+#define DMA_UCD         0x1000
+#define DMA_DATA        0x2000
+#define DMA_SIZE        (DMA_DATA + UFS_BLOCK)
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;                  /* [15:0] response UPIU length, [31:16] offset, DWORDs */
+	uint32_t prdt;                  /* [15:0] PRDT entries, [31:16] offset, DWORDs (as ufshcd) */
+};
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	struct {
+		uint32_t addr_lo, addr_hi, rsvd, dbc;
+	} prdt[1];
+};
+
+static struct {
+	vm_offset_t regs, gcc, dma;
+	uint64_t dma_pa;
+	uint8_t tag;
+	bool owned;
+} lu;
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(lu.regs + off);
+}
+
+/* The only UFSHCI register store in this file; anything off the allow-list is refused. */
+static void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	switch (off) {
+	case REG_IS:
+	case REG_UTRLBA:
+	case REG_UTRLBAU:
+	case REG_UTRLRSR:
+		break;
+	case REG_UTRLDBR:
+		if (v != 1) {
+			return;
+		}
+		break;
+	default:
+		return;
+	}
+	*(volatile uint32_t *)(lu.regs + off) = v;
+}
+
+static unsigned int
+ufs_gate(void)
+{
+	unsigned int nib = 0;
+	uint32_t gdsc = *(volatile uint32_t *)(lu.gcc + GDSC_UFS);
+	uint32_t ahb = *(volatile uint32_t *)(lu.gcc + GCC_UFS_AHB);
+
+	if ((gdsc & (1u << 31)) && !(ahb & (1u << 31))) {
+		nib |= 1;
+	} else {
+		/* Without power and clock the controller registers must not be accessed. */
+		printf("LILAC UFS: gate gdsc 0x%x ahb 0x%x\n", gdsc, ahb);
+		return 0;
+	}
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	uint32_t dbr = ufs_rd(REG_UTRLDBR), ie = ufs_rd(REG_IE);
+	if (hce & 1) {
+		nib |= 2;
+	}
+	if ((hcs & HCS_READY) == HCS_READY) {
+		nib |= 4;
+	}
+	if (dbr == 0 && ie == 0) {
+		nib |= 8;
+	}
+	printf("LILAC UFS: gdsc 0x%x ahb 0x%x cap 0x%x hce 0x%x hcs 0x%x dbr 0x%x ie 0x%x is 0x%x\n",
+	    gdsc, ahb, ufs_rd(REG_CAP), hce, hcs, dbr, ie, ufs_rd(REG_IS));
+	return nib;
+}
+
+static void
+dma_flush(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(lu.dma_pa + off), len, TRUE);
+}
+
+/* Install a private one-slot request list (same register sequence as UfsReadRo). */
+static int
+ufs_take_list(void)
+{
+	if (kmem_alloc_contig(kernel_map, &lu.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)lu.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	lu.dma_pa = ptoa_64(pn);
+	if (((lu.dma_pa + DMA_SIZE - 1) >> 32) && !(ufs_rd(REG_CAP) & CAP_64AS)) {
+		return ENXIO;
+	}
+	uint64_t list = lu.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLRSR, 0);
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		return EIO;
+	}
+	lu.owned = true;
+	return 0;
+}
+
+enum ufs_op { OP_INQUIRY, OP_READ_CAPACITY, OP_READ_BLOCK };
+
+/*
+ * One allow-listed SCSI command on LUN 0, slot 0, data into lu.dma + DMA_DATA.
+ * Returns 0, or an errno; *status gets the SCSI status, *sense_key the sense key.
+ */
+static int
+ufs_cmd_once(enum ufs_op op, uint32_t lba, uint8_t *status, uint8_t *sense_key)
+{
+	struct utrd *utrd = (struct utrd *)(lu.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(lu.dma + DMA_UCD);
+	uint64_t ucd_pa = lu.dma_pa + DMA_UCD, data_pa = lu.dma_pa + DMA_DATA;
+	uint8_t cdb[16] = { 0 };
+	uint32_t len;
+
+	switch (op) {
+	case OP_INQUIRY:
+		cdb[0] = 0x12;
+		cdb[4] = 36;
+		len = 36;
+		break;
+	case OP_READ_CAPACITY:
+		cdb[0] = 0x25;
+		len = 8;
+		break;
+	case OP_READ_BLOCK:
+		if (lba > EXP_LAST_LBA) {
+			return EINVAL;
+		}
+		cdb[0] = 0x28;
+		cdb[2] = (uint8_t)(lba >> 24);
+		cdb[3] = (uint8_t)(lba >> 16);
+		cdb[4] = (uint8_t)(lba >> 8);
+		cdb[5] = (uint8_t)lba;
+		cdb[8] = 1;
+		len = UFS_BLOCK;
+		break;
+	default:
+		return EINVAL;
+	}
+	if (!lu.owned || (ufs_rd(REG_UTRLDBR) & 1)) {
+		return EBUSY;
+	}
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	bzero((void *)(lu.dma + DMA_DATA), UFS_BLOCK);
+
+	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
+	ucd->cmd[1] = 0x40;                     /* R: data in, simple task attribute */
+	ucd->cmd[2] = 0;                        /* LUN 0 */
+	ucd->cmd[3] = ++lu.tag;
+	ucd->cmd[4] = 0x00;                     /* command set: SCSI */
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, sizeof(cdb));
+	ucd->prdt[0].addr_lo = (uint32_t)data_pa;
+	ucd->prdt[0].addr_hi = (uint32_t)(data_pa >> 32);
+	ucd->prdt[0].dbc = len - 1;
+
+	/* CT 1 (UFS storage), DD 2 (device to memory), I 1; IE stays 0, so polled. */
+	utrd->dw0 = (1u << 28) | (2u << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until the host updates it */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	utrd->prdt = (1024u / 4) << 16 | 1u;
+
+	dma_flush(DMA_UTRL, sizeof(*utrd));
+	dma_flush(DMA_UCD, sizeof(*ucd));
+	dma_flush(DMA_DATA, UFS_BLOCK);
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			/* Leave the request alone (no UTRLCLR); the stage reset follows. */
+			lu.owned = false;
+			printf("LILAC UFS: command 0x%02x timed out\n", cdb[0]);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+
+	dma_flush(DMA_UTRL, sizeof(*utrd));
+	dma_flush(DMA_UCD, sizeof(*ucd));
+	dma_flush(DMA_DATA, UFS_BLOCK);
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	*status = ucd->resp[7];
+	*sense_key = ucd->resp[34 + 2] & 0x0f;  /* fixed-format sense data after its length */
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6]) {
+		printf("LILAC UFS: command 0x%02x: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		return EIO;
+	}
+	return 0;
+}
+
+/* As UfsReadRo: re-issue the same read-class command once on UNIT ATTENTION. */
+static int
+ufs_cmd(enum ufs_op op, uint32_t lba)
+{
+	uint8_t status = 0, key = 0;
+	int error = ufs_cmd_once(op, lba, &status, &key);
+	if (!error && status == 0x02 && key == 0x6) {
+		error = ufs_cmd_once(op, lba, &status, &key);
+	}
+	if (!error && status != 0) {
+		printf("LILAC UFS: SCSI status 0x%x sense key 0x%x\n", status, key);
+		error = EIO;
+	}
+	return error;
+}
+
+static inline uint32_t
+be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static unsigned int
+ufs_gpt_header_checks(uint32_t lba)
+{
+	const uint8_t *b = (const uint8_t *)(lu.dma + DMA_DATA);
+	unsigned int nib = 0;
+
+	if (ufs_cmd(OP_READ_BLOCK, lba)) {
+		return 0;
+	}
+	nib |= 1;
+	if (memcmp(b, "EFI PART", 8) == 0) {
+		nib |= 2;
+		uint32_t hsize, crc;
+		memcpy(&hsize, b + 12, 4);
+		memcpy(&crc, b + 16, 4);
+		if (hsize >= 92 && hsize <= 512) {
+			uint8_t h[512];
+			memcpy(h, b, hsize);
+			bzero(h + 16, 4);
+			if (crc32(0, h, hsize) == crc) {
+				nib |= 4;
+			}
+		}
+		uint64_t my, alt, ent;
+		memcpy(&my, b + 24, 8);
+		memcpy(&alt, b + 32, 8);
+		memcpy(&ent, b + 72, 8);
+		if (my == 1 && alt == EXP_LAST_LBA && ent == 2) {
+			nib |= 8;
+		}
+	}
+	printf("LILAC UFS: LBA %u: first bytes %02x%02x%02x%02x, 510: %02x%02x, checks 0x%x\n",
+	    lba, b[0], b[1], b[2], b[3], b[510], b[511], nib);
+	return nib;
+}
+
+void lilac_ufs_probe(void);
+
+void
+lilac_ufs_probe(void)
+{
+	unsigned int stage = 0, nib = 0;
+
+	for (unsigned int s = 80; s <= 83; s++) {
+		if (lilac_stop_is(s)) {
+			stage = s;
+		}
+	}
+	if (!stage) {
+		return;                         /* no UFS access at all */
+	}
+	lu.gcc = ml_io_map(GCC_UFS_PA, PAGE_SIZE);
+	lu.regs = ml_io_map(UFS_PA, PAGE_SIZE);
+	if (!lu.gcc || !lu.regs) {
+		lilac_report(stage, 0);
+		return;
+	}
+	nib = ufs_gate();
+	if (stage == 80) {
+		lilac_report(80, nib);
+		return;
+	}
+	if (nib != 0xF || ufs_take_list()) {
+		lilac_report(stage, 0);
+		return;
+	}
+	nib = 0;
+	if (stage == 81) {
+		const uint8_t *b = (const uint8_t *)(lu.dma + DMA_DATA);
+		if (!ufs_cmd(OP_INQUIRY, 0)) {
+			nib |= 1;
+			if (memcmp(b + 8, "TOSHIBA ", 8) == 0 && memcmp(b + 16, "THGAF4G8N2LBAIRB", 16) == 0) {
+				nib |= 2;
+			}
+		}
+		if (!ufs_cmd(OP_READ_CAPACITY, 0)) {
+			nib |= 4;
+			if (be32(b) == EXP_LAST_LBA && be32(b + 4) == UFS_BLOCK) {
+				nib |= 8;
+			}
+			printf("LILAC UFS: capacity last LBA %u, block %u\n", be32(b), be32(b + 4));
+		}
+	} else {
+		nib = ufs_gpt_header_checks(stage == 82 ? 1 : 0);
+	}
+	if (lu.owned) {
+		ufs_wr(REG_UTRLRSR, 0);         /* stop our list, as UfsReadRo did at exit */
+	}
+	lilac_report(stage, nib);
+}
+
+#endif /* ARM64_BOARD_CONFIG_LILAC */
