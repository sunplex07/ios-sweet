+    # Compile the actual reader bodies and asm statements for the real Mach-O
+    # target, then inspect emitted instructions (not clang's textual assembly).
+    clang = '/home/sunplex/lineage-arm64/ext/toolchain-xnu/prefix/llvm/bin/clang'
+    vct = function(stage, 'smpt_counter_read')
+    pct = function(stage, 'smpt_physical_read')
+    drain = re.search(r'__asm__ volatile\("clrex[^;]*;', stage).group(0)
+    at = re.search(r'__asm__ volatile\("at s1e1r[^;]*;', stage).group(0)
