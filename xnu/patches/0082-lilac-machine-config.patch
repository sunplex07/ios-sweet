+	uintptr_t d, s;
+	uint32_t n = vinfo.v_rowscanbytes, k;
+
+	if (dst_line >= vinfo.v_height || src_line >= vinfo.v_height) {
+		return;
+	}
+	d = vinfo.v_baseaddr + (uintptr_t)dst_line * vinfo.v_rowbytes;
+	s = vinfo.v_baseaddr + (uintptr_t)src_line * vinfo.v_rowbytes;
+	if (((d | s | n) & 7) == 0) {
+		volatile uint64_t *dp = (volatile uint64_t *)d;
+		volatile uint64_t *sp = (volatile uint64_t *)s;
+		for (k = 0; k < n / 8; k++) {
+			dp[k] = sp[k];
+		}
+	} else {
+		volatile uint8_t *dp = (volatile uint8_t *)d;
+		volatile uint8_t *sp = (volatile uint8_t *)s;
+		for (k = 0; k < n; k++) {
+			dp[k] = sp[k];
+		}
+	}
