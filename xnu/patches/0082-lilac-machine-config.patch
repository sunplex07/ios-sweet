+		fScaleW = fWidth;
+		fScaleH = (uint32_t)(((uint64_t)fLogicalH * fWidth + fLogicalW / 2) / fLogicalW);
+	} else {
+		fScaleH = fHeight;
+		fScaleW = (uint32_t)(((uint64_t)fLogicalW * fHeight + fLogicalH / 2) / fLogicalH);
+	}
+	fScaleW = fScaleW == 0 ? 1 : (fScaleW > fWidth ? fWidth : fScaleW);
+	fScaleH = fScaleH == 0 ? 1 : (fScaleH > fHeight ? fHeight : fScaleH);
+	fScaleX = (fWidth - fScaleW) / 2;
+	fScaleY = (fHeight - fScaleH) / 2;
+
+	fShadowSize = (uint32_t)panelBytes;
+	fShadow = (uint8_t *)IOMallocZeroData(fShadowSize);
+	fColSrc = (uint16_t *)IOMallocData(fScaleW * sizeof(uint16_t));
+	fRowSrc = (uint16_t *)IOMallocData(fScaleH * sizeof(uint16_t));
+	if (fPixels == 0 || fShadow == NULL || fColSrc == NULL || fRowSrc == NULL) {
+		return false;
+	}
+	/* Nearest neighbour: sample the logical pixel under each scaled pixel's centre. */
+	for (uint32_t i = 0; i < fScaleW; i++) {
+		fColSrc[i] = (uint16_t)(((2 * (uint64_t)i + 1) * fLogicalW) / (2 * (uint64_t)fScaleW));
+	}
+	for (uint32_t j = 0; j < fScaleH; j++) {
+		fRowSrc[j] = (uint16_t)(((2 * (uint64_t)j + 1) * fLogicalH) / (2 * (uint64_t)fScaleH));
+	}
+
+	/* The default surface handed to userland: BGRA, logical size, 64-byte rows. */
+	fSurface = sweet_surface_create_buffer(fLogicalW, fLogicalH, (fLogicalW * 4 + 63) & ~63u,
+	    SWEET_FB_FORMAT_BGRA);
+	if (fSurface == NULL) {
+		return false;
+	}
+
+	/* Black bars around the scaled frame (the shadow is zeroed). */
+	lilacFlush(0, fHeight, 0, fScaleX * 3);
+	lilacFlush(0, fHeight, (fScaleX + fScaleW) * 3, fWidth * 3);
+	lilacFlush(0, fScaleY, 0, fWidth * 3);
+	lilacFlush(fScaleY + fScaleH, fHeight, 0, fWidth * 3);
+	return true;
+}
+
+/* Copy shadow rows [y0, y1), bytes [b0, b1) of each, into the panel. */
+void
+AppleCLCD::lilacFlush(uint32_t y0, uint32_t y1, uint32_t b0, uint32_t b1)
+{
+	if (y1 > fHeight) {
+		y1 = fHeight;
+	}
+	if (b1 > fRowBytes) {
+		b1 = fRowBytes;
+	}
+	if (y0 >= y1 || b0 >= b1) {
+		return;
+	}
+	if (((fPixels | fRowBytes | (uintptr_t)fShadow) & 3) == 0) {
+		b0 &= ~3u;
+		b1 = (b1 + 3) & ~3u;            /* <= fRowBytes, a multiple of 4 */
+		uint32_t words = (b1 - b0) / 4;
+		for (uint32_t y = y0; y < y1; y++) {
+			uint64_t off = (uint64_t)y * fRowBytes + b0;
+			const uint32_t *s = (const uint32_t *)((uintptr_t)fShadow + off);
+			volatile uint32_t *d = (volatile uint32_t *)(fPixels + off);
+			for (uint32_t k = 0; k < words; k++) {
+				d[k] = s[k];
+			}
+		}
+	} else {
+		for (uint32_t y = y0; y < y1; y++) {
+			uint64_t off = (uint64_t)y * fRowBytes;
+			volatile uint8_t *d = (volatile uint8_t *)(fPixels + off);
+			for (uint32_t k = b0; k < b1; k++) {
+				d[k] = fShadow[off + k];
+			}
+		}
+	}
+}
+
+/* Fade step while off: halve every byte of the shadow (6 steps), then black. */
+void
+AppleCLCD::lilacFade(uint32_t step)
+{
+	uint32_t *w = (uint32_t *)(uintptr_t)fShadow;    /* page-aligned kmem allocation */
+	uint32_t words = fShadowSize / 4;
+
+	for (uint32_t i = 0; i < words; i++) {
+		w[i] = step < 6 ? (w[i] >> 1) & 0x7f7f7f7f : 0;
+	}
+	for (uint32_t i = words * 4; i < fShadowSize; i++) {
+		fShadow[i] = (uint8_t)(step < 6 ? fShadow[i] >> 1 : 0);
+	}
+	lilacFlush(0, fHeight, 0, fRowBytes);
+}
+
+/* First index of the non-decreasing table t[0..n) with t[i] >= v (n if none). */
+static uint32_t
+lilac_lower_bound(const uint16_t *t, uint32_t n, uint32_t v)
+{
+	uint32_t lo = 0, hi = n;
+	while (lo < hi) {
+		uint32_t mid = (lo + hi) / 2;
+		if (t[mid] < v) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	return lo;
+}
+
+/*
+ * Compose the enabled layers (clipped in logical coordinates, the default
+ * surface included) into the shadow, scaled; then flush the changed part.
+ * A scaled pixel belongs to a layer when its logical sample point lies in
+ * the layer's destination rect, so adjacent layers tile without gaps.
+ */
+void
+AppleCLCD::lilacPresent(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+	uint32_t ry0 = fScaleH, ry1 = 0, ri0 = fScaleW, ri1 = 0;        /* changed scaled rect */
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(id);
+		if (sweet_fb_swaps_logged < 16) {
+			sweet_fb_swaps_logged++;
+			IOLog("SWEET FB: swap %u layer %u surface %u %ux%u fmt 0x%x bpr %u a %d,%d %ux%u b %d,%d %dx%d\n",
+			    get32(rec, 0x50), layer, id, s ? s->width : 0, s ? s->height : 0,
+			    s ? s->pixelFormat : 0, s ? s->bytesPerRow : 0, sx, sy, get32(a, 8),
+			    get32(a, 12), dx, dy, w, h);
+		}
+		if (s == NULL) {
+			continue;
+		}
+		uintptr_t src = s->kernelAddress();
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (dx < 0 || dy < 0) {
+			dx = dy = 0;
+		}
+		if (w > (int32_t)s->width - sx) {
+			w = (int32_t)s->width - sx;
+		}
+		if (h > (int32_t)s->height - sy) {
+			h = (int32_t)s->height - sy;
+		}
+		if (w > (int32_t)fLogicalW - dx) {
+			w = (int32_t)fLogicalW - dx;
+		}
+		if (h > (int32_t)fLogicalH - dy) {
+			h = (int32_t)fLogicalH - dy;
+		}
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		if (w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+		    s->memory == NULL || last > s->memory->getLength()) {
+			src = 0;
+		}
+		if (src != 0 && bpe == 4) {
+			uint32_t udx = (uint32_t)dx, udy = (uint32_t)dy;
+			uint32_t i0 = lilac_lower_bound(fColSrc, fScaleW, udx);
+			uint32_t i1 = lilac_lower_bound(fColSrc, fScaleW, udx + (uint32_t)w);
+			uint32_t j0 = lilac_lower_bound(fRowSrc, fScaleH, udy);
+			uint32_t j1 = lilac_lower_bound(fRowSrc, fScaleH, udy + (uint32_t)h);
+			const uint8_t *base = (const uint8_t *)src + s->offset + (uint64_t)sx * 4;
+			for (uint32_t j = j0; j < j1 && i0 < i1; j++) {
+				const uint8_t *row = base + (uint64_t)(sy + fRowSrc[j] - udy) * s->bytesPerRow;
+				uint8_t *d = fShadow + (uint64_t)(fScaleY + j) * fRowBytes + (uint64_t)(fScaleX + i0) * 3;
+				const uint16_t *cx = fColSrc + i0;
+				for (uint32_t n = i1 - i0; n != 0; n--) {
+					uint32_t v;
+					memcpy(&v, row + ((uint32_t)(*cx++ - udx) << 2), 4);       /* B,G,R,A */
+					d[0] = (uint8_t)v;
+					d[1] = (uint8_t)(v >> 8);
+					d[2] = (uint8_t)(v >> 16);
+					d += 3;
+				}
+			}
+			if (i0 < i1 && j0 < j1) {
+				ry0 = j0 < ry0 ? j0 : ry0;
+				ry1 = j1 > ry1 ? j1 : ry1;
+				ri0 = i0 < ri0 ? i0 : ri0;
+				ri1 = i1 > ri1 ? i1 : ri1;
+			}
+		}
+		s->release();
+	}
+	if (ry0 < ry1) {
+		lilacFlush(fScaleY + ry0, fScaleY + ry1, (fScaleX + ri0) * 3, (fScaleX + ri1) * 3);
+	}
+}
+#endif /* LILAC */
