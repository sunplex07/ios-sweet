diff --git a/bsd/dev/lilac_disp.c b/bsd/dev/lilac_disp.c
new file mode 100644
index 0000000..3c3a2dd
--- /dev/null
+++ b/bsd/dev/lilac_disp.c
@@ -0,0 +1,165 @@
+/*
+ * LILAC (Xperia XZ1 Compact, MSM8998): display probe, stage 85 (lilac_stop=85).
+ *
+ * The panel is a 720x1280 DSI command-mode panel (somc lilac dtsi:
+ * qcom,mdss-dsi-panel-type = "dsi_cmd_mode"); UEFI's SimpleFbDxe draws into
+ * the continuous-splash RAM at 0x9D400000 (RGB888, stride 2160) and the
+ * bootloader-programmed MDP refreshes the panel from it. Whether that refresh
+ * survives into xnu decides whether a RAM framebuffer can show anything.
+ *
+ * Nothing here runs unless lilac_stop=85. MDSS/MMCC/GCC registers are only
+ * read, and only after the clocks that gate them read as running:
+ *   GCC  0x00100000 + 0x9004  gcc_mmss_noc_cfg_ahb_clk CBCR (any MMSS access depends on it)
+ *   MMCC 0x0C8C0000 + 0x2304  MDSS GDSCR (bit31 PWR_ON)
+ *                   + 0x2308/0x2310/0x231C  mdss_ahb/axi/mdp CBCR (bit31 CLK_OFF)
+ *   MDP  0x0C901000: pingpong_0 +0x70000 (+0x14 read pointer, +0x2C write pointer line,
+ *        +0x30 autorefresh config), SSPP VIG0-3 +0x4000.. / DMA0-3 +0x24000.. (+0x14 SRC0_ADDR,
+ *        +0x24 YSTRIDE0)  (Linux dpu_3_0_msm8998.h, dpu_hw_pingpong.c, dpu_hw_sspp.c).
+ * The only write is to the splash RAM itself (below xnu's physBase 0xA0000000,
+ * mapped device-nGnRE so no cache maintenance is needed): eight vertical
+ * colour bars, written once the MDSS clocks read as running, during the 20 s +
+ * 4 * nibble stop delay, so they are on screen if the panel is refreshing.
+ *
+ * Nibble: bit0 GCC MMSS NoC AHB clock running; bit1 MDSS GDSC on and AHB/AXI/MDP
+ * clocks running; bit2 pingpong_0 pointers move over 100 ms (frames are being
+ * sent); bit3 an SSPP scans out 0x9D400000 with stride 2160.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <libkern/libkern.h>
+#include <arm64/sweet_early.h>
+
+#if defined(ARM64_BOARD_CONFIG_LILAC)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define GCC_MMSS_NOC_PA         0x00109000ULL
+#define GCC_MMSS_NOC_CBCR       0x004
+#define MMCC_MDSS_PA            0x0C8C2000ULL
+#define MMCC_MDSS_GDSCR         0x304
+#define MMCC_MDSS_AHB_CBCR      0x308
+#define MMCC_MDSS_AXI_CBCR      0x310
+#define MMCC_MDSS_MDP_CBCR      0x31C
+#define MDP_PA                  0x0C901000ULL
+#define MDP_PP0                 0x70000
+#define MDP_LEN                 0x72000
+#define PP_INT_COUNT_VAL        0x14
+#define PP_LINE_COUNT           0x2C
+#define PP_AUTOREFRESH_CONFIG   0x30
+#define SSPP_SRC0_ADDR          0x14
+#define SSPP_SRC_YSTRIDE0       0x24
+
+#define FB_PA                   0x9D400000ULL
+#define FB_W                    720u
+#define FB_H                    1280u
+#define FB_STRIDE               2160u
+
+static const uint32_t sspp_off[8] = {
+	0x4000, 0x6000, 0x8000, 0xa000, 0x24000, 0x26000, 0x28000, 0x2a000,
+};
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+lilac_disp_bars(void)
+{
+	static const uint8_t col[8][3] = {   /* bytes in memory order B, G, R (PixelBitMask R=0xFF0000) */
+		{ 0xFF, 0xFF, 0xFF }, { 0x00, 0xFF, 0xFF }, { 0xFF, 0xFF, 0x00 }, { 0x00, 0xFF, 0x00 },
+		{ 0xFF, 0x00, 0xFF }, { 0x00, 0x00, 0xFF }, { 0xFF, 0x00, 0x00 }, { 0x00, 0x00, 0x00 },
+	};
+	vm_offset_t fb = ml_io_map(FB_PA, (vm_size_t)FB_STRIDE * FB_H);
+	if (!fb) {
+		return;
+	}
+	for (uint32_t y = 0; y < FB_H; y++) {
+		volatile uint8_t *row = (volatile uint8_t *)(fb + (vm_offset_t)y * FB_STRIDE);
+		for (uint32_t x = 0; x < FB_W; x++) {
+			const uint8_t *c = col[(x * 8) / FB_W];
+			row[3 * x] = c[0];
+			row[3 * x + 1] = c[1];
+			row[3 * x + 2] = c[2];
+		}
+	}
+	__builtin_arm_dsb(0xF);
+}
+
+void lilac_disp_probe(void);
+
+void
+lilac_disp_probe(void)
+{
+	unsigned int nib = 0;
+
+	if (!lilac_stop_is(85)) {
+		return;
+	}
+	vm_offset_t gcc = ml_io_map(GCC_MMSS_NOC_PA, PAGE_SIZE);
+	uint32_t noc = gcc ? rd(gcc, GCC_MMSS_NOC_CBCR) : 0xFFFFFFFFu;
+	printf("LILAC DISP: gcc_mmss_noc_cfg_ahb CBCR 0x%08x\n", noc);
+	if (!gcc || (noc & 0x80000000u)) {
+		lilac_report(85, nib);
+		return;
+	}
+	nib |= 1;
+
+	vm_offset_t mmcc = ml_io_map(MMCC_MDSS_PA, PAGE_SIZE);
+	if (!mmcc) {
+		lilac_report(85, nib);
+		return;
+	}
+	uint32_t gdsc = rd(mmcc, MMCC_MDSS_GDSCR), ahb = rd(mmcc, MMCC_MDSS_AHB_CBCR);
+	uint32_t axi = rd(mmcc, MMCC_MDSS_AXI_CBCR), mdp = rd(mmcc, MMCC_MDSS_MDP_CBCR);
+	printf("LILAC DISP: MDSS GDSCR 0x%08x ahb 0x%08x axi 0x%08x mdp 0x%08x\n", gdsc, ahb, axi, mdp);
+	if (!(gdsc & 0x80000000u) || ((ahb | axi | mdp) & 0x80000000u)) {
+		lilac_report(85, nib);
+		return;
+	}
+	nib |= 2;
+
+	vm_offset_t m = ml_io_map(MDP_PA, MDP_LEN);
+	if (!m) {
+		lilac_report(85, nib);
+		return;
+	}
+	uint32_t rp0 = rd(m, MDP_PP0 + PP_INT_COUNT_VAL), wp0 = rd(m, MDP_PP0 + PP_LINE_COUNT);
+	uint32_t ar = rd(m, MDP_PP0 + PP_AUTOREFRESH_CONFIG);
+	unsigned int rp_changes = 0, wp_changes = 0;
+	uint32_t rp = rp0, wp = wp0;
+	for (unsigned int i = 0; i < 1000; i++) {
+		delay(97 + (int)(i % 7));
+		uint32_t r = rd(m, MDP_PP0 + PP_INT_COUNT_VAL), w = rd(m, MDP_PP0 + PP_LINE_COUNT);
+		if (r != rp) {
+			rp_changes++;
+		}
+		if (w != wp) {
+			wp_changes++;
+		}
+		rp = r;
+		wp = w;
+	}
+	printf("LILAC DISP: pp0 autorefresh 0x%08x rdptr 0x%08x->0x%08x (%u changes) wrptr 0x%08x->0x%08x (%u changes)\n",
+	    ar, rp0, rp, rp_changes, wp0, wp, wp_changes);
+	if (wp_changes > 0 || (rp >> 16) != (rp0 >> 16)) {
+		nib |= 4;
+	}
+	for (unsigned int i = 0; i < 8; i++) {
+		uint32_t a = rd(m, sspp_off[i] + SSPP_SRC0_ADDR), s = rd(m, sspp_off[i] + SSPP_SRC_YSTRIDE0);
+		printf("LILAC DISP: sspp 0x%05x src0 0x%08x ystride0 0x%08x\n", sspp_off[i], a, s);
+		if (a == (uint32_t)FB_PA && (s & 0xFFFFu) == FB_STRIDE) {
+			nib |= 8;
+		}
+	}
+	/* RAM only (no MDSS access), so also when no motion was seen: the screen is the ground truth. */
+	lilac_disp_bars();
+	printf("LILAC DISP: colour bars written to 0x%llx\n", FB_PA);
+	lilac_report(85, nib);
+}
+
+#endif /* ARM64_BOARD_CONFIG_LILAC */
diff --git a/bsd/dev/lilac_input.c b/bsd/dev/lilac_input.c
new file mode 100644
index 0000000..68102d2
--- /dev/null
+++ b/bsd/dev/lilac_input.c
@@ -0,0 +1,385 @@
+/*
+ * LILAC phase-a input discovery, opt-in only: lilac_stop=86.
+ * No PMIC writes, GPIO writes, clock votes, touch reset/wake or HID events.
+ * Only observer EXT_READL commands and QUP5 PIO configuration are written.
+ * Inherited clocks/pinmux/I2C divider must already be usable; otherwise stop.
+ * RMI reads send a one-byte register pointer, never register data (including
+ * page-select). Page zero is required, not forced. No firmware upload.
+ * Register references: Linux i2c-qup.c, spmi-pmic-arb.c, pinctrl-msm8998.c;
+ * Sony msm8998-yoshino-common.dtsi and msm8998-yoshino-lilac_common.dtsi.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm64/sweet_early.h>
+
+#if defined(ARM64_BOARD_CONFIG_LILAC)
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void lilac_input_probe(void);
+
+#define INPUT_STAGE 86u
+#define Q_CONFIG 0x000u
+#define Q_STATE 0x004u
+#define Q_IO 0x008u
+#define Q_RESET 0x00cu
+#define Q_OP 0x018u
+#define Q_ERR 0x01cu
+#define Q_ERR_EN 0x020u
+#define Q_MASK 0x028u
+#define Q_HW 0x030u
+#define Q_OUT_CNT 0x100u
+#define Q_OUT 0x110u
+#define Q_WRITE_CNT 0x150u
+#define Q_IN_CNT 0x200u
+#define Q_READ_CNT 0x208u
+#define Q_IN 0x218u
+#define Q_CLK 0x400u
+#define Q_STATUS 0x404u
+#define Q_GEN 0x408u
+
+static vm_offset_t qup;
+static uint32_t divider;
+static bool qup_dead;
+
+static uint32_t
+input_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+input_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+qup_wait_state(unsigned state)
+{
+	for (unsigned i = 0; i < 100; i++) {
+		if ((input_rd(qup, Q_STATE) & 7u) == (4u | state)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+qup_state(unsigned state)
+{
+	if (!(input_rd(qup, Q_STATE) & 4u)) {
+		return false;
+	}
+	input_wr(qup, Q_STATE, state);
+	return qup_wait_state(state);
+}
+
+/* A complete pointer-write/repeated-start/read/STOP, entirely in the FIFOs.
+ * QUP v2 tags are packed little-endian; receive has a two-byte tag prefix.
+ * Bound reads to 16 bytes; touch_probe validates both hardware capacities.
+ */
+static bool
+rmi_read(uint8_t reg, uint8_t *out, unsigned len)
+{
+	uint8_t tx[9] = {0x81, 0x58, 0x82, 1, reg, 0x81, 0x59, 0x87, (uint8_t)len};
+	uint8_t rx[20];
+	unsigned got = 0;
+	bool done = false;
+	if (!qup || qup_dead || len == 0 || len > 16 || (unsigned)reg + len > 256) {
+		return false;
+	}
+	if (input_rd(qup, Q_STATUS) & (1u << 8)) {
+		printf("LILAC INPUT: FAIL I2C bus-active before transfer\n");
+		qup_dead = true;
+		return false;
+	}
+	input_wr(qup, Q_RESET, 1);
+	if (!qup_wait_state(0)) {
+		goto fail;
+	}
+	input_wr(qup, Q_CONFIG, 0x207); /* I2C mini-core, 8-bit words */
+	input_wr(qup, Q_GEN, 1);       /* v2 tags */
+	if (!(input_rd(qup, Q_STATE) & 0x10u)) {
+		goto fail;
+	}
+	input_wr(qup, Q_ERR_EN, 0);    /* polling; no interrupt route installed */
+	input_wr(qup, Q_MASK, 0x300);  /* mask service interrupts only */
+	input_wr(qup, Q_IO, 0xc000);   /* pack/unpack, FIFO (not BAM) */
+	input_wr(qup, Q_OUT_CNT, 0);
+	input_wr(qup, Q_IN_CNT, 0);
+	input_wr(qup, Q_WRITE_CNT, sizeof(tx));
+	input_wr(qup, Q_READ_CNT, len + 2);
+	if (!qup_state(1)) {
+		goto fail;
+	}
+	input_wr(qup, Q_CLK, divider); /* preserve the firmware's proven divider */
+	if (!qup_state(3)) {
+		goto fail;
+	}
+	for (unsigned i = 0; i < sizeof(tx); i += 4) {
+		uint32_t word = 0;
+		for (unsigned j = 0; j < 4 && i + j < sizeof(tx); j++) {
+			word |= (uint32_t)tx[i + j] << (8 * j);
+		}
+		input_wr(qup, Q_OUT, word);
+	}
+	if (!qup_state(1)) {
+		goto fail;
+	}
+	for (unsigned i = 0; i < 20000; i++) {
+		uint32_t status = input_rd(qup, Q_STATUS);
+		uint32_t op = input_rd(qup, Q_OP);
+		if ((status & 0x038000fcu) || (input_rd(qup, Q_ERR) & 0x7cu)) {
+			goto fail;
+		}
+		if ((op & 0x20u) && got < len + 2) {
+			uint32_t word = input_rd(qup, Q_IN);
+			for (unsigned j = 0; j < 4 && got < len + 2; j++, got++) {
+				rx[got] = (uint8_t)(word >> (8 * j));
+			}
+		}
+		if (op & 0x300u) {
+			input_wr(qup, Q_OP, op & 0x300u); /* W1C service flags */
+		}
+		if (got == len + 2 && (op & 0xc00u) == 0xc00u && !(status & 0x100u)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !qup_state(0)) {
+		goto fail;
+	}
+	/* Linux qup_i2c_recv_tags discards two bytes; do not invent tag values.
+	 * Capture the first prefix so hardware evidence can check packing. */
+	if (reg == 0xff) {
+		printf("LILAC INPUT: RX prefix=%02x,%02x page-byte=%02x\n", rx[0], rx[1], rx[2]);
+	}
+	for (unsigned i = 0; i < len; i++) {
+		out[i] = rx[i + 2];
+	}
+	return true;
+fail:
+	printf("LILAC INPUT: FAIL I2C reg=%02x n=%u got=%u state=%08x op=%08x status=%08x err=%08x\n",
+	    reg, len, got, input_rd(qup, Q_STATE), input_rd(qup, Q_OP),
+	    input_rd(qup, Q_STATUS), input_rd(qup, Q_ERR));
+	/* Abort only our PIO transaction, then forbid further bus transactions. */
+	(void)qup_state(0);
+	qup_dead = true;
+	return false;
+}
+
+/* v2/v3/v4 observer layout, NOT SWEET's v5 0x80*APID layout. */
+static vm_offset_t observers[5];
+static const uint16_t key_regs[5] = {0x0810, 0xc410, 0xc510, 0xc610, 0xc710};
+static const char *const key_names[5] = {"power/RESIN", "vol-", "vol+", "camera", "focus"};
+
+static bool
+pmic_read(unsigned k, uint8_t offset, uint8_t *v)
+{
+	if (!observers[k]) {
+		return false;
+	}
+	/* EXT_READL, one byte; this is a controller command, not a PMIC write. */
+	input_wr(observers[k], 0, (1u << 27) | ((uint32_t)offset << 4));
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t status = input_rd(observers[k], 8);
+		if (status & 1u) {
+			if (status & 0xeu) {
+				printf("LILAC INPUT: FAIL SPMI %s status=%08x\n", key_names[k], status);
+				return false;
+			}
+			*v = (uint8_t)input_rd(observers[k], 0x18);
+			return true;
+		}
+		delay(1);
+	}
+	printf("LILAC INPUT: FAIL SPMI %s timeout\n", key_names[k]);
+	return false;
+}
+
+static bool
+keys_probe(void)
+{
+	vm_offset_t core = ml_io_map(0x0800f000, 0x1000);
+	if (!core) {
+		return false;
+	}
+	uint32_t version = input_rd(core, 0);
+	printf("LILAC INPUT: SPMI arb=%08x EE=0\n", version);
+	if (version < 0x20010000u || version >= 0x50000000u) {
+		printf("LILAC INPUT: FAIL unsupported SPMI version (no command issued)\n");
+		return false;
+	}
+	bool all = true;
+	for (unsigned k = 0; k < 5; k++) {
+		for (unsigned apid = 0; apid < 512; apid++) {
+			uint32_t map = input_rd(core, 0x800 + 4 * apid);
+			if (map && ((map >> 8) & 0xfffu) == (key_regs[k] >> 8)) {
+				observers[k] = ml_io_map(0x09400000ull + 0x8000ull * apid, 0x1000);
+				printf("LILAC INPUT: SPMI %s SID0:%04x apid=%u\n", key_names[k], key_regs[k], apid);
+				break;
+			}
+		}
+		uint8_t rt = 0, mode = 0, en = 0, sub = 0;
+		bool ok = pmic_read(k, 0x10, &rt);
+		if (k) {
+			bool cfg = pmic_read(k, 0x40, &mode) && pmic_read(k, 0x46, &en) && pmic_read(k, 5, &sub);
+			printf("LILAC INPUT: GPIO%u rt=%02x mode=%02x en=%02x subtype=%02x cfg-ok=%d\n", k + 4, rt, mode, en, sub, cfg);
+			/* Report only: phase a never repairs pin configuration. */
+			ok = ok && cfg;
+		}
+		all &= ok;
+		if (!ok) {
+			observers[k] = 0; /* bounded failure, no retry loop */
+		}
+	}
+	printf("LILAC INPUT: %s KEYS-readable (states are raw, not HID)\n", all ? "PASS" : "FAIL");
+	return all;
+}
+
+static unsigned
+touch_probe(void)
+{
+	vm_offset_t gcc = ml_io_map(0x00100000, 0x53000);
+	vm_offset_t east = ml_io_map(0x03d00000, 0x80000);
+	vm_offset_t west = ml_io_map(0x03500000, 0x90000);
+	if (!gcc || !east || !west) {
+		printf("LILAC INPUT: FAIL GPIO/GCC mapping\n");
+		return 0;
+	}
+	uint32_t ahb = input_rd(gcc, 0x17004), apps = input_rd(gcc, 0x21008);
+	uint32_t c87 = input_rd(east, 87 * 0x1000), c88 = input_rd(east, 88 * 0x1000);
+	printf("LILAC INPUT: GCC ahb=%08x apps=%08x rcg=%08x cfg=%08x vote=%08x\n",
+	    ahb, apps, input_rd(gcc, 0x21020), input_rd(gcc, 0x21024), input_rd(gcc, 0x52004));
+	printf("LILAC INPUT: TLMM87 cfg=%08x io=%x 88 cfg=%08x io=%x\n", c87,
+	    input_rd(east, 87 * 0x1000 + 4), c88, input_rd(east, 88 * 0x1000 + 4));
+	printf("LILAC INPUT: TLMM89 reset cfg=%08x io=%x IRQ125 cfg=%08x io=%x VIO133 cfg=%08x io=%x\n",
+	    input_rd(east, 89 * 0x1000), input_rd(east, 89 * 0x1000 + 4),
+	    input_rd(east, 125 * 0x1000), input_rd(east, 125 * 0x1000 + 4),
+	    input_rd(west, 133 * 0x1000), input_rd(west, 133 * 0x1000 + 4));
+	if (((ahb | apps) & 0x80000000u) || ((c87 >> 2) & 15) != 3 || ((c88 >> 2) & 15) != 3) {
+		printf("LILAC INPUT: FAIL touch prerequisites clocks/mux; no QUP access\n");
+		return 0;
+	}
+	qup = ml_io_map(0x0c179000, 0x1000);
+	if (!qup) {
+		return 0;
+	}
+	divider = input_rd(qup, Q_CLK);
+	uint32_t cfg = input_rd(qup, Q_CONFIG), gen = input_rd(qup, Q_GEN);
+	uint32_t io = input_rd(qup, Q_IO);
+	printf("LILAC INPUT: QUP5 hw=%08x config=%08x state=%08x io=%08x clk=%08x gen=%08x status=%08x\n",
+	    input_rd(qup, Q_HW), cfg, input_rd(qup, Q_STATE), io, divider, gen, input_rd(qup, Q_STATUS));
+	const unsigned block_bytes[] = {4, 16, 32};
+	unsigned ob = io & 3u, ib = (io >> 5) & 3u;
+	if (ob >= 3 || ib >= 3 ||
+	    block_bytes[ob] * (2u << ((io >> 2) & 7u)) < 9 ||
+	    block_bytes[ib] * (2u << ((io >> 7) & 7u)) < 18) {
+		printf("LILAC INPUT: FAIL QUP FIFO geometry io=%08x; no QUP writes\n", io);
+		return 0;
+	}
+	if ((cfg & 0xf00u) != 0x200 || !(gen & 1) || !(divider & 0xff) ||
+	    (input_rd(qup, Q_OP) & 0x30u) || /* inherited FIFO data: another owner */
+	    (input_rd(qup, Q_STATUS) & 0x100) || (input_rd(qup, Q_STATE) & 7) != 4) {
+		printf("LILAC INPUT: FAIL inherited QUP not idle/configured; no QUP writes\n");
+		return 0;
+	}
+	unsigned bits = 2;
+	uint8_t page;
+	if (!rmi_read(0xff, &page, 1)) {
+		return bits;
+	}
+	if (page != 0) {
+		printf("LILAC INPUT: FAIL RMI page=%u (not changed)\n", page);
+		return bits;
+	}
+	bool terminated = false;
+	for (int reg = 0xe9; reg >= 5; reg -= 6) {
+		uint8_t fd[6];
+		if (!rmi_read((uint8_t)reg, fd, 6)) {
+			return bits & 2u;
+		}
+		if (!fd[5]) {
+			terminated = true;
+			break;
+		}
+		if (fd[5] == 0xff) {
+			printf("LILAC INPUT: FAIL invalid PDT function ff\n");
+			return bits & 2u;
+		}
+		printf("LILAC INPUT: PDT F%02x query=%02x cmd=%02x ctrl=%02x data=%02x irq=%02x\n",
+		    fd[5], fd[0], fd[1], fd[2], fd[3], fd[4]);
+		if (fd[5] == 1) {
+			uint8_t id[11] = {0};
+			if (fd[0] > 0xea || !rmi_read((uint8_t)(fd[0] + 11), id, 10)) {
+				printf("LILAC INPUT: FAIL F01 query extent/read\n");
+				return bits & 2u;
+			}
+			bool valid = false;
+			for (unsigned i = 0; i < 10; i++) {
+				if (id[i] >= 0x21 && id[i] <= 0x7e) {
+					valid = true;
+				} else if (id[i] != 0 && id[i] != ' ') {
+					valid = false;
+					break;
+				}
+			}
+			printf("LILAC INPUT: %s F01 product=%s addr=2c page=0\n", valid ? "PASS" : "FAIL", valid ? (char *)id : "invalid");
+			if (valid) {
+				bits |= 4;
+			}
+		}
+		if (fd[5] == 0x11 || fd[5] == 0x12) {
+			bits |= 8;
+		}
+	}
+	if (!terminated) {
+		printf("LILAC INPUT: FAIL unterminated page-zero PDT\n");
+		bits &= 2u;
+	}
+	printf("LILAC INPUT: %s TOUCH-ID bits=%x (page-zero probe only)\n", (bits & 12) == 12 ? "PASS" : "FAIL", bits);
+	return bits;
+}
+
+void
+lilac_input_probe(void)
+{
+	if (!lilac_stop_is(INPUT_STAGE)) {
+		return;
+	}
+	printf("LILAC INPUT: BEGIN phase=a stage=86 no-PMIC-writes no-HID\n");
+	unsigned bits = keys_probe() ? 1 : 0;
+	bits |= touch_probe();
+	printf("LILAC INPUT: KEYS window=10s sample=50ms press-and-release each key\n");
+	uint8_t last[5] = {0xff, 0xff, 0xff, 0xff, 0xff};
+	for (unsigned sample = 0; sample < 200; sample++) {
+		for (unsigned k = 0; k < 5; k++) {
+			uint8_t rt;
+			if (!observers[k]) {
+				continue;
+			}
+			if (!pmic_read(k, 0x10, &rt)) {
+				observers[k] = 0;
+				bits &= ~1u;
+				continue;
+			}
+			if (rt != last[k]) {
+				printf("LILAC INPUT: KEY sample=%u %s raw=%02x down=%u\n", sample,
+				    key_names[k], rt, k ? !(rt & 1u) : !!(rt & 1u));
+				last[k] = rt;
+			}
+		}
+		delay(50000);
+	}
+	printf("LILAC INPUT: END phase=a bits=%x %s (key transitions require operator review)\n",
+	    bits, bits == 15 ? "PASS discovery" : "FAIL discovery");
+	lilac_report(INPUT_STAGE, bits);
+}
+#endif
diff --git a/bsd/dev/lilac_keys.c b/bsd/dev/lilac_keys.c
new file mode 100644
index 0000000..70e605e
--- /dev/null
+++ b/bsd/dev/lilac_keys.c
@@ -0,0 +1,274 @@
+/*
+ * LILAC hardware keys: PM8998 power/volume/camera/focus buttons, polled over
+ * SPMI v2/v3/v4 observer reads at 20 Hz with a two-sample debounce, injected
+ * into iOS through SweetHID's consumer-control path (sweet_hid_key). Started
+ * from bsd_init after the stage-86 probe (that probe ends in a device reset,
+ * so the two never share the observers).
+ *
+ * PMIC access is READ ONLY: the only MMIO store to the arbiter is the observer
+ * EXT_READL command word. No PMIC configuration, IRQ, reset or regulator
+ * write exists here; failed reads retain the last state and never fabricate a
+ * transition. Camera/focus and the PON RESIN bit1 volume-up mirror are logged
+ * only (no HID event). Kill switch: boot-arg lilackeys=0 keeps the previous
+ * behaviour (no polling, no events); default is on.
+ *
+ * Register references: Linux spmi-pmic-arb.c, pinctrl-spmi-gpio.c,
+ * pm8941-pwrkey.c and Sony msm8998-yoshino-common.dtsi (PON pwrkey/resin,
+ * GPIO5..8 keys), as verified read-only on device by the stage-86 probe.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+#if defined(ARM64_BOARD_CONFIG_LILAC)
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+void lilac_keys_start(void);
+
+#define KEYS_CORE_PA  0x0800f000u          /* SPMI arbiter core */
+#define KEYS_OBS_PA   0x09400000ull        /* observer channels, EE0 */
+#define KEYS_PON_RT   0x10u                /* PON RT_STS: bit0 power, bit1 RESIN */
+#define KEYS_POLL_MS  50u                  /* 20 Hz */
+
+/* Poll sources 0..4: PON power (active high), PM8998 GPIO5..8 (active low).
+ * key_hid is the sweet_hid_key() index (0 power, 1 vol+, 2 vol-); -1 = the
+ * transition is logged only. Index KEYS_N is the PON RESIN bit1 mirror. */
+#define KEYS_N 5
+static const uint16_t key_ppid[KEYS_N] = { 0x008, 0x0c4, 0x0c5, 0x0c6, 0x0c7 };
+static const char *const key_name[KEYS_N + 1] =
+{ "power", "vol-", "vol+", "camera", "focus", "resin" };
+static const int key_hid[KEYS_N] = { 0, 2, 1, -1, -1 };
+
+static vm_offset_t keys_core, keys_obs[KEYS_N];
+static bool keys_started;
+static bool key_stable_ready[KEYS_N + 1];  /* baseline established */
+static bool key_stable[KEYS_N + 1];        /* debounced state, true = down */
+static bool key_last[KEYS_N + 1];          /* previous raw sample */
+static bool key_down_sent[KEYS_N + 1];     /* a down event was injected */
+static unsigned key_errors[KEYS_N];
+static int keys_sleep_chan;
+
+static uint32_t
+keys_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+keys_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* One-byte EXT_READL on key k's observer channel: an arbiter command, never a
+ * PMIC register write. Channel offsets: RT_STS +0x10, subtype +0x05,
+ * mode +0x40, enable +0x46 (pinctrl-spmi-gpio.c). */
+static bool
+keys_read(unsigned k, uint8_t off, uint8_t *v)
+{
+	uint32_t status;
+
+	if (!keys_obs[k]) {
+		return false;
+	}
+	keys_wr(keys_obs[k], 0, (1u << 27) | ((uint32_t)off << 4));
+	for (unsigned i = 0; i < 1000; i++) {
+		status = keys_rd(keys_obs[k], 8);
+		if (status & 1u) {
+			if (status & 0xeu) {
+				return false;
+			}
+			*v = (uint8_t)keys_rd(keys_obs[k], 0x18);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+keys_enabled_input(uint8_t subtype, uint8_t mode)
+{
+	/* GPIO subtypes 0x10..0x13 encode the direction in mode bits1:0,
+	 * the others in bits6:4; 0 (and 2) are inputs. sweet_keys.c agrees. */
+	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+	    mode & 3u : (mode >> 4) & 7u;
+	return dir == 0u || dir == 2u;
+}
+
+/* Map the observer channel of each key's peripheral and confirm it is a
+ * readable enabled input. Configuration is only ever reported, not repaired. */
+static bool
+keys_discover(void)
+{
+	uint32_t version;
+	bool any = false;
+
+	keys_core = ml_io_map(KEYS_CORE_PA, 0x1000);
+	if (!keys_core) {
+		return false;
+	}
+	version = keys_rd(keys_core, 0);
+	printf("LILAC KEYS: SPMI arb=%08x EE=0\n", version);
+	if (version < 0x20010000u || version >= 0x50000000u) {
+		printf("LILAC KEYS: FAIL unsupported SPMI version; no reads\n");
+		return false;
+	}
+	for (unsigned k = 0; k < KEYS_N; k++) {
+		uint8_t rt = 0, mode = 0, en = 0, sub = 0;
+		bool cfg;
+
+		for (unsigned apid = 0; apid < 512; apid++) {
+			uint32_t map = keys_rd(keys_core, 0x800 + 4 * apid);
+			if (map && ((map >> 8) & 0xfffu) == key_ppid[k]) {
+				keys_obs[k] = ml_io_map(KEYS_OBS_PA + 0x8000ull * apid, 0x1000);
+				break;
+			}
+		}
+		if (!keys_read(k, KEYS_PON_RT, &rt)) {
+			printf("LILAC KEYS: FAIL %s RT_STS unreadable\n", key_name[k]);
+			keys_obs[k] = 0;
+			continue;
+		}
+		if (k == 0) {
+			printf("LILAC KEYS: %s PON rt=%02x\n", key_name[k], rt);
+			any = true;
+			continue;
+		}
+		cfg = keys_read(k, 0x40, &mode) && keys_read(k, 0x46, &en) &&
+		    keys_read(k, 5, &sub);
+		printf("LILAC KEYS: %s GPIO%u rt=%02x mode=%02x en=%02x subtype=%02x\n",
+		    key_name[k], k + 4, rt, mode, en, sub);
+		if (!cfg || !(en & 0x80u) || !keys_enabled_input(sub, mode)) {
+			printf("LILAC KEYS: FAIL %s not an enabled input; PMIC unchanged\n",
+			    key_name[k]);
+			keys_obs[k] = 0;
+			continue;
+		}
+		any = true;
+	}
+	return any;
+}
+
+static void
+keys_emit(unsigned k, bool down)
+{
+	int hid = k < KEYS_N ? key_hid[k] : -1;
+
+	if (hid < 0) {
+		printf("LILAC KEY %s %s (log-only)\n", key_name[k], down ? "down" : "up");
+		return;
+	}
+	if (!down && !key_down_sent[k]) {
+		/* The key was already down when polling started; keep the event
+		 * stream paired instead of emitting an orphan release. */
+		printf("LILAC KEY %s up (no event; down predates start)\n", key_name[k]);
+		return;
+	}
+	key_down_sent[k] = down;
+	printf("LILAC KEY %s %s -> sweet_hid_key(%d,%d)\n",
+	    key_name[k], down ? "down" : "up", hid, down ? 1 : 0);
+	sweet_hid_key(hid, down ? 1 : 0);
+}
+
+/* A new state needs two equal consecutive samples (one glitch at 50 ms is
+ * rejected); the baseline is adopted silently. */
+static void
+keys_sample(unsigned k, bool down)
+{
+	if (down != key_last[k]) {
+		key_last[k] = down;
+		return;
+	}
+	if (!key_stable_ready[k]) {
+		key_stable_ready[k] = true;
+		key_stable[k] = down;
+		return;
+	}
+	if (down == key_stable[k]) {
+		return;
+	}
+	key_stable[k] = down;
+	keys_emit(k, down);
+}
+
+/* One poll cycle over all live sources. */
+static void
+keys_poll(void)
+{
+	for (unsigned k = 0; k < KEYS_N; k++) {
+		uint8_t rt = 0;
+		bool down;
+
+		if (!keys_read(k, KEYS_PON_RT, &rt)) {
+			if (keys_obs[k] && (++key_errors[k] == 1u ||
+			    key_errors[k] % 250u == 0u)) {
+				printf("LILAC KEYS: FAIL %s read error #%u; state retained\n",
+				    key_name[k], key_errors[k]);
+			}
+			continue;
+		}
+		down = k == 0 ? (rt & 1u) != 0 : (rt & 1u) == 0;
+		keys_sample(k, down);
+		if (k == 0) {
+			/* PON RESIN bit1 mirrors volume-up on yoshino (KEY_VOLUMEUP);
+			 * correlation only: volume-up events come from GPIO6. */
+			keys_sample(KEYS_N, (rt & 2u) != 0);
+		}
+	}
+}
+
+/* Kernel-thread glue below; host tests stop here. */
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	uint64_t deadline;
+
+	(void)arg;
+	(void)result;
+	for (;;) {
+		keys_poll();
+		clock_interval_to_deadline(KEYS_POLL_MS, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void
+lilac_keys_start(void)
+{
+	kern_return_t kr;
+	thread_t thread;
+
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	int enabled = 1;
+	(void)PE_parse_boot_argn("lilackeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("LILAC KEYS: disabled (lilackeys=0)\n");
+		return;
+	}
+	if (!keys_discover()) {
+		printf("LILAC KEYS: FAIL no readable keys; polling not started\n");
+		return;
+	}
+	kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr != KERN_SUCCESS) {
+		printf("LILAC KEYS: FAIL kernel_thread_start %d\n", kr);
+		return;
+	}
+	thread_deallocate(thread);
+	printf("LILAC KEYS: polling 20 Hz debounce=2 HID=power,vol+/- camera/focus log-only"
+	    " (lilackeys=0 disables)\n");
+}
+#endif /* ARM64_BOARD_CONFIG_LILAC */
diff --git a/bsd/dev/lilac_sd.c b/bsd/dev/lilac_sd.c
new file mode 100644
index 0000000..be3e796
--- /dev/null
+++ b/bsd/dev/lilac_sd.c
@@ -0,0 +1,1618 @@
+/*
+ * LILAC microSD (MSM8998 SDHC2): ADMA2 strategy I/O, PIO probe/log/fallback.
+ *
+ * Hardware (mainline msm8998.dtsi sdhc2, qcom,sdhci-msm-v4): standard SDHCI
+ * registers at 0x0c0a4900, MSM core registers at 0x0c0a4000. No SMMU.
+ * UEFI SdccDxe leaves the card selected in transfer state, 4-bit bus, clocks
+ * running and interrupt signals off (G17-SDP register dump), so this code
+ * reuses that state: it never touches clocks, power, bus width or the card's
+ * identification. Probes and the SD log use PIO; sdroot0 strategy uses ADMA2
+ * unless sddma=0 or unavailable. Only the guarded paths below may write.
+ *
+ * Probe (bsd_init, only when lilac_stop is 65, 66 or 67):
+ *   65: read LBA 0          expect nibble 0xF
+ *   66: read LBA 2048       FAT32 boot sector: nibble from its bytes (see EXPERIMENTS.md G17)
+ *   67: read LBA 0x8000000  past the end of the card: expect nibble 0x0
+ * nibble bit0 = CMD17 completed without error, bit1 = 0x55AA signature,
+ * bit2 = partition 1 type 0x0C (FAT32 LBA), bit3 = partition 1 starts at 2048.
+ *
+ * Step 2: read-only BSD disk sdroot0 / rsdroot0 over one MBR partition of the
+ * card (boot-arg sdpart=N, 1-4, default 2; it must have type 0xAF, Apple HFS),
+ * so rd=sdroot0 roots on it (IOFindBSDRoot, iokit/bsddev/IOKitBSDInit.cpp).
+ * Without boot-arg sdrw=1 there is no write path: opens for writing and write
+ * requests fail with EROFS. With sdrw=1 the partition must also not overlap
+ * LBA 0 or any other MBR entry; strategy writes use CMD25/CMD24 ADMA2 with
+ * PIO CMD24 fallback (synchronous: wait for card busy to end) and may only hit
+ * LBAs inside that partition (sd_lba_writable). Stage 84 (lilac_stop=84,
+ * sdrw=1) is a write self-check on the partition's last block, see
+ * lilac_sd_write_check().
+ * Stage 68 reports the setup: bit0 MBR read, bit1 0x55AA, bit2 partition type
+ * 0xAF with a non-empty extent, bit3 device nodes created.
+ */
+#if defined(ARM64_BOARD_CONFIG_LILAC)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <sys/kernel.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/debug.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+#include <libkern/crc.h>
+#include <arm64/sweet_early.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include "lilac_sd_adma.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);   /* as bsd/dev/sweet_ufs.c */
+
+#define SD_MAP_PA       0x0c0a4000ULL   /* MSM core; SDHCI at +0x900 */
+#define SD_MAP_SIZE     0x1000
+#define SD_HC           0x900
+
+/* SDHCI standard registers (offsets from SD_HC) */
+#define HC_BLKSZ_CNT    0x04            /* [15:0] block size, [31:16] block count */
+#define HC_ARG          0x08
+#define HC_XFER_CMD     0x0C            /* [15:0] transfer mode, [31:16] command */
+#define HC_RESP0        0x10
+#define HC_BUFFER       0x20
+#define HC_PRESENT      0x24
+#define HC_RESET        0x2C            /* byte 3 (0x2F): software reset */
+#define HC_INT_STATUS   0x30            /* [15:0] normal, [31:16] error */
+#define HC_INT_ENABLE   0x34            /* status enables (latching), not IRQ signals */
+#define INT_ENABLE_UEFI 0x07FF803Fu     /* value UEFI SdccDxe leaves (G17-SDP) */
+#define R1_ERRORS       0xFDF90008u     /* R1 card-status error bits */
+
+#define PS_CMD_INHIBIT  (1u << 0)
+#define PS_DAT_INHIBIT  (1u << 1)
+
+#define INT_CMD_DONE    (1u << 0)
+#define INT_XFER_DONE   (1u << 1)
+#define INT_BUF_WR      (1u << 4)
+#define INT_BUF_RD      (1u << 5)
+#define PS_WRITABLE     (1u << 19)      /* write-protect pin: 1 = writable */
+#define PS_DAT0         (1u << 20)      /* DAT[0] level; low while the card is busy programming */
+#define INT_ERROR       (1u << 15)
+#define INT_ERR_MASK    0xFFFF0000u
+
+#define XFER_BLKCNT_EN  (1u << 1)
+#define XFER_READ       (1u << 4)
+#define XFER_MULTI      (1u << 5)
+#define CMD_RESP48      0x02
+#define CMD_RESP48_BUSY 0x03
+#define CMD_TYPE_ABORT  (3u << 6)
+#define CMD_CRC_CHECK   (1u << 3)
+#define CMD_IDX_CHECK   (1u << 4)
+#define CMD_DATA        (1u << 5)
+
+#define RESET_CMD       (1u << 25)      /* bits of the 32-bit word at 0x2C */
+#define RESET_DAT       (1u << 26)
+
+#define SD_BLOCK        512u
+#define SD_MULTI_MAX    128u            /* blocks per CMD18 (64 KiB) */
+
+/* Register encodings: Linux 4.14 drivers/mmc/host/sdhci.h:35-45,83-89,
+ * 122-123,211-219,254-259,276-283. Byte accesses preserve power/clock state.
+ */
+#define HC_CONTROL      0x28
+#define HC_CAPS         0x40
+#define HC_ADMA_ERROR   0x54
+#define HC_ADMA_LO      0x58
+#define HC_ADMA_HI      0x5c
+#define HC_VERSION      0xfe
+#define CAP_ADMA2       (1u << 19)
+#define CAP_64BIT       (1u << 28)
+#define CTRL_DMA_MASK   0x18u
+#define CTRL_ADMA32     0x10u
+#define CTRL_ADMA64     0x18u
+#define XFER_DMA        1u
+#define XFER_AUTO12     (1u << 2)
+#define R1_ILLEGAL_CMD  (1u << 22)
+#define SD_DMA_BYTES    (SD_MULTI_MAX * SD_BLOCK)
+#define SD_DMA_NAP_US   150
+
+static vm_offset_t sd_regs;
+static bool sd_dma_fatal; /* failed line reset: no subsequent controller command */
+static struct {
+	vm_offset_t mem;
+	uint64_t pa;
+	bool initialized, enabled, wide, writes, verified, cmd25;
+} sda;
+
+static void sd_dma_init(void);
+static int sd_dma_hw(bool rd, uint32_t first, uint32_t count,
+    uint32_t lba, uint32_t n, uint8_t *buf, uint32_t *stp);
+static int sd_strategy_transfer(bool rd, uint32_t lba, uint32_t n, uint8_t *buf,
+    bool *used_dma, bool *used_pio);
+
+static void
+sd_map(void)
+{
+	if (!sd_regs) {
+		sd_regs = ml_io_map(SD_MAP_PA, SD_MAP_SIZE);
+	}
+}
+
+static inline uint32_t
+sd_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sd_regs + SD_HC + off);
+}
+
+static inline void
+sd_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(sd_regs + SD_HC + off) = v;
+}
+
+static uint64_t
+sd_deadline(uint32_t usec)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)usec * 1000, &abs);
+	return mach_absolute_time() + abs;
+}
+
+/*
+ * Polling without holding the CPU. The controller is driven without
+ * interrupts, and a card programming a CMD24 block or fetching a CMD17/18
+ * block keeps the caller waiting for hundreds of microseconds to
+ * milliseconds; spinning through that charged the whole wait to the caller
+ * and starved everything else on the single CPU (G29-HB: logd_helper spent
+ * ~90 s of system time in sd_write_block_hw's XFER_DONE wait). After
+ * SD_SPIN_US of polling, a caller that may block sleeps SD_NAP_US between
+ * polls: delay() blocks the thread when interrupts and preemption are
+ * enabled and spins otherwise, so the reset-time log flush (interrupts may be
+ * masked) and panic keep polling.
+ */
+#define SD_SPIN_US      20u
+#define SD_NAP_US       50u
+
+/*
+ * Data-phase waits (command response, next PIO buffer of a transfer the card is
+ * already streaming) spin up to SD_DATA_SPIN_US before napping: at ~5.8 MB/s a 512-byte block arrives every
+ * ~90 us, and a nap per block (block, idle, timer IRQ, wake) left the single CPU
+ * ~85% idle while HFS reads crawled (G30m2 t+120-420 s, pid 91 in sd_read_blocks).
+ * Card-busy waits (write programming, XFER_DONE) keep the short SD_SPIN_US.
+ */
+#define SD_DATA_SPIN_US 500u
+
+/* Per-report-interval I/O statistics, printed by lilac_sd_report() (lilac_hb.c). */
+#define SDS_PIDS        6u
+static struct {
+	uint32_t rd_req, rd_blk, wr_req, wr_blk;
+	uint64_t rd_abs, wr_abs, max_abs;
+	uint32_t dma, pio, err; /* strategy requests; fallback counts in both */
+	uint32_t naps;
+	uint64_t nap_abs;
+	struct { int32_t pid; uint32_t blk; char name[17]; } top[SDS_PIDS];
+} sds;
+
+static void
+sd_poll_pause(uint64_t spin_end)
+{
+	if (mach_absolute_time() > spin_end && !panic_active()) {
+		uint64_t t0 = mach_absolute_time();
+		delay(SD_NAP_US);
+		os_atomic_inc(&sds.naps, relaxed);
+		os_atomic_add(&sds.nap_abs, mach_absolute_time() - t0, relaxed);
+	}
+}
+
+/* One sdroot0 strategy request of nblk blocks that took abs (lilac_sd_lock held). */
+static void
+sd_stat_request(bool rd, uint32_t nblk, uint64_t abs)
+{
+	if (rd) {
+		sds.rd_req++;
+		sds.rd_blk += nblk;
+		sds.rd_abs += abs;
+	} else {
+		sds.wr_req++;
+		sds.wr_blk += nblk;
+		sds.wr_abs += abs;
+	}
+	if (abs > sds.max_abs) {
+		sds.max_abs = abs;
+	}
+	int32_t pid = proc_selfpid();
+	uint32_t slot = SDS_PIDS;
+	for (uint32_t i = 0; i < SDS_PIDS; i++) {
+		if (sds.top[i].blk != 0 && sds.top[i].pid == pid) {
+			slot = i;
+			break;
+		}
+		if (slot == SDS_PIDS && sds.top[i].blk == 0) {
+			slot = i;
+		}
+	}
+	if (slot == SDS_PIDS) {
+		return;
+	}
+	if (sds.top[slot].blk == 0) {
+		sds.top[slot].pid = pid;
+		proc_selfname(sds.top[slot].name, sizeof(sds.top[slot].name));
+	}
+	sds.top[slot].blk += nblk;
+}
+
+static uint32_t
+sd_abs_ms(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return (uint32_t)(ns / NSEC_PER_MSEC);
+}
+
+static int sd_wait_int_spin(uint32_t want, uint32_t usec, uint32_t spin_us, uint32_t *status);
+
+/* Wait until any bit of want is set in the interrupt status, or an error. */
+static int
+sd_wait_int(uint32_t want, uint32_t usec, uint32_t *status)
+{
+	return sd_wait_int_spin(want, usec,
+	           (want & (INT_CMD_DONE | INT_BUF_RD | INT_BUF_WR)) ? SD_DATA_SPIN_US : SD_SPIN_US, status);
+}
+
+static int
+sd_wait_int_spin(uint32_t want, uint32_t usec, uint32_t spin_us, uint32_t *status)
+{
+	uint64_t end = sd_deadline(usec), spin_end = sd_deadline(spin_us);
+	for (;;) {
+		uint32_t s = sd_rd(HC_INT_STATUS);
+		if (s & (INT_ERROR | INT_ERR_MASK)) {
+			*status = s;
+			return EIO;
+		}
+		if (s & want) {
+			*status = s;
+			return 0;
+		}
+		if (mach_absolute_time() > end) {
+			*status = s;
+			return ETIMEDOUT;
+		}
+		sd_poll_pause(spin_end);
+	}
+}
+
+/* Wait until none of the HC_PRESENT bits in mask is set. */
+static int
+sd_wait_present_clear(uint32_t mask, uint32_t usec)
+{
+	if (sd_dma_fatal) {
+		return EIO;
+	}
+	uint64_t end = sd_deadline(usec), spin_end = sd_deadline(SD_SPIN_US);
+	while (sd_rd(HC_PRESENT) & mask) {
+		if (mach_absolute_time() > end) {
+			return EBUSY;
+		}
+		sd_poll_pause(spin_end);
+	}
+	return 0;
+}
+
+/* Software reset of the CMD and DAT state machines after an error (card state untouched). */
+static bool
+sd_reset_lines(void)
+{
+	/* Write ONLY reset CMD/DAT, never echo a full-reset bit or clock bits. */
+	volatile uint8_t *reset = (volatile uint8_t *)(sd_regs + SD_HC + HC_RESET + 3);
+	*reset = 6;
+	uint64_t end = sd_deadline(100000);
+	while ((*reset & 6) && mach_absolute_time() < end) {
+	}
+	bool ok = (*reset & 6) == 0;
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	return ok;
+}
+
+/* CMD17 for one 512-byte block (SDHC/SDXC block addressing), polled PIO. */
+static int
+sd_read_block_hw(uint32_t lba, uint8_t *buf, uint32_t *stp)
+{
+	uint32_t st = 0;
+	*stp = 0;
+	if (sd_wait_present_clear(PS_CMD_INHIBIT | PS_DAT_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	if ((sd_rd(HC_INT_ENABLE) & (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_RD)) != (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_RD)) {
+		sd_wr(HC_INT_ENABLE, INT_ENABLE_UEFI);
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_BLKSZ_CNT, (1u << 16) | SD_BLOCK);
+	sd_wr(HC_ARG, lba);
+	sd_wr(HC_XFER_CMD, ((17u << 8 | CMD_DATA | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48) << 16) | XFER_READ);
+
+	int error = sd_wait_int(INT_CMD_DONE, 100000, &st);
+	if (!error && (sd_rd(HC_RESP0) & R1_ERRORS)) {
+		st = sd_rd(HC_RESP0);
+		error = ERANGE;
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_CMD_DONE);
+		error = sd_wait_int(INT_BUF_RD, 500000, &st);
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_BUF_RD);
+		for (uint32_t i = 0; i < SD_BLOCK; i += 4) {
+			uint32_t w = sd_rd(HC_BUFFER);
+			buf[i] = (uint8_t)w;
+			buf[i + 1] = (uint8_t)(w >> 8);
+			buf[i + 2] = (uint8_t)(w >> 16);
+			buf[i + 3] = (uint8_t)(w >> 24);
+		}
+		error = sd_wait_int(INT_XFER_DONE, 500000, &st);
+	}
+	if (error) {
+		*stp = st;
+		sd_reset_lines();
+		return error;
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	return 0;
+}
+
+/*
+ * CMD12 STOP_TRANSMISSION (R1b), as UEFI SdccDxe ends its multi-block reads on
+ * this controller (G17-SDP: last command CMD12). Returns 0 once the card has
+ * released DAT0.
+ */
+static int
+sd_stop_transmission(uint32_t *stp)
+{
+	if (sd_wait_present_clear(PS_CMD_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_ARG, 0);
+	sd_wr(HC_XFER_CMD, (12u << 8 | CMD_TYPE_ABORT | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48_BUSY) << 16);
+	int error = sd_wait_int(INT_CMD_DONE, 100000, stp);
+	if (!error) {
+		/* R1b: transfer complete marks the end of the busy signal. */
+		error = sd_wait_int(INT_XFER_DONE, 1000000, stp);
+	}
+	return error;
+}
+
+/*
+ * CMD18 for n (2..SD_MULTI_MAX) consecutive 512-byte blocks, polled PIO, then
+ * an explicit CMD12. Read-only: no write command can be issued from here.
+ */
+static int
+sd_read_multi_hw(uint32_t lba, uint32_t n, uint8_t *buf, uint32_t *stp)
+{
+	uint32_t st = 0;
+	*stp = 0;
+	if (n < 2 || n > SD_MULTI_MAX) {
+		return EINVAL;
+	}
+	if (sd_wait_present_clear(PS_CMD_INHIBIT | PS_DAT_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	if ((sd_rd(HC_INT_ENABLE) & (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_RD)) != (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_RD)) {
+		sd_wr(HC_INT_ENABLE, INT_ENABLE_UEFI);
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_BLKSZ_CNT, (n << 16) | SD_BLOCK);
+	sd_wr(HC_ARG, lba);
+	sd_wr(HC_XFER_CMD, ((18u << 8 | CMD_DATA | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48) << 16) |
+	    XFER_MULTI | XFER_READ | XFER_BLKCNT_EN);
+
+	int error = sd_wait_int(INT_CMD_DONE, 100000, &st);
+	if (!error && (sd_rd(HC_RESP0) & R1_ERRORS)) {
+		st = sd_rd(HC_RESP0);
+		error = ERANGE;
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_CMD_DONE);
+	}
+	for (uint32_t b = 0; !error && b < n; b++) {
+		error = sd_wait_int(INT_BUF_RD, 500000, &st);
+		if (error) {
+			break;
+		}
+		sd_wr(HC_INT_STATUS, INT_BUF_RD);
+		uint8_t *p = buf + b * SD_BLOCK;
+		for (uint32_t i = 0; i < SD_BLOCK; i += 4) {
+			uint32_t w = sd_rd(HC_BUFFER);
+			p[i] = (uint8_t)w;
+			p[i + 1] = (uint8_t)(w >> 8);
+			p[i + 2] = (uint8_t)(w >> 16);
+			p[i + 3] = (uint8_t)(w >> 24);
+		}
+	}
+	if (!error) {
+		error = sd_wait_int(INT_XFER_DONE, 500000, &st);
+	}
+	/* Always end the open-ended read, also after an error, so the card returns to tran. */
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	uint32_t st12 = 0;
+	int stop = sd_stop_transmission(&st12);
+	if (error || stop) {
+		*stp = error ? st : st12;
+		sd_reset_lines();
+		return error ? error : stop;
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	return 0;
+}
+
+/*
+ * One controller transaction at a time. Interrupts stay enabled (a polled
+ * transfer can take far longer than the 35 ms interrupt-masked limit of
+ * DEVELOPMENT kernels), so a transaction can be preempted. Thread-context
+ * callers wait for the controller, sleeping between attempts; the reset-time
+ * log flush, which may run in a panic or with interrupts masked, only tries
+ * once and skips its flush if a transaction is in progress.
+ */
+static uint32_t _Atomic sd_busy;
+
+static bool
+sd_claim(bool wait)
+{
+	while (!os_atomic_cmpxchg(&sd_busy, 0u, 1u, acquire)) {
+		if (!wait) {
+			return false;
+		}
+		delay(100);
+	}
+	return true;
+}
+
+static void
+sd_release(void)
+{
+	os_atomic_store(&sd_busy, 0u, release);
+}
+
+static int
+sd_read_block(uint32_t lba, uint8_t *buf)
+{
+	uint32_t st;
+	(void)sd_claim(true);
+	int error = sd_read_block_hw(lba, buf, &st);
+	sd_release();
+	if (error) {
+		printf("LILAC SD: CMD17 lba 0x%x failed %d, int 0x%08x\n", lba, error, st);
+	}
+	return error;
+}
+
+/* n consecutive blocks; CMD18 for runs of 2+, CMD17 for a single block. */
+static int
+sd_read_blocks(uint32_t lba, uint32_t n, uint8_t *buf)
+{
+	uint32_t st;
+	int error = 0;
+	while (n && !error) {
+		uint32_t k = MIN(n, SD_MULTI_MAX);
+		(void)sd_claim(true);
+		error = (k == 1) ? sd_read_block_hw(lba, buf, &st) : sd_read_multi_hw(lba, k, buf, &st);
+		sd_release();
+		if (error) {
+			printf("LILAC SD: CMD%u lba 0x%x n %u failed %d, int 0x%08x\n", k == 1 ? 17 : 18, lba, k, error, st);
+		}
+		lba += k;
+		buf += k * SD_BLOCK;
+		n -= k;
+	}
+	return error;
+}
+
+/*
+ * Stage 69: CMD18 self-check on the first 4 MiB of MBR partition 2 (the
+ * G15 getpid.hfs image, CRC32 0x794a64d2). bit0 all CMD18 reads succeeded,
+ * bit1 CRC32 matches, bit2 the first 64 KiB equal CMD17 reads of the same
+ * blocks, bit3 CMD18 at least 4x faster than CMD17 over those 64 KiB.
+ */
+#define SD69_BYTES      (4u << 20)
+#define SD69_CRC        0x794a64d2u
+
+static void
+lilac_sd_multi_check(void)
+{
+	static uint8_t chunk[SD_MULTI_MAX * SD_BLOCK], single[SD_MULTI_MAX * SD_BLOCK];
+	unsigned int nib = 0;
+	uint32_t crc = 0, first, p2_count;
+	uint64_t t0, t1, t2, multi_ns = 0, single_ns = 0;
+	bool ok = true;
+
+	sd_map();
+	if (sd_read_blocks(0, 1, chunk) || chunk[510] != 0x55 || chunk[511] != 0xAA || chunk[446 + 16 + 4] != 0xAF) {
+		lilac_report(69, 0);
+		return;
+	}
+	first = chunk[446 + 16 + 8] | chunk[446 + 16 + 9] << 8 | chunk[446 + 16 + 10] << 16 | (uint32_t)chunk[446 + 16 + 11] << 24;
+	p2_count = chunk[474] | chunk[475] << 8 | chunk[476] << 16 | (uint32_t)chunk[477] << 24;
+	if (!sd_adma_range(first, p2_count, first, SD69_BYTES / SD_BLOCK)) {
+		lilac_report(69, 0);
+		return;
+	}
+	t0 = mach_absolute_time();
+	for (uint32_t off = 0; off < SD69_BYTES && ok; off += sizeof(chunk)) {
+		ok = sd_read_blocks(first + off / SD_BLOCK, SD_MULTI_MAX, chunk) == 0;
+		if (ok) {
+			crc = crc32(crc, chunk, sizeof(chunk));
+		}
+	}
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &multi_ns);
+	if (ok) {
+		nib |= 1;
+		if (crc == SD69_CRC) {
+			nib |= 2;
+		}
+		/* Same 64 KiB both ways. */
+		t0 = mach_absolute_time();
+		ok = sd_read_blocks(first, SD_MULTI_MAX, chunk) == 0;
+		t1 = mach_absolute_time();
+		for (uint32_t b = 0; ok && b < SD_MULTI_MAX; b++) {
+			ok = sd_read_blocks(first + b, 1, single + b * SD_BLOCK) == 0;
+		}
+		t2 = mach_absolute_time();
+		uint64_t m64 = 0;
+		absolutetime_to_nanoseconds(t1 - t0, &m64);
+		absolutetime_to_nanoseconds(t2 - t1, &single_ns);
+		if (ok && memcmp(chunk, single, sizeof(chunk)) == 0) {
+			nib |= 4;
+		}
+		if (ok && m64 * 4 <= single_ns) {
+			nib |= 8;
+		}
+		printf("LILAC SD: CMD18 check: 4 MiB in %llu us (%llu KiB/s), crc32 0x%08x; 64 KiB: CMD18 %llu us, CMD17 %llu us\n",
+		    multi_ns / 1000, multi_ns ? (4096ull * 1000000000ull) / multi_ns : 0, crc, m64 / 1000, single_ns / 1000);
+	}
+	printf("LILAC SD: CMD18 check nibble 0x%x\n", nib);
+	sd_dma_init();
+	if (sda.enabled) {
+		uint32_t dma_crc = 0, st = 0;
+		bool dma_ok = (nib & 1) && sd_adma_range(first, p2_count, first, SD69_BYTES / SD_BLOCK);
+		t0 = mach_absolute_time();
+		for (uint32_t off = 0; dma_ok && off < SD69_BYTES; off += sizeof(chunk)) {
+			(void)sd_claim(true);
+			dma_ok = sd_dma_hw(true, first, p2_count, first + off / SD_BLOCK,
+			    SD_MULTI_MAX, chunk, &st) == 0;
+			sd_release();
+			if (dma_ok) {
+				dma_crc = crc32(dma_crc, chunk, sizeof(chunk));
+			}
+		}
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		bool match = dma_ok && dma_crc == crc;
+		printf("LILAC SD: DMA check: 4 MiB in %llu us (%llu KiB/s) crc 0x%08x pio crc 0x%08x %s\n",
+		    ns / 1000, ns ? 4096ull * NSEC_PER_SEC / ns : 0, dma_crc, crc, match ? "match" : "MISMATCH");
+		if (!match) {
+			sda.enabled = sda.writes = false;
+			printf("LILAC SD: DMA disabled for this boot (check failed)\n");
+		}
+	}
+	lilac_report(69, nib);
+}
+
+void lilac_sd_probe(void);
+
+void
+lilac_sd_probe(void)
+{
+	static const struct {
+		unsigned int stage;
+		uint32_t lba;
+	} t[] = { { 65, 0 }, { 66, 2048 }, { 67, 0x8000000 } };
+	static uint8_t blk[SD_BLOCK];
+
+	if (lilac_stop_is(69)) {
+		lilac_sd_multi_check();
+	}
+	for (unsigned int i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+		if (!lilac_stop_is(t[i].stage)) {
+			continue;
+		}
+		sd_map();
+		unsigned int nib = 0;
+		if (sd_read_block(t[i].lba, blk) == 0) {
+			nib |= 1;
+			if (blk[510] == 0x55 && blk[511] == 0xAA) {
+				nib |= 2;
+			}
+			if (blk[446 + 4] == 0x0C) {
+				nib |= 4;
+			}
+			if ((blk[446 + 8] | blk[446 + 9] << 8 | blk[446 + 10] << 16 | (uint32_t)blk[446 + 11] << 24) == 2048) {
+				nib |= 8;
+			}
+		}
+		printf("LILAC SD: probe stage %u lba 0x%x nibble 0x%x\n", t[i].stage, t[i].lba, nib);
+		lilac_report(t[i].stage, nib);
+	}
+}
+
+/* ---- step 2: read-only BSD disk over one MBR partition ---- */
+
+static LCK_GRP_DECLARE(lilac_sd_grp, "lilac_sd");
+static LCK_MTX_DECLARE(lilac_sd_lock, &lilac_sd_grp);
+
+static struct {
+	bool     ready;
+	bool     writable;      /* sdrw=1 and the partition passed the overlap check */
+	uint32_t first;         /* partition start, card LBA (512-byte blocks) */
+	uint32_t nblocks;       /* partition length in 512-byte blocks */
+	uint32_t secsize;       /* logical sector size presented to BSD */
+	int      bmajor, cmajor;
+	dev_t    bdev;
+	uint8_t  bounce[SD_MULTI_MAX * SD_BLOCK];
+} sdd;
+
+static int
+lilac_sd_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!sdd.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !sdd.writable) ? EROFS : 0;
+}
+
