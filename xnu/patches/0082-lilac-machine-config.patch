diff --git a/osfmk/arm64/lilac_diag.c b/osfmk/arm64/lilac_diag.c
new file mode 100644
index 0000000..4301927
--- /dev/null
+++ b/osfmk/arm64/lilac_diag.c
@@ -0,0 +1,329 @@
+/*
+ * LILAC (Sony Xperia XZ1 Compact, MSM8998) boot-progress channel.
+ *
+ * The board has no usable serial port and the command-mode panel does not show
+ * post-ExitBootServices framebuffer writes, so progress is encoded in the time
+ * until a PSCI SYSTEM_RESET returns the phone to Android:
+ *   lilac_stop=N  reaching stage N resets after LILAC_STOP_SECS (20 s)
+ *   early vectors start.s LOW_VECTOR_TRAP resets after 45 s (no stack)
+ *   panic / halt  resets after LILAC_FATAL_BASE + LILAC_FATAL_STEP * last stage
+ *   probes        lilac_event(N) stops at N without changing last_stage:
+ *                 33 any IRQ, 34 ICC_SRE set, 35 vtimer armed, 36 GICD RWP done,
+ *                 37 vtimer asserted >1 s with no IRQ pending at the CPU
+ *   idle hang     lilac_idle_wait() replaces WFI; once LILAC_HANG_SECS have passed
+ *                 since lilac_diag_init it resets after LILAC_HANG_STEP * last stage
+ *                 (a kernel blocked with no wakeup source recovers by itself)
+ *   watchdog      lilac_wd_word (stage | LILAC_WD_FATAL | LILAC_WD_IDLE) is cleaned to
+ *                 PoC on every change. The G8 loader finds it by symbol and leaves a
+ *                 secondary CPU polling it MMU-off. Once the word has been unchanged
+ *                 for 30 s with neither flag set, that CPU resets at jump + 60 s + 6 s *
+ *                 stage, so busy or interrupts-masked hangs recover too (stage 22: 192 s,
+ *                 52: 372 s; below the panic delay 90 + 15 * stage >= 420 s for stage >= 22).
+ *                 A set flag defers to the paths above; the loader caps the run at 1000 s.
+ *                 Bits 32-63 carry a beat counter (the stub uses only bits 0-17 for the
+ *                 stage and flags): lilac_heartbeat(), called each second by a kernel thread
+ *                 (lilac_hb.c), changes the word, so the stub fires only when that thread
+ *                 can no longer run (deadlocked with interrupts or preemption off, or
+ *                 starved). The idle-hang budget above is unchanged and still ends a live
+ *                 run with an SD log flush. Beats stop once any reset delay has started.
+ *   stages 39-52  finer marks between kernel_bootstrap (22) and bsd_init (24), startup.c
+ *   stages 53-61  after PE_lockdown_iokit: pe_init.c, startup.c, SweetCPU.cpp
+ *   stages 70-74  pe_init_fiq GIC/timer probes (lilac_report): only when lilac_stop selects
+ *                 them; reset after 20 + 4 * nibble s, so one run returns 4 bits
+ *   stage 62      transient: published while cpu_idle spins in wfe_to_deadline_or_interrupt
+ *                 (proximate-timer path, which bypasses lilac_idle_wait); restored on exit
+ * The steps exceed the ~9 s jitter of the UEFI-to-adb path seen in G1-G3.
+ * No allocation, locks or per-CPU state: usable from arm_init entry on.
+ *
+ * SMP (cpus=N > 1, SMP phase 1):
+ *   - Only the boot CPU (MPIDR Aff2-0 == 0, which SweetCPU::startAll requires to be
+ *     logical CPU 0) runs the idle publish, the probes and the hang deadline in
+ *     lilac_idle_wait and the stage-62 WFE hooks; other CPUs idle with plain WFI.
+ *   - The first CPU to start a reset delay owns it (lilac_reset_claim); any other CPU
+ *     that reaches a reset path parks with IRQ/FIQ masked. After a claim only the owner
+ *     changes lilac_wd_word, so the watchdog sees the delay that will actually run.
+ *   - lilac_wd_word is updated with an LL/SC compare-exchange: the stage/flag half and the
+ *     beat half never tear, and LILAC_WD_FATAL, once set, is never cleared.
+ */
+#include <arm64/sweet_early.h>
+
+#if defined(LILAC)
+#include <stdint.h>
+
+#define LILAC_STOP_SECS         20u
+#define LILAC_FATAL_BASE        90u
+#define LILAC_FATAL_STEP        15u
+#define LILAC_HANG_SECS         600u
+#define LILAC_HANG_STEP         5u
+#define PSCI_SYSTEM_RESET       0x84000009ull
+#define ISR_EL1_IRQ_FIQ         0xC0ull
+
+static unsigned int lilac_stop_stage;   /* 0: no stop requested */
+static unsigned int lilac_last_stage;
+static uint64_t lilac_hang_deadline;    /* CNTVCT value; 0 before lilac_diag_init */
+
+#define LILAC_WD_FATAL          0x10000ull
+#define LILAC_WD_IDLE           0x20000ull
+/* Read by the loader's watchdog CPU with its MMU off: keep it alone in its cache line. */
+__attribute__((used, aligned(128))) volatile uint64_t lilac_wd_word;
+static volatile int lilac_wd_latched;
+/* 0: no reset delay running; else LILAC_OWNER_VALID | MPIDR Aff2-0 of the CPU running it. */
+static uint64_t lilac_reset_owner;
+#define LILAC_OWNER_VALID       (1ull << 63)
+
+static inline uint64_t
+lilac_mpidr_aff(void)
+{
+	return __builtin_arm_rsr64("MPIDR_EL1") & 0xffffffull;
+}
+
+/* The boot CPU: MPIDR 0 (/cpus/cpu0 "running", loader G2; checked by SweetCPU::startAll). */
+static inline int
+lilac_is_boot_cpu(void)
+{
+	return lilac_mpidr_aff() == 0;
+}
+
+/*
+ * Atomically replace the stage/flag half (beat = 0) or add one to the beat half (beat = 1)
+ * of lilac_wd_word. FATAL is sticky; once a reset delay is claimed only its owner writes.
+ */
+static void
+lilac_wd_update(uint64_t v, int beat)
+{
+	uint64_t owner = __atomic_load_n(&lilac_reset_owner, __ATOMIC_ACQUIRE);
+	if (owner != 0 && owner != (LILAC_OWNER_VALID | lilac_mpidr_aff())) {
+		return;
+	}
+	uint64_t old = __atomic_load_n(&lilac_wd_word, __ATOMIC_RELAXED), nv;
+	do {
+		if (old & LILAC_WD_FATAL) {
+			if (beat || !(v & LILAC_WD_FATAL)) {
+				return;
+			}
+		}
+		if (beat && lilac_wd_latched) {
+			return;
+		}
+		nv = beat ? old + (1ull << 32) : ((old & ~0xffffffffull) | (v & 0xffffffffull));
+	} while (!__atomic_compare_exchange_n(&lilac_wd_word, &old, nv, 1, __ATOMIC_RELEASE, __ATOMIC_RELAXED));
+	__asm__ volatile ("dc civac, %0\n\tdsb sy" :: "r"(&lilac_wd_word) : "memory");
+}
+
+static void
+lilac_wd_publish(uint64_t v)
+{
+	lilac_wd_update(v, 0);
+}
+
+static uint64_t
+lilac_counter(void)
+{
+	uint64_t v;
+	__asm__ volatile ("isb\n\tmrs %0, CNTVCT_EL0" : "=r"(v) :: "memory");
+	return v;
+}
+
+/* Run once at the start of a reset delay, inside it (lilac_sd.c SD log flush). */
+void (*volatile lilac_reset_hook)(uint32_t budget_secs);
+
+/*
+ * One reset delay per boot: the first CPU to get here owns it (re-entry on the owner CPU,
+ * e.g. a panic inside the hook, proceeds as on one CPU). Any other CPU parks for good with
+ * IRQ/FIQ masked, so the reset time encodes the first event only.
+ */
+static void
+lilac_reset_claim(void)
+{
+	uint64_t me = LILAC_OWNER_VALID | lilac_mpidr_aff(), expected = 0;
+	if (__atomic_compare_exchange_n(&lilac_reset_owner, &expected, me, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE) ||
+	    expected == me) {
+		return;
+	}
+	__asm__ volatile ("msr DAIFSet, #3" ::: "memory");
+	for (;;) {
+		__asm__ volatile ("wfe");
+	}
+}
+
+/* Returns only if PSCI SYSTEM_RESET returns. */
+static void
+lilac_reset_after(uint64_t secs)
+{
+	uint64_t freq;
+	lilac_reset_claim();
+	__asm__ volatile ("mrs %0, CNTFRQ_EL0" : "=r"(freq));
+	uint64_t end = lilac_counter() + secs * freq;
+	lilac_wd_latched = 1;
+	void (*hook)(uint32_t) = __atomic_exchange_n(&lilac_reset_hook, (void (*)(uint32_t))0, __ATOMIC_ACQ_REL);
+	if (hook != 0 && secs <= 4) {
+		lilac_reset_hook = hook;        /* not run: leave it for a later, longer delay (as before) */
+		hook = 0;
+	}
+	if (hook != 0) {
+		hook((uint32_t)secs - 4);
+	}
+	while (lilac_counter() < end) {
+		__asm__ volatile ("yield");
+	}
+	register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_RESET;
+	__asm__ volatile ("dsb sy\n\tsmc #0" : "+r"(x0) ::
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+	    "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+}
+
+void
+lilac_diag_init(const char *cmdline)
+{
+	static const char key[] = "lilac_stop=";
+	uint64_t freq;
+	__asm__ volatile ("mrs %0, CNTFRQ_EL0" : "=r"(freq));
+	lilac_hang_deadline = lilac_counter() + (uint64_t)LILAC_HANG_SECS * freq;
+	for (unsigned int i = 0; i < 608 && cmdline[i]; i++) {
+		if (i != 0 && cmdline[i - 1] != ' ') {
+			continue;
+		}
+		unsigned int k = 0;
+		while (key[k] && cmdline[i + k] == key[k]) {
+			k++;
+		}
+		if (key[k]) {
+			continue;
+		}
+		unsigned int n = 0;
+		for (unsigned int j = i + k; cmdline[j] >= '0' && cmdline[j] <= '9' && n < 1000; j++) {
+			n = n * 10 + (unsigned int)(cmdline[j] - '0');
+		}
+		lilac_stop_stage = n;
+	}
+}
+
+void
+lilac_mark(unsigned int stage)
+{
+	lilac_last_stage = stage;
+	lilac_wd_publish(stage);
+	if (stage == lilac_stop_stage) {
+		lilac_reset_after(LILAC_STOP_SECS);
+	}
+}
+
+int
+lilac_stop_is(unsigned int stage)
+{
+	return stage == lilac_stop_stage;
+}
+
+void
+lilac_report(unsigned int stage, unsigned int nibble)
+{
+	if (stage == lilac_stop_stage) {
+		lilac_reset_after(LILAC_STOP_SECS + 4u * (uint64_t)(nibble & 15u));
+	}
+}
+
+/* A probe that may stop the boot but does not change the recorded stage. */
+void
+lilac_event(unsigned int stage)
+{
+	if (stage == lilac_stop_stage) {
+		lilac_reset_after(LILAC_STOP_SECS);
+	}
+}
+
+/*
+ * Idle in place of WFI: return as soon as an IRQ or FIQ is pending (ISR_EL1
+ * reports it even while PSTATE masks it, which is what wakes WFI).
+ */
+static void
+lilac_idle_checks(void)
+{
+	static uint64_t fired_since;
+	{
+		uint64_t ctl = __builtin_arm_rsr64("CNTV_CTL_EL0");
+		if ((ctl & 3) == 1) {
+			lilac_event(35);        /* virtual timer enabled and unmasked */
+		}
+		if ((ctl & 7) == 5) {           /* ENABLE, !IMASK, ISTATUS: timer asserted */
+			uint64_t now = lilac_counter(), f;
+			__asm__ volatile ("mrs %0, CNTFRQ_EL0" : "=r"(f));
+			if (fired_since == 0) {
+				fired_since = now;
+			} else if (now - fired_since > f) {
+				lilac_event(37);        /* asserted >1 s, never reached the CPU: GIC routing */
+			}
+		} else {
+			fired_since = 0;
+		}
+		if (lilac_hang_deadline != 0 && lilac_counter() >= lilac_hang_deadline) {
+			lilac_reset_after(LILAC_HANG_STEP * (uint64_t)lilac_last_stage);
+		}
+	}
+}
+
+void
+lilac_idle_wait(void)
+{
+	if (!lilac_is_boot_cpu()) {
+		__builtin_arm_wfi();            /* secondary CPUs: the normal idle path (cpu_idle) */
+		return;
+	}
+	lilac_wd_publish(lilac_last_stage | LILAC_WD_IDLE);
+	while ((__builtin_arm_rsr64("ISR_EL1") & ISR_EL1_IRQ_FIQ) == 0) {
+		lilac_idle_checks();
+		__asm__ volatile ("yield");
+	}
+	lilac_wd_publish(lilac_last_stage);
+}
+
+#define LILAC_WFE_STAGE         62u
+
+void
+lilac_wfe_enter(void)
+{
+	if (!lilac_is_boot_cpu()) {
+		return;
+	}
+	lilac_wd_publish(LILAC_WFE_STAGE);
+	lilac_event(LILAC_WFE_STAGE);
+}
+
+void
+lilac_wfe_poll(void)
+{
+	if (!lilac_is_boot_cpu()) {
+		return;
+	}
+	lilac_idle_checks();
+}
+
+void
+lilac_wfe_exit(void)
+{
+	if (!lilac_is_boot_cpu()) {
+		return;
+	}
+	lilac_wd_publish(lilac_last_stage);
+}
+
+void
+lilac_fatal_reset(void)
+{
+	lilac_reset_claim();            /* another CPU's delay already runs: park here */
+	lilac_wd_latched = 1;           /* before the publish: no beat may clear FATAL */
+	lilac_wd_publish(lilac_last_stage | LILAC_WD_FATAL);
+	lilac_reset_after(LILAC_FATAL_BASE + LILAC_FATAL_STEP * (uint64_t)lilac_last_stage);
+}
+/*
+ * Thread context, once per second (lilac_hb.c), on any CPU. IRQ/FIQ masked so this CPU's idle
+ * and fatal publishes cannot interleave; other CPUs are excluded by the compare-exchange.
+ */
+void
+lilac_heartbeat(void)
+{
+	uint64_t daif = __builtin_arm_rsr64("DAIF");
+	__asm__ volatile ("msr DAIFSet, #3" ::: "memory");
+	lilac_wd_update(0, 1);
+	__builtin_arm_wsr64("DAIF", daif);
+}
+#endif /* LILAC */
diff --git a/osfmk/arm64/lilac_hb.c b/osfmk/arm64/lilac_hb.c
new file mode 100644
index 0000000..cf5b647
--- /dev/null
+++ b/osfmk/arm64/lilac_hb.c
@@ -0,0 +1,258 @@
+/*
+ * LILAC: watchdog heartbeat and timer-interrupt PC sampler.
+ *
+ * Heartbeat: a kernel thread at MAXPRI_KERNEL calls lilac_heartbeat() (lilac_diag.c) every
+ * second, so the G8 watchdog CPU sees lilac_wd_word change while the kernel can still
+ * schedule, and resets only on real hangs. Started from bsd_init after the SD log.
+ *
+ * Sampler: sleh_irq calls lilac_pc_sample() for every virtual-timer IRQ (quantum and
+ * timer deadlines, so a CPU-bound thread is sampled about every 10 ms). Samples are
+ * counted as idle, user or kernel; kernel samples are binned by (pc, pid). Every
+ * HB_REPORT_SECS the thread prints the busiest bins to the console (and so to the SD
+ * log) as unslid addresses, to be symbolicated against the CI kernel.development.
+ * SMP: each CPU samples into a private bank, with local IRQs masked. The heartbeat
+ * requests a bank handoff once a second; the next IRQ switches banks and release-publishes
+ * the retired bank. Only the heartbeat consumes/resets it, then requests another handoff.
+ * Neither side waits for the other, and the IRQ path has no shared lock or RMW loop.
+ * Reports lag the last handoff (normally <= one second; longer for an inactive CPU).
+ * Kernel bins are keyed by (pc, pid, cpu). The totals line keeps its format
+ * (tools/prof-sym.py); with more than one CPU, per-CPU lines "LILAC PROF cpuN: ..." follow
+ * it and bin lines end in " cpu N" (prof-sym.py's regexes still match / skip them).
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(LILAC)
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <kern/kern_types.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <kern/processor.h>
+#include <kern/sched.h>
+#include <kern/sched_prim.h>
+#include <kern/misc_protos.h>
+#include <kern/cpu_number.h>
+#include <arm/cpu_internal.h>
+#include <machine/machine_routines.h>
+#include <arm64/proc_reg.h>
+#include <arm64/sweet_early.h>
+
+#define HB_SLOTS        64u
+#define HB_PROBE        8u
+#define HB_TOP          8u
+#define HB_REPORT_SECS  20u
+
+struct hb_slot {
+	uint64_t pc;
+	uint64_t lr;            /* of the latest sample in this bin */
+	uint32_t n;
+	int32_t  pid;
+	uint32_t cpu;
+};
+
+struct hb_cpu_cnt {
+	uint32_t user, kern, idle;
+};
+
+struct hb_bank {
+	struct hb_slot tab[HB_SLOTS];
+	struct hb_cpu_cnt cnt;
+	uint32_t drop;
+};
+
+struct hb_cpu {
+	struct hb_bank bank[2];
+	uint32_t active;             /* local IRQ writer only */
+	uint32_t request, ready;     /* release/acquire ownership handoff */
+} __attribute__((aligned(128)));
+
+static struct hb_cpu hb_cpu[MAX_CPUS];
+/* Everything below is owned exclusively by the heartbeat thread. */
+static uint32_t hb_inflight[MAX_CPUS];
+static struct hb_slot hb_tab[MAX_CPUS * HB_SLOTS];
+static struct hb_cpu_cnt hb_cnt[MAX_CPUS];
+static uint32_t hb_drop;
+static int hb_on;
+static int hb_wait_chan;
+
+void lilac_pc_sample(arm_saved_state_t *state);
+
+/* Timer IRQ context, interrupts masked. */
+void
+lilac_pc_sample(arm_saved_state_t *state)
+{
+	if (!__atomic_load_n(&hb_on, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	thread_t th = current_thread();
+	uint32_t cpu = (uint32_t)cpu_number();
+	if (cpu >= MAX_CPUS) {
+		return;
+	}
+	struct hb_cpu *c = &hb_cpu[cpu];
+	if (__atomic_load_n(&c->request, __ATOMIC_ACQUIRE)) {
+		uint32_t retired = c->active;
+		c->active ^= 1;
+		__atomic_store_n(&c->request, 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&c->ready, retired + 1, __ATOMIC_RELEASE);
+	}
+	struct hb_bank *b = &c->bank[c->active];
+	if (th == current_processor()->idle_thread) {
+		b->cnt.idle++;
+		return;
+	}
+	if (!PSR64_IS_KERNEL(get_saved_state_cpsr(state))) {
+		b->cnt.user++;
+		return;
+	}
+	uint64_t pc = get_saved_state_pc(state), lr = get_saved_state_lr(state);
+	task_t task = get_threadtask(th);
+	int32_t pid = task ? task_pid(task) : -1;
+	uint32_t h = (uint32_t)((pc >> 2) ^ (uint32_t)pid ^ (cpu * 0x9E3779B1u)) % HB_SLOTS;
+	b->cnt.kern++;
+	for (uint32_t i = 0; i < HB_PROBE; i++) {
+		struct hb_slot *s = &b->tab[(h + i) % HB_SLOTS];
+		if (s->n == 0) {
+			s->pc = pc;
+			s->pid = pid;
+			s->cpu = cpu;
+		}
+		if (s->pc == pc && s->pid == pid && s->cpu == cpu) {
+			s->n++;
+			s->lr = lr;
+			return;
+		}
+	}
+	b->drop++;
+}
+
+/* Single consumer; no IRQ masking, no remote writes into the active bank. */
+static void
+hb_collect(void)
+{
+	for (uint32_t cpu = 0; cpu < MAX_CPUS; cpu++) {
+		struct hb_cpu *c = &hb_cpu[cpu];
+		if (hb_inflight[cpu]) {
+			uint32_t ready = __atomic_load_n(&c->ready, __ATOMIC_ACQUIRE);
+			if (ready == 0) {
+				continue;  /* CPU has not sampled yet; never wait on it. */
+			}
+			struct hb_bank *b = &c->bank[ready - 1];
+			hb_cnt[cpu].idle += b->cnt.idle;
+			hb_cnt[cpu].user += b->cnt.user;
+			hb_cnt[cpu].kern += b->cnt.kern;
+			hb_drop += b->drop;
+			for (uint32_t i = 0; i < HB_SLOTS; i++) {
+				struct hb_slot *s = &b->tab[i];
+				if (!s->n) {
+					continue;
+				}
+				uint32_t h = (uint32_t)((s->pc >> 2) ^ (uint32_t)s->pid ^
+				    (cpu * 0x9E3779B1u)) % HB_SLOTS;
+				uint32_t j;
+				for (j = 0; j < HB_PROBE; j++) {
+					struct hb_slot *d = &hb_tab[cpu * HB_SLOTS + (h + j) % HB_SLOTS];
+					if (!d->n) {
+						*d = *s;
+						break;
+					}
+					if (d->pc == s->pc && d->pid == s->pid) {
+						d->n += s->n;
+						d->lr = s->lr;
+						break;
+					}
+				}
+				if (j == HB_PROBE) {
+					hb_drop += s->n;
+				}
+			}
+			*b = (struct hb_bank){ 0 };
+			__atomic_store_n(&c->ready, 0, __ATOMIC_RELAXED);
+		}
+		hb_inflight[cpu] = 1;
+		/* Publishes the cleared retired bank before the producer may reuse it. */
+		__atomic_store_n(&c->request, 1, __ATOMIC_RELEASE);
+	}
+}
+
+static void
+hb_report(uint32_t secs)
+{
+	struct hb_slot *snap = hb_tab;
+	struct hb_cpu_cnt *cnt = hb_cnt;
+	uint32_t user = 0, kern = 0, idle = 0, drop = hb_drop;
+
+	for (uint32_t c = 0; c < MAX_CPUS; c++) {
+		user += cnt[c].user; kern += cnt[c].kern; idle += cnt[c].idle;
+	}
+	const int smp = real_ncpus > 1;
+	printf("LILAC PROF t+%us: idle %u user %u kern %u (unbinned %u)\n", secs, idle, user, kern, drop);
+	for (uint32_t c = 0; smp && c < MAX_CPUS; c++) {
+		if (cnt[c].idle | cnt[c].user | cnt[c].kern) {
+			printf("LILAC PROF cpu%u: idle %u user %u kern %u\n", c, cnt[c].idle, cnt[c].user, cnt[c].kern);
+		}
+	}
+	for (uint32_t k = 0; k < HB_TOP; k++) {
+		uint32_t best = MAX_CPUS * HB_SLOTS;
+		for (uint32_t i = 0; i < MAX_CPUS * HB_SLOTS; i++) {
+			if (snap[i].n != 0 && (best == MAX_CPUS * HB_SLOTS || snap[i].n > snap[best].n)) {
+				best = i;
+			}
+		}
+		if (best == MAX_CPUS * HB_SLOTS) {
+			break;
+		}
+		if (smp) {
+			printf("LILAC PROF  %u pid %d pc 0x%lx lr 0x%lx cpu %u\n", snap[best].n, snap[best].pid,
+			    (unsigned long)VM_KERNEL_UNSLIDE(snap[best].pc),
+			    (unsigned long)VM_KERNEL_UNSLIDE(snap[best].lr), snap[best].cpu);
+		} else {
+			printf("LILAC PROF  %u pid %d pc 0x%lx lr 0x%lx\n", snap[best].n, snap[best].pid,
+			    (unsigned long)VM_KERNEL_UNSLIDE(snap[best].pc),
+			    (unsigned long)VM_KERNEL_UNSLIDE(snap[best].lr));
+		}
+		snap[best].n = 0;
+	}
+	for (uint32_t i = 0; i < MAX_CPUS * HB_SLOTS; i++) {
+		hb_tab[i].n = 0;
+	}
+	for (uint32_t c = 0; c < MAX_CPUS; c++) {
+		hb_cnt[c] = (struct hb_cpu_cnt){ 0 };
+	}
+	hb_drop = 0;
+	extern void lilac_sd_report(void);
+	lilac_sd_report();      /* bsd/dev/lilac_sd.c: SD requests, KiB, time, naps for the same interval */
+	extern void lilac_ufs_report(void);
+	lilac_ufs_report();     /* lifetime UFS totals, including refused writes */
+}
+
+static void
+lilac_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t secs = 0;
+	for (;;) {
+		lilac_heartbeat();
+		hb_collect();
+		if (++secs % HB_REPORT_SECS == 0) {
+			hb_report(secs);
+		}
+		assert_wait_timeout((event_t)&hb_wait_chan, THREAD_UNINT, 1000, (uint32_t)NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void lilac_hb_start(void);
+
+void
+lilac_hb_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start_priority(lilac_hb_thread, NULL, MAXPRI_KERNEL, &thread) != KERN_SUCCESS) {
+		printf("LILAC HB: thread start failed\n");
+		return;
+	}
+	thread_deallocate(thread);
+	__atomic_store_n(&hb_on, 1, __ATOMIC_RELEASE);
+	printf("LILAC HB: watchdog heartbeat 1 s, PC sampler report every %u s\n", HB_REPORT_SECS);
+}
+#endif /* LILAC */
diff --git a/osfmk/arm64/lilac_smptest.c b/osfmk/arm64/lilac_smptest.c
new file mode 100644
index 0000000..6c36e28
--- /dev/null
+++ b/osfmk/arm64/lilac_smptest.c
@@ -0,0 +1,619 @@
+/*
+ * LILAC stage 91: local event-stream differential probe, then a real shared
+ * lck_spin_t hammered by bound threads on every selected CPU. No change to the
+ * normal boot path. 92-99 belong to touch; 91 was the earlier SGI/timer test in
+ * lilac-gold (not an ancestor of lilac-ufsroot).
+ *
+ * WFE tests run one CPU at a time with IRQs masked and EVNTEN always set.
+ * The slow control selects EVENTI=15 (65536 ticks), never disables events.
+ * A separately bound, IRQ-enabled peer sends SEV once the 50ms probe deadline
+ * expires, so a broken local stream cannot strand the probing CPU. Without a
+ * ready peer, skip WFE. No timer registers are changed: a masked timer IRQ was
+ * NOT an effective wake guard in the original test. Restore CNTKCTL and IRQs
+ * after each sample, report partial progress on expiry, then continue stress.
+ * WFE may return spuriously; compare slow/old-OR/configured timing, not just
+ * register readback. EL1 cannot inspect or rule out resident EL2 WFE trapping.
+ *
+ * Nibble: b0 all selected CPUs online, b1 CNTKCTL readback correct on all,
+ * b2 all workers completed N acquisitions, b3 protected counter == N*n.
+ * WFE timing is diagnostic, NOT automatically labelled PASS.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(LILAC)
+#include <mach/mach_types.h>
+#include <mach/mach_time.h>
+#include <kern/kern_types.h>
+#include <kern/thread.h>
+#include <kern/processor.h>
+#include <kern/sched.h>
+#include <kern/sched_prim.h>
+#include <kern/misc_protos.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/cpu_number.h>
+#include <arm/cpu_internal.h>
+#include <arm/cpu_data_internal.h>
+#include <machine/machine_routines.h>
+#include <arm64/proc_reg.h>
+#include <arm64/sweet_early.h>
+#include <pexpert/pexpert.h>
+
+#define SMPT_STAGE 91u
+#define SMPT_ITERATIONS 20000u
+#define SMPT_MAX_ITERATIONS 1000000u
+#define SMPT_WAIT_SECS 30u
+
+extern boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+extern uint64_t lilac_wfe_init_regs[MAX_CPUS][2];
+
+static LCK_GRP_DECLARE(smpt_group, "lilac_smpt");
+static LCK_SPIN_DECLARE(smpt_lock, &smpt_group);
+static uint64_t smpt_counter; /* deliberately non-atomic, protected by smpt_lock */
+static uint32_t smpt_go, smpt_abort, smpt_iterations, smpt_worker_count;
+static int smpt_chan;
+
+struct smpt_worker {
+	uint32_t cpu, ready, entered, done, count;
+	uint64_t wait_max, hold_max;
+} __attribute__((aligned(128)));
+static struct smpt_worker smpt_workers[MAX_CPUS];
+
+/* Mach-O arm64 treats ';' as an assembler comment, NOT an instruction
+ * separator. Keep every instruction on its own line (host test disassembles it). */
+static uint64_t
+smpt_counter_read(void)
+{
+	uint64_t t;
+	__asm__ volatile("isb\n\tmrs %0, CNTVCT_EL0" : "=r"(t) :: "memory");
+	return t;
+}
+
+static void
+smpt_sleep(void)
+{
+	assert_wait_timeout((event_t)&smpt_chan, THREAD_UNINT, 1, (uint32_t)NSEC_PER_MSEC);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+#define SMPT_RAW_READS 200000u
+#define SMPT_RAW_FORWARD_LIMIT 19200ULL /* raw ticks, not a time conversion */
+#define SMPT_RAW_ROUNDS 5u
+
+struct smpt_raw_stats {
+	uint64_t first, last, backward, forward_max, zero;
+	uint32_t saved;
+	struct { uint32_t index; uint64_t prev, cur; } anomaly[4];
+};
+
+static uint64_t
+smpt_physical_read(void)
+{
+	uint64_t t;
+	__asm__ volatile("isb\n\tmrs %0, CNTPCT_EL0" : "=r"(t) :: "memory");
+	return t;
+}
+
+static void
+smpt_raw_step(struct smpt_raw_stats *s, uint32_t index, uint64_t cur)
+{
+	uint64_t prev = s->last;
+	int anomaly = cur < prev;
+	if (cur < prev) {
+		s->backward++;
+	} else {
+		uint64_t delta = cur - prev;
+		s->forward_max = MAX(s->forward_max, delta);
+		s->zero += delta == 0;
+		anomaly = delta > SMPT_RAW_FORWARD_LIMIT;
+	}
+	if (anomaly && s->saved < 4) {
+		uint32_t n = s->saved++;
+		s->anomaly[n].index = index;
+		s->anomaly[n].prev = prev;
+		s->anomaly[n].cur = cur;
+	}
+	s->last = cur;
+}
+
+static void
+smpt_raw_local(uint32_t cpu, int physical)
+{
+	struct smpt_raw_stats s = { 0 };
+	boolean_t irq = ml_set_interrupts_enabled(FALSE);
+	uint64_t mpidr_before = __builtin_arm_rsr64("MPIDR_EL1");
+	s.first = s.last = physical ? smpt_physical_read() : smpt_counter_read();
+	for (uint32_t i = 1; i < SMPT_RAW_READS; i++) {
+		uint64_t cur = physical ? smpt_physical_read() : smpt_counter_read();
+		smpt_raw_step(&s, i, cur);
+	}
+	uint64_t mpidr_after = __builtin_arm_rsr64("MPIDR_EL1");
+	ml_set_interrupts_enabled(irq);
+	const char *name = physical ? "CNTPCT" : "CNTVCT";
+	printf("LILAC RAW: cpu %u %s reads %u first 0x%llx last 0x%llx backward %llu forward-max 0x%llx zero %llu mpidr-before 0x%llx mpidr-after 0x%llx anomaly-forward-limit 0x%llx\n",
+	    cpu, name, SMPT_RAW_READS, s.first, s.last, s.backward, s.forward_max, s.zero,
+	    mpidr_before, mpidr_after, SMPT_RAW_FORWARD_LIMIT);
+	for (uint32_t i = 0; i < s.saved; i++) {
+		printf("LILAC RAW: cpu %u %s anomaly index %u prev 0x%llx cur 0x%llx\n",
+		    cpu, name, s.anomaly[i].index, s.anomaly[i].prev, s.anomaly[i].cur);
+	}
+}
+
+struct smpt_raw_worker {
+	uint32_t cpu, armed, captured, done;
+	uint64_t value[SMPT_RAW_ROUNDS], mpidr[SMPT_RAW_ROUNDS];
+} __attribute__((aligned(128)));
+static struct smpt_raw_worker smpt_raw_workers[MAX_CPUS];
+static uint32_t smpt_raw_prepare, smpt_raw_release, smpt_raw_abort;
+
+static void
+smpt_raw_worker_main(void *arg, __unused wait_result_t wr)
+{
+	struct smpt_raw_worker *w = arg;
+	thread_bind(cpu_to_processor((int)w->cpu));
+	thread_block(THREAD_CONTINUE_NULL);
+	for (uint32_t r = 1; r <= SMPT_RAW_ROUNDS; r++) {
+		/* Sleep with IRQs enabled during the one-second inter-round interval. */
+		while (__atomic_load_n(&smpt_raw_prepare, __ATOMIC_ACQUIRE) < r) {
+			if (__atomic_load_n(&smpt_raw_abort, __ATOMIC_ACQUIRE)) {
+				goto done;
+			}
+			smpt_sleep();
+		}
+		boolean_t irq = ml_set_interrupts_enabled(FALSE);
+		__atomic_store_n(&w->armed, r, __ATOMIC_RELEASE);
+		while (__atomic_load_n(&smpt_raw_release, __ATOMIC_ACQUIRE) < r) {
+			if (__atomic_load_n(&smpt_raw_abort, __ATOMIC_ACQUIRE)) {
+				ml_set_interrupts_enabled(irq);
+				goto done;
+			}
+			__asm__ volatile("yield");
+		}
+		w->value[r - 1] = smpt_counter_read();
+		w->mpidr[r - 1] = __builtin_arm_rsr64("MPIDR_EL1");
+		ml_set_interrupts_enabled(irq);
+		__atomic_store_n(&w->captured, r, __ATOMIC_RELEASE);
+	}
+done:
+	__atomic_store_n(&w->done, 1, __ATOMIC_RELEASE);
+	thread_terminate_self();
+}
+
+static int
+smpt_raw_wait(uint32_t n, uint32_t round, int captured)
+{
+	uint64_t end = smpt_counter_read() + 3 * __builtin_arm_rsr64("CNTFRQ_EL0");
+	for (;;) {
+		uint32_t have = 0;
+		for (uint32_t i = 1; i < n; i++) {
+			uint32_t *p = captured ? &smpt_raw_workers[i].captured : &smpt_raw_workers[i].armed;
+			have += __atomic_load_n(p, __ATOMIC_ACQUIRE) >= round;
+		}
+		if (have == n - 1) {
+			return 1;
+		}
+		if (smpt_counter_read() >= end) {
+			printf("LILAC RAW: skew round %u %s TIMEOUT ready %u/%u\n",
+			    round, captured ? "capture" : "arm", have, n - 1);
+			__atomic_store_n(&smpt_raw_abort, 1, __ATOMIC_RELEASE);
+			return 0;
+		}
+		smpt_sleep();
+	}
+}
+
+static void
+smpt_raw_run(const ml_topology_info_t *topo, uint32_t n)
+{
+	uint32_t physical = 0;
+	PE_parse_boot_argn("lilac_raw_phys", &physical, sizeof(physical));
+	uint64_t el = __builtin_arm_rsr64("CurrentEL") >> 2;
+	if (el == 2) {
+		printf("LILAC RAW: EL2 CNTHCTL 0x%llx\n", __builtin_arm_rsr64("CNTHCTL_EL2"));
+	} else {
+		printf("LILAC RAW: EL%llu CNTHCTL_EL2 unreadable; Sony arm64 Linux selects CNTVCT (arm_arch_timer.c:478)\n", el);
+	}
+	printf("LILAC RAW: CNTPCT %s; lilac_raw_phys=1 explicitly permits a potentially faulting EL1 read\n",
+	    physical ? "OPT-IN" : "SKIPPED (default)");
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t cpu = topo->cpus[i].cpu_id;
+		thread_bind(cpu_to_processor((int)cpu));
+		thread_block(THREAD_CONTINUE_NULL);
+		assert(cpu_number() == (int)cpu);
+		smpt_raw_local(cpu, 0);
+		if (physical) {
+			smpt_raw_local(cpu, 1);
+		}
+	}
+	thread_bind(master_processor);
+	thread_block(THREAD_CONTINUE_NULL);
+	assert(cpu_number() == master_cpu && topo->cpus[0].cpu_id == (uint32_t)master_cpu);
+	for (uint32_t i = 1; i < n; i++) {
+		thread_t th;
+		smpt_raw_workers[i].cpu = topo->cpus[i].cpu_id;
+		if (kernel_thread_start(smpt_raw_worker_main, &smpt_raw_workers[i], &th) != KERN_SUCCESS) {
+			printf("LILAC RAW: skew worker cpu %u creation FAILED\n", topo->cpus[i].cpu_id);
+			__atomic_store_n(&smpt_raw_abort, 1, __ATOMIC_RELEASE);
+			return;
+		}
+		thread_deallocate(th);
+	}
+	for (uint32_t r = 1; r <= SMPT_RAW_ROUNDS; r++) {
+		if (r > 1) {
+			assert_wait_timeout((event_t)&smpt_chan, THREAD_UNINT, 1000, (uint32_t)NSEC_PER_MSEC);
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+		__atomic_store_n(&smpt_raw_prepare, r, __ATOMIC_RELEASE);
+		if (!smpt_raw_wait(n, r, 0)) {
+			return;
+		}
+		boolean_t irq = ml_set_interrupts_enabled(FALSE);
+		uint64_t ref = smpt_counter_read();
+		__atomic_store_n(&smpt_raw_release, r, __ATOMIC_RELEASE);
+		uint64_t after = smpt_counter_read();
+		ml_set_interrupts_enabled(irq);
+		if (!smpt_raw_wait(n, r, 1)) {
+			return;
+		}
+		printf("LILAC RAW: skew round %u cpu 0 value 0x%llx release-after 0x%llx delta +0\n", r, ref, after);
+		for (uint32_t i = 1; i < n; i++) {
+			struct smpt_raw_worker *w = &smpt_raw_workers[i];
+			uint64_t v = w->value[r - 1];
+			printf("LILAC RAW: skew round %u cpu %u mpidr 0x%llx value 0x%llx ref 0x%llx delta %c%llu\n",
+			    r, w->cpu, w->mpidr[r - 1], v, ref, v < ref ? '-' : '+', v < ref ? ref - v : v - ref);
+		}
+	}
+	/* A release flag measures counter offset PLUS observation latency, not
+	 * simultaneous hardware latching. Print raw brackets, not inferred drift. */
+}
+
+/* One guard at a time; storage is reused only after done acquire. */
+static struct {
+	uint32_t cpu, ready, stop, done;
+	uint64_t deadline;
+} smpt_guard;
+static uint32_t smpt_guard_active; /* coordinator only */
+
+static void
+smpt_guard_main(__unused void *arg, __unused wait_result_t wr)
+{
+	thread_bind(cpu_to_processor((int)smpt_guard.cpu));
+	thread_block(THREAD_CONTINUE_NULL);
+	__atomic_store_n(&smpt_guard.ready, cpu_number() == (int)smpt_guard.cpu, __ATOMIC_RELEASE);
+	while (!__atomic_load_n(&smpt_guard.stop, __ATOMIC_ACQUIRE)) {
+		uint64_t deadline = __atomic_load_n(&smpt_guard.deadline, __ATOMIC_ACQUIRE);
+		if (deadline && smpt_counter_read() >= deadline) {
+			/* SEV wakes WFE independently of PSTATE.I and CNTKCTL.EVNTEN. */
+			__asm__ volatile("sev" ::: "memory");
+		}
+		__asm__ volatile("yield");
+	}
+	__atomic_store_n(&smpt_guard.done, 1, __ATOMIC_RELEASE);
+	thread_terminate_self();
+}
+
+static int
+smpt_guard_start(uint32_t cpu)
+{
+	if (smpt_worker_count < 2 || (smpt_guard_active &&
+	    !__atomic_load_n(&smpt_guard.done, __ATOMIC_ACQUIRE))) {
+		return 0;
+	}
+	smpt_guard.cpu = cpu == 0 ? 1 : 0;
+	__atomic_store_n(&smpt_guard.ready, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&smpt_guard.stop, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&smpt_guard.done, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&smpt_guard.deadline, 0, __ATOMIC_RELAXED);
+	thread_t th;
+	smpt_guard_active = 0;
+	if (kernel_thread_start_priority(smpt_guard_main, NULL, MAXPRI_KERNEL, &th) != KERN_SUCCESS) {
+		return 0;
+	}
+	smpt_guard_active = 1;
+	thread_deallocate(th);
+	uint64_t end = smpt_counter_read() + __builtin_arm_rsr64("CNTFRQ_EL0");
+	while (!__atomic_load_n(&smpt_guard.ready, __ATOMIC_ACQUIRE)) {
+		if (smpt_counter_read() >= end) {
+			__atomic_store_n(&smpt_guard.stop, 1, __ATOMIC_RELEASE);
+			return 0;
+		}
+		smpt_sleep();
+	}
+	return 1;
+}
+
+static void
+smpt_guard_stop(void)
+{
+	__atomic_store_n(&smpt_guard.stop, 1, __ATOMIC_RELEASE);
+	/* IRQs are enabled here; a late peer is never reused by the next CPU. */
+	uint64_t end = smpt_counter_read() + __builtin_arm_rsr64("CNTFRQ_EL0");
+	while (!__atomic_load_n(&smpt_guard.done, __ATOMIC_ACQUIRE) && smpt_counter_read() < end) {
+		smpt_sleep();
+	}
+}
+
+struct smpt_wfe_result {
+	uint64_t min, max, sum;
+	uint32_t completed, pending, expired, refused;
+};
+
+static struct smpt_wfe_result
+smpt_wfe_probe(uint64_t ctl, uint32_t n)
+{
+	struct smpt_wfe_result r = { .min = ~0ULL };
+	uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t deadline = smpt_counter_read() + MAX(freq / 20, 1ULL); /* 50ms total */
+	if (!(ctl & CNTKCTL_EL1_EVNTEN) || !__atomic_load_n(&smpt_guard.ready, __ATOMIC_ACQUIRE)) {
+		r.refused = 1;
+		return r;
+	}
+	__atomic_store_n(&smpt_guard.deadline, deadline, __ATOMIC_RELEASE);
+	for (uint32_t i = 0; i < n; i++) {
+		if (smpt_counter_read() >= deadline) {
+			r.expired = 1;
+			break;
+		}
+		boolean_t irq = ml_set_interrupts_enabled(FALSE);
+		uint64_t saved_kctl = __builtin_arm_rsr64("CNTKCTL_EL1");
+		__builtin_arm_wsr64("CNTKCTL_EL1", ctl);
+		__builtin_arm_isb(ISB_SY);
+		/* Do not WFE if firmware did not accept the enabled event stream. */
+		if (__builtin_arm_rsr64("CNTKCTL_EL1") != ctl) {
+			r.refused = 1;
+		} else {
+			uint64_t pending = __builtin_arm_rsr64("ISR_EL1");
+			__asm__ volatile("clrex\n\tsevl\n\twfe" ::: "memory");
+			uint64_t start = smpt_counter_read();
+			__asm__ volatile("wfe" ::: "memory");
+			uint64_t now = smpt_counter_read(), elapsed = now - start;
+			pending |= __builtin_arm_rsr64("ISR_EL1");
+			r.min = MIN(r.min, elapsed);
+			r.max = MAX(r.max, elapsed);
+			r.sum += elapsed;
+			r.completed++;
+			r.pending += (pending & 0xc0) != 0;
+			r.expired = now >= deadline;
+		}
+		__builtin_arm_wsr64("CNTKCTL_EL1", saved_kctl);
+		__builtin_arm_isb(ISB_SY);
+		ml_set_interrupts_enabled(irq);
+		if (r.expired || r.refused) {
+			break;
+		}
+	}
+	__atomic_store_n(&smpt_guard.deadline, 0, __ATOMIC_RELEASE);
+	return r;
+}
+
+static void
+smpt_wfe_print(uint32_t cpu, const char *mode, uint64_t ctl, uint32_t n)
+{
+	struct smpt_wfe_result r = smpt_wfe_probe(ctl, n);
+	printf("LILAC SMPT: wfe cpu %u %s cntkctl 0x%llx completed %u/%u ticks min %llu max %llu avg %llu pending %u %s\n",
+	    cpu, mode, ctl, r.completed, n, r.completed ? r.min : 0, r.max,
+	    r.completed ? r.sum / r.completed : 0, r.pending,
+	    r.refused ? "REFUSED (wake source/readback)" : r.expired ? "DEADLINE (continuing)" : "DONE");
+}
+
+/* Called only after binding to the target CPU. AT preserves the caller's PAR. */
+static int
+smpt_state(uint32_t cpu)
+{
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1") & 0xffffff;
+	uint32_t slot = (uint32_t)(((mpidr >> 8) & 0xff) * 4 + (mpidr & 0xff));
+	uint64_t ctl = __builtin_arm_rsr64("CNTKCTL_EL1");
+	uint64_t after = slot < MAX_CPUS ? __atomic_load_n(&lilac_wfe_init_regs[slot][1], __ATOMIC_ACQUIRE) : 0;
+	uint64_t before = slot < MAX_CPUS ? __atomic_load_n(&lilac_wfe_init_regs[slot][0], __ATOMIC_RELAXED) : 0;
+	boolean_t irq = ml_set_interrupts_enabled(FALSE);
+	uint64_t saved_par = __builtin_arm_rsr64("PAR_EL1"), par;
+	__asm__ volatile("at s1e1r, %0\n\tisb" :: "r"(&smpt_lock) : "memory");
+	par = __builtin_arm_rsr64("PAR_EL1");
+	__builtin_arm_wsr64("PAR_EL1", saved_par);
+	ml_set_interrupts_enabled(irq);
+	printf("LILAC SMPT: state cpu %u mpidr 0x%llx midr 0x%llx EL%llu cntfrq %llu init-before 0x%llx init-after 0x%llx cntkctl 0x%llx tcr 0x%llx mair 0x%llx lock-par 0x%llx\n",
+	    cpu, mpidr, __builtin_arm_rsr64("MIDR_EL1"), __builtin_arm_rsr64("CurrentEL") >> 2,
+	    __builtin_arm_rsr64("CNTFRQ_EL0"), before, after, ctl,
+	    __builtin_arm_rsr64("TCR_EL1"), __builtin_arm_rsr64("MAIR_EL1"), par);
+	if (!smpt_guard_start(cpu)) {
+		printf("LILAC SMPT: wfe cpu %u SKIPPED completed 0 (no ready SEV peer); continuing to stress\n", cpu);
+	} else {
+		/* Keep EVNTEN set in every mode. The peer guards even a broken stream. */
+		uint64_t enabled = ctl | CNTKCTL_EL1_EVNTEN;
+		uint64_t slow = (enabled & ~((uint64_t)CNTKCTL_EL1_EVENTI_MASK)) | CNTKCTL_EL1_EVENTI_MASK;
+		uint64_t old_ctl = enabled | (before & CNTKCTL_EL1_EVENTI_MASK);
+		smpt_wfe_print(cpu, "slow-stream", slow, 8);
+		smpt_wfe_print(cpu, "old-or", old_ctl, 64);
+		smpt_wfe_print(cpu, "configured", enabled, 64);
+		smpt_guard_stop();
+	}
+	return (ctl & CNTKCTL_EL1_EVNTEN) && ctl == after && !(par & 1);
+}
+
+static void
+smpt_worker_main(void *arg, __unused wait_result_t wr)
+{
+	struct smpt_worker *w = arg;
+	thread_bind(cpu_to_processor((int)w->cpu));
+	thread_block(THREAD_CONTINUE_NULL);
+	if (cpu_number() != (int)w->cpu) {
+		__atomic_store_n(&smpt_abort, 1, __ATOMIC_RELEASE);
+		goto done;
+	}
+	__atomic_store_n(&w->ready, 1, __ATOMIC_RELEASE);
+	while (!__atomic_load_n(&smpt_go, __ATOMIC_ACQUIRE)) {
+		if (__atomic_load_n(&smpt_abort, __ATOMIC_ACQUIRE)) {
+			goto done;
+		}
+		smpt_sleep();
+	}
+	/* All workers must be awake before any starts hammering. Otherwise silver
+	 * can finish while gold is still waking from the timed gate wait. IRQs stay
+	 * enabled here; no test lock is held and the coordinator can abort. */
+	__atomic_store_n(&w->entered, 1, __ATOMIC_RELEASE);
+	for (;;) {
+		uint32_t entered = 0;
+		for (uint32_t c = 0; c < smpt_worker_count; c++) {
+			entered += __atomic_load_n(&smpt_workers[c].entered, __ATOMIC_ACQUIRE);
+		}
+		if (entered == smpt_worker_count) {
+			break;
+		}
+		if (__atomic_load_n(&smpt_abort, __ATOMIC_ACQUIRE)) {
+			goto done;
+		}
+		__asm__ volatile("yield");
+	}
+	for (uint32_t i = 0; i < smpt_iterations; i++) {
+		if (__atomic_load_n(&smpt_abort, __ATOMIC_ACQUIRE)) {
+			break;
+		}
+		/* Like the failed sampler: ordinary XNU spinlock with local IRQs masked. */
+		boolean_t irq = ml_set_interrupts_enabled(FALSE);
+		uint64_t start = smpt_counter_read();
+		lck_spin_lock(&smpt_lock);
+		uint64_t acquired = smpt_counter_read();
+		smpt_counter++;
+		uint64_t held = smpt_counter_read() - acquired;
+		lck_spin_unlock(&smpt_lock);
+		ml_set_interrupts_enabled(irq);
+		w->wait_max = MAX(w->wait_max, acquired - start);
+		w->hold_max = MAX(w->hold_max, held);
+		w->count++;
+	}
+done:
+	__atomic_store_n(&w->done, 1, __ATOMIC_RELEASE);
+	thread_terminate_self();
+}
+
+/* Always dump all physical slots from cpu0 before migrating/probing. Slot 7
+ * is the loader watchdog, not an XNU CPU; zeros mean no init published. */
+static void
+smpt_init_dump(const char *phase)
+{
+	for (uint32_t slot = 0; slot < MAX_CPUS; slot++) {
+		uint64_t after = __atomic_load_n(&lilac_wfe_init_regs[slot][1], __ATOMIC_ACQUIRE);
+		uint64_t before = __atomic_load_n(&lilac_wfe_init_regs[slot][0], __ATOMIC_RELAXED);
+		printf("LILAC SMPT: init-slot %s cpu %d mpidr 0x%x before 0x%llx after 0x%llx %s\n",
+		    phase, cpu_number(), ((slot / 4) << 8) | (slot % 4), before, after,
+		    after ? "published" : "not-published");
+	}
+}
+
+void lilac_smptest_run(void);
+void
+lilac_smptest_run(void)
+{
+	if (!lilac_stop_is(SMPT_STAGE)) {
+		return;
+	}
+	/* bsd_init invokes this on the bootstrap CPU; do not bind before the dump. */
+	assert(cpu_number() == master_cpu);
+	smpt_init_dump("start");
+	const ml_topology_info_t *topo = ml_get_topology_info();
+	uint32_t n = topo->num_cpus;
+	smpt_worker_count = n;
+	uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	smpt_iterations = SMPT_ITERATIONS;
+	PE_parse_boot_argn("lilac_lock_iters", &smpt_iterations, sizeof(smpt_iterations));
+	if (!smpt_iterations || smpt_iterations > SMPT_MAX_ITERATIONS || n > MAX_CPUS || !n) {
+		panic("LILAC SMPT: invalid cpus/iterations");
+	}
+	printf("LILAC SMPT: stage 91 WFE/spinlock start cpus %u iterations %u CNTFRQ %llu\n", n, smpt_iterations, freq);
+	uint64_t deadline = smpt_counter_read() + SMPT_WAIT_SECS * freq;
+	for (;;) {
+		uint32_t up = 0;
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t c = topo->cpus[i].cpu_id;
+			cpu_data_t *cd = c < MAX_CPUS ? CpuDataEntries[c].cpu_data_vaddr : NULL;
+			up += cd && cd->cpu_running && sweet_cpu_signal_is_enabled(c);
+		}
+		if (up == n) {
+			break;
+		}
+		if (smpt_counter_read() > deadline) {
+			printf("LILAC SMPT: FAIL online %u/%u\n", up, n);
+			lilac_report(SMPT_STAGE, 0);
+			return;
+		}
+		smpt_sleep();
+	}
+	smpt_init_dump("online"); /* Includes secondaries that started after the first dump. */
+	smpt_raw_run(topo, n); /* Raw evidence before any WFE probe or spin stress. */
+	int state_ok = 1;
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t cpu = topo->cpus[i].cpu_id;
+		thread_bind(cpu_to_processor((int)cpu));
+		thread_block(THREAD_CONTINUE_NULL);
+		if (cpu_number() != (int)cpu) {
+			panic("LILAC SMPT: binding failed");
+		}
+		state_ok &= smpt_state(cpu);
+	}
+	thread_bind(master_processor);
+	thread_block(THREAD_CONTINUE_NULL);
+	for (uint32_t i = 0; i < n; i++) {
+		thread_t th;
+		smpt_workers[i].cpu = topo->cpus[i].cpu_id;
+		if (kernel_thread_start(smpt_worker_main, &smpt_workers[i], &th) != KERN_SUCCESS) {
+			__atomic_store_n(&smpt_abort, 1, __ATOMIC_RELEASE);
+			printf("LILAC SMPT: FAIL worker create cpu %u\n", topo->cpus[i].cpu_id);
+			break;
+		}
+		thread_deallocate(th);
+	}
+	deadline = smpt_counter_read() + SMPT_WAIT_SECS * freq;
+	for (;;) {
+		uint32_t ready = 0;
+		for (uint32_t i = 0; i < n; i++) {
+			ready += __atomic_load_n(&smpt_workers[i].ready, __ATOMIC_ACQUIRE);
+		}
+		if (ready == n) {
+			break;
+		}
+		if (smpt_counter_read() > deadline || __atomic_load_n(&smpt_abort, __ATOMIC_ACQUIRE)) {
+			__atomic_store_n(&smpt_abort, 1, __ATOMIC_RELEASE);
+			printf("LILAC SMPT: FAIL ready %u/%u\n", ready, n);
+			lilac_report(SMPT_STAGE, 1 | (state_ok << 1));
+			return;
+		}
+		smpt_sleep();
+	}
+	printf("LILAC SMPT: spin start %u CPUs x %u acquisitions (normal XNU timeout unchanged)\n", n, smpt_iterations);
+	__atomic_store_n(&smpt_go, 1, __ATOMIC_RELEASE);
+	deadline = smpt_counter_read() + SMPT_WAIT_SECS * freq;
+	uint32_t done;
+	for (;;) {
+		done = 0;
+		for (uint32_t i = 0; i < n; i++) {
+			done += __atomic_load_n(&smpt_workers[i].done, __ATOMIC_ACQUIRE);
+		}
+		if (done == n || smpt_counter_read() > deadline) {
+			break;
+		}
+		smpt_sleep();
+	}
+	int complete = done == n;
+	if (!complete) {
+		__atomic_store_n(&smpt_abort, 1, __ATOMIC_RELEASE);
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		struct smpt_worker *w = &smpt_workers[i];
+		if (!__atomic_load_n(&w->done, __ATOMIC_ACQUIRE)) {
+			printf("LILAC SMPT: spin cpu %u TIMEOUT (no racy partial counters)\n", w->cpu);
+			continue;
+		}
+		complete &= w->count == smpt_iterations;
+		printf("LILAC SMPT: spin cpu %u mpidr 0x%x count %u/%u wait-max %llu ticks hold-max %llu ticks\n",
+		    w->cpu, topo->cpus[i].phys_id, w->count, smpt_iterations, w->wait_max, w->hold_max);
+	}
+	/* Read the non-atomic counter only when every writer has release-published done. */
+	uint64_t expected = (uint64_t)n * smpt_iterations;
+	int counter_ok = done == n && smpt_counter == expected;
+	if (done == n) {
+		printf("LILAC SMPT: spin counter %llu expected %llu %s\n", smpt_counter, expected, counter_ok ? "PASS" : "FAIL");
+	}
+	uint32_t nib = 1 | ((uint32_t)state_ok << 1) | ((uint32_t)complete << 2) | ((uint32_t)counter_ok << 3);
+	printf("LILAC SMPT: result nibble 0x%x (online/registers/completed/counter); WFE timing requires slow/configured comparison\n", nib);
+	lilac_report(SMPT_STAGE, nib);
+}
+#endif /* LILAC */
