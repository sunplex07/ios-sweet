+#!/usr/bin/env python3
+"""Host control/failure tests of the real touch power-up C code (T1-T5,
+lilac_stop=92..96) with a modeled MMIO register file, under ASan/UBSan.
+
+Asserts the two write-safety invariants of docs/lilac-touch-power.md:
+ 1. no SPMI/PMIC access of any kind occurs (reads included): the model
+    aborts on any address outside TLMM/GCC/QUP5, and every store must be an
+    allow-listed register (W1 TLMM87/88 cfg, W2 0x52004, W3 0x21024/0x21020,
+    W4 0x21008, and the i2c-qup v2 QUP5 set); TLMM89 and TLMM133 (WEST) are
+    never written (inherited 0 = Android working level, EXPERIMENTS.md T7b);
+ 1b. every QUP sub-transfer matches ML i2c-qup.c v2: tags, WRITE_CNT incl.
+    tags, READ_CNT = 2 + len, CONFIG 0x207/0x287, CLK_CTL 0x00100320, and a
+    register read is write-message + PAUSE + read-message;
+ 2. stop-at-first-mismatch: a failed read-back ends the stage with no further
+    writes (scenario-specific write counters).
+Tests software behaviour, not physical I2C/PMIC protocol. Only the includes
+and the MMIO accessors are substituted; the executable is built in a
+temporary directory and removed afterwards.
+"""
+import pathlib
+import re
+import subprocess
+import tempfile
+
+root = pathlib.Path(__file__).resolve().parents[1]
+source = (root / "bsd/dev/lilac_touch.c").read_text()
+source = re.sub(r"^#include .*\n", "", source, flags=re.M)
+# The model below supplies the MMIO accessors; drop the kernel's copies.
+a = source.index("static uint32_t\ntouch_rd")
+b = source.index("static uint32_t\ntlmm_rd")
+source = source[:a] + source[b:]
+headers = r'''
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <assert.h>
+typedef uintptr_t vm_offset_t;
+typedef size_t vm_size_t;
+#define ARM64_BOARD_CONFIG_LILAC 1
+static unsigned scenario, maps, host_reports, host_report_stage, host_report_bits;
+static unsigned long host_max_delay;
+static int host_stage;
+static unsigned host_lines_high = 1, host_no_mux_latch, host_update_stuck, host_branch_stuck;
+vm_offset_t ml_io_map(vm_offset_t p, vm_size_t s) { (void)s; maps++; return p; }
+int lilac_stop_is(unsigned s) { return s == (unsigned)host_stage; }
+void lilac_report(unsigned s, unsigned b) {
+    host_reports++; host_report_stage = s; host_report_bits = b;
+}
+void delay(unsigned us) { if (us > host_max_delay) host_max_delay = us; }
+typedef int kern_return_t; typedef void *thread_t; typedef int wait_result_t;
+#define KERN_SUCCESS 0
+#define NSEC_PER_MSEC 1000000ull
+#define THREAD_CONTINUE_NULL ((void *)0)
+#define THREAD_UNINT 0
+void sweet_hid_touch(int finger, int down, int x, int y) { (void)finger; (void)down; (void)x; (void)y; }
+int PE_parse_boot_argn(const char *s, void *v, int len) { (void)s; (void)v; (void)len; return 0; }
+void clock_interval_to_deadline(unsigned ms, unsigned long long ns, uint64_t *d) { (void)ms;(void)ns;(void)d; }
+kern_return_t assert_wait_deadline(void *c, int o, uint64_t d) { (void)c;(void)o;(void)d; return 0; }
+wait_result_t thread_block(void *c) { (void)c; return 0; }
+kern_return_t kernel_thread_start(void (*f)(void *, wait_result_t), void *a, thread_t *t) { (void)f;(void)a;(void)t; return 0; }
+void thread_deallocate(thread_t t) { (void)t; }
+'''
+model = r'''
+/* ---- modeled device: TLMM EAST/WEST, GCC, QUP5; nothing else exists ---- */
+#define M_EAST 0x03d00000ull
+#define M_WEST 0x03500000ull
+#define M_GCC  0x00100000ull
+#define M_QUP  0x0c179000ull
+static uint32_t m_east[0x80000 / 4], m_west[0x90000 / 4];
+static unsigned w_east, w_west, w_gcc, w_qup;
+static uint32_t m_vote = 0x80889d80, m_cfg, m_branch, m_pend;
+/* QUP v2 model. Each RUN with queued OUT words is one sub-transfer; the
+ * model checks it against ML i2c-qup.c (tags :569-614, counts :1151-1175 +
+ * :1477-1484, CONFIG NO_INPUT :1171, CLK_CTL :1898-1901) and flags a read
+ * tag behind a write address (or a 2nd START inside one sub-transfer) as
+ * I2C_STATUS bit24 INVALID_READ_ADDR (model invariant, cf. T7b 0x011363c8). */
+static uint32_t q_state, q_op, q_status, q_err, q_cfg, q_wcnt, q_rcnt, q_clk;
+static uint8_t q_tx[128]; static unsigned q_txlen;
+static uint8_t q_rx[80]; static unsigned q_rxpos, q_rxlen;
+static unsigned host_ack, host_clk_ok = 1;
+struct sub_rec { uint32_t cfg, wcnt, rcnt; uint8_t b[16]; unsigned n; };
+static struct sub_rec subs[8]; static unsigned nsub;
+static void q_run(void) {
+    if (!q_txlen) return;
+    unsigned n = q_wcnt & 0xffffu;
+    assert(q_txlen == ((n + 3u) & ~3u));        /* FIFO words == WRITE_CNT */
+    if (q_clk != 0x00100320u) host_clk_ok = 0;
+    if (nsub < 8) { subs[nsub].cfg = q_cfg; subs[nsub].wcnt = q_wcnt;
+        subs[nsub].rcnt = q_rcnt; subs[nsub].n = n;
+        memcpy(subs[nsub].b, q_tx, n < 16 ? n : 16); }
+    nsub++;
+    uint8_t addr = q_tx[1], tag = q_tx[2], len = q_tx[3];
+    int rd = tag == 0x85 || tag == 0x86 || tag == 0x87;
+    int bad = q_tx[0] != 0x81 || rd != (addr & 1) || (addr >> 1) != 0x2c;
+    if (!rd && n != 4u + len) bad = 1;
+    if (rd && (n != 4u || (q_rcnt & 0xffffu) != len + 2u || q_cfg != 0x207u)) bad = 1;
+    if (!rd && q_cfg != 0x287u) bad = 1;
+    q_txlen = 0;
+    if (bad) { q_status |= 0x01000000u; return; }
+    if (!host_ack) { q_status |= 0x8u; return; }      /* PACKET_NACKED */
+    if (rd) { q_rx[0] = tag; q_rx[1] = len; for (unsigned i = 0; i < len; i++) q_rx[2 + i] = 0xff;
+              q_rxlen = 2u + len; q_rxpos = 0; q_op |= 0x20u | 0x800u; }
+    else q_op |= 0x400u;
+}
+/* Every store must hit exactly these allow-listed registers. */
+static void touch_wr(vm_offset_t b, uint32_t o, uint32_t v) {
+    assert(!(b >= 0x0800a000 && b < 0x08500000) && !(b >= 0x09400000 && b < 0x0a400000));
+    if (b == M_EAST) {   /* W1 only: the two mux cfg registers; never 89 */
+        assert(o == 87u * 0x1000 || o == 88u * 0x1000);
+        w_east++;
+        if (!host_no_mux_latch) m_east[o / 4] = v;
+        return;
+    }
+    if (b == M_WEST) {   /* VIO133 is never written (active-low, inherited 0) */
+        w_west++; assert(!"TLMM WEST write");
+    }
+    if (b == M_GCC) {    /* W2 vote, W3 RCG CFG+CMD, W4 branch enable */
+        assert(o == 0x52004 || o == 0x21024 || o == 0x21020 || o == 0x21008);
+        w_gcc++;
+        if (o == 0x52004) m_vote = v;
+        else if (o == 0x21024) m_cfg = v;
+        else if (o == 0x21020) { if (v & 1u) m_pend = 1; }
+        else m_branch = v;
+        return;
+    }
+    if (b == M_QUP) {    /* the i2c-qup v2 FIFO register set + W1C clears */
+        assert((o & 3u) == 0);
+        assert(o == 0x004 || o == 0x00c || o == 0x000 || o == 0x408 ||
+               o == 0x008 || o == 0x100 || o == 0x200 || o == 0x150 ||
+               o == 0x208 || o == 0x400 || o == 0x110 || o == 0x018 ||
+               o == 0x404 || o == 0x01c);
+        w_qup++;
+        if (o == 0x00c) { q_state = 0; q_op = 0; q_status = 0; q_err = 0;
+                          q_txlen = 0; q_rxlen = q_rxpos = 0; }
+        else if (o == 0x004) { q_state = v & 7u; if (v == 1u) q_run(); }
+        else if (o == 0x000) q_cfg = v;
+        else if (o == 0x150) q_wcnt = v;
+        else if (o == 0x208) q_rcnt = v;
+        else if (o == 0x400) q_clk = v;
+        else if (o == 0x008) assert(v == 0xc000u);   /* REPACK, FIFO */
+        else if (o == 0x404) q_status &= ~v;
+        else if (o == 0x01c) q_err &= ~v;
+        else if (o == 0x018) q_op &= ~v;
+        else if (o == 0x110) { for (unsigned j = 0; j < 4 && q_txlen < 128; j++)
+                                   q_tx[q_txlen++] = (uint8_t)(v >> (8 * j)); }
+        return;
+    }
+    abort();
+}
+static uint32_t touch_rd(vm_offset_t b, uint32_t o) {
+    assert(!(b >= 0x0800a000 && b < 0x08500000) && !(b >= 0x09400000 && b < 0x0a400000));
+    if (b == M_EAST || b == M_WEST) {
+        uint32_t *r = b == M_EAST ? m_east : m_west;
+        uint32_t v = r[o / 4];
+        if (b == M_EAST && (o == 87u * 0x1000 + 4 || o == 88u * 0x1000 + 4))
+            v = (v & ~1u) | (uint32_t)host_lines_high;  /* SCL/SDA input bit */
+        return v;
+    }
+    if (b == M_GCC) {
+        if (o == 0x52004) return m_vote;
+        if (o == 0x17004) return (m_vote & 0x20000u) ? 0x0000c220u : 0x8000c220u;
+        if (o == 0x21024) return m_cfg;
+        if (o == 0x21020) {
+            uint32_t v = 0x80000000u | (m_pend ? 1u : 0u);
+            if (m_pend && !host_update_stuck) m_pend = 0;
+            return v;
+        }
+        if (o == 0x21008) {
+            if (host_branch_stuck) return 0x80000000u;
+            return (m_branch & 1u) ? 0u : 0x80000000u;
+        }
+        abort();
+    }
+    if (b == M_QUP) {
+        if (o == 0x030) return 0x20070000;              /* device T3 */
+        if (o == 0x004) return 4u | q_state | 0x10u;
+        if (o == 0x008) return 0xa5;                    /* device T3: 64/64 */
+        if (o == 0x018) return q_op;
+        if (o == 0x404) return q_status;
+        if (o == 0x01c) return q_err;
+        if (o == 0x218) { uint32_t w = 0;
+            for (unsigned j = 0; j < 4 && q_rxpos < q_rxlen; j++) w |= (uint32_t)q_rx[q_rxpos++] << (8 * j);
+            if (q_rxpos == q_rxlen) q_op &= ~0x20u; return w; }
+        abort();
+    }
+    abort();
+}
+static void mmio_reset(void) {   /* INPUT86 / T1 baseline */
+    memset(m_east, 0, sizeof(m_east)); memset(m_west, 0, sizeof(m_west));
+    m_east[87 * 0x1000 / 4 + 1] = 1; m_east[88 * 0x1000 / 4 + 1] = 1;
+    m_east[89 * 0x1000 / 4] = 0x203;
+    m_east[125 * 0x1000 / 4] = 0x3; m_east[125 * 0x1000 / 4 + 1] = 1;
+    m_west[133 * 0x1000 / 4] = 0x203;
+    m_vote = 0x80889d80; m_cfg = 0; m_branch = 0; m_pend = 0;
+    q_state = 0; q_op = 0; q_status = 0; q_err = 0; q_txlen = 0; nsub = 0;
+    w_east = w_west = w_gcc = w_qup = 0;
+}
+static int sub_is(unsigned i, uint32_t cfg, uint32_t wcnt, uint32_t rcnt,
+                  const uint8_t *bytes, unsigned n) {
+    return i < nsub && subs[i].cfg == cfg && subs[i].wcnt == wcnt &&
+           (rcnt == 0xffffffffu || subs[i].rcnt == rcnt) && subs[i].n == n &&
+           !memcmp(subs[i].b, bytes, n);
+}
+'''
+main = r'''
+int main(int argc, char **argv) {
+    assert(argc == 2);
+    scenario = (unsigned)atoi(argv[1]);
+    static const int stages[] = {0, 0, 92, 93, 94, 95, 96, 93, 94, 96, 95, 95, 96, 96};
+    assert(scenario >= 1 && scenario <= 13);
+    host_stage = stages[scenario];
+    if (scenario == 7) host_no_mux_latch = 1;
+    if (scenario == 8) host_update_stuck = 1;
+    if (scenario == 9) host_lines_high = 0;
+    if (scenario == 10) host_branch_stuck = 1;
+    if (scenario == 11) host_ack = 1;
+    mmio_reset();
+    /* io stays 0 (T1 gates io), but the pin is no longer a driven output */
+    if (scenario == 12) m_west[133 * 0x1000 / 4] = 0x3;     /* VIO input, no OE */
+    if (scenario == 13) m_east[89 * 0x1000 / 4] = 0x3;      /* reset input, no OE */
+    unsigned before_maps = maps;
+    lilac_touch_powerup();
+    static const uint8_t m1[5] = {0x81, 0x58, 0x82, 0x01, 0xff};
+    static const uint8_t m2[4] = {0x81, 0x59, 0x87, 0x01};
+    switch (scenario) {
+    case 1:  /* stage not selected: no maps, no MMIO at all, no report */
+        assert(maps == before_maps && host_reports == 0);
+        assert(w_east + w_west + w_gcc + w_qup == 0);
+        break;
+    case 2:  /* T1: read-only; zero writes anywhere */
+        assert(maps == 3 && w_east + w_west + w_gcc + w_qup == 0);
+        assert(host_reports == 1 && host_report_stage == 92 && host_report_bits == 0xf);
+        break;
+    case 3:  /* T2 = W1: only the two cfg writes */
+        assert(maps == 3 && w_east == 2 && w_west == 0 && w_gcc == 0 && w_qup == 0);
+        assert(host_reports == 1 && host_report_stage == 93 && host_report_bits == 0xf);
+        assert(m_east[87 * 0x1000 / 4] == 0xc && m_east[88 * 0x1000 / 4] == 0xc);
+        break;
+    case 4:  /* T3 = W2+W3+W4: adds exactly the four GCC writes */
+        assert(maps == 4 && w_east == 2 && w_gcc == 4 && w_qup == 0 && w_west == 0);
+        assert(m_vote == 0x808a9d80);   /* only bit17 changed */
+        assert(host_reports == 1 && host_report_stage == 94 && host_report_bits == 0xf);
+        break;
+    case 5:  /* T4 NACK: write msg 81 58 82 01 ff (WRITE_CNT 5, CONFIG 0x287)
+              * NACKs, so no read message is ever queued (i2c-qup -ENXIO) */
+        assert(nsub == 1 && sub_is(0, 0x287, 5, 0xffffffffu, m1, 5) && host_clk_ok);
+        assert(maps == 4 && w_east == 2 && w_gcc == 4 && w_qup == 16 && w_west == 0);
+        assert(host_reports == 1 && host_report_stage == 95 && host_report_bits == 0xf);
+        break;
+    case 6:  /* T5: no TLMM write at all; pins verified at inherited 0 */
+        assert(maps == 4 && w_east == 2 && w_gcc == 4 && w_west == 0 && w_qup == 16);
+        assert(m_west[133 * 0x1000 / 4 + 1] == 0 && m_east[89 * 0x1000 / 4 + 1] == 0);
+        assert(host_reports == 1 && host_report_stage == 96 && host_report_bits == 0xf);
+        break;
+    case 7:  /* mux does not latch: stop after the first write */
+        assert(w_east == 1 && w_west == 0 && w_gcc == 0 && w_qup == 0);
+        assert(host_reports == 1 && host_report_stage == 93 && host_report_bits == 0x0);
+        break;
+    case 8:  /* RCG UPDATE never clears: stop; vote+CFG bits only */
+        assert(w_east == 2 && w_gcc == 3 && w_qup == 0);
+        assert(host_reports == 1 && host_report_stage == 94 && host_report_bits == 0x3);
+        break;
+    case 9:  /* SCL/SDA low at T5: stop, no TLMM write */
+        assert(w_west == 0 && w_east == 2 && w_qup == 16);
+        assert(host_reports == 1 && host_report_stage == 96 && host_report_bits == 0x1);
+        break;
+    case 10: /* QUP5 branch never comes on: stop before any QUP write */
+        assert(w_east == 2 && w_gcc == 4 && w_qup == 0 && w_west == 0);
+        assert(host_reports == 1 && host_report_stage == 95 && host_report_bits == 0x3);
+        break;
+    case 11: /* T4 ACK: msg1 as above, PAUSE, msg2 81 59 87 01 with
+              * WRITE_CNT 0x80000004, READ_CNT 0x80000003, CONFIG 0x207 */
+        assert(nsub == 2 && sub_is(0, 0x287, 5, 0xffffffffu, m1, 5));
+        assert(sub_is(1, 0x207, 0x80000004u, 0x80000003u, m2, 4) && host_clk_ok);
+        assert(w_qup == 21 && (q_status & 0x01000000u) == 0);
+        assert(host_reports == 1 && host_report_stage == 95 && host_report_bits == 0xf);
+        break;
+    case 12: /* VIO133 not at 0: refuse, never write it */
+        assert(w_west == 0 && w_east == 2);
+        assert(host_reports == 1 && host_report_stage == 96 && host_report_bits == 0x0);
+        break;
+    case 13: /* RESET89 not at 0: refuse, never write it */
+        assert(w_west == 0 && w_east == 2);
+        assert(host_reports == 1 && host_report_stage == 96 && host_report_bits == 0x3);
+        break;
+    }
+    printf("scenario %u ok: maps=%u w_east=%u w_west=%u w_gcc=%u w_qup=%u nsub=%u "
+           "report=%u,%x\n", scenario, maps, w_east, w_west, w_gcc, w_qup, nsub,
+           host_report_stage, host_report_bits);
+    return 0;
+}
+'''
+expected_lines = {
+    1: [],
+    2: ["LILAC TOUCH T1: BEGIN stage=92 (T1-T8",
+        "LILAC TOUCH T1: TLMM87 cfg=00000000 io=00000001",
+        "LILAC TOUCH T1: L28 status read DEFERRED to stage 97 (T6)",
+        "LILAC TOUCH T1: PASS unchanged snapshot (bits f)",
+        "LILAC TOUCH T1: END stage=92 bits=f PASS"],
+    3: ["T2 W1 TLMM mux [3d00000+57000] before=00000000 write=0000000c",
+        "LILAC TOUCH T2: PASS W1 mux=3",
+        "LILAC TOUCH T2: END stage=93 bits=f PASS"],
+    4: ["T3 W2 AHB vote RMW [100000+52004] before=80889d80 write=808a9d80",
+        "T3 W3 RCG CFG [100000+21024] before=00000000 write=00000000",
+        "LILAC TOUCH T3: PASS W2+W3+W4 (vote, RCG XO 19.2 MHz, branch on)",
+        "END stage=94 bits=f PASS"],
+    5: ["LILAC TOUCH T4: QUP init (W8) hw=20070000 clk_ctl=00100320",
+        "LILAC TOUCH: I2C verdict=NACK msg=1/2 tags=81 58 82 01 raw_status=00000008",
+        "LILAC TOUCH T4: NACK 0x2c on msg 1/2 (I2C_STATUS bit3) raw_status=00000008",
+        "END stage=95 bits=f PASS"],
+    6: ["VIO(active-low,0=on) TLMM133 cfg=00000203 io=00000000",
+        "LILAC TOUCH T5: PASS pins inherited (VIO133=0 on, RESET89=0, SCL/SDA high); no TLMM write",
+        "END stage=96 bits=f PASS"],
+    7: ["LILAC TOUCH: FAIL TLMM mux readback (stopped; no repair, no retry)",
+        "END stage=93 bits=0 FAIL"],
+    8: ["LILAC TOUCH: FAIL RCG UPDATE not clearing",
+        "END stage=94 bits=3 FAIL"],
+    9: ["LILAC TOUCH: FAIL SCL/SDA not high: bus pulled low",
+        "END stage=96 bits=1 FAIL"],
+    10: ["LILAC TOUCH: FAIL QUP5 branch still off",
+         "END stage=95 bits=3 FAIL"],
+    11: ["LILAC TOUCH T4: ACK 0x2c: reg 0xff=ff",
+         "END stage=95 bits=f PASS"],
+    12: ["TLMM133 is NOT at the inherited level",
+         "LILAC TOUCH: FAIL VIO133 not at inherited 0 (touch VIO would be off)",
+         "END stage=96 bits=0 FAIL"],
+    13: ["TLMM89 is NOT at the inherited level",
+         "LILAC TOUCH: FAIL RESET89 not at inherited 0",
+         "END stage=96 bits=3 FAIL"],
+}
+with tempfile.TemporaryDirectory(dir=str(root / "tests")) as d:
+    exe = pathlib.Path(d) / "touch_host"
+    src = pathlib.Path(d) / "touch_host.c"
+    src.write_text(headers + model + source + main)
+    subprocess.run(["clang", "-O1", "-g", "-fsanitize=address,undefined",
+                    "-Wall", "-Wno-unused-function", "-o", str(exe), str(src)],
+                   check=True)
+    for s in sorted(expected_lines):
+        out = subprocess.run([str(exe), str(s)], capture_output=True,
+                             text=True, check=True).stdout
+        for line in expected_lines[s]:
+            assert line in out, f"scenario {s}: missing log {line!r} in:\n{out}"
+        print(f"scenario {s}: {out.strip().splitlines()[-1]}")
+    print("all lilac_touch host tests passed")
diff --git a/tests/lilac_touch_t6t8_test.py b/tests/lilac_touch_t6t8_test.py
new file mode 100644
index 0000000..5b12df6
--- /dev/null
+++ b/tests/lilac_touch_t6t8_test.py
@@ -0,0 +1,337 @@
+#!/usr/bin/env python3
+"""Host tests of the real T6-T8 code (stages 97-99 + lilactouch) with a
+modeled TLMM/GCC/QUP/SPMI register file and a synthetic RMI4 device built to
+the clearpad register layout, under ASan/UBSan. Checks:
+ 1. pins: TLMM133 (WEST) is never written; TLMM89 is never written unless
+    lilactouchrst=1 AND the inherited-pin probe NACKed, and then exactly one
+    io write (release) after >=11 ms, followed by >=220 ms before the next
+    probe (Sony hybrid sequence);
+ 2. regulator write refusal: only PM8998 L28 EN_CTL (0x46) on APID 300 with
+    owner EE0 may be written; voltage registers are never written; a set
+    point other than 3000 mV or a subtype other than 0x35 means zero writes;
+    L14 is read-only; a non-EE0 owner means zero writes;
+ 3. QUP: every sub-transfer is ML i2c-qup.c v2 (START addr8 with R/W bit,
+    DATAWR/DATAWR_STOP/DATARD_STOP + len, WRITE_CNT incl. tags, READ_CNT =
+    len+2, CONFIG 0x287 write / 0x207 read, CLK_CTL 0x00100320); anything
+    else latches INVALID_READ_ADDR in the model and fails the test;
+ 4. RMI4 PDT parse against the synthetic PDT (F01 page 0 "S3508_LIL", F12
+    page 1) with presence-decoded ctrl/data offsets, register pointer set by
+    a write message and read back by a separate read message;
+ 5. F12 frame parse + panel->logical mapping and injection through
+    sweet_hid_touch; kill switch lilactouch absent/0 -> no thread.
+"""
+import pathlib, re, subprocess, tempfile
+
+root = pathlib.Path(__file__).resolve().parents[1]
+source = (root / "bsd/dev/lilac_touch.c").read_text()
+source = re.sub(r"^#include .*\n", "", source, flags=re.M)
+a = source.index("static uint32_t\ntouch_rd")
+b = source.index("static uint32_t\ntlmm_rd")
+source = source[:a] + source[b:]
+headers = r'''
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <assert.h>
+typedef uintptr_t vm_offset_t; typedef size_t vm_size_t;
+#define ARM64_BOARD_CONFIG_LILAC 1
+typedef int kern_return_t; typedef void *thread_t; typedef int wait_result_t;
+#define KERN_SUCCESS 0
+#define NSEC_PER_MSEC 1000000ull
+#define THREAD_UNINT 0
+#define THREAD_CONTINUE_NULL ((void *)0)
+static unsigned scenario, maps, host_reports, host_report_stage, host_report_bits;
+static unsigned long host_max_delay; static int host_stage;
+static unsigned chn_writes, thread_starts;
+static int host_arg_lilactouch;   /* -1 absent */
+static int host_arg_rst; static unsigned host_hold_seen;
+static long seq_chn, seq_e89, seq_counter;
+static int hid_calls, hid_finger[8], hid_down[8], hid_x[8], hid_y[8];
+vm_offset_t ml_io_map(vm_offset_t p, vm_size_t s) { (void)s; maps++; return p; }
+int lilac_stop_is(unsigned s) { return s == (unsigned)host_stage; }
+void lilac_report(unsigned s, unsigned b) { host_reports++; host_report_stage = s; host_report_bits = b; }
+extern uint32_t host_e89_io(void);
+void delay(unsigned us) { if (us > host_max_delay) host_max_delay = us;
+    if (us >= 11000 && us < 220000 && !(host_e89_io() & 2u)) host_hold_seen = 1; }
+void clock_interval_to_deadline(unsigned ms, unsigned long long ns, uint64_t *d) { (void)ms;(void)ns;(void)d; }
+kern_return_t assert_wait_deadline(void *c, int o, uint64_t d) { (void)c;(void)o;(void)d; return 0; }
+wait_result_t thread_block(void *c) { (void)c; return 0; }
+kern_return_t kernel_thread_start(void (*f)(void *, wait_result_t), void *a2, thread_t *t) {
+    (void)f; (void)a2; (void)t; thread_starts++; return KERN_SUCCESS; }
+void thread_deallocate(thread_t t) { (void)t; }
+int PE_parse_boot_argn(const char *s, void *v, int len) {
+    if (!strcmp(s, "lilactouch") && host_arg_lilactouch >= 0) { *(int *)v = host_arg_lilactouch; return 1; }
+    if (!strcmp(s, "lilactouchrst") && host_arg_rst) { *(int *)v = host_arg_rst; return 1; }
+    return 0; }
+void sweet_hid_touch(int finger, int down, int x, int y) {
+    if (hid_calls < 8) { hid_finger[hid_calls]=finger; hid_down[hid_calls]=down;
+        hid_x[hid_calls]=x; hid_y[hid_calls]=y; }
+    hid_calls++; }
+'''
+model = r'''
+#define M_EAST 0x03d00000ull
+#define M_WEST 0x03500000ull
+#define M_GCC  0x00100000ull
+#define M_QUP  0x0c179000ull
+#define M_CORE 0x0800f000ull
+#define M_CNFG 0x0800a000ull
+#define M_CHN_BASE 0x08400000ull
+#define M_OBS_BASE 0x09400000ull
+#define APID_L28 300u
+#define APID_L14 299u
+static uint32_t m_east[0x80000/4], m_west[0x90000/4];
+static uint32_t m_vote=0x80889d80, m_cfg, m_branch, m_pend;
+static uint32_t q_state, q_op, q_status, q_err, q_cfg, q_wcnt, q_rcnt, q_clk;
+static uint8_t q_tx[128]; static unsigned q_txlen;
+static uint8_t rmi[4][256]; static unsigned rmi_page, rmi_ptr;
+static uint8_t rxbytes[80]; static unsigned rx_pos, rx_total;
+static uint8_t l28[256], l14[256]; static unsigned l28_owner;
+static unsigned host_device_on=1, host_need_reset, irq_frames, w_e89, w_w133, bad_subs;
+static void dev_init(void) {
+    memset(rmi, 0, sizeof(rmi)); rmi_page = 0; rmi_ptr = 0; irq_frames = 0;
+    /* F01 PDT entry like the device (T7c: ctrl=0d data=06 differ); the old
+     * fixture left ctrl=data=0, so CTRL01 aliased the DATA01 status read. */
+    rmi[0][0xe9]=0x43; rmi[0][0xeb]=0x0d; rmi[0][0xed]=2; rmi[0][0xee]=1;
+    memcpy(&rmi[0][0x4e], "S3508_LIL", 9);
+    rmi[1][0xe9]=0x10; rmi[1][0xeb]=0x40; rmi[1][0xec]=0x20; rmi[1][0xed]=0x0a; rmi[1][0xee]=0x12;
+    rmi[1][0x10]=0x01;
+    /* RMI4 multi-byte registers sit at ONE address (query5 / query8 are
+     * the presence registers; the HEAD fixture laid them out byte-wise so
+     * they overlapped and ctrl8 decoded absent). size: query4=4, query7=2. */
+    rmi[1][0x14]=4; rmi[1][0x17]=2;
+    rmi[1][0x41]=0xcf; rmi[1][0x42]=0x02; rmi[1][0x43]=0xff; rmi[1][0x44]=0x04;
+    rmi[1][0x49]=0x00; rmi[1][0x4a]=0x0a;
+    rmi[1][0x4e]=0xff;
+    rmi[1][0x31]=1; rmi[1][0x32]=100; rmi[1][0x34]=200;
+}
+static int dev_answers(void) {
+    if (!host_device_on) return 0;
+    if (host_need_reset && !(m_east[89*0x1000/4+1] & 2u)) return 0;  /* held in reset */
+    return 1;
+}
+/* One RUN with queued OUT words = one i2c-qup v2 sub-transfer. */
+static void serve(void) {
+    unsigned n = q_wcnt & 0xffffu;
+    uint8_t addr = q_tx[1], tag = q_tx[2], len = q_tx[3];
+    int rd = tag == 0x85 || tag == 0x86 || tag == 0x87;
+    int bad = q_txlen != ((n + 3u) & ~3u) || q_tx[0] != 0x81 || (addr >> 1) != 0x2c ||
+              rd != (addr & 1) || q_clk != 0x00100320u;
+    if (rd) bad |= n != 4u || (q_rcnt & 0xffffu) != len + 2u || q_cfg != 0x207u;
+    else bad |= n != 4u + len || q_cfg != 0x287u || (tag != 0x82 && tag != 0x83);
+    q_txlen = 0; rx_pos = rx_total = 0;
+    if (bad) { bad_subs++; q_status |= 0x01000000u; return; }
+    if (!dev_answers()) { q_status |= 0x8u; return; }
+    if (rd) {
+        rxbytes[0]=tag; rxbytes[1]=len; rx_total = len + 2u;
+        /* ctrl presence: hdr 1, regs 0,8-15,23,24-28 -> ctrl8=1 ctrl23=9 ctrl28=14;
+         * data presence: hdr 1, regs 0-12,15 -> data1=1 data15=13 */
+        static const uint8_t cpres[5] = {1, 0x01, 0xff, 0x80, 0x1f};
+        static const uint8_t dpres[3] = {1, 0xff, 0x9f};
+        for (unsigned i=0;i<len;i++) {
+            if (rmi_page == 1 && rmi_ptr == 0x15) rxbytes[2+i] = i < 5 ? cpres[i] : 0;
+            else if (rmi_page == 1 && rmi_ptr == 0x18) rxbytes[2+i] = i < 3 ? dpres[i] : 0;
+            else rxbytes[2+i] = rmi[rmi_page][(uint8_t)(rmi_ptr+i)];
+        }
+        /* F01 DATA01 interrupt status (fixture F01 data base 0x00 on page 0):
+         * F01 owns irq bits 0-1, F12 bits 2-3 in PDT order; reading it
+         * acknowledges ATTN, so an empty read releases the IRQ125 line. */
+        if (rmi_page == 0 && rmi_ptr == 0x01) {
+            rxbytes[2] = irq_frames < 2 ? 0x0cu : 0u;
+            if (irq_frames >= 2) irq_frames = 3;
+        }
+        if (rmi_ptr == 0x20+13) { unsigned att = irq_frames < 2 ? 4u : 0u;
+            rxbytes[2]=(uint8_t)att; rxbytes[3]=0; irq_frames++; }
+        q_op |= 0x20u|0x800u;
+    } else {
+        rmi_ptr = q_tx[4];
+        for (unsigned i = 5; i < n; i++) {
+            uint8_t r = (uint8_t)(rmi_ptr + i - 5);
+            if (r == 0xff) { rmi_page = q_tx[i] & 3u; rmi[rmi_page][0xff] = (uint8_t)rmi_page; }
+            else rmi[rmi_page][r] = q_tx[i];
+        }
+        q_op |= 0x400u;
+    }
+}
+static unsigned obs_off[2]; static uint8_t chn_data[2];
+static uint8_t *ldo_for(vm_offset_t b, unsigned *apid) {
+    if (b >= M_OBS_BASE) { *apid = (unsigned)((b - M_OBS_BASE) / 0x8000ull); }
+    else { *apid = (unsigned)((b - M_CHN_BASE) / 0x8000ull); }
+    return *apid == APID_L28 ? l28 : (*apid == APID_L14 ? l14 : NULL);
+}
+static void touch_wr(vm_offset_t b, uint32_t o, uint32_t v) {
+    seq_counter++;
+    if (b == M_EAST) { assert(o==87u*0x1000||o==88u*0x1000||o==89u*0x1000+4);
+        if (o==89u*0x1000+4) { w_e89++; if (!seq_e89) seq_e89 = seq_counter; }
+        m_east[o/4]=v; return; }
+    if (b == M_WEST) { w_w133++; assert(!"TLMM133 must never be written"); }
+    if (b == M_GCC) { if (o==0x52004) m_vote=v; else if (o==0x21024) m_cfg=v;
+        else if (o==0x21020) { if (v&1u) m_pend=1; } else if (o==0x21008) m_branch=v;
+        else abort(); return; }
+    if (b == M_QUP) {
+        if (o==0x00c) { q_state=0; q_op=0; q_status=0; q_err=0; q_txlen=0; rx_pos=rx_total=0; }
+        else if (o==0x004) { q_state=v&7u; if (v==1u && q_txlen) serve(); }
+        else if (o==0x000) q_cfg=v;
+        else if (o==0x150) q_wcnt=v;
+        else if (o==0x208) q_rcnt=v;
+        else if (o==0x400) q_clk=v;
+        else if (o==0x404) q_status &= ~v;
+        else if (o==0x01c) q_err &= ~v;
+        else if (o==0x018) q_op &= ~v;
+        else if (o==0x110) { for (unsigned j=0;j<4 && q_txlen<128;j++) q_tx[q_txlen++]=(uint8_t)(v>>(8*j)); }
+        return; }
+    if (b >= M_CHN_BASE && b < M_OBS_BASE) {
+        unsigned apid; (void)ldo_for(b, &apid);
+        assert(apid == APID_L28);
+        assert(l28_owner == 0);
+        if (o == 0x10) { chn_data[0]=(uint8_t)v; return; }
+        assert(o == 0);
+        unsigned off = (v >> 4) & 0xffu;
+        assert(off==0x46);
+        l28[off] = chn_data[0]; chn_writes++;
+        if (!seq_chn) seq_chn = seq_counter;
+        return; }
+    if (b >= M_OBS_BASE) {
+        assert(o == 0);
+        unsigned apid; (void)ldo_for(b, &apid);
+        obs_off[0] = (v >> 4) & 0xffu; return; }
+    abort();
+}
+static uint32_t touch_rd(vm_offset_t b, uint32_t o) {
+    /* T8 reads IRQ125 through a pre-computed io pointer (irq125_io, off 0) */
+    if (b == M_EAST + 125u*0x1000 + 4 && o == 0) { b = M_EAST; o = 125u*0x1000 + 4; }
+    if (b == M_EAST || b == M_WEST) {
+        uint32_t *r = b==M_EAST?m_east:m_west; uint32_t v = r[o/4];
+        if (b==M_EAST && (o==87u*0x1000+4||o==88u*0x1000+4)) v |= 1u;
+        if (b==M_EAST && o==89u*0x1000+4 && (v & 2u)) v |= 1u;
+        if (b==M_EAST && o==125u*0x1000+4) return irq_frames < 3 ? 0u : 1u;
+        return v; }
+    if (b == M_GCC) {
+        if (o==0x52004) return m_vote;
+        if (o==0x17004) return (m_vote&0x20000u)?0x0000c220u:0x8000c220u;
+        if (o==0x21024) return m_cfg;
+        if (o==0x21020) { uint32_t v=0x80000000u|(m_pend?1u:0u); if (m_pend) m_pend=0; return v; }
+        if (o==0x21008) return (m_branch&1u)?0u:0x80000000u;
+        abort(); }
+    if (b == M_QUP) {
+        if (o==0x030) return 0x20070000;
+        if (o==0x004) return 4u|q_state|0x10u;
+        if (o==0x008) return 0xa5;
+        if (o==0x018) return q_op;
+        if (o==0x404) return q_status;
+        if (o==0x01c) return q_err;
+        if (o==0x218) { uint32_t w=0; for (unsigned j=0;j<4 && rx_pos<rx_total;j++) w |= (uint32_t)rxbytes[rx_pos++]<<(8*j);
+            if (rx_pos==rx_total) q_op &= ~0x20u; return w; }
+        abort(); }
+    if (b == M_CORE) {
+        if (o==0) return 0x30010000u;
+        if (o >= 0x800 && o < 0x1000) { unsigned apid=(o-0x800)/4;
+            if (apid==APID_L28) return 0x15bu<<8; if (apid==APID_L14) return 0x14du<<8; return 0; }
+        abort(); }
+    if (b == M_CNFG) {
+        if (o >= 0x700 && o < 0xf00) { unsigned apid=(o-0x700)/4;
+            return apid==APID_L28 ? l28_owner : 0u; }
+        abort(); }
+    if (b >= M_CHN_BASE && b < M_OBS_BASE) { if (o==8) return 1u; abort(); }
+    if (b >= M_OBS_BASE) {
+        unsigned apid; uint8_t *ldo = ldo_for(b, &apid);
+        assert(ldo);
+        if (o==8) return 1u;
+        if (o==0x18) return ldo[obs_off[0]];
+        abort(); }
+    abort();
+}
+static void mmio_reset(void) {
+    memset(m_east,0,sizeof(m_east)); memset(m_west,0,sizeof(m_west));
+    m_east[89*0x1000/4]=0x203; m_east[125*0x1000/4]=3; m_east[125*0x1000/4+1]=1;
+    m_west[133*0x1000/4]=0x203;
+    m_vote=0x80889d80; m_cfg=0; m_branch=0; m_pend=0;
+    q_state=0; q_op=0; q_status=0; q_err=0; q_txlen=0;
+    chn_writes=0; l28_owner=0; host_device_on=1; host_need_reset=0;
+    w_e89=0; w_w133=0; bad_subs=0;
+    memset(l28,0,sizeof(l28)); memset(l14,0,sizeof(l14));
+    l28[4]=0x04; l28[5]=0x35; l14[4]=0x04; l14[5]=0x3c;
+    l14[0x40]=0x08; l14[0x41]=0x07; l14[0x46]=0x80;
+    l28[0x40]=0xb8; l28[0x41]=0x0b;
+    dev_init();
+}
+'''
+main = r'''
+int main(int argc, char **argv) {
+    extern void lilac_touch_map(int px, int py, int *nx16, int *ny16, int *edge);
+    extern void lilac_touch_start(void);
+    extern void lilac_touch_powerup(void);
+    int nx, ny, ed;
+    setvbuf(stdout, NULL, _IONBF, 0);
+    assert(argc == 2); scenario = (unsigned)atoi(argv[1]);
+    assert(scenario >= 1 && scenario <= 11);
+    lilac_touch_map(64, 0, &nx, &ny, &ed);
+    assert(nx==0 && ny==0 && ed);
+    lilac_touch_map(654, 1279, &nx, &ny, &ed);
+    assert(nx == (int)((590LL<<16)/591) && ny == (int)((1279LL<<16)/1280) && ed);
+    lilac_touch_map(360, 640, &nx, &ny, &ed);
+    assert(nx == (int)((296LL<<16)/591) && ny == (int)((640LL<<16)/1280) && !ed);
+    lilac_touch_map(0, 640, &nx, &ny, &ed);
+    assert(nx == 0 && ed);
+    lilac_touch_map(719, 1279, &nx, &ny, &ed);
+    assert(nx == (int)((590LL<<16)/591));
+    if (scenario == 9) {
+        host_arg_lilactouch = -1; lilac_touch_start(); assert(thread_starts == 0);
+        host_arg_lilactouch = 1;  lilac_touch_start(); assert(thread_starts == 1);
+        host_arg_lilactouch = 0;  lilac_touch_start(); assert(thread_starts == 1);
+        printf("scenario 9 ok: kill switch\n"); return 0;
+    }
+    static const int stages[] = {0,97,97,97,97,97,98,99,98,0,98,98};
+    host_stage = stages[scenario];
+    mmio_reset();
+    switch (scenario) {
+    case 2: l28[0x40]=0xc0; l28[0x46]=0x80; break;   /* device: inherited ON 3008 mV */
+    case 3: l28_owner = 1; break;
+    case 4: l28[0x40]=0xe4; l28[0x41]=0x0c; break;   /* 3300 mV */
+    case 5: l28[5]=0x0a; break;
+    case 8: host_device_on = 0; break;               /* NACK, no opt-in */
+    case 10: host_need_reset = 1; host_arg_rst = 1; break;  /* NACK until released */
+    case 11: host_device_on = 0; host_arg_rst = 1; break;   /* opt-in, still NACK */
+    default: break;
+    }
+    lilac_touch_powerup();
+    assert(w_w133 == 0 && bad_subs == 0);
+    switch (scenario) {
+    case 1: assert(chn_writes == 1 && l28[0x46]==0x80);
+            assert(l28[0x40]==0xb8 && l28[0x41]==0x0b);
+            assert(w_e89 == 0 && host_report_bits == 0xf); break;
+    case 2: assert(chn_writes == 0 && host_report_bits == 0xf); break;
+    case 3: assert(chn_writes == 0 && host_report_bits == 0x1); break;
+    case 4: assert(chn_writes == 0 && host_report_bits == 0x1); break;
+    case 5: assert(chn_writes == 0 && host_report_bits == 0x1); break;
+    case 6: assert(chn_writes >= 1 && host_report_bits == 0xf && w_e89 == 0); break;
+    case 7: assert(host_report_bits == 0xf && hid_calls == 2 && w_e89 == 0);
+            assert(hid_finger[0]==2 && hid_down[0]==1 && hid_x[0]==100 && hid_y[0]==200);
+            assert(hid_finger[1]==2 && hid_down[1]==0); break;
+    case 8: assert(host_report_bits == 0x1 && hid_calls == 0 && w_e89 == 0); break;
+    case 10: assert(host_report_bits == 0xf && w_e89 == 1);
+             assert((m_east[89*0x1000/4+1] & 2u) && host_max_delay >= 220000);
+             assert(host_hold_seen); break;
+    case 11: assert(host_report_bits == 0x1 && w_e89 == 1); break;
+    }
+    printf("scenario %u ok: bits=%x chn=%u hid=%u delay=%lu w_e89=%u w133=%u\n",
+           scenario, host_report_bits, chn_writes, hid_calls, host_max_delay, w_e89, w_w133);
+    return 0;
+}
+'''
+with tempfile.TemporaryDirectory(dir=str(root / "tests")) as d:
+    exe = pathlib.Path(d) / "t68"
+    src = pathlib.Path(d) / "t68.c"
+    full = headers + model + "uint32_t host_e89_io(void) { return m_east[89*0x1000/4+1]; }\n" + source + main
+    src.write_text(full)
+    subprocess.run(["clang", "-O1", "-g", "-fsanitize=address,undefined",
+                    "-Wall", "-Wno-unused-function", "-o", str(exe), str(src)],
+                   check=True)
+    for s in range(1, 12):
+        r = subprocess.run([str(exe), str(s)], capture_output=True, text=True)
+        if r.returncode:
+            raise SystemExit(f"scenario {s} failed rc={r.returncode}:\n{r.stdout}\n{r.stderr}")
+        out = r.stdout
+        print(f"scenario {s}: {out.strip().splitlines()[-1]}")
+print("all T6-T8 host scenarios passed")
diff --git a/tools/lilac_sd_adma_test.c b/tools/lilac_sd_adma_test.c
new file mode 100644
index 0000000..7f5a710
--- /dev/null
+++ b/tools/lilac_sd_adma_test.c
@@ -0,0 +1,81 @@
+/* Host-only test; no device access. Run with a native C11 compiler, -Wall -Wextra -Werror. */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include "../bsd/dev/lilac_sd_adma.h"
+
+static uint32_t le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void check(bool wide, uint64_t pa, uint32_t bytes, uint32_t page, size_t expected)
+{
+	uint8_t table[4096];
+	memset(table, 0xa5, sizeof(table));
+	size_t stride = wide ? 12 : 8;
+	size_t used = sd_adma_build(table, sizeof(table), 0xa0000000, pa, bytes, page, wide);
+	assert(used == expected * stride);
+	uint32_t total = 0;
+	for (size_t off = 0; off < used; off += stride) {
+		const uint8_t *d = table + off;
+		assert(d[0] == (off + stride == used ? 0x23 : 0x21));
+		assert(d[1] == 0);
+		uint32_t len = (uint32_t)d[2] | (uint32_t)d[3] << 8;
+		if (!len) len = 65536;
+		uint64_t addr = le32(d + 4);
+		if (wide) addr |= (uint64_t)le32(d + 8) << 32;
+		assert(addr == pa + total);
+		assert(len <= 65536 && len <= page - (addr & (page - 1)));
+		assert((addr & (wide ? 7u : 3u)) == 0);
+		total += len;
+	}
+	assert(total == bytes);
+	for (size_t i = used; i < sizeof(table); i++) assert(table[i] == 0xa5);
+}
+
+int main(void)
+{
+	uint8_t t[4096];
+	for (unsigned wide = 0; wide < 2; wide++) {
+		check(wide != 0, 0xa0010000, 65536, 16384, 4); /* XNU VM pages */
+		check(wide != 0, 0xa0010000, 65536, 4096, 16); /* not assumed VM size */
+		check(wide != 0, 0xa0013ff8, 32768, 16384, 3); /* partial first/last */
+		check(wide != 0, 0xa0020000, 131072, 131072, 2); /* length 0 = 64K */
+		check(wide != 0, 0xa0020000, 65544, 131072, 2);
+		check(wide != 0, 0xa0020000, 512, 16384, 1);
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2000, 0, 16384, wide));
+		assert(!sd_adma_build(t, 7, 0x1000, 0x2000, 512, 16384, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1001, 0x2000, 512, 16384, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2001, 512, 16384, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2000, 512, 0, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2000, 512, 12288, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, UINT64_MAX - 7, 512, 16384, wide));
+		/* Capacity failures must not overrun the table. */
+		memset(t, 0xa5, sizeof(t));
+		assert(!sd_adma_build(t, 16, 0x1000, 0x2000, 65536, 4096, wide));
+		for (size_t i = 16; i < sizeof(t); i++) assert(t[i] == 0xa5);
+	}
+	assert(sd_adma_build(t, sizeof(t), 0x1004, 0x2004, 512, 16384, false) == 8);
+	assert(!sd_adma_build(t, sizeof(t), 0x1004, 0x2000, 512, 16384, true));
+	assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2004, 512, 16384, true));
+	assert(!sd_adma_build(t, sizeof(t), 0x1000, 0xffffff00, 512, 16384, false));
+	assert(!sd_adma_build(t, sizeof(t), 0x100000000ull, 0x2000, 512, 16384, false));
+	assert(!sd_adma_build(t, sizeof(t), 0xfffffffc, 0x2000, 512, 16384, false));
+	check(true, 0x12345678000ull, 65536, 16384, 4);
+	/* No zero/LBA0, arithmetic wrap, cross-partition or boundary overrun. */
+	assert(sd_adma_range(2048, 8192, 2048, 8192));
+	assert(sd_adma_range(2048, 8192, 10239, 1));
+	assert(!sd_adma_range(0, 8192, 0, 1));
+	assert(!sd_adma_range(2048, 8192, 0, 1));
+	assert(!sd_adma_range(2048, 8192, 2047, 1));
+	assert(!sd_adma_range(2048, 8192, 10239, 2));
+	assert(!sd_adma_range(2048, 8192, 10240, 1));
+	assert(!sd_adma_range(2048, 8192, 2048, 0));
+	assert(!sd_adma_range(UINT32_MAX - 8, 16, UINT32_MAX - 8, 1));
+	puts("PASS: ADMA32/64 page splits, 64KiB lengths, LE/END/VALID/TRAN, alignment, bounds, LBA guards");
+	return 0;
+}
diff --git a/tools/lilac_smp_test.py b/tools/lilac_smp_test.py
new file mode 100644
index 0000000..4ed119f
--- /dev/null
+++ b/tools/lilac_smp_test.py
@@ -0,0 +1,464 @@
+#!/usr/bin/env python3
+"""Host regression tests of the actual EVENTI and sampler C bodies (no device IO)."""
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+hb = (root / 'osfmk/arm64/lilac_hb.c').read_text()
+mr = (root / 'osfmk/arm64/machine_routines.c').read_text()
+
+
+def function(text, name):
+    start = text.index('\n' + name + '(') + 1
+    brace = text.index('{', start)
+    level = 1
+    end = brace + 1
+    while level:
+        level += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+# Keep the production sampler/handoff/report bodies; substitute only XNU services.
+hb_body = hb[hb.index('#define HB_SLOTS'):hb.index('static void\nlilac_hb_thread')]
+assert 'lck_spin' not in hb_body
+common = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <assert.h>
+#include <pthread.h>
+#include <sched.h>
+#include <string.h>
+#define MAX_CPUS 7
+#define VM_KERNEL_UNSLIDE(x) (x)
+#define PSR64_IS_KERNEL(x) (x)
+#define real_ncpus MAX_CPUS
+typedef uintptr_t thread_t;
+typedef uintptr_t task_t;
+typedef struct { uint64_t pc, lr; int kernel; } arm_saved_state_t;
+static _Thread_local unsigned int test_cpu;
+static _Thread_local thread_t test_thread;
+static struct { thread_t idle_thread; } proc = { 1 };
+#define current_processor() (&proc)
+#define current_thread() (test_thread)
+#define cpu_number() (test_cpu)
+#define get_saved_state_cpsr(s) ((s)->kernel)
+#define get_saved_state_pc(s) ((s)->pc)
+#define get_saved_state_lr(s) ((s)->lr)
+#define get_threadtask(th) ((task_t)2)
+#define task_pid(task) ((int32_t)(task))
+void lilac_sd_report(void) {}
+void lilac_ufs_report(void) {}
+'''
+main = r'''
+#define N 120000u
+static unsigned int finished;
+static void *producer(void *p) {
+    test_cpu = (unsigned int)(uintptr_t)p;
+    for (unsigned int i = 0; i < N; i++) {
+        test_thread = i % 3 == 0 ? 1 : 2;
+        /* Deliberate collisions exercise both producer and aggregation drops. */
+        arm_saved_state_t s = { 0x1000 + (i % 17) * 256, 0x8000 + i, i % 3 == 2 };
+        lilac_pc_sample(&s);
+        if (i % 97 == 0) sched_yield();
+    }
+    __atomic_add_fetch(&finished, 1, __ATOMIC_RELEASE);
+    return NULL;
+}
+int main(void) {
+    pthread_t t[MAX_CPUS];
+    __atomic_store_n(&hb_on, 1, __ATOMIC_RELEASE);
+    hb_collect();
+    for (unsigned int c = 0; c < MAX_CPUS; c++)
+        assert(!pthread_create(&t[c], NULL, producer, (void *)(uintptr_t)c));
+    while (__atomic_load_n(&finished, __ATOMIC_ACQUIRE) != MAX_CPUS) {
+        hb_collect();
+        sched_yield();
+    }
+    for (unsigned int c = 0; c < MAX_CPUS; c++) assert(!pthread_join(t[c], NULL));
+    /* Retire the final active bank; the sentinel stays in the new active bank. */
+    hb_collect();
+    for (unsigned int c = 0; c < MAX_CPUS; c++) {
+        test_cpu = c; test_thread = 1;
+        arm_saved_state_t s = {0};
+        lilac_pc_sample(&s);
+    }
+    hb_collect();
+    for (unsigned int c = 0; c < MAX_CPUS; c++) {
+        assert(hb_cnt[c].idle == N / 3);
+        assert(hb_cnt[c].user == N / 3);
+        assert(hb_cnt[c].kern == N / 3);
+    }
+    uint64_t binned = 0;
+    for (unsigned int i = 0; i < MAX_CPUS * HB_SLOTS; i++) binned += hb_tab[i].n;
+    assert(binned + hb_drop == (uint64_t)MAX_CPUS * N / 3);
+    /* A silent CPU never stalls the consumer or reissues an outstanding handoff. */
+    uint32_t request = hb_cpu[0].request, ready = hb_cpu[0].ready;
+    for (unsigned int i = 0; i < 10000; i++) hb_collect();
+    assert(hb_cpu[0].request == request && hb_cpu[0].ready == ready);
+    hb_report(20);
+    for (unsigned int c = 0; c < MAX_CPUS; c++)
+        assert(!(hb_cnt[c].idle | hb_cnt[c].user | hb_cnt[c].kern));
+    for (unsigned int i = 0; i < MAX_CPUS * HB_SLOTS; i++) assert(!hb_tab[i].n);
+    assert(!hb_drop);
+    puts("PASS sampler: 840000 samples, per-CPU conservation, collisions, handoff, idle CPU, report reset");
+}
+'''
+
+prog = function(mr, '_enable_timebase_event_stream')
+prog = re.sub(r'__asm__ volatile \("mrs\s+%0, CNTKCTL_EL1" : "=r"\(cntkctl\)\);',
+              'cntkctl = test_reg;', prog)
+assert '__asm__' not in prog
+cfg = function(mr, 'wfe_timeout_configure')
+reg_header = (root / 'osfmk/arm64/proc_reg.h').read_text()
+defines = '\n'.join(x for x in reg_header.splitlines() if x.startswith('#define CNTKCTL_EL1_'))
+event = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <assert.h>
+#include <string.h>
+#define MIN(a,b) ((a)<(b)?(a):(b))
+#define USEC_PER_SEC 1000000
+#define USER_TIMEBASE_NONE 0
+#define user_timebase_type() 1
+#define panic(...) abort()
+#define ISB_SY 15
+static uint64_t test_reg;
+static unsigned int test_isb, arm64_eventi;
+static uint64_t arg;
+static struct { uint64_t timebase_frequency_hz; } gPEClockFrequencyInfo;
+#define __builtin_arm_wsr64(reg, val) (test_reg = (val))
+#define __builtin_arm_isb(x) (test_isb++)
+static int flsll(uint64_t v) { return v ? 64 - __builtin_clzll(v) : 0; }
+static int PE_parse_boot_argn(const char *s, void *v, unsigned int n) {
+    (void)s; memcpy(v, &arg, n); return 1;
+}
+''' + defines + '\nstatic void\n' + prog + '\nvoid\n' + cfg + r'''
+int main(void) {
+    for (unsigned int inherited = 0; inherited < 1024; inherited++) {
+        for (unsigned int i = 0; i < 16; i++) {
+            test_reg = inherited; test_isb = 0;
+            _enable_timebase_event_stream(i);
+            assert(((test_reg >> 4) & 15) == i);
+            assert(test_reg == ((inherited & ~0xf0u) | (i << 4) | 0xf));
+            assert(test_isb == 1);
+        }
+    }
+    /* Old code is falsified by inherited EVENTI=1, desired=4 => old result 5. */
+    assert((((1u << 4) | (4u << 4)) >> 4) != 4);
+    gPEClockFrequencyInfo.timebase_frequency_hz = 19200000;
+    arg = 1000000; wfe_timeout_configure(); assert(arm64_eventi == 4);
+    arg = 1000; wfe_timeout_configure(); assert(arm64_eventi == 14);
+    arg = 1; wfe_timeout_configure(); assert(arm64_eventi == 15);
+    arg = 0; wfe_timeout_configure(); assert(arm64_eventi == 15);
+    gPEClockFrequencyInfo.timebase_frequency_hz = 1;
+    arg = 1000000; wfe_timeout_configure(); assert(arm64_eventi == 0);
+    puts("PASS EVENTI: 16384 inherited/index combinations, ISB, 19.2MHz => bit4/32ticks, field saturation/zero ticks");
+}
+'''
+
+# Exercise the actual worker/start barrier/abort body with host scheduling and a
+# pthread lock. This verifies bookkeeping, NOT ARM WFE or spinlock semantics.
+stage = (root / 'osfmk/arm64/lilac_smptest.c').read_text()
+worker = function(stage, 'smpt_worker_main')
+worker_decls = stage[stage.index('static uint64_t smpt_counter;'):stage.index('static uint64_t\nsmpt_counter_read')]
+stress = common + r'''
+#include <time.h>
+#define __unused __attribute__((unused))
+#define MIN(a,b) ((a)<(b)?(a):(b))
+#define MAX(a,b) ((a)>(b)?(a):(b))
+#define FALSE 0
+#define THREAD_CONTINUE_NULL 0
+typedef int boolean_t;
+typedef int wait_result_t;
+#define cpu_to_processor(c) (c)
+#define thread_bind(c) (test_cpu = (unsigned int)(c))
+#define thread_block(c) sched_yield()
+#define thread_terminate_self() pthread_exit(NULL)
+static pthread_mutex_t smpt_lock = PTHREAD_MUTEX_INITIALIZER;
+#define lck_spin_lock(l) assert(!pthread_mutex_lock(l))
+#define lck_spin_unlock(l) assert(!pthread_mutex_unlock(l))
+static int ml_set_interrupts_enabled(int v) { (void)v; return 1; }
+static void smpt_sleep(void) { sched_yield(); }
+static uint64_t smpt_counter_read(void) {
+    struct timespec ts; assert(!clock_gettime(CLOCK_MONOTONIC, &ts));
+    return (uint64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
+''' + worker_decls + '\nstatic void\n' + worker.replace('__asm__ volatile("yield");', 'sched_yield();') + r'''
+static void *launch(void *arg) { smpt_worker_main(arg, 0); return NULL; }
+int main(void) {
+    for (unsigned int abort_run = 0; abort_run < 2; abort_run++) {
+        memset(smpt_workers, 0, sizeof(smpt_workers));
+        smpt_go = smpt_abort = 0; smpt_counter = 0;
+        smpt_worker_count = MAX_CPUS; smpt_iterations = 2000;
+        pthread_t threads[MAX_CPUS];
+        for (unsigned int c = 0; c < MAX_CPUS; c++) {
+            smpt_workers[c].cpu = c;
+            assert(!pthread_create(&threads[c], NULL, launch, &smpt_workers[c]));
+        }
+        for (unsigned int c = 0; c < MAX_CPUS; c++)
+            while (!__atomic_load_n(&smpt_workers[c].ready, __ATOMIC_ACQUIRE)) sched_yield();
+        if (abort_run) __atomic_store_n(&smpt_abort, 1, __ATOMIC_RELEASE);
+        else __atomic_store_n(&smpt_go, 1, __ATOMIC_RELEASE);
+        for (unsigned int c = 0; c < MAX_CPUS; c++) {
+            assert(!pthread_join(threads[c], NULL));
+            assert(smpt_workers[c].done == 1);
+            assert(smpt_workers[c].count == (abort_run ? 0 : smpt_iterations));
+            assert(smpt_workers[c].entered == !abort_run);
+        }
+        assert(smpt_counter == (abort_run ? 0 : (uint64_t)MAX_CPUS * smpt_iterations));
+    }
+    puts("PASS stage worker bookkeeping: 7 CPUs, 14000 increments, all-awake gate, aborted gate (host mutex, not ARM spinlock)");
+}
+'''
+
+# Execute the production probe with deterministic counter/register/WFE models.
+# Model a failed stream being released by the peer's SEV at the armed deadline.
+# This tests software bounds/restoration, not hardware event delivery.
+probe_body = function(stage, 'smpt_wfe_probe')
+assert 'CNTV_CTL_EL0' not in probe_body and 'CNTV_CVAL_EL0' not in probe_body
+assert 'off-control' not in stage
+assert stage.index('smpt_init_dump("start")') < stage.index('thread_bind(cpu_to_processor((int)cpu));', stage.index('lilac_smptest_run(void)\n{'))
+probe_body = probe_body.replace(r'__asm__ volatile("clrex\n\tsevl\n\twfe" ::: "memory");', 'assert(!test_irq);')
+probe_body = probe_body.replace('__asm__ volatile("wfe" ::: "memory");', 'test_wfe();')
+assert '__asm__' not in probe_body
+result_type = stage[stage.index('struct smpt_wfe_result {'):stage.index('static struct smpt_wfe_result')]
+probe = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+#define MAX(a,b) ((a)>(b)?(a):(b))
+#define MIN(a,b) ((a)<(b)?(a):(b))
+#define FALSE 0
+#define ISB_SY 15
+#define CNTKCTL_EL1_EVNTEN 4
+typedef int boolean_t;
+static struct { uint32_t ready; uint64_t deadline; } smpt_guard;
+static uint64_t ticks, test_reg;
+static unsigned int calls, reads;
+static int test_irq, broken, bad_readback, preexpire;
+static uint64_t smpt_counter_read(void) {
+    if (preexpire && reads++ == 1) ticks = smpt_guard.deadline;
+    return ticks++;
+}
+static uint64_t rsr(const char *s) {
+    if (!strcmp(s, "CNTFRQ_EL0")) return 19200000;
+    if (!strcmp(s, "ISR_EL1")) return 0;
+    assert(!strcmp(s, "CNTKCTL_EL1"));
+    return bad_readback && test_reg != 0x34f ? test_reg ^ 4 : test_reg;
+}
+static void wsr(const char *s, uint64_t v) {
+    assert(!strcmp(s, "CNTKCTL_EL1")); test_reg = v;
+}
+#define __builtin_arm_rsr64(s) rsr(s)
+#define __builtin_arm_wsr64(s,v) wsr(s,v)
+#define __builtin_arm_isb(s) ((void)0)
+static int ml_set_interrupts_enabled(int v) { int old = test_irq; test_irq = v; return old; }
+static void test_wfe(void) {
+    assert(!test_irq && (test_reg & 4) && smpt_guard.ready && smpt_guard.deadline);
+    calls++;
+    if (broken) ticks = smpt_guard.deadline; /* independent peer SEV */
+    else ticks += 1ULL << (((test_reg >> 4) & 15) + 1);
+}
+static void reset(void) {
+    ticks = calls = reads = 0; test_irq = 1; test_reg = 0x34f;
+    broken = bad_readback = preexpire = 0;
+    smpt_guard.ready = 1; smpt_guard.deadline = 0;
+}
+static void restored(void) { assert(test_irq && test_reg == 0x34f && !smpt_guard.deadline); }
+''' + result_type + '\nstatic struct smpt_wfe_result\n' + probe_body + r'''
+int main(void) {
+    struct smpt_wfe_result r;
+    reset(); r = smpt_wfe_probe(0x3ff, 8); /* enabled slow stream */
+    assert(r.completed == 8 && !r.expired && !r.refused && calls == 8); restored();
+    reset(); r = smpt_wfe_probe(0x34f, 64);
+    assert(r.completed == 64 && !r.expired && !r.refused); restored();
+    reset(); r = smpt_wfe_probe(0x3ff, 64); /* partial batch, not an unbounded loop */
+    assert(r.expired && r.completed > 0 && r.completed < 64); restored();
+    reset(); broken = 1; r = smpt_wfe_probe(0x34f, 64);
+    assert(r.expired && r.completed == 1 && calls == 1); restored();
+    broken = 0; r = smpt_wfe_probe(0x34f, 64); /* proceed after failed probe */
+    assert(r.completed == 64 && !r.expired); restored();
+    reset(); preexpire = 1; r = smpt_wfe_probe(0x34f, 64);
+    assert(r.expired && !r.completed && !calls); restored();
+    reset(); bad_readback = 1; r = smpt_wfe_probe(0x3ff, 8);
+    assert(r.refused && !r.completed && !calls); restored();
+    reset(); smpt_guard.ready = 0; r = smpt_wfe_probe(0x34f, 64);
+    assert(r.refused && !calls); restored();
+    reset(); r = smpt_wfe_probe(0x34b, 8); /* old disabled control must be refused */
+    assert(r.refused && !calls); restored();
+    puts("PASS WFE bounds: slow/configured, partial/zero progress, broken stream + peer SEV, readback/no-peer/disabled refusal, restore and continuation");
+}
+'''
+
+# Independently exercise the production peer guard loop: never send SEV before
+# an armed deadline, repeatedly send it after expiry, and acknowledge stop.
+guard_body = function(stage, 'smpt_guard_main')
+guard_body = guard_body.replace('__asm__ volatile("sev" ::: "memory");', '__atomic_add_fetch(&sevs, 1, __ATOMIC_RELEASE);')
+guard_body = guard_body.replace('__asm__ volatile("yield");', '__atomic_add_fetch(&passes, 1, __ATOMIC_RELEASE); sched_yield();')
+guard_decls = stage[stage.index('static struct {\n\tuint32_t cpu, ready, stop, done;'):stage.index('static void\nsmpt_guard_main')]
+guard = common + r'''
+#define __unused __attribute__((unused))
+#define THREAD_CONTINUE_NULL 0
+typedef int wait_result_t;
+#define cpu_to_processor(c) (c)
+#define thread_bind(c) (test_cpu = (unsigned int)(c))
+#define thread_block(c) sched_yield()
+#define thread_terminate_self() pthread_exit(NULL)
+static uint64_t now;
+static uint32_t sevs, passes;
+static uint64_t smpt_counter_read(void) { return __atomic_load_n(&now, __ATOMIC_ACQUIRE); }
+''' + guard_decls + '\nstatic void\n' + guard_body + r'''
+static void *launch_guard(void *p) { smpt_guard_main(p, 0); return NULL; }
+static void wait_passes(void) {
+    uint32_t end = __atomic_load_n(&passes, __ATOMIC_ACQUIRE) + 100;
+    while (__atomic_load_n(&passes, __ATOMIC_ACQUIRE) < end) sched_yield();
+}
+int main(void) {
+    pthread_t thread;
+    smpt_guard.cpu = 1;
+    assert(!pthread_create(&thread, NULL, launch_guard, NULL));
+    while (!__atomic_load_n(&smpt_guard.ready, __ATOMIC_ACQUIRE)) sched_yield();
+    wait_passes(); assert(!__atomic_load_n(&sevs, __ATOMIC_ACQUIRE));
+    __atomic_store_n(&now, 99, __ATOMIC_RELEASE);
+    __atomic_store_n(&smpt_guard.deadline, 100, __ATOMIC_RELEASE);
+    wait_passes(); assert(!__atomic_load_n(&sevs, __ATOMIC_ACQUIRE));
+    __atomic_store_n(&now, 100, __ATOMIC_RELEASE);
+    while (__atomic_load_n(&sevs, __ATOMIC_ACQUIRE) < 2) sched_yield();
+    __atomic_store_n(&smpt_guard.stop, 1, __ATOMIC_RELEASE);
+    assert(!pthread_join(thread, NULL));
+    assert(__atomic_load_n(&smpt_guard.done, __ATOMIC_ACQUIRE));
+    puts("PASS peer guard: distinct CPU, no SEV before armed deadline, repeated SEV after expiry, stop acknowledgment");
+}
+'''
+
+raw_type = stage[stage.index('struct smpt_raw_stats {'):stage.index('static uint64_t\nsmpt_physical_read')]
+raw = common + '\n#define MAX(a,b) ((a)>(b)?(a):(b))\n#define SMPT_RAW_FORWARD_LIMIT 19200ULL\n' + raw_type
+raw += '\nstatic void\n' + function(stage, 'smpt_raw_step') + r'''
+int main(void) {
+    struct smpt_raw_stats s = { .first = 100, .last = 100 };
+    uint64_t v[] = {101,100,40000,40000,1,50000};
+    for (unsigned int i = 0; i < 6; i++) smpt_raw_step(&s, i + 1, v[i]);
+    assert(s.backward == 2 && s.zero == 1 && s.forward_max == 49999 && s.saved == 4);
+    assert(s.anomaly[0].index == 2 && s.anomaly[0].prev == 101 && s.anomaly[0].cur == 100);
+    assert(s.anomaly[1].index == 3 && s.anomaly[2].index == 5 && s.anomaly[3].index == 6);
+    smpt_raw_step(&s, 7, UINT64_MAX); smpt_raw_step(&s, 8, 0);
