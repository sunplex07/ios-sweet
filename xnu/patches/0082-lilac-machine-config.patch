+/*
+ * Loader handoff wall clock (fRTCBase) plus the elapsed time since it was
+ * captured; 0 when the loader provided none (calendar then starts from the
+ * system clock, as before).
+ */
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	if (fRTCBase == 0) {
+		return 0;
+	}
+	uint64_t elapsed;
+	absolutetime_to_nanoseconds(mach_absolute_time() - fRTCBaseAbs, &elapsed);
