+
+/* 0xFF in the 3 bytes of every pixel whose font bit is set (bit 0 = leftmost) */
+static void
+vc24_expand(unsigned int bits, uint64_t m[3])
+{
+	unsigned int k;
+
+	m[0] = m[1] = m[2] = 0;
+	for (k = 0; k < 24; k++) {
+		if (bits & (1u << (k / 3))) {
