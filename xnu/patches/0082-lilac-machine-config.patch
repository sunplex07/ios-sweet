+static void
+vc_paint_char_24(unsigned int xx, unsigned int yy, unsigned char ch, int attrs,
+    unsigned char ch_previous, int attrs_previous)
+{
+	const unsigned char *bitsp = iso_font + (ch * ISO_CHAR_HEIGHT);
+	const unsigned char *prevp = NULL;
+	uintptr_t where;
+	int i, w;
+
+	/*
+	 * As in vc_paint_char_32: gc_scroll_up/down pass ch_previous only when
+	 * the cell already shows it in the same colours, so glyph rows that
+	 * are identical need no framebuffer write.
+	 */
+	if (ch_previous && !attrs_previous && !attrs) {
+		prevp = iso_font + (ch_previous * ISO_CHAR_HEIGHT);
+	}
+
+	if (xx >= vinfo.v_columns || yy >= vinfo.v_rows) {
+		return;
+	}
+	where = vinfo.v_baseaddr + ((uintptr_t)yy * ISO_CHAR_HEIGHT * vinfo.v_rowbytes) +
+	    ((uintptr_t)xx * ISO_CHAR_WIDTH * 3);
+
+	for (i = 0; i < ISO_CHAR_HEIGHT; i++) {
+		uint64_t m[3], out[3];
+		const uint64_t *r = NULL;
+
+		if (prevp && prevp[i] == bitsp[i]) {
+			where += vinfo.v_rowbytes;
+			continue;
+		}
+		if (!attrs && vc_rendered_font &&
+		    vc_rendered_char_size == ISO_CHAR_HEIGHT * 3 * ISO_CHAR_WIDTH) {
+			r = (const uint64_t *)(vc_rendered_font + (ch * vc_rendered_char_size) + (i * 24));
+			if (((uintptr_t)r & 7) != 0) {
+				r = NULL;
+			}
+		}
+		if (r) {
+			m[0] = r[0];
+			m[1] = r[1];
+			m[2] = r[2];
+		} else {
+			unsigned int bits = bitsp[i];
+			if (attrs & ATTR_BOLD) {        /* a pixel is also set if its left neighbour is */
+				bits |= (bits << 1) & 0xFF;
+			}
+			if (attrs & ATTR_REVERSE) {
+				bits = ~bits & 0xFF;
+			}
+			if ((attrs & ATTR_UNDER) && i == ISO_CHAR_HEIGHT - 1) {
+				bits = ~bits & 0xFF;
+			}
+			vc24_expand(bits, m);
+		}
+		for (w = 0; w < 3; w++) {
+			out[w] = (vc24_back[w] & ~m[w]) | (vc24_fore[w] & m[w]);
+		}
+		vc24_store8(where, out);
+		where += vinfo.v_rowbytes;
+	}
+}
+
+static void
+vc_reverse_cursor_24(unsigned int xx, unsigned int yy)
+{
+	uintptr_t where;
+	int line, k;
+
+	if (xx >= vinfo.v_columns || yy >= vinfo.v_rows) {
+		return;
+	}
+	where = vinfo.v_baseaddr + ((uintptr_t)yy * ISO_CHAR_HEIGHT * vinfo.v_rowbytes) +
+	    ((uintptr_t)xx * ISO_CHAR_WIDTH * 3);
+	for (line = 0; line < ISO_CHAR_HEIGHT; line++) {
+		if ((where & 7) == 0) {
+			volatile uint64_t *d = (volatile uint64_t *)where;
+			d[0] = ~d[0];
+			d[1] = ~d[1];
+			d[2] = ~d[2];
+		} else {
+			volatile uint8_t *d = (volatile uint8_t *)where;
+			for (k = 0; k < 24; k++) {
+				d[k] = (uint8_t)~d[k];
+			}
+		}
+		where += vinfo.v_rowbytes;
+	}
+}
+
+static void
+vc_scroll_up_24(int num, unsigned int scrreg_top, unsigned int scrreg_bottom)
+{
+	uint32_t line, shift;
+
+	if (num <= 0 || scrreg_bottom > vinfo.v_rows || scrreg_top >= scrreg_bottom ||
+	    (unsigned int)num >= scrreg_bottom - scrreg_top) {
+		return;
+	}
+	shift = (uint32_t)num * ISO_CHAR_HEIGHT;
+	for (line = scrreg_top * ISO_CHAR_HEIGHT; line < (scrreg_bottom - (unsigned int)num) * ISO_CHAR_HEIGHT; line++) {
+		vc24_copy_line(line, line + shift);
+	}
+}
+
+static void
+vc_scroll_down_24(int num, unsigned int scrreg_top, unsigned int scrreg_bottom)
+{
+	uint32_t line, shift;
+
+	if (num <= 0 || scrreg_bottom > vinfo.v_rows || scrreg_top >= scrreg_bottom ||
+	    (unsigned int)num >= scrreg_bottom - scrreg_top) {
+		return;
+	}
+	shift = (uint32_t)num * ISO_CHAR_HEIGHT;
+	for (line = scrreg_bottom * ISO_CHAR_HEIGHT; line-- > (scrreg_top + (unsigned int)num) * ISO_CHAR_HEIGHT;) {
+		vc24_copy_line(line, line - shift);
+	}
+}
