+model = r'''
+static vm_offset_t ml_io_map(vm_offset_t p, vm_size_t size) {
+    (void)size; maps++; return p;
+}
+static uint8_t host_cmd_off;   /* PMIC offset commanded by the last EXT_READL */
+static uint32_t keys_rd(vm_offset_t b, uint32_t o) {
+    if (b == 0x0800f000) {
+        if (!o) return scenario == 8 ? 0x60000000 : 0x30000000;
+        if (o >= 0x800 && o < 0x1000) {
+            static const uint16_t ppids[512] = {
+                [4] = 0x008, [218] = 0x0c4, [219] = 0x0c5, [220] = 0x0c6, [221] = 0x0c7,
+            };
+            unsigned apid = (o - 0x800) / 4;
+            return ppids[apid] ? ((uint32_t)ppids[apid] << 8) : 0;
+        }
+        return 0;
+    }
+    assert(b >= 0x09400000 && b < 0x0a400000 && ((b - 0x09400000) % 0x8000) == 0);
+    unsigned apid = (unsigned)((b - 0x09400000) / 0x8000);
+    assert(apid == 4 || (apid >= 218 && apid <= 221));
+    if (o == 8) {   /* scenario 4: DONE with error bits; scenario 5: never DONE */
+        if (!obs_fails) return 1;
+        return scenario == 5 ? 0 : 3;
+    }
+    assert(o == 0x18);  /* data registers are only read after a command */
+    switch (host_cmd_off) {
+    case 0x10: return apid == 4 ? host_pon_rt : host_gpio_rt[apid - 218]; /* RT_STS */
+    case 0x05: return 0x10;                                        /* GPIO subtype */
+    case 0x40: return (scenario == 9 && apid == 220) ? 1 : 0;      /* mode */
+    case 0x46: return 0x80;                                        /* enabled */
+    default: abort();   /* any other PMIC offset is a test failure */
+    }
+}
+static void keys_wr(vm_offset_t b, uint32_t o, uint32_t v) {
+    if (b >= 0x09400000 && b < 0x0a400000) {
+        /* Every PMIC-region store must be an EXT_READL command word. */
+        assert(o == 0 && (v >> 27) == 1 && (v & 7) == 0);
+        assert(((b - 0x09400000) % 0x8000) == 0);
+        host_cmd_off = (uint8_t)((v >> 4) & 0xff);
+        return;
+    }
+    abort();
+}
+'''
+main = r'''
+static void expect_hid(unsigned n, const int (*seq)[2]) {
+    assert(hid_n == n);
