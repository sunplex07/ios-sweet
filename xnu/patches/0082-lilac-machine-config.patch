+    case 1: { /* each press/release is exactly one HID down/up pair */
+        static const int seq[6][2] = {{0,1},{0,0},{2,1},{2,0},{1,1},{1,0}};
+        host_pon_rt = 1; keys_poll(); keys_poll();   /* power */
+        host_pon_rt = 0; keys_poll(); keys_poll();
+        host_gpio_rt[0] = 0; keys_poll(); keys_poll(); /* vol- */
+        host_gpio_rt[0] = 1; keys_poll(); keys_poll();
+        host_gpio_rt[1] = 0; keys_poll(); keys_poll(); /* vol+ */
+        host_gpio_rt[1] = 1; keys_poll(); keys_poll();
+        expect_hid(6, seq);
+        break;
+    }
+    case 2:  /* one 50 ms glitch is rejected by the two-sample debounce */
+        host_pon_rt = 1; keys_poll();
+        host_pon_rt = 0; keys_poll(); keys_poll();
+        assert(hid_n == 0);
+        break;
+    case 3:  /* camera/focus/resin log only; never a sweet_hid_key call */
+        host_gpio_rt[2] = 0; keys_poll(); keys_poll();   /* camera */
+        host_gpio_rt[2] = 1; keys_poll(); keys_poll();
+        host_gpio_rt[3] = 0; keys_poll(); keys_poll();   /* focus */
+        host_gpio_rt[3] = 1; keys_poll(); keys_poll();
