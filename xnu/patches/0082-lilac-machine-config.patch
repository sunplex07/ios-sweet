+ */
+void
+sweet_sample_lilac_start(void)
+{
+	static bool started;
+	char extra[128];
+	thread_t thread;
+
+	if (started) {
+		return;
+	}
+	if (!PE_parse_boot_argn("sweetsample", extra, sizeof(extra))) {
+		return;
+	}
+	if (extra[0] == '-') {
+		return;
+	}
+	started = true;
+	strlcpy(sweet_sample_lilac_names, sweet_sample_lilac_default,
+	    sizeof(sweet_sample_lilac_names));
+	if (extra[0] != 0) {
+		strlcat(sweet_sample_lilac_names, ",", sizeof(sweet_sample_lilac_names));
+		strlcat(sweet_sample_lilac_names, extra, sizeof(sweet_sample_lilac_names));
+	}
+	printf("SMP --- sampler started: %s\n", sweet_sample_lilac_names);
+	if (kernel_thread_start(sweet_sample_lilac_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
