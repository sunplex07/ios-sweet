+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,21 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(ARM64_BOARD_CONFIG_LILAC)
+	/* ARMv8.0 (no LSE): single-shot CAS 0->1 with acquire via LL/SC.
+	 * w10 = observed value (0 on success), like casa. */
+1:
+	ldaxr	w10, [x3]
+	cbnz	w10, 2f
+	stxr	w12, w11, [x3]
+	cbnz	w12, 1b
+	b	3f
+2:
+	clrex
+3:
+#else
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#endif
