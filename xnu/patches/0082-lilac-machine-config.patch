+/* 19.2 MHz XO / 355 kHz bus. 355000 > I2C_MAX_STANDARD_MODE_FREQ (100000,
+ * include/linux/i2c.h:44), so ML i2c-qup.c:1898-1901 takes the fast-mode
+ * branch: fs_div = ((19200000/355000)-6)*2/3 = (54-6)*2/3 = 32, clk_ctl =
+ * ((fs_div/2)<<16)|(hs_div 3<<8)|fs_div = 0x00100320. K44 i2c-msm-v2.c:420-424
+ * tables the same 355 kHz fs 32 / ht 16 (noise rejection 0: not set in the
+ * K44 QUP5 DT, msm8998-blsp.dtsi:165-189). The old 0x318 was the
+ * standard-mode formula (fs 24, no high-time field). */
+#define QUP_CLK_CTL_355K ((16u << 16) | (3u << 8) | 32u)
+#define RESET_HOLD_MS 11u              /* hybrid pw-wait-after-off-touch-reset */
+#define RESET_DELAY_MS 220u            /* K44 hwreset_delay_for_powerup_ms */
+#define TOUCH_POLL_MS 10u              /* 100 Hz poll of IRQ125 */
+
+/* SPMI PMIC arbiter v2/v3 (spmi-pmic-arb.c; version gate as lilac_keys). */
+#define SPMI_CORE_PA 0x0800f000ull     /* APID map at +0x800+4*apid, PPID 19:8 */
+#define SPMI_CNFG_PA 0x0800a000ull     /* PERIPH2OWNER at +0x700+4*apid */
+#define SPMI_CHNL_PA 0x08400000ull     /* command channels: +0x8000*apid+0x1000*ee */
+#define SPMI_OBS_PA  0x09400000ull     /* observer alias of the same channels */
+#define SPMI_APS_MAX 512u
+#define SPMI_CMD_DONE 0x1u
+#define SPMI_CMD_ERR  0xeu             /* failure|denied|dropped (status 3:1) */
+
+/* PM8998 LDO peripheral (SID1). LDO n base = 0x4000+0x100*(n-1). */
+#define LDO_L14_BASE 0x4d00u           /* panel VDDIO 1.8 V (read-only here) */
+#define LDO_L28_BASE 0x5b00u           /* touch AVDD 3.0 V */
+#define LDO_L14_PPID 0x014du           /* SID1<<8 | 0x4d */
+#define LDO_L28_PPID 0x015bu           /* SID1<<8 | 0x5b */
+#define LDO_REG_TYPE   0x04u           /* peripheral TYPE register value: LDO */
+#define LDO_REG_SUBTYPE 0x05u
+/* PM8998 LDO28 is subtype 0x35 (HT_P150) and LDO14 0x3c (HT_LVP300): HFS430-style
+ * regulators whose voltage is VOLTAGE_LSB/MSB (+0x40/+0x41) in millivolts
+ * (ML qcom_spmi-regulator.c: SPMI_VREG(LDO, HT_P150, ..., HFS430, ...) at :1589,
+ * spmi_regulator_ftsmps426_get_voltage/set_voltage :894-946). Read live on the
+ * phone under Android #44 (regmap spmi0-01): 5b04=04 5b05=35 5b40=b8 5b41=0b
+ * (0x0bb8 = 3000 mV) with 5b46=00 screen off / 80 screen on; 4d40=08 4d41=07
+ * (1800 mV). The voltage is already programmed to 3.0 V while disabled, so the
+ * only write ever needed is EN_CTL +0x46 bit7 (regulator_enable_regmap). */
+#define LDO_REG_VLSB   0x40u
+#define LDO_REG_VMSB   0x41u
+#define LDO_REG_EN     0x46u
+#define LDO_EN_BIT     0x80u
+#define LDO_SUBTYPE_HT_P150   0x35u
+#define LDO_SUBTYPE_HT_LVP300 0x3cu
+#define L28_MV 3000u                   /* K44 yoshino: min=max 3000000 uV */
+#define L28_MV_LO 2950u                /* accepted inherited window (no write) */
+#define L28_MV_HI 3100u
+#define L14_MV 1800u
+
+/* RMI4 (clearpad_core.c). */
+#define RMI_ADDR 0x2cu
+#define RMI_PDT_END 0xe9u              /* lowest PDT entry; walk downward */
+#define RMI_PDT_PAGES 4u               /* SYN_SUPPORTED_PAGE_NUM */
+#define RMI_PDT_MAX 39u                /* 0xef..0x05 / 6 */
+#define RMI_PAGE_SEL 0xffu
+#define RMI_F01 0x01u
+#define RMI_F12 0x12u
+#define F01_PRODUCT_Q 11u              /* F01_RMI_QUERY11, 10 bytes */
+#define F12_PRESENCE_MAX 32u           /* register presence descriptor bytes */
+#define F12_REG_MAX 32u                /* per-type decoded offsets */
+#define F12_OBJ_BYTES 8u               /* type,xl,xh,yl,yh,z,wx,wy */
+#define F12_SLOTS_MAX 10u
+#define TOUCH_SLOTS F12_SLOTS_MAX
+
+static vm_offset_t gcc, east, west, qup;
+static bool qup_dead;
+static unsigned qup_out_fifo, qup_in_fifo;   /* bytes, from QUP_IO_MODE (T3) */
+static unsigned nibble_bits;
+static bool stage_failed;
+static bool touch_in_thread;           /* sleep with thread_block, not delay() */
+
+/* Discovered F12 geometry (page-local bases, presence-decoded offsets). */
+static uint8_t f01_page, f12_page, f01_query, f01_data, f01_ctrl;
+static uint8_t f12_query, f12_ctrl, f12_data;
+/* F12 bits in F01 interrupt status, assigned in PDT walk order (clearpad_core.c:1688-1690). */
+static uint8_t f12_irq_mask, t8_irqst_last;
+static uint8_t f12_ctrl_off[F12_REG_MAX], f12_data_off[F12_REG_MAX];
+static uint16_t f12_xmax, f12_ymax;
+static uint8_t f12_slots, f12_objbytes;
+static char f01_product[11];
+
+/* T8 contact state (slot -> down + last injected panel coords). */
+static bool slot_down[TOUCH_SLOTS];
+static int slot_x[TOUCH_SLOTS], slot_y[TOUCH_SLOTS];
+static vm_offset_t irq125_io;          /* TLMM EAST 125 io reg (read-only) */
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static uint32_t
+tlmm_rd(vm_offset_t tile, unsigned gpio, uint32_t off)
+{
+	return touch_rd(tile, gpio * 0x1000u + off);
+}
+
+/* Log + write + read back. Returns the read-back value. */
+static uint32_t
+wr_rb(const char *what, vm_offset_t base, uint32_t off, uint32_t v)
+{
+	uint32_t before = touch_rd(base, off);
+	printf("LILAC TOUCH: %s [%llx+%x] before=%08x write=%08x\n",
+	    what, (unsigned long long)base, off, before, v);
+	touch_wr(base, off, v);
+	uint32_t after = touch_rd(base, off);
+	printf("LILAC TOUCH: %s [%llx+%x] after=%08x\n",
+	    what, (unsigned long long)base, off, after);
+	return after;
+}
+
+static bool
+fail(const char *msg)
+{
+	printf("LILAC TOUCH: FAIL %s (stopped; no repair, no retry)\n", msg);
+	stage_failed = true;
+	return false;
+}
+
+/* Sleep ms in the touch thread, busy-wait during the boot-context stages. */
+static void
+touch_sleep_ms(unsigned ms)
+{
+	if (!touch_in_thread) {
+		delay(ms * 1000u);
+		return;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&qup_dead /* chan unused */, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- SPMI PMIC arbiter v2 (observer reads; EE0 command-channel writes) --- */
+
+static vm_offset_t spmi_core, spmi_cnfg;
+
+static bool
+spmi_map(void)
+{
+	uint32_t version;
+
+	spmi_core = ml_io_map(SPMI_CORE_PA, 0x1000);
+	spmi_cnfg = ml_io_map(SPMI_CNFG_PA, 0x1000);
+	if (!spmi_core || !spmi_cnfg) {
+		return false;
+	}
+	version = touch_rd(spmi_core, 0);
+	printf("LILAC TOUCH T6: SPMI arb=%08x EE=0\n", version);
+	if (version < 0x20010000u || version >= 0x50000000u) {
+		printf("LILAC TOUCH T6: FAIL unsupported SPMI version\n");
+		return false;
+	}
+	return true;
+}
+
+static bool
+spmi_apid(unsigned ppid, unsigned *apid)
+{
+	for (unsigned a = 0; a < SPMI_APS_MAX; a++) {
+		uint32_t map = touch_rd(spmi_core, 0x800 + 4 * a);
+		if (map && ((map >> 8) & 0xfffu) == ppid) {
+			*apid = a;
+			return true;
+		}
+	}
+	return false;
+}
+
+/* One-byte EXT_READL on the observer alias of the APID's channel. */
+static bool
+spmi_obs_read(vm_offset_t obs, uint8_t off, uint8_t *v)
+{
+	touch_wr(obs, 0, (1u << 27) | ((uint32_t)off << 4));
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t st = touch_rd(obs, 8);
+		if (st & SPMI_CMD_DONE) {
+			if (st & SPMI_CMD_ERR) {
+				return false;
+			}
+			*v = (uint8_t)touch_rd(obs, 0x18);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* One-byte EXT_WRITEL through the EE0 command channel: opcode 0
+ * (PMIC_ARB_OP_EXT_WRITEL), fmt_cmd_v2 = (opc<<27)|((addr&0xff)<<4)|bc,
+ * WDATA +0x10, CMD +0, STATUS +8 (spmi-pmic-arb.c:36-41,73-84,1428-1435). */
+static bool
+spmi_chn_write(vm_offset_t chn, uint8_t off, uint8_t v)
+{
+	touch_wr(chn, 0x10, v);
+	touch_wr(chn, 0, ((uint32_t)off << 4) | 0u);
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t st = touch_rd(chn, 8);
+		if (st & SPMI_CMD_DONE) {
+			return !(st & SPMI_CMD_ERR);
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* ---- T1: read-only snapshot ------------------------------------------- */
+
+/* L28 status reading is deferred to stage 97 (T6), where the enable logic
+ * lives: the base is now established as PM8998 SID1 0x4000+0x100*(28-1) =
+ * 0x5b00 (the LDO convention of every tabled PMIC in ML qcom_spmi-regulator.c,
+ * e.g. pm8994/pm8950/pm660 l1@0x4000 l2@0x4100 at :2019-2340, while this
+ * phone's own firmware DT confirms the PMIC's buck convention 0x1400+0x300*
+ * (n-1) via pm8998_s10@0x2f00/s13@0x3800, research/os-loader/
+ * firmware-lilac-decompiled.dts:1423-1447); T1 itself stays read-only on
+ * TLMM/GCC only, so stage 92 output remains comparable with INPUT86/T1. */
+static void
+touch_l28_note(void)
+{
+	printf("LILAC TOUCH T1: L28 status read DEFERRED to stage 97 (T6): PM8998 "
+	    "LDO28 SPMI base 0x5b00 (LDO layout per ML qcom_spmi-regulator.c); "
+	    "T1 performs no PMIC access\n");
+}
+
+/* Snapshot TLMM 87/88/89/125/133 + GCC. bit0 all reads done, bit1 87/88 still
+ * function 0, bit2 89/133 still output-low, bit3 GCC still gated as INPUT86. */
+static void
+t1_snapshot(void)
+{
+	uint32_t c87 = tlmm_rd(east, 87, 0), i87 = tlmm_rd(east, 87, 4);
+	uint32_t c88 = tlmm_rd(east, 88, 0), i88 = tlmm_rd(east, 88, 4);
+	uint32_t c89 = tlmm_rd(east, 89, 0), i89 = tlmm_rd(east, 89, 4);
+	uint32_t c125 = tlmm_rd(east, 125, 0), i125 = tlmm_rd(east, 125, 4);
+	uint32_t c133 = tlmm_rd(west, 133, 0), i133 = tlmm_rd(west, 133, 4);
+	printf("LILAC TOUCH T1: TLMM87 cfg=%08x io=%08x 88 cfg=%08x io=%08x\n",
+	    c87, i87, c88, i88);
+	printf("LILAC TOUCH T1: TLMM89 cfg=%08x io=%08x IRQ125 cfg=%08x io=%08x "
+	    "VIO133 cfg=%08x io=%08x\n", c89, i89, c125, i125, c133, i133);
+	uint32_t ahb = touch_rd(gcc, GCC_AHB_CBCR);
+	uint32_t branch = touch_rd(gcc, GCC_QUP5_CBCR);
+	uint32_t cmd = touch_rd(gcc, GCC_QUP5_CMD);
+	uint32_t cfg = touch_rd(gcc, GCC_QUP5_CFG);
+	uint32_t vote = touch_rd(gcc, GCC_AHB_VOTE);
+	printf("LILAC TOUCH T1: GCC ahb=%08x qup5=%08x rcg=%08x cfg=%08x vote=%08x\n",
+	    ahb, branch, cmd, cfg, vote);
+	touch_l28_note();
+	nibble_bits = 1u;
+	bool unchanged = true;
+	if (((c87 >> 2) & 15u) == 0u && ((c88 >> 2) & 15u) == 0u) {
+		nibble_bits |= 2u;
+	} else {
+		unchanged = false;
+		printf("LILAC TOUCH T1: mux 87/88 already changed (87=%u 88=%u)\n",
+		    (c87 >> 2) & 15u, (c88 >> 2) & 15u);
+	}
+	if (!(i89 & 3u) && !(i133 & 3u)) {
+		nibble_bits |= 4u;
+	} else {
+		unchanged = false;
+		printf("LILAC TOUCH T1: 89/133 no longer output-low (io89=%08x io133=%08x)\n",
+		    i89, i133);
+	}
+	if ((branch & CLK_OFF) && !(vote & GCC_AHB_VOTE_BIT) && cfg == 0u) {
+		nibble_bits |= 8u;
+	} else {
+		unchanged = false;
+		printf("LILAC TOUCH T1: GCC state changed vs INPUT86\n");
+	}
+	if (!unchanged) {
+		/* Pass = unchanged (doc T1): stop before any later write step. */
+		(void)fail("T1 baseline differs from INPUT86 snapshot");
+	} else {
+		printf("LILAC TOUCH T1: PASS unchanged snapshot (bits %x)\n", nibble_bits);
+	}
+}
+
+/* ---- T2 = W1: TLMM87/88 mux ------------------------------------------- */
+
+/* K44 msm8998-yoshino-common.dtsi:2939-2967 and ML msm8998.dtsi:1231-1243
+ * mux gpio87/88 to blsp_i2c5 (function index 3, pinctrl-msm8998.c:1429-1431)
+ * with drive 2 mA and bias disabled - the measured baseline cfg 0 already
+ * encodes 2 mA (drv 0) and no pull, so only the mux field is modified and
+ * every other bit is preserved. */
+static void
+t2_mux_w1(void)
+{
+	nibble_bits = 0u;   /* the selected stage's own steps define the nibble */
+	for (unsigned gpio = 87; gpio <= 88; gpio++) {
+		uint32_t old = tlmm_rd(east, gpio, 0);
+		uint32_t v = (old & ~TLMM_MUX_MASK) | (TLMM_MUX_FUNC_I2C5 << 2);
+		uint32_t after = wr_rb("T2 W1 TLMM mux", east, TLMM_CFG_OFF(gpio), v);
+		if (((after >> 2) & 15u) != TLMM_MUX_FUNC_I2C5) {
+			fail("TLMM mux readback");
+			return;
+		}
+		if ((after & ~TLMM_MUX_MASK) != (old & ~TLMM_MUX_MASK)) {
+			fail("TLMM mux readback disturbed other bits");
+			return;
+		}
+	}
+	uint32_t i87 = tlmm_rd(east, 87, 4), i88 = tlmm_rd(east, 88, 4);
+	printf("LILAC TOUCH T2: PASS W1 mux=3 io87=%08x io88=%08x\n", i87, i88);
+	nibble_bits = 7u;   /* both muxed, other bits preserved, io readable */
+}
+
+/* ---- T3 = W2+W3+W4 ---------------------------------------------------- */
+
+static void
+t3_clocks_w2_w3_w4(void)
+{
+	nibble_bits = 0u;
+	/* W2: APPS AHB vote, read-modify-write preserving every other vote bit
+	 * (gcc_blsp1_ahb_clk is BRANCH_VOTED: enable_reg 0x52004 bit17,
+	 * gcc-msm8998.c:1448-1458; clk_branch2 enable is an RMW that sets only
+	 * its own mask). */
+	uint32_t vote = touch_rd(gcc, GCC_AHB_VOTE);
+	uint32_t vote2 = wr_rb("T3 W2 AHB vote RMW", gcc, GCC_AHB_VOTE,
+	    vote | GCC_AHB_VOTE_BIT);
+	if (!(vote2 & GCC_AHB_VOTE_BIT)) {
+		fail("AHB vote readback");
+		return;
+	}
+	if ((vote2 & ~GCC_AHB_VOTE_BIT) != (vote & ~GCC_AHB_VOTE_BIT)) {
+		fail("AHB vote RMW disturbed other bits");
+		return;
+	}
+	uint32_t ahb = touch_rd(gcc, GCC_AHB_CBCR);
+	printf("LILAC TOUCH T3: AHB CBCR %08x\n", ahb);
+	if (ahb & CLK_OFF) {
+		fail("AHB branch still off after vote");
+		return;
+	}
+	nibble_bits |= 1u;
+
+	/* W3: QUP5 source RCG to XO 19.2 MHz. gcc-msm8998.c:598-609,469-473,
+	 * 411-419: parent index 0 is XO, F(19200000, P_XO, 1, 0, 0), so CFG =
+	 * (src 0 << 3) | (div 1 - 1) = 0; clk-rcg2.c:36-39,121-122 then writes
+	 * CMD_UPDATE bit0 at cmd_rcgr 0x21020 and polls it clear. */
+	uint32_t cfg2 = wr_rb("T3 W3 RCG CFG", gcc, GCC_QUP5_CFG, 0u);
+	if (cfg2 != 0u) {
+		fail("RCG CFG readback");
+		return;
+	}
+	nibble_bits |= 2u;
+	wr_rb("T3 W3 RCG UPDATE", gcc, GCC_QUP5_CMD, CMD_UPDATE);
+	for (unsigned i = 0; i < 100; i++) {
+		if (!(touch_rd(gcc, GCC_QUP5_CMD) & CMD_UPDATE)) {
+			break;
+		}
+		if (i == 99) {
+			fail("RCG UPDATE not clearing");
+			return;
+		}
+		delay(1);
+	}
+
+	/* W4: QUP5 I2C branch enable, 0x21008 bit0 (gcc-msm8998.c:1605-1620,
+	 * BRANCH_HALT: bit31 is CLK_OFF and must clear once enabled). */
+	(void)wr_rb("T3 W4 QUP5 branch", gcc, GCC_QUP5_CBCR,
+	    touch_rd(gcc, GCC_QUP5_CBCR) | 1u);
+	for (unsigned i = 0; i < 100; i++) {
+		if (!(touch_rd(gcc, GCC_QUP5_CBCR) & CLK_OFF)) {
+			break;
+		}
+		if (i == 99) {
+			fail("QUP5 branch still off");
+			return;
+		}
+		delay(1);
+	}
+
+	/* Only now is the QUP clocked and safely readable. Plausibility per doc
+	 * T3: non-degenerate HW_VERSION (ML msm8998.dtsi:2392-2405 identifies
+	 * QUP v2.2.1) and a valid/reset sequencer state. */
+	uint32_t hw = touch_rd(qup, Q_HW), state = touch_rd(qup, Q_STATE);
+	uint32_t io = touch_rd(qup, Q_IO);
+	printf("LILAC TOUCH T3: QUP5 hw=%08x state=%08x io=%08x\n", hw, state, io);
+	if (hw == 0u || hw == 0xffffffffu || (state & 7u) != 4u) {
+		fail("QUP5 not plausible after clock-on");
+		return;
+	}
+	const unsigned block_bytes[3] = {4, 16, 32};
+	unsigned ob = io & 3u, ib = (io >> 5) & 3u;
+	unsigned out_sz = block_bytes[ob] * (2u << ((io >> 2) & 7u));
+	unsigned in_sz = block_bytes[ib] * (2u << ((io >> 7) & 7u));
+	printf("LILAC TOUCH T3: QUP5 fifo out=%u in=%u\n", out_sz, in_sz);
+	qup_out_fifo = out_sz;
+	qup_in_fifo = in_sz;
+	if (out_sz < 9u || in_sz < 3u) {
+		fail("QUP5 FIFO geometry");
+		return;
+	}
+	printf("LILAC TOUCH T3: PASS W2+W3+W4 (vote, RCG XO 19.2 MHz, branch on)\n");
+	nibble_bits |= 4u;
+}
+
+/* ---- W8: QUP5 v2 FIFO transfer = ML i2c-qup.c qup_i2c_xfer_v2 ----------- */
+
+/* Mainline (lilac-mainline linux-6.18.58 drivers/i2c/busses/i2c-qup.c) facts
+ * this engine reproduces, per I2C message, exactly:
+ *  - CONFIG = I2C_MINI_CORE|I2C_N_VAL_V2 = 0x207 (:74,:76,:1590), plus
+ *    QUP_NO_INPUT BIT(7) for a sub-transfer without RX (:72,:1171) -> 0x287;
+ *  - IO_MODE = QUP_REPACK_EN 0xc000, FIFO both ways, OUTPUT/INPUT_CNT = 0
+ *    (qup_i2c_conf_mode_v2 :1182-1202);
+ *  - tags (qup_i2c_set_tags :569-614): START, addr8 = addr7<<1 | R/W
+ *    (i2c_8bit_addr_from_msg, include/linux/i2c.h:948-951), then DATAWR(0x82)
+ *    or DATARD_NACK(0x86) for a non-last message, DATAWR_STOP(0x83) or
+ *    DATARD_STOP(0x87) for the last one, then the length;
+ *  - WRITE_CNT includes the tags: tags+data for a write, tags only for a
+ *    read; READ_CNT = 2-byte RX tag prefix + data (qup_i2c_xfer_v2_msg
+ *    :1477-1484, conf_count_v2 :1151-1175); every sub-transfer after the
+ *    first carries QUP_I2C_MX_CONFIG_DURING_RUN BIT(31) (:124,:1398);
+ *  - state: SW_RESET -> RESET, CONFIG, MASTER_GEN=1 (tags v2), poll MAST_GEN
+ *    (:1584-1596); first sub-transfer RUN, CLK_CTL, PAUSE (:1404-1414); FIFO
+ *    filled while PAUSED (:1422-1429); RUN (:1431); wait; PAUSE again unless
+ *    it was the last message (:1439-1444); after the last message wait for
+ *    !BUS_ACTIVE (:1617-1618) and go to RESET (:1620-1621);
+ *  - a write+read register access is TWO messages (rmi_i2c_read_block,
+ *    drivers/input/rmi4/rmi_i2c.c:127-160): the read tags are queued only
+ *    after the write sub-transfer completed, and a NACK on the write ends
+ *    the transfer (-ENXIO, qup_i2c_wait_for_complete :928-944) - no read is
+ *    ever issued. The old engine loaded "81 58 82 01 reg 81 59 87 n" as ONE
+ *    sub-transfer (WRITE_CNT 9, CONFIG 0x207), which is what i2c-msm-v2 does
+ *    but not i2c-qup, and that is the transfer that latched bit24
+ *    INVALID_READ_ADDR on the device (T7b raw 0x011363c8);
+ *  - NACK = I2C_STATUS bit3 (QUP_I2C_NACK_FLAG :60, decoded :296,:941),
+ *    errors = I2C_STATUS & 0x38000fc and ERROR_FLAGS & 0x7c, both W1C
+ *    (qup_i2c_interrupt :306-315). The raw value is recorded BEFORE the W1C.
+ *  - FIFO mode only while tx <= out_fifo-QUP_MAX_TAGS_LEN and rx <=
+ *    in_fifo-READ_RX_TAGS_LEN (:1557-1560): 64-byte FIFOs (T3) -> 60 bytes.
+ * OPERATIONAL_MASK / ERROR_FLAGS_EN are not written (i2c-qup.c's v2 FIFO path
+ * does not touch them; this is a polled driver). */
+#define Q_CFG_V2 0x207u
+#define Q_CFG_NO_INPUT 0x80u
+#define Q_CNT_DURING_RUN 0x80000000u
+#define Q_IO_FIFO_REPACK 0xc000u
+#define Q_ST_ERR_MASK 0x038000fcu
+#define Q_ST_NACK 0x8u
+#define Q_ST_BUS_ACTIVE 0x100u
+#define Q_ERR_MASK 0x7cu
+#define Q_OP_IN_NOT_EMPTY 0x20u
+#define Q_OP_SVC 0x300u
+#define Q_OP_OUT_DONE 0x400u
+#define TAG_START 0x81u
+#define TAG_DATAWR 0x82u
+#define TAG_DATAWR_STOP 0x83u
+#define TAG_DATARD_NACK 0x86u
+#define TAG_DATARD_STOP 0x87u
+#define TOUCH_I2C_MAX 60u
+
+static bool
+qup_wait_state(unsigned want)
+{
+	for (unsigned i = 0; i < 100; i++) {
+		if ((touch_rd(qup, Q_STATE) & 7u) == (4u | want)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* qup_i2c_change_state :430-440: require VALID, write, poll. */
+static bool
+qup_state(unsigned want)
+{
+	if (!(touch_rd(qup, Q_STATE) & 4u)) {
+		return false;
+	}
+	touch_wr(qup, Q_STATE, want);
+	return qup_wait_state(want);
+}
+
+enum {
+	XFER_OK = 0,
+	XFER_NACK,
+	XFER_BUSERR,
+	XFER_TIMEOUT,
+	XFER_HW,
+};
+
+struct touch_msg {
+	uint8_t addr7;
+	bool rd;
+	uint8_t *buf;
+	unsigned len;
+};
+
+static unsigned xfer_status, xfer_op, xfer_err, xfer_hit_status, xfer_hit_err;
+static unsigned xfer_msg, xfer_num, xfer_got;
+static uint8_t xfer_tags[4], xfer_rx_tag[2];
+
+static const char *
+xfer_name(unsigned v)
+{
+	static const char *const n[] = { "ACK", "NACK", "BUS-ERROR", "TIMEOUT", "HW" };
+	return n[v > XFER_HW ? XFER_HW : v];
+}
+
+/* Error check of one poll step; records the raw registers before the W1C. */
+static int
+qup_check_errors(uint32_t status, uint32_t err)
+{
+	if (err & Q_ERR_MASK) {
+		xfer_hit_status = status;
+		xfer_hit_err = err;
+		touch_wr(qup, Q_ERR, err & Q_ERR_MASK);           /* W1C */
+		if (status & Q_ST_ERR_MASK) {
+			touch_wr(qup, Q_STATUS, status & Q_ST_ERR_MASK);
+		}
+		return (status & Q_ST_NACK) ? XFER_NACK : XFER_BUSERR;
+	}
+	if (status & Q_ST_ERR_MASK) {
+		xfer_hit_status = status;
+		xfer_hit_err = err;
+		touch_wr(qup, Q_STATUS, status & Q_ST_ERR_MASK);  /* W1C */
+		return (status & Q_ST_NACK) ? XFER_NACK : XFER_BUSERR;
+	}
+	return XFER_OK;
+}
+
+/* Wait for one running sub-transfer: a write is complete on MX_OUTPUT_DONE
+ * (qup_i2c_interrupt :365-375), a read once the 2 RX tag bytes + data have
+ * been drained (qup_i2c_read_rx_fifo_v2 :1263-1275; the tag bytes are
+ * discarded by i2c-qup and only logged here). */
+static int
+qup_poll(const struct touch_msg *msg)
+{
+	uint8_t rxb[TOUCH_I2C_MAX + 4u];
+	unsigned need = msg->rd ? msg->len + 2u : 0u, got = 0, i, j;
+	int v;
+
+	for (i = 0; i < 20000u; i++) {
+		uint32_t status = touch_rd(qup, Q_STATUS);
+		uint32_t err = touch_rd(qup, Q_ERR);
+		uint32_t op = touch_rd(qup, Q_OP);
+
+		v = qup_check_errors(status, err);
+		if (v != XFER_OK) {
+			xfer_got = got;
+			return v;
+		}
+		if (op & Q_OP_SVC) {
+			touch_wr(qup, Q_OP, op & Q_OP_SVC);   /* W1C, :338-351 */
+		}
+		while (got < need && (touch_rd(qup, Q_OP) & Q_OP_IN_NOT_EMPTY)) {
+			uint32_t w = touch_rd(qup, Q_IN);
+			for (j = 0; j < 4u && got < need; j++, got++) {
+				rxb[got] = (uint8_t)(w >> (8u * j));
+			}
+		}
+		if (msg->rd ? got == need : (op & Q_OP_OUT_DONE) != 0u) {
+			if (msg->rd) {
+				xfer_rx_tag[0] = rxb[0];
+				xfer_rx_tag[1] = rxb[1];
+				memcpy(msg->buf, rxb + 2, msg->len);
+			}
+			xfer_got = got;
+			return XFER_OK;
+		}
+		delay(1);
+	}
+	xfer_got = got;
+	return XFER_TIMEOUT;
+}
+
+/* One message = one QUP v2 sub-transfer (qup_i2c_xfer_v2_msg/conf_xfer_v2). */
+static int
+touch_i2c_sub(const struct touch_msg *msg, bool first, bool last)
+{
+	uint8_t out[4u + TOUCH_I2C_MAX];
+	uint32_t run = first ? 0u : Q_CNT_DURING_RUN, word;
+	unsigned n = 0, i, j;
+	int v;
+
+	out[n++] = TAG_START;
+	out[n++] = (uint8_t)((msg->addr7 << 1) | (msg->rd ? 1u : 0u));
+	if (last) {
+		out[n++] = msg->rd ? TAG_DATARD_STOP : TAG_DATAWR_STOP;
+	} else {
+		out[n++] = msg->rd ? TAG_DATARD_NACK : TAG_DATAWR;
+	}
+	out[n++] = (uint8_t)msg->len;
+	memcpy(xfer_tags, out, 4u);
+	if (!msg->rd) {
+		memcpy(out + n, msg->buf, msg->len);
+		n += msg->len;
+	}
+	touch_wr(qup, Q_WRITE_CNT, run | n);
+	if (msg->rd) {
+		touch_wr(qup, Q_READ_CNT, run | (msg->len + 2u));
+		touch_wr(qup, Q_CONFIG, Q_CFG_V2);
+	} else {
+		touch_wr(qup, Q_CONFIG, Q_CFG_V2 | Q_CFG_NO_INPUT);
+	}
+	if (first) {
+		if (!qup_state(1)) {
+			return XFER_HW;
+		}
+		touch_wr(qup, Q_CLK, QUP_CLK_CTL_355K);
+		if (!qup_state(3)) {
+			return XFER_HW;
+		}
+	}
+	/* LE-packed words, trailing partial word flushed (:1282-1311,:1362) */
+	for (i = 0; i < n; i += 4u) {
+		word = 0;
+		for (j = 0; j < 4u && i + j < n; j++) {
+			word |= (uint32_t)out[i + j] << (8u * j);
+		}
+		touch_wr(qup, Q_OUT, word);
+	}
+	if (!qup_state(1)) {
+		return XFER_HW;
+	}
+	v = qup_poll(msg);
+	if (v != XFER_OK) {
+		return v;
+	}
+	if (!last && !qup_state(3)) {
+		return XFER_HW;
+	}
+	return XFER_OK;
+}
+
+/* qup_i2c_xfer_v2 for 1 message, or write+read (2 messages). Returns the
+ * verdict; ACK only when every message completed, no error bit was seen and
+ * the bus went idle. On failure the raw I2C_STATUS/ERROR_FLAGS (before W1C)
+ * and the failing message's tags are logged; the QUP is left in RESET. */
+static int
+touch_i2c_xfer(const struct touch_msg *msgs, unsigned num)
+{
+	uint32_t st0, er0, status = 0;
+	unsigned m, i;
+	int v = XFER_OK;
+
+	xfer_status = xfer_op = xfer_err = xfer_hit_status = xfer_hit_err = 0;
+	xfer_msg = xfer_got = 0;
+	xfer_num = num;
+	memset(xfer_tags, 0, sizeof(xfer_tags));
+	xfer_rx_tag[0] = xfer_rx_tag[1] = 0;
+	if (!qup || qup_dead || num == 0u || num > 2u ||
+	    (num == 2u && (msgs[0].rd || !msgs[1].rd))) {
+		return XFER_HW;
+	}
+	for (m = 0; m < num; m++) {
+		if (!msgs[m].buf || msgs[m].len == 0u || msgs[m].len > TOUCH_I2C_MAX) {
+			return XFER_HW;   /* no zero-length (I2C_AQ_NO_ZERO_LEN :1651-1657) */
+		}
+		/* FIFO mode only (qup_i2c_determine_mode_v2 :1557-1560) */
+		if (msgs[m].rd ? msgs[m].len + 2u > qup_in_fifo :
+		    msgs[m].len + 4u > qup_out_fifo) {
+			return XFER_HW;
+		}
+	}
+	if (touch_rd(qup, Q_STATUS) & Q_ST_BUS_ACTIVE) {
+		printf("LILAC TOUCH: FAIL I2C bus-active before transfer\n");
+		qup_dead = true;
+		return XFER_HW;
+	}
+	touch_wr(qup, Q_RESET, 1);
+	if (!qup_wait_state(0)) {
+		v = XFER_HW;
+		goto seq_out;
+	}
+	/* Sticky bits from an earlier transfer must not leak into this verdict. */
+	st0 = touch_rd(qup, Q_STATUS) & Q_ST_ERR_MASK;
+	if (st0) {
+		touch_wr(qup, Q_STATUS, st0);
+	}
+	er0 = touch_rd(qup, Q_ERR) & Q_ERR_MASK;
+	if (er0) {
+		touch_wr(qup, Q_ERR, er0);
+	}
+	touch_wr(qup, Q_CONFIG, Q_CFG_V2);
+	touch_wr(qup, Q_GEN, 1);              /* QUP_V2_TAGS_EN */
+	if (!(touch_rd(qup, Q_STATE) & 0x10u)) {   /* QUP_I2C_MAST_GEN */
+		v = XFER_HW;
+		goto seq_out;
+	}
+	touch_wr(qup, Q_OUT_CNT, 0);
+	touch_wr(qup, Q_IN_CNT, 0);
+	touch_wr(qup, Q_IO, Q_IO_FIFO_REPACK);
+	for (m = 0; m < num; m++) {
+		xfer_msg = m;
+		v = touch_i2c_sub(&msgs[m], m == 0u, m == num - 1u);
+		if (v == XFER_HW) {
+			goto seq_out;
+		}
+		if (v != XFER_OK) {
+			goto verdict_out;
+		}
+	}
+	for (i = 0; i < 1000u; i++) {
+		status = touch_rd(qup, Q_STATUS);
+		v = qup_check_errors(status, touch_rd(qup, Q_ERR));
+		if (v != XFER_OK) {
+			goto verdict_out;
+		}
+		if (!(status & Q_ST_BUS_ACTIVE)) {
+			break;
+		}
+		delay(1);
+	}
+	if (status & Q_ST_BUS_ACTIVE) {
+		v = XFER_TIMEOUT;
+		goto verdict_out;
+	}
+	xfer_status = status;
+	xfer_op = touch_rd(qup, Q_OP);
+	xfer_err = touch_rd(qup, Q_ERR);
+	if (!qup_state(0)) {
+		v = XFER_HW;
+		goto seq_out;
+	}
+	return XFER_OK;
+verdict_out:
+	xfer_status = touch_rd(qup, Q_STATUS);
+	xfer_op = touch_rd(qup, Q_OP);
+	xfer_err = touch_rd(qup, Q_ERR);
+	printf("LILAC TOUCH: I2C verdict=%s msg=%u/%u tags=%02x %02x %02x %02x "
+	    "raw_status=%08x raw_err=%08x after_w1c status=%08x op=%08x err=%08x "
+	    "rx_tag=%02x%02x got=%u state=%08x\n", xfer_name((unsigned)v),
+	    xfer_msg + 1u, num, xfer_tags[0], xfer_tags[1], xfer_tags[2],
+	    xfer_tags[3], xfer_hit_status, xfer_hit_err, xfer_status, xfer_op,
+	    xfer_err, xfer_rx_tag[0], xfer_rx_tag[1], xfer_got,
+	    touch_rd(qup, Q_STATE));
+	(void)qup_state(0);
+	qup_dead = true;
+	return v;
+seq_out:
+	printf("LILAC TOUCH: I2C verdict=%s (sequencer) msg=%u/%u state=%08x\n",
+	    xfer_name((unsigned)v), xfer_msg + 1u, num, touch_rd(qup, Q_STATE));
+	(void)qup_state(0);
+	qup_dead = true;
+	return v;
+}
+
+/* Address probe: a 1-byte read (i2cdetect read-byte = one I2C_M_RD message
+ * of length 1): tags 81 59 87 01, WRITE_CNT 4, READ_CNT 3, CONFIG 0x207. The
+ * QUP cannot do zero-length transfers (i2c-qup.c:1651-1657). */
+static int
+touch_i2c_scan(uint8_t addr7)
+{
+	uint8_t b = 0;
+	struct touch_msg m = { addr7, true, &b, 1u };
+
+	return touch_i2c_xfer(&m, 1u);
+}
+
+/* RMI register read = rmi_i2c_read_block (rmi_i2c.c:127-160): message 1
+ * write [reg] (81 58 82 01 reg; WRITE_CNT 5, CONFIG 0x287), PAUSE, message 2
+ * read (81 59 87 len; WRITE_CNT 0x80000004, READ_CNT 0x80000000|len+2,
+ * CONFIG 0x207) behind a repeated START. */
+static int
+touch_rmi_readv(uint8_t reg, uint8_t *out, unsigned len)
+{
+	struct touch_msg m[2] = {
+		{ RMI_ADDR, false, &reg, 1u },
+		{ RMI_ADDR, true, out, len },
+	};
+	int v = touch_i2c_xfer(m, 2u);
+
+	if (v != XFER_OK) {
+		printf("LILAC TOUCH: RMI read reg=%02x len=%u verdict=%s\n",
+		    reg, len, xfer_name((unsigned)v));
+	}
+	return v;
+}
+
+/* RMI register write = one message [reg, val] (81 58 83 02 reg val; WRITE_CNT
+ * 6, CONFIG 0x287), then a read-back through touch_rmi_readv. */
+static int
+touch_rmi_write(uint8_t reg, uint8_t val)
+{
+	uint8_t b[2] = { reg, val };
+	struct touch_msg m = { RMI_ADDR, false, b, 2u };
+	uint8_t chk = 0;
+	int v = touch_i2c_xfer(&m, 1u);
+
+	if (v != XFER_OK) {
+		printf("LILAC TOUCH: RMI write reg=%02x val=%02x verdict=%s\n",
+		    reg, val, xfer_name((unsigned)v));
+		return v;
+	}
+	v = touch_rmi_readv(reg, &chk, 1u);
+	if (v != XFER_OK) {
+		return v;
+	}
+	return chk == val ? XFER_OK : XFER_BUSERR;
+}
+
+/* Page select at 0xff (clearpad_i2c_set_page, clearpad_i2c.c:39-56); the
+ * read-back confirms the controller followed. */
+static int
+touch_rmi_page(uint8_t page)
+{
+	return touch_rmi_write(RMI_PAGE_SEL, page);
+}
+
+/* ---- T4 = W8: one RMI register read with the inherited pins ------------- */
+
+/* Diagnostic only: reads the page-select register 0xff through the corrected
+ * two-message access with VIO133/RESET89 exactly as UEFI left them. ACK and
+ * NACK are both reported as a clean, decoded result (bit1); a bus error,
+ * timeout or sequencer failure is not. */
+static void
+t4_qup_w8(void)
+{
+	uint8_t page = 0xff;
+	int v;
+
+	nibble_bits = 0u;
+	printf("LILAC TOUCH T4: QUP init (W8) hw=%08x clk_ctl=%08x (i2c-qup.c "
+	    "fast-mode divider, 355 kHz)\n", touch_rd(qup, Q_HW), QUP_CLK_CTL_355K);
+	qup_dead = false;
+	v = touch_rmi_readv(RMI_PAGE_SEL, &page, 1u);
+	if (v != XFER_HW) {
+		nibble_bits |= 1u;   /* the sequencer ran to the transfer poll */
+	}
+	if (v == XFER_OK) {
+		nibble_bits |= 2u;
+		printf("LILAC TOUCH T4: ACK 0x2c: reg 0xff=%02x status=%08x rx_tag=%02x%02x "
+		    "(inherited pins, no TLMM89/133 write)\n", page, xfer_status,
+		    xfer_rx_tag[0], xfer_rx_tag[1]);
+	} else if (v == XFER_NACK) {
+		nibble_bits |= 2u;
+		printf("LILAC TOUCH T4: NACK 0x2c on msg %u/%u (I2C_STATUS bit3) "
+		    "raw_status=%08x%s\n", xfer_msg + 1u, xfer_num, xfer_hit_status,
+		    (xfer_hit_status & 0x01000000u) ? " INVALID_READ_ADDR STILL SET" : "");
+	} else {
+		printf("LILAC TOUCH T4: NOTE verdict=%s (neither ACK nor NACK)\n",
+		    xfer_name((unsigned)v));
+	}
+	if ((touch_rd(qup, Q_STATE) & 7u) == 4u) {
+		nibble_bits |= 4u;   /* back in RESET */
+	}
+	printf("LILAC TOUCH T4: END W8 verdict=%s\n", xfer_name((unsigned)v));
+}
+
+/* ---- T5: touch pins verified at the inherited level (no write) --------- */
+
+/* VIO133 (active-low, 0 = touch VIO on) and RESET89 must be GPIO-function
+ * outputs driving 0, exactly as UEFI leaves them (T1/T7b). This code never
+ * writes VIO133; RESET89 is written only by the opt-in Sony release in T7. */
+static bool
+touch_pin_inherited_low(vm_offset_t tile, unsigned gpio, const char *name)
+{
+	uint32_t cfg = tlmm_rd(tile, gpio, 0), io = tlmm_rd(tile, gpio, 4);
+
+	printf("LILAC TOUCH: %s TLMM%u cfg=%08x io=%08x (want func0 + OE, out 0, "
+	    "in 0)\n", name, gpio, cfg, io);
+	if (((cfg >> 2) & 15u) != 0u || !(cfg & 0x200u) || (io & 3u) != 0u) {
+		printf("LILAC TOUCH: %s TLMM%u is NOT at the inherited level (GPIO "
+		    "output driving 0); refusing to touch it\n", name, gpio);
+		return false;
+	}
+	return true;
+}
+
+static void
+t5_pins_check(void)
+{
+	nibble_bits = 0u;
+	if (!touch_pin_inherited_low(west, 133, "VIO(active-low,0=on)")) {
+		fail("VIO133 not at inherited 0 (touch VIO would be off)");
+		return;
+	}
+	nibble_bits |= 1u;
+	uint32_t i87 = tlmm_rd(east, 87, 4), i88 = tlmm_rd(east, 88, 4);
+	printf("LILAC TOUCH T5: SCL87 io=%08x SDA88 io=%08x\n", i87, i88);
+	if (!(i87 & 1u) || !(i88 & 1u)) {
+		fail("SCL/SDA not high: bus pulled low");
+		return;
+	}
+	nibble_bits |= 2u;
+	if (!touch_pin_inherited_low(east, 89, "RESET")) {
+		fail("RESET89 not at inherited 0");
+		return;
+	}
+	nibble_bits |= 4u;
+	printf("LILAC TOUCH T5: PASS pins inherited (VIO133=0 on, RESET89=0, "
+	    "SCL/SDA high); no TLMM write\n");
+}
+
+/* ---- T6 = W6: L14/L28 state read, L28 enable if needed ------------------ */
+
+struct ldo_status {
+	uint8_t type, subtype, vlsb, vmsb, en;
+	unsigned mv;      /* programmed voltage in mV (VOLTAGE_MSB:LSB) */
+	bool on;
+};
+
+/* Read one PM8998 LDO peripheral over the observer; voltage = MSB:LSB mV. */
+static bool
+ldo_read(unsigned ppid, struct ldo_status *s, const char *name)
+{
+	unsigned apid = 0;
+	vm_offset_t obs;
+
+	memset(s, 0, sizeof(*s));
+	if (!spmi_apid(ppid, &apid)) {
+		printf("LILAC TOUCH T6: %s APID not found\n", name);
+		return false;
+	}
+	obs = ml_io_map(SPMI_OBS_PA + 0x8000ull * apid, 0x1000);
+	if (!obs) {
+		return false;
+	}
+	if (!spmi_obs_read(obs, LDO_REG_TYPE, &s->type) ||
+	    !spmi_obs_read(obs, LDO_REG_SUBTYPE, &s->subtype) ||
+	    !spmi_obs_read(obs, LDO_REG_VLSB, &s->vlsb) ||
+	    !spmi_obs_read(obs, LDO_REG_VMSB, &s->vmsb) ||
+	    !spmi_obs_read(obs, LDO_REG_EN, &s->en)) {
+		printf("LILAC TOUCH T6: %s status unreadable\n", name);
+		return false;
+	}
+	s->mv = ((unsigned)s->vmsb << 8) | s->vlsb;
+	s->on = (s->en & LDO_EN_BIT) != 0;
+	printf("LILAC TOUCH T6: %s apid=%u type=%02x subtype=%02x vlsb=%02x "
+	    "vmsb=%02x mv=%u en=%02x on=%u\n", name, apid, s->type, s->subtype,
+	    s->vlsb, s->vmsb, s->mv, s->en, s->on);
+	if (s->type != 0x04u) {   /* SPMI_REGULATOR_TYPE_LDO */
+		printf("LILAC TOUCH T6: %s type is not LDO; refusing\n", name);
+		return false;
+	}
+	return true;
+}
+
+/* Enable L28 (exactly 3.0 V, K44 yoshino min=max 3000000 uV): require subtype
+ * HT_P150, an already-programmed 3000 mV set point and EE0 write ownership of
+ * the APID (v2 PERIPH2OWNER). Never writes the voltage registers; the only
+ * PMIC write is EN_CTL bit7, read back afterwards. */
+static bool
+l28_enable(const struct ldo_status *s0)
+{
+	struct ldo_status s = *s0;
+	unsigned apid = 0;
+	vm_offset_t chn, obs;
+	uint32_t owner;
+	uint8_t rb;
+
+	if (s.subtype != LDO_SUBTYPE_HT_P150) {
+		printf("LILAC TOUCH T6: FAIL L28 subtype %02x != 35 (HT_P150): "
+		    "register layout unverified; refusing\n", s.subtype);
+		return false;
+	}
+	if (s.mv != L28_MV) {
+		printf("LILAC TOUCH T6: FAIL L28 set point %u mV != 3000: refusing "
+		    "(this code never writes voltage registers)\n", s.mv);
+		return false;
+	}
+	if (s.on) {
+		return true;                /* inherited on at 3.0 V */
+	}
+	if (!spmi_apid(LDO_L28_PPID, &apid)) {
+		return false;
+	}
+	owner = touch_rd(spmi_cnfg, 0x700 + 4 * apid) & 7u;
+	printf("LILAC TOUCH T6: L28 apid=%u owner-EE=%u (need 0)\n", apid, owner);
+	if (owner != 0u) {
+		printf("LILAC TOUCH T6: FAIL L28 writes denied for EE0 (RPM-owned): "
+		    "an RPM SMD request would be required; stopping\n");
+		return false;
+	}
+	chn = ml_io_map(SPMI_CHNL_PA + 0x8000ull * apid, 0x1000);
+	obs = ml_io_map(SPMI_OBS_PA + 0x8000ull * apid, 0x1000);
+	if (!chn || !obs) {
+		return false;
+	}
+	printf("LILAC TOUCH T6: L28 W6 EN_CTL [SID1 0x%04x] before=%02x write=%02x\n",
+	    LDO_L28_BASE + LDO_REG_EN, s.en, LDO_EN_BIT);
+	if (!spmi_chn_write(chn, LDO_REG_EN, LDO_EN_BIT) ||
+	    !spmi_obs_read(obs, LDO_REG_EN, &rb) || !(rb & LDO_EN_BIT)) {
+		printf("LILAC TOUCH T6: FAIL L28 EN write/readback\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+t6_ldo_w6(void)
+{
+	struct ldo_status l14, l28, v;
+	bool r14, r28;
+
+	nibble_bits = 0u;
+	if (!spmi_map()) {
+		fail("SPMI arbiter map/version");
+		return;
+	}
+	r14 = ldo_read(LDO_L14_PPID, &l14, "L14");
+	r28 = ldo_read(LDO_L28_PPID, &l28, "L28");
+	if (r14 && r28) {
+		nibble_bits |= 1u;
+	}
+	if (r14 && !l14.on) {
+		printf("LILAC TOUCH T6: NOTE L14 (panel vddio) reads OFF with the "
+		    "display lit; left untouched (display path owns it)\n");
+	}
+	if (!r28) {
+		fail("L28 not readable as an LDO");
+		return;
+	}
+	/* T6 on device (stage 97, 2026-10-26): XBL/UEFI leaves L28 enabled at
+	 * 0x0bc0 = 3008 mV (Android later reprograms 3000 mV). An inherited rail
+	 * within 2950..3100 mV is accepted as-is with no PMIC write. */
+	if (l28.on && l28.mv >= L28_MV_LO && l28.mv <= L28_MV_HI &&
+	    l28.subtype == LDO_SUBTYPE_HT_P150) {
+		printf("LILAC TOUCH T6: L28 already ON at %u mV (inherited; no PMIC write)\n",
+		    l28.mv);
+		nibble_bits |= 2u | 4u;
+		return;
+	}
+	if (!l28_enable(&l28)) {
+		fail("L28 enable denied or read-back mismatch");
+		return;
+	}
+	if (ldo_read(LDO_L28_PPID, &v, "L28") && v.on && v.mv == L28_MV) {
+		printf("LILAC TOUCH T6: PASS L28 ON at 3.0 V (verified read-back)\n");
+		nibble_bits |= 2u | 4u;
+	} else {
+		fail("L28 final state mismatch");
+	}
+}
+
+/* ---- T7: inherited-pin probe (+ opt-in Sony reset) + RMI4 PDT/F01/F12 --- */
+
+/* F12 register-presence decode: bit i of each descriptor byte assigns the
+ * next offset to register 8*byte+i (clearpad_gen_offsets, clearpad_core.c:2365). */
+static int
+f12_decode_presence(const uint8_t *desc, unsigned ndesc, uint8_t *offs)
+{
+	unsigned offset = 0, i, bit, reg;
+
+	for (i = 0; i < ndesc; i++) {
+		for (bit = 0; bit < 8u; bit++) {
+			reg = i * 8u + bit;
+			if (reg >= F12_REG_MAX) {
+				/* the table may describe more registers than we track;
+				 * everything we need is below F12_REG_MAX */
+				return 1;
+			}
+			if (desc[i] & (1u << bit)) {
+				offs[reg] = (uint8_t)offset++;
+			} else {
+				offs[reg] = 0xffu;
+			}
+		}
+	}
+	return 1;
+}
+
+/* Read one presence table: size byte at qbase+qnum, then the size_num_bytes
+ * (1, or 3 when the first header byte is 0) + descriptor payload at +1
+ * (clearpad_query_regs, clearpad_core.c:2383-2425). */
+static int
+f12_read_presence(uint8_t qbase, uint8_t qnum, uint8_t *offs)
+{
+	uint8_t size = 0, b0 = 1, hdr[F12_PRESENCE_MAX + 3];
+	unsigned nb;
+
+	if (touch_rmi_readv(qbase + qnum, &size, 1u) != XFER_OK ||
+	    size == 0u || size > F12_PRESENCE_MAX) {
+		return 0;
+	}
+	if (touch_rmi_readv(qbase + qnum + 1u, &b0, 1u) != XFER_OK) {
+		return 0;
+	}
+	nb = b0 == 0u ? 3u : 1u;
+	if ((unsigned)size + nb > sizeof(hdr)) {
+		return 0;
+	}
+	if (touch_rmi_readv(qbase + qnum + 1u, hdr, size + nb) != XFER_OK) {
+		return 0;
+	}
+	return f12_decode_presence(hdr + nb, size, offs);
+}
+
+/* Opt-in (boot-arg lilactouchrst=1) Sony hybrid-incell touch reset release,
+ * used only after the inherited-pin probe NACKed. Exact K44 order: panel-on
+ * runs mdss_dsi_panel_driver_reset_touch(0) then (1) for a HYBRID_INCELL
+ * panel (mdss_dsi_panel.c:1063-1070); (0) = gpio 89 <- 0 then wait
+ * pw-wait-after-off-touch-reset = 11 ms, (1) = gpio_direction_output(89, 1)
+ * then wait pw-wait-after-on-touch-reset = 0 (mdss_dsi_panel_driver.c:
+ * 1006-1012, :248-298; dsi-panel-lilac.dtsi:367,371 / :615,619); clearpad
+ * waits hwreset_delay_for_powerup_ms = 220 before its first I2C access
+ * (clearpad_core.c:2752-2754, msm8998-yoshino-common.dtsi:200). 89 is
+ * already a GPIO output at 0 (verified), so the hold is the 11 ms wait and
+ * the release is one io-latch write. VIO133 and panel reset 94 are never
+ * written. */
+static bool
+t7_sony_reset_release(void)
+{
+	uint32_t io89;
+
+	printf("LILAC TOUCH T7: Sony reset release (lilactouchrst=1): 89 held 0 for "
+	    "%u ms, then 1, then %u ms\n", RESET_HOLD_MS, RESET_DELAY_MS);
+	touch_sleep_ms(RESET_HOLD_MS);
+	io89 = wr_rb("T7 RESET89 release (Sony reset_touch(1))", east,
+	    TLMM_CFG_OFF(89) + 4u, tlmm_rd(east, 89, 4) | TLMM_OUT_BIT);
+	if (!(io89 & TLMM_OUT_BIT)) {
+		fail("TLMM89 release latch readback");
+		return false;
+	}
+	touch_sleep_ms(RESET_DELAY_MS);
+	return true;
+}
+
+static bool
+touch_reset_optin(void)
+{
+	int en = 0;
+
+	return PE_parse_boot_argn("lilactouchrst", &en, sizeof(en)) && en == 1;
+}
+
+static void
+t7_reset_scan_w7(void)
+{
+	uint8_t ctrl_off[F12_REG_MAX];
+	int v;
+
+	nibble_bits = 0u;
+	/* No VIO133 write and, by default, no RESET89 write: both must still be
+	 * GPIO outputs driving 0 as UEFI left them. */
+	if (!touch_pin_inherited_low(west, 133, "VIO(active-low,0=on)") ||
+	    !touch_pin_inherited_low(east, 89, "RESET")) {
+		fail("touch pins not at the inherited 0 level");
+		return;
+	}
+	nibble_bits |= 1u;
+
+	qup_dead = false;
+	v = touch_i2c_scan(RMI_ADDR);
+	printf("LILAC TOUCH T7: probe 0x%02x (inherited pins) verdict=%s raw_status=%08x "
+	    "status=%08x\n", RMI_ADDR, xfer_name((unsigned)v), xfer_hit_status,
+	    xfer_status);
+	if (v == XFER_NACK && touch_reset_optin()) {
+		if (!t7_sony_reset_release()) {
+			return;
+		}
+		qup_dead = false;
+		v = touch_i2c_scan(RMI_ADDR);
+		printf("LILAC TOUCH T7: probe 0x%02x (after Sony reset release) verdict=%s "
+		    "raw_status=%08x status=%08x\n", RMI_ADDR, xfer_name((unsigned)v),
+		    xfer_hit_status, xfer_status);
+	} else if (v == XFER_NACK) {
+		printf("LILAC TOUCH T7: NACK with RESET89 held 0; the Sony release is "
+		    "opt-in: boot-arg lilactouchrst=1\n");
+	}
+	if (v != XFER_OK) {
+		fail("0x2c did not ACK");
+		return;
+	}
+	printf("LILAC TOUCH T7: ACK 0x2c\n");
+
+	/* PDT walk, pages 0..3 (clearpad_read_pdt, clearpad_core.c:1669-1747):
+	 * entries descend from 0xe9; entry = query,command,ctrl,data,irq,func. */
+	f01_page = 0xffu;
+	f12_page = 0xffu;
+	f12_irq_mask = 0;
+	unsigned irq_bit = 0;
+	for (uint8_t page = 0; page < RMI_PDT_PAGES; page++) {
+		if (touch_rmi_page(page) != XFER_OK) {
+			fail("PDT page select");
+			return;
+		}
+		bool term = false;
+		for (unsigned e = 0; e < 37u; e++) {
+			uint8_t base = (uint8_t)(RMI_PDT_END - 6u * e);
+			uint8_t ent[6];
+			if (base < 6u || touch_rmi_readv(base, ent, 6u) != XFER_OK) {
+				fail("PDT entry read");
+				return;
+			}
+			if (ent[5] == 0u) {
+				term = true;
+				break;
+			}
+			printf("LILAC TOUCH T7: PDT p%u F%02x q=%02x cmd=%02x ctrl=%02x "
+			    "data=%02x irq=%u\n", page, ent[5], ent[0], ent[1], ent[2],
+			    ent[3], ent[4] & 0x1fu);
+			if (ent[5] == RMI_F01 && f01_page == 0xffu) {
+				f01_page = page;
+				f01_query = ent[0];
+				f01_data = ent[3];
+				f01_ctrl = ent[2];
+			}
+			unsigned fmask = 0;
+			for (unsigned j = 0; j < (ent[4] & 0x7u); j++, irq_bit++) {
+				if (irq_bit < 8u) {
+					fmask |= 1u << irq_bit;
+				}
+			}
+			if (ent[5] == RMI_F12 && f12_page == 0xffu) {
+				f12_irq_mask = (uint8_t)fmask;
+				f12_page = page;
+				f12_query = ent[0];
+				f12_ctrl = ent[2];
+				f12_data = ent[3];
+			}
+		}
+		if (!term) {
+			fail("PDT page never terminated");
+			return;
+		}
+		if (f01_page == 0u && f12_page != 0xffu) {
+			break;
+		}
+	}
+	if (f01_page != 0u) {
+		fail("F01 not found on page 0");
+		return;
+	}
+	if (f12_page == 0xffu) {
+		fail("F12 not found");
+		return;
+	}
+	if (touch_rmi_page(0) != XFER_OK) {
+		fail("F01 page select");
+		return;
+	}
+	uint8_t prod[10];
+	if (touch_rmi_readv(f01_query + F01_PRODUCT_Q, prod, 10u) != XFER_OK) {
+		fail("F01 product read");
+		return;
+	}
+	memcpy(f01_product, prod, 10u);
+	f01_product[10] = 0;
+	printf("LILAC TOUCH T7: F01 product=%s page=0 query=%02x\n",
+	    f01_product, f01_query);
+	nibble_bits |= 2u;
+
+	if (touch_rmi_page(f12_page) != XFER_OK) {
+		fail("F12 page select");
+		return;
+	}
+	uint8_t qd = 0;
+	if (touch_rmi_readv(f12_query, &qd, 1u) != XFER_OK || !(qd & 1u)) {
+		fail("F12 query0 register descriptor absent");
+		return;
+	}
+	if (!f12_read_presence(f12_query, 0x04u, ctrl_off) ||
+	    !f12_read_presence(f12_query, 0x07u, f12_data_off)) {
+		fail("F12 presence decode");
+		return;
+	}
+	if (ctrl_off[8] == 0xffu || ctrl_off[23] == 0xffu || ctrl_off[28] == 0xffu ||
+	    f12_data_off[1] == 0xffu || f12_data_off[15] == 0xffu) {
+		fail("F12 required registers absent (ctrl8/23/28, data1/15)");
+		return;
+	}
+	uint8_t xy[4], c23[2], c28 = 0;
+	if (touch_rmi_readv(f12_ctrl + ctrl_off[8], xy, 4u) != XFER_OK ||
+	    touch_rmi_readv(f12_ctrl + ctrl_off[23], c23, 2u) != XFER_OK ||
+	    touch_rmi_readv(f12_ctrl + ctrl_off[28], &c28, 1u) != XFER_OK) {
+		fail("F12 ctrl read");
+		return;
+	}
+	f12_xmax = (uint16_t)(xy[0] | (xy[1] << 8));
+	f12_ymax = (uint16_t)(xy[2] | (xy[3] << 8));
+	f12_slots = c23[1];
+	f12_objbytes = 0;
+	for (unsigned b = 0; b < 8u; b++) {
+		f12_objbytes += (c28 >> b) & 1u;
+	}
+	printf("LILAC TOUCH T7: PASS F12 xmax=%u ymax=%u slots=%u objbytes=%u "
+	    "data1=%02x data15=%02x ctrl=%02x query=%02x page=%u\n", f12_xmax,
+	    f12_ymax, f12_slots, f12_objbytes, f12_data_off[1], f12_data_off[15],
+	    f12_ctrl, f12_query, f12_page);
+	if (f12_xmax != 719u || f12_ymax != 1279u) {
+		printf("LILAC TOUCH T7: NOTE extents differ from the DTS 719x1279 "
+		    "(K44 lilac preset); T8 will scale to panel space\n");
+	}
+	if (f12_slots == 0u || f12_slots > F12_SLOTS_MAX) {
+		fail("F12 slot count out of range");
+		return;
+	}
+	if (f12_objbytes < 5u) {
+		fail("F12 object layout too short (need status+xy)");
+		return;
+	}
+	/* After reset the S3330 reports only the F01 status interrupt (R11t:
+	 * asserts=1 in 400 s). Sony enables every source in F01_RMI_CTRL01
+	 * (INTERRUPT_ENABLE_0_ENABLE_ALL = 0x3f, clearpad_core.c:3912-3918) and
+	 * sets DEVICE_CONTROL_CONFIGURED (CTRL00 bit7, :2700-2704) once F12 is
+	 * prepared. Offsets ctrl00=+0, ctrl01=+1 (clearpad-ic-default-regoffset.dtsi). */
+	if (touch_rmi_page(f01_page) != XFER_OK) {
+		fail("F01 page select (configure)");
+		return;
+	}
+	uint8_t c0 = 0, c1 = 0;
+	if (touch_rmi_readv(f01_ctrl, &c0, 1u) != XFER_OK ||
+	    touch_rmi_readv((uint8_t)(f01_ctrl + 1u), &c1, 1u) != XFER_OK) {
+		fail("F01 control read");
+		return;
+	}
+	printf("LILAC TOUCH T7: F01 ctrl=%02x ctrl00=%02x ctrl01(int-enable)=%02x before\n",
+	    f01_ctrl, c0, c1);
+	/* R12t: CTRL01 already read 0x3f after reset, and the combined write
+	 * failed its read-back check, which aborted the whole thread. Only write
+	 * what differs, log the read-back, and keep going: neither register is
+	 * needed for F12 reports (Sony sets CONFIGURED only to detect resets). */
+	int w1 = XFER_OK, w0 = XFER_OK;
+	uint8_t r0 = 0, r1 = 0;
+	if (c1 != 0x3fu) {
+		w1 = touch_rmi_write((uint8_t)(f01_ctrl + 1u), 0x3fu);
+	}
+	if (!(c0 & 0x80u)) {
+		w0 = touch_rmi_write(f01_ctrl, (uint8_t)(c0 | 0x80u));
+	}
+	(void)touch_rmi_readv(f01_ctrl, &r0, 1u);
+	(void)touch_rmi_readv((uint8_t)(f01_ctrl + 1u), &r1, 1u);
+	printf("LILAC TOUCH T7: F01 configure ctrl01 w=%s rb=%02x, ctrl00 w=%s rb=%02x "
+	    "(non-fatal)\n", xfer_name((unsigned)w1), r1, xfer_name((unsigned)w0), r0);
+	nibble_bits |= 4u;
+}
+
+/* ---- T8 = phase b: IRQ-gated F12 polling -> SweetHID -------------------- */
+
+/* LILAC panel->logical mapping: the 720x1280 panel presents the 1125x2436
+ * logical image uniformly scaled and centred as 591x1280 at x=64
+ * (SweetFramebuffer.cpp fit); black bars clamp to the image edges
+ * (docs/lilac-input-plan.md geometry contract). Normalized 16.16 + edge flag
+ * (SWEET's 48 px edge threshold scaled 48*720/1080 = 32). */
+void
+lilac_touch_map(int px, int py, int *nx16, int *ny16, int *edge)
+{
+#define LILAC_PANEL_H   1280
+#define LILAC_IMG_X     64
+#define LILAC_IMG_W     591
+#define LILAC_EDGE_PX   32
+	if (px < LILAC_IMG_X) {
+		px = LILAC_IMG_X;
+	}
+	if (px > LILAC_IMG_X + LILAC_IMG_W - 1) {
+		px = LILAC_IMG_X + LILAC_IMG_W - 1;
+	}
+	if (py < 0) {
+		py = 0;
+	}
+	if (py > LILAC_PANEL_H - 1) {
+		py = LILAC_PANEL_H - 1;
+	}
+	*nx16 = (int)(((long long)(px - LILAC_IMG_X) << 16) / LILAC_IMG_W);
+	*ny16 = (int)(((long long)py << 16) / LILAC_PANEL_H);
+	*edge = (px - LILAC_IMG_X) < LILAC_EDGE_PX ||
+	    (LILAC_IMG_X + LILAC_IMG_W - 1 - px) < LILAC_EDGE_PX ||
+	    py < LILAC_EDGE_PX || (LILAC_PANEL_H - 1 - py) < LILAC_EDGE_PX;
+#undef LILAC_PANEL_H
+#undef LILAC_IMG_X
+#undef LILAC_IMG_W
+#undef LILAC_EDGE_PX
+}
+
+/* Contact-event logging: the first 20 events (down/up/move injections) are
+ * logged in full with the letterbox-mapped logical pixel (1125x2436 image
+ * fit into the 720x1280 panel), afterwards 1 line per 100 events (~1 s at
+ * the 100 Hz poll ceiling) so a drag cannot flood the console; the periodic
+ * thread stats line remains the long-term summary. */
+#define TOUCH_LOG_FIRST 20u
+#define TOUCH_LOG_EVERY 100u
+static unsigned contact_events;
+
+static void
+slot_inject(unsigned i, int down, unsigned x, unsigned y)
+{
+	/* Sensor -> panel space (720x1280); SweetHID applies the display fit. */
+	int px = f12_xmax == 719u ? (int)x : (int)(x * 719u / f12_xmax);
+	int py = f12_ymax == 1279u ? (int)y : (int)(y * 1279u / f12_ymax);
+
+	if (down == (int)slot_down[i] && (!down ||
+	    (x == (unsigned)slot_x[i] && y == (unsigned)slot_y[i]))) {
+		return;
+	}
+	if (down || slot_down[i]) {
+		if (contact_events < TOUCH_LOG_FIRST || contact_events % TOUCH_LOG_EVERY == 0u) {
+			int nx16 = 0, ny16 = 0, edge = 0;
+			lilac_touch_map(px, py, &nx16, &ny16, &edge);
+			printf("LILAC TOUCH: id %u %s raw=%u,%u panel=%d,%d -> %d,%d%s\n",
+			    i, down ? "down" : "up", x, y, px, py,
+			    (int)(((long long)nx16 * 1125) >> 16),
+			    (int)(((long long)ny16 * 2436) >> 16),
+			    contact_events < TOUCH_LOG_FIRST ? "" :
+			    " (rate-limited)");
+		}
+		contact_events++;
+		sweet_hid_touch((int)i, down, px, py);
+	}
+	slot_down[i] = (down != 0);
+	slot_x[i] = (int)x;
+	slot_y[i] = (int)y;
+}
+
+/* Release every held contact once (fatal transport or window end). */
+static void
+touch_release_all(void)
+{
+	for (unsigned i = 0; i < TOUCH_SLOTS; i++) {
+		if (slot_down[i]) {
+			slot_inject(i, 0, 0, 0);
+		}
+	}
+}
+
+/* One F12 frame: Data15 attention, then Data1 objects; 0 OK, -1 fatal. */
+static int
+touch_f12_frame(void)
+{
+	uint8_t att[2], objs[F12_SLOTS_MAX * F12_OBJ_BYTES];
+	unsigned attv, num, need, done, chunk, i, mask;
+
+	/* F01_RMI_DATA01 = interrupt status; reading it de-asserts ATTN (IRQ125).
+	 * Sony clearpad reads it on every interrupt before F12 (clearpad_core.c:
+	 * 2768-2771, 4858-4873). Without it the line stays low forever (stage 99
+	 * on device: asserts=1200 of 1200 polls, no contacts). */
+	uint8_t irqst = 0;
+	if (touch_rmi_page(f01_page) != XFER_OK ||
+	    touch_rmi_readv((uint8_t)(f01_data + 1u), &irqst, 1u) != XFER_OK) {
+		return -1;
+	}
+	t8_irqst_last = irqst;
+	if (!(irqst & f12_irq_mask)) {
+		return 0;                       /* not an F12 report (F01/F34/...) */
+	}
+	if (touch_rmi_page(f12_page) != XFER_OK) {
+		return -1;
+	}
+	if (touch_rmi_readv(f12_data + f12_data_off[15], att, 2u) != XFER_OK) {
+		return -1;
+	}
+	attv = att[0] | ((unsigned)att[1] << 8);
+	/* clearpad get_num_fingers_f12: objects = bits needed by attention. */
+	for (num = 0, mask = 1u; num < f12_slots; num++, mask <<= 1u) {
+		if (attv < mask) {
+			break;
+		}
+	}
+	if (num) {
+		need = num * f12_objbytes;
+		done = 0;
+		while (done < need) {
+			chunk = need - done > 60u ? 60u : need - done;
+			if (touch_rmi_readv(f12_data + f12_data_off[1] + done,
+			    objs + done, chunk) != XFER_OK) {
+				return -1;
+			}
+			done += chunk;
+		}
+	}
+	for (i = 0; i < f12_slots; i++) {
+		bool present = i < num && (attv & (1u << i)) != 0;
+		int down = 0;
+		unsigned x = 0, y = 0;
+		if (present) {
+			const uint8_t *o = objs + i * f12_objbytes;
+			uint8_t type = o[0];
+			x = o[1] | ((unsigned)o[2] << 8);
+			y = o[3] | ((unsigned)o[4] << 8);
+			/* clearpad_tool_type_f12: 1 finger, 6 glove; palm/other rejected */
+			down = (type == 1u || type == 6u) ? 1 : 0;
+			if (!down) {
+				x = 0;
+				y = 0;
+			}
+		}
+		slot_inject(i, down, x, y);
+	}
+	return 0;
+}
+
+/* Stage T8: a bounded 12 s IRQ125-gated polling window, then release all. */
+static void
+t8_poll_window(void)
+{
+	unsigned polls = 0, asserts = 0, frames = 0, errors = 0, active = 0, i;
+
+	nibble_bits = 0u;
+	irq125_io = east + 125u * 0x1000u + 4u;
+	printf("LILAC TOUCH T8: poll window 12 s at %u ms, IRQ125-gated "
+	    "(lilactouch=1 for normal boots)\n", TOUCH_POLL_MS);
+	for (unsigned t = 0; t < 12000u / TOUCH_POLL_MS && !stage_failed; t++) {
+		polls++;
+		if (!(touch_rd(irq125_io, 0) & 1u)) {  /* line LOW = asserted */
+			asserts++;
+			qup_dead = false;
+			if (touch_f12_frame() == 0) {
+				frames++;
+			} else {
+				errors++;
+			}
+		}
+		touch_sleep_ms(TOUCH_POLL_MS);
+	}
+	for (i = 0; i < TOUCH_SLOTS; i++) {
+		active += slot_down[i] ? 1u : 0u;
+	}
+	touch_release_all();
+	printf("LILAC TOUCH T8: stats polls=%u asserts=%u frames=%u errors=%u "
+	    "active=%u f12_irq_mask=%02x last_irqst=%02x f01_data=%02x\n", polls, asserts,
+	    frames, errors, active, f12_irq_mask, t8_irqst_last, f01_data);
+	if (polls == 12000u / TOUCH_POLL_MS) {
+		nibble_bits |= 1u;
+	}
+	if (asserts) {
+		nibble_bits |= 2u;
+	}
+	if (frames && !errors) {
+		nibble_bits |= 4u;
+	}
+}
+
+/* ---- entry (stages) and the normal-boot thread (lilactouch=1) ----------- */
+
+/* GCC and TLMM east/west windows used by every step. Shared by the stage
+ * entry and the normal-boot thread: R10t (lilactouch=1) faulted reading
+ * TLMM87 at 0x57000 because only lilac_touch_powerup() mapped them. */
+static bool
+touch_map_windows(void)
+{
+	if (!gcc) {
+		gcc = ml_io_map(GCC_BASE, 0x53000);
+	}
+	if (!east) {
+		east = ml_io_map(TLMM_EAST, 0x80000);
+	}
+	if (!west) {
+		west = ml_io_map(TLMM_WEST, 0x90000);
+	}
+	return gcc && east && west;
+}
+
+/* T2,T3,T5,T6,T7 in order (T4's unpowered probe is stage-test only). */
+static bool
+touch_bringup_steps(void)
+{
+	if (!touch_map_windows()) {
+		fail("mapping TLMM/GCC");
+		return false;
+	}
+	t2_mux_w1();
+	if (stage_failed) {
+		return false;
+	}
+	qup = ml_io_map(QUP5_BASE, 0x1000);
+	if (!qup) {
+		fail("QUP5 mapping");
+		return false;
+	}
+	t3_clocks_w2_w3_w4();
+	if (stage_failed) {
+		return false;
+	}
+	t5_pins_check();
+	if (stage_failed) {
+		return false;
+	}
+	t6_ldo_w6();
+	if (stage_failed) {
+		return false;
+	}
+	t7_reset_scan_w7();
+	return !stage_failed;
+}
+
+static void
+touch_thread(void *arg, wait_result_t w)
+{
+	unsigned polls = 0, asserts = 0, frames = 0, errors = 0, active = 0, i;
+
+	(void)arg;
+	(void)w;
+	printf("LILAC TOUCH: bring-up thread started (lilactouch=1)\n");
+	touch_in_thread = true;
+	if (!touch_bringup_steps()) {
+		printf("LILAC TOUCH: bring-up failed; thread exits (no HID events)\n");
+		return;
+	}
+	irq125_io = east + 125u * 0x1000u + 4u;
+	for (;;) {
+		polls++;
+		if (!(touch_rd(irq125_io, 0) & 1u)) {
+			asserts++;
+			qup_dead = false;
+			if (touch_f12_frame() == 0) {
+				frames++;
+			} else {
+				errors++;
+				if (errors >= 16u) {
+					printf("LILAC TOUCH: fatal transport after %u errors; "
+					    "releasing contacts, thread exits\n", errors);
+					touch_release_all();
+					return;
+				}
+			}
+		}
+		if (polls % 2000u == 0u) {
+			active = 0;
+			for (i = 0; i < TOUCH_SLOTS; i++) {
+				active += slot_down[i] ? 1u : 0u;
+			}
+			printf("LILAC TOUCH: stats polls=%u asserts=%u frames=%u "
+			    "errors=%u active=%u\n", polls, asserts, frames, errors, active);
+		}
+		touch_sleep_ms(TOUCH_POLL_MS);
+	}
+}
+
+void
+lilac_touch_start(void)
+{
+	int enabled = 0;
+	kern_return_t kr;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("lilactouch", &enabled, sizeof(enabled)) || !enabled) {
+		printf("LILAC TOUCH: polling disabled (set lilactouch=1 to enable; "
+		    "stages 92-99 probes stay available via lilac_stop)\n");
+		return;
+	}
+	kr = kernel_thread_start(touch_thread, NULL, &thread);
+	if (kr != KERN_SUCCESS) {
+		printf("LILAC TOUCH: FAIL kernel_thread_start %d\n", kr);
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+void
+lilac_touch_powerup(void)
+{
+	unsigned stage = 0;
+	for (unsigned s = TOUCH_T1; s <= TOUCH_T8; s++) {
+		if (lilac_stop_is(s)) {
+			stage = s;
+		}
+	}
+	if (!stage) {
+		return;
+	}
+	unsigned tnum = stage - TOUCH_T1 + 1u;
+	printf("LILAC TOUCH T%u: BEGIN stage=%u (T1-T8 of docs/lilac-touch-power.md; "
+	    "T6 PMIC writes are L28-only and owner-gated)\n", tnum, stage);
+	nibble_bits = 0;
+	stage_failed = false;
+
+	if (!touch_map_windows()) {
+		printf("LILAC TOUCH: FAIL mapping TLMM/GCC\n");
+		lilac_report(stage, 0);
+		return;
+	}
+	t1_snapshot();
+	if (stage >= TOUCH_T1 + 1u && !stage_failed) {
+		t2_mux_w1();
+	}
+	if (stage >= TOUCH_T1 + 2u && !stage_failed) {
+		/* t3 reads QUP plausibility once the branch is on, so map it first. */
+		qup = ml_io_map(QUP5_BASE, 0x1000);
+		if (!qup) {
+			fail("QUP5 mapping");
+		}
+	}
+	if (stage >= TOUCH_T1 + 2u && !stage_failed) {
+		t3_clocks_w2_w3_w4();
+	}
+	if (stage >= TOUCH_T1 + 3u && !stage_failed) {
+		t4_qup_w8();
+	}
+	if (stage >= TOUCH_T1 + 4u && !stage_failed) {
+		t5_pins_check();
+	}
+	if (stage >= TOUCH_T1 + 5u && !stage_failed) {
+		t6_ldo_w6();
+	}
+	if (stage >= TOUCH_T1 + 6u && !stage_failed) {
+		t7_reset_scan_w7();
+	}
+	if (stage >= TOUCH_T1 + 7u && !stage_failed) {
+		t8_poll_window();
+	}
+	if (!stage_failed) {
+		nibble_bits |= 8u;   /* this stage ran to its end without stopping */
+	}
+	printf("LILAC TOUCH T%u: END stage=%u bits=%x %s\n", tnum, stage,
+	    nibble_bits, !stage_failed ? "PASS" : "FAIL");
+	lilac_report(stage, nibble_bits);
+}
+#endif /* ARM64_BOARD_CONFIG_LILAC */
diff --git a/bsd/dev/lilac_ufs.c b/bsd/dev/lilac_ufs.c
new file mode 100644
index 0000000..373fb23
--- /dev/null
+++ b/bsd/dev/lilac_ufs.c
@@ -0,0 +1,969 @@
+/*
+ * LILAC inherited-link UFS, LU0 only. No cold init, UIC, QUERY or passthrough.
+ * Safety rationale: lilac-uefi/docs/ufs-write-driver-design.md; sources:
+ * [S1] docs/ufs-erase-web-research.md sections 2, 4, 7 (allow-list, no purge).
+ * [S2] evidence/ufsdxe-re/findings.md sections 2-4 (erase API, boot LUs).
+ * [S3] lilac44-ksu6/drivers/scsi/ufs/ufshci.h:305-415 (UTRD/PRDT).
+ * [S4] same tree ufshcd.c:5035, ufs-qcom.c:1519 (1 TX lane, broken AH8).
+ * [S5] UEFI 2.10 section 5.3 (GPT CRCs, GUIDs, attributes, both copies).
+ *
+ * Preserve firmware's link/gear/power/AH8 state [S4]. One serialized slot,
+ * permanently wired bounce allocation; no CPU access after a DMA timeout.
+ * No reset/abort/retry recovery: an uncertain transaction poisons this boot.
+ * Stages 80-83 retain the original read-only diagnostics. W0-W3 are 87-90.
+ * No args and no selected phase => no MMIO, no allocation, no device nodes.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/debug.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <libkern/libkern.h>
+#include <libkern/crc.h>
+#include <arm64/sweet_early.h>
+
+#if defined(ARM64_BOARD_CONFIG_LILAC)
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+#define UFS_PA 0x01DA4000ULL
+#define GCC_UFS_PA 0x00175000ULL
+#define GDSC_UFS 0x004
+#define GCC_UFS_AHB 0x00C
+#define REG_CAP 0x00
+#define REG_IS 0x20
+#define REG_IE 0x24
+#define REG_HCS 0x30
+#define REG_HCE 0x34
+#define REG_UTRLBA 0x50
+#define REG_UTRLBAU 0x54
+#define REG_UTRLDBR 0x58
+#define REG_UTRLRSR 0x60
+#define REG_UTMRLDBR 0x78
+#define CAP_64AS (1u << 24)
+#define UFS_BLOCK 4096u
+#define EXP_LAST_LBA 7810047u
+#define UFS_MAX_BLOCKS 64u
+#define UFS_BYTES (UFS_MAX_BLOCKS * UFS_BLOCK)
+#define PRD_BYTES 65536u
+#define DMA_UTRL 0u
+#define DMA_UCD 0x1000u
+#define DMA_DATA 0x2000u
+#define DMA_SIZE (DMA_DATA + UFS_BYTES)
+#define GPT_ENTRIES 128u
+#define GPT_ENTRY_SIZE 128u
+#define GPT_BYTES (GPT_ENTRIES * GPT_ENTRY_SIZE)
+#define CMD_TIMEOUT_NS (5ull * NSEC_PER_SEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3, ucdba, ucdbau, resp, prdt;
+};
+struct ucd {
+	uint8_t cmd[512], resp[512];
+	struct { uint32_t addr_lo, addr_hi, rsvd, dbc; } prdt[4];
+};
+_Static_assert(sizeof(struct ucd) <= DMA_DATA - DMA_UCD, "UCD must not overlap data");
+_Static_assert(sizeof(struct utrd) == 32, "UFSHCI UTRD size");
+static LCK_GRP_DECLARE(lilac_ufs_grp, "lilac_ufs");
+static LCK_MTX_DECLARE(lilac_ufs_lock, &lilac_ufs_grp);
+static struct {
+	vm_offset_t regs, gcc, dma;
+	uint64_t dma_pa;
+	uint8_t tag;
+	bool attempted, powered, owned, geometry, gpt, selected, policy, ready, phase_ran;
+	uint32_t rw, first, last, backup, secsize;
+	char name[38], guid_arg[34];
+	uint8_t guid[16];
+	dev_t bdev;
+} lu;
+static struct {
+	uint64_t rd, wr, rd_bytes, wr_bytes, ns, max_ns, naps;
+	uint64_t errors, refused, range_refused, reg_refused;
+} us;
+/* GPT snapshots and phase originals are private and never used as DMA memory. */
+static uint8_t gpt_primary[GPT_BYTES], gpt_backup[GPT_BYTES];
+static uint8_t phase_saved[UFS_BYTES], phase_back[UFS_BYTES];
+
+enum ufs_op { OP_TUR, OP_INQUIRY, OP_CAPACITY, OP_SENSE, OP_READ, OP_WRITE, OP_SYNC };
+
+static uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(lu.regs + off);
+}
+
+/* Only controller stores; fail closed, including value restrictions [S1,S3]. */
+static void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	switch (off) {
+	case REG_IS: case REG_UTRLBA: case REG_UTRLBAU: break;
+	case REG_UTRLRSR: if (v > 1) { goto refuse; } break;
+	case REG_UTRLDBR: if (v != 1) { goto refuse; } break;
+	default: goto refuse;
+	}
+	*(volatile uint32_t *)(lu.regs + off) = v;
+	return;
+refuse:
+	us.reg_refused++;
+	printf("LILAC UFS: REFUSED register 0x%x value 0x%x\n", off, v);
+}
+
+static uint32_t
+get_be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+static uint32_t
+get_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+static uint64_t
+get_le64(const uint8_t *p)
+{
+	return get_le32(p) | (uint64_t)get_le32(p + 4) << 32;
+}
+static bool
+nonzero_guid(const uint8_t *g)
+{
+	uint8_t v = 0;
+	for (unsigned i = 0; i < 16; i++) { v |= g[i]; }
+	return v != 0;
+}
+static bool
+ufs_range(uint32_t first, uint32_t last, uint32_t lba, uint32_t n)
+{
+	return n && first <= last && lba >= first && lba <= last && n - 1 <= last - lba;
+}
+
+/* Immutable arm-time facts are checked again at EVERY write/sync request.
+ * Metadata is not writable, and no other driver owns this controller, so the
+ * validated snapshots cannot change through this driver. No GPT repair [S5]. */
+static bool
+ufs_writable(void)
+{
+	return lu.owned && lu.rw == 1 && lu.geometry && lu.gpt && lu.selected && lu.policy &&
+	       nonzero_guid(lu.guid) && lu.first > 5 && lu.first <= lu.last && lu.last < lu.backup;
+}
+static int
+ufs_refuse(uint32_t lba, uint32_t n, bool range)
+{
+	us.refused++;
+	us.range_refused += range;
+	printf("LILAC UFS: REFUSED write lba=%u n=%u range=%u owned=%u rw=%u geometry=%u GPT=%u selected=%u policy=%u GUID-nonzero=%u first=%u last=%u backup=%u\n",
+	    lba, n, range, lu.owned, lu.rw, lu.geometry, lu.gpt, lu.selected, lu.policy,
+	    nonzero_guid(lu.guid), lu.first, lu.last, lu.backup);
+	return EPERM;
+}
+
+/* Diagnostic reads must not defeat the original power/clock admission gate. */
+static void
+ufs_registers(const char *where)
+{
+	if (!lu.regs || !lu.powered) {
+		printf("LILAC UFS: %s registers unavailable (unmapped or power/clock gate failed)\n", where);
+		return;
+	}
+	printf("LILAC UFS: %s HCS=%08x HCE=%08x UTRLRSR=%08x UTRLBA=%08x:%08x DBR=%08x TMDBR=%08x IE=%08x IS=%08x\n",
+	    where, ufs_rd(REG_HCS), ufs_rd(REG_HCE), ufs_rd(REG_UTRLRSR),
+	    ufs_rd(REG_UTRLBAU), ufs_rd(REG_UTRLBA), ufs_rd(REG_UTRLDBR),
+	    ufs_rd(REG_UTMRLDBR), ufs_rd(REG_IE), ufs_rd(REG_IS));
+}
+static int
+ufs_fail(const char *check, int error)
+{
+	printf("LILAC UFS: FAIL %s errno=%d\n", check, error);
+	ufs_registers(check);
+	return error;
+}
+
+static unsigned
+ufs_gate(void)
+{
+	unsigned nib = 0;
+	uint32_t gdsc = *(volatile uint32_t *)(lu.gcc + GDSC_UFS);
+	uint32_t ahb = *(volatile uint32_t *)(lu.gcc + GCC_UFS_AHB);
+	printf("LILAC UFS: power GDSC=%08x AHB=%08x\n", gdsc, ahb);
+	lu.powered = (gdsc & (1u << 31)) && !(ahb & (1u << 31));
+	if (!lu.powered) { (void)ufs_fail("gate power/clock", ENXIO); return 0; }
+	nib |= 1;
+	ufs_registers("inherited");
+	if (ufs_rd(REG_HCE) & 1) { nib |= 2; }
+	else { (void)ufs_fail("gate HCE disabled", ENXIO); }
+	if ((ufs_rd(REG_HCS) & 0x0b) == 0x0b) { nib |= 4; }
+	else { (void)ufs_fail("gate HCS not ready", ENXIO); }
+	if (!ufs_rd(REG_UTRLDBR) && !ufs_rd(REG_UTMRLDBR) && !ufs_rd(REG_IE)) { nib |= 8; }
+	else { (void)ufs_fail("gate outstanding transfer/task or interrupts enabled", EBUSY); }
+	printf("LILAC UFS: inherited gate 0x%x\n", nib);
+	return nib;
+}
+
+static void
+dma_flush(uint32_t off, uint32_t len)
+{
+	if (len) { flush_dcache64((addr64_t)(lu.dma_pa + off), len, TRUE); }
+}
+static int
+ufs_take_list(void)
+{
+	ppnum_t max = (ufs_rd(REG_CAP) & CAP_64AS) ? 0 : (ppnum_t)(UINT32_MAX >> PAGE_SHIFT);
+	kern_return_t kr = kmem_alloc_contig(kernel_map, &lu.dma, DMA_SIZE, PAGE_MASK, max, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS) {
+		printf("LILAC UFS: DMA allocation bytes=%u kr=%d\n", DMA_SIZE, kr);
+		return ufs_fail("DMA allocation", ENOMEM);
+	}
+	lu.dma_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)lu.dma));
+	printf("LILAC UFS: DMA bytes=%u pa=%llx cap=%08x page=%u\n",
+	    DMA_SIZE, lu.dma_pa, ufs_rd(REG_CAP), (unsigned)PAGE_SIZE);
+	if (!lu.dma_pa || (lu.dma_pa & PAGE_MASK) ||
+	    (max && lu.dma_pa + DMA_SIZE - 1 > UINT32_MAX)) { return ufs_fail("DMA address/alignment", ENXIO); }
+	for (uint32_t off = 0; off < DMA_SIZE; off += PAGE_SIZE) {
+		uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, lu.dma + off));
+		if (pa != lu.dma_pa + off) {
+			printf("LILAC UFS: DMA offset=%u actual=%llx expected=%llx\n", off, pa, lu.dma_pa + off);
+			return ufs_fail("DMA contiguity", ENXIO);
+		}
+	}
+	ufs_wr(REG_UTRLRSR, 0);
+	ufs_wr(REG_UTRLBA, (uint32_t)lu.dma_pa);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(lu.dma_pa >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)lu.dma_pa ||
+	    ufs_rd(REG_UTRLBAU) != (uint32_t)(lu.dma_pa >> 32) || !(ufs_rd(REG_UTRLRSR) & 1)) {
+		return ufs_fail("list base/run-stop readback", EIO);
+	}
+	lu.owned = true;
+	return 0;
+}
+
+/* The ONLY CDB source; enum is private, never supplied by an ioctl. [S1,S2]
+ * FUA on all writes; SYNC is range-scoped, never IMMED and never count zero. */
+static int
+ufs_prepare(enum ufs_op op, uint32_t lba, uint32_t n, uint32_t *bytes)
+{
+	uint8_t cdb[16] = { 0 };
+	uint32_t len = 0, dd = 0;
+	if (op == OP_WRITE || op == OP_SYNC) {
+		bool range = !ufs_range(lu.first, lu.last, lba, n);
+		if (!ufs_writable() || range) { return ufs_refuse(lba, n, range); }
+	}
+	switch (op) {
+	case OP_TUR: cdb[0] = 0x00; break;
+	case OP_INQUIRY: cdb[0] = 0x12; cdb[4] = 36; len = 36; break;
+	case OP_CAPACITY: cdb[0] = 0x25; len = 8; break;
+	case OP_SENSE: cdb[0] = 0x03; cdb[4] = 20; len = 20; break;
+	case OP_READ: case OP_WRITE: case OP_SYNC:
+		if (n > (op == OP_SYNC ? 65535u : UFS_MAX_BLOCKS) || !ufs_range(0, EXP_LAST_LBA, lba, n)) {
+			printf("LILAC UFS: command range op=%u lba=%u n=%u\n", op, lba, n);
+			return ufs_fail("command bounds", EINVAL);
+		}
+		cdb[0] = op == OP_READ ? 0x28 : op == OP_WRITE ? 0x2a : 0x35;
+		cdb[1] = op == OP_WRITE ? 8 : 0;
+		cdb[2] = (uint8_t)(lba >> 24); cdb[3] = (uint8_t)(lba >> 16);
+		cdb[4] = (uint8_t)(lba >> 8); cdb[5] = (uint8_t)lba;
+		cdb[7] = (uint8_t)(n >> 8); cdb[8] = (uint8_t)n;
+		len = op == OP_SYNC ? 0 : n * UFS_BLOCK;
+		break;
+	default: return EINVAL;
+	}
+	if (!lu.owned || ufs_rd(REG_UTRLDBR) || !(ufs_rd(REG_UTRLRSR) & 1) ||
+	    ufs_rd(REG_UTRLBA) != (uint32_t)lu.dma_pa ||
+	    ufs_rd(REG_UTRLBAU) != (uint32_t)(lu.dma_pa >> 32)) {
+		return ufs_fail("command ownership/idle/list", EBUSY);
+	}
+	struct utrd *t = (struct utrd *)(lu.dma + DMA_UTRL);
+	struct ucd *u = (struct ucd *)(lu.dma + DMA_UCD);
+	uint64_t pa = lu.dma_pa + DMA_UCD;
+	bzero(t, sizeof(*t)); bzero(u, sizeof(*u));
+	if (len) { dd = op == OP_WRITE ? 1 : 2; }
+	u->cmd[0] = 0x01; /* COMMAND UPIU, never QUERY or task management */
+	u->cmd[1] = dd == 1 ? 0x20 : dd == 2 ? 0x40 : 0;
+	u->cmd[2] = 0; /* LU0 only, including TEST UNIT READY and REQUEST SENSE */
+	u->cmd[3] = ++lu.tag;
+	u->cmd[12] = (uint8_t)(len >> 24); u->cmd[13] = (uint8_t)(len >> 16);
+	u->cmd[14] = (uint8_t)(len >> 8); u->cmd[15] = (uint8_t)len;
+	memcpy(u->cmd + 16, cdb, sizeof(cdb));
+	unsigned entries = 0;
+	for (uint32_t off = 0; off < len; off += PRD_BYTES) {
+		uint64_t data = lu.dma_pa + DMA_DATA + off;
+		u->prdt[entries].addr_lo = (uint32_t)data;
+		u->prdt[entries].addr_hi = (uint32_t)(data >> 32);
+		u->prdt[entries++].dbc = MIN(PRD_BYTES, len - off) - 1;
+	}
+	/* UFSHCI v2 command type 1, inherited from the working RO probe [S3]. */
+	t->dw0 = (1u << 28) | (dd << 25) | (1u << 24);
+	t->dw2 = 0x0f; t->ucdba = (uint32_t)pa; t->ucdbau = (uint32_t)(pa >> 32);
+	t->resp = (512u / 4) << 16 | (512u / 4);
+	t->prdt = (1024u / 4) << 16 | entries;
+	*bytes = len;
+	return 0;
+}
+
+/* Called under lilac_ufs_lock (or single-threaded probe before publication). */
+static int
+ufs_cmd(enum ufs_op op, uint32_t lba, uint32_t n, void *buf)
+{
+	uint32_t len;
+	int error = ufs_prepare(op, lba, n, &len);
+	if (error) { return error; }
+	if (len && !buf) { return ufs_fail("command data buffer absent", EINVAL); }
+	struct utrd *t = (struct utrd *)(lu.dma + DMA_UTRL);
+	struct ucd *u = (struct ucd *)(lu.dma + DMA_UCD);
+	void *data = (void *)(lu.dma + DMA_DATA);
+	if (op == OP_WRITE) { memcpy(data, buf, len); }
+	else if (len) { bzero(data, len); }
+	dma_flush(DMA_DATA, len); dma_flush(DMA_UCD, sizeof(*u)); dma_flush(DMA_UTRL, sizeof(*t));
+	__builtin_arm_dsb(0xf);
+	uint64_t start = mach_absolute_time(), timeout, spin;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &timeout);
+	nanoseconds_to_absolutetime(20000, &spin);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLDBR, 1);
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		uint64_t elapsed = mach_absolute_time() - start;
+		if (elapsed > timeout) {
+			error = ETIMEDOUT;
+			goto failed; /* DMA may still be live: never read/reuse/free this allocation. */
+		}
+		if (elapsed > spin && !panic_active()) { delay(150); us.naps++; }
+	}
+	__builtin_arm_dsb(0xf);
+	dma_flush(DMA_UTRL, sizeof(*t)); dma_flush(DMA_UCD, sizeof(*u));
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	/* Reject short/overflow transfers, wrong task, LU or transaction, not just OCS. */
+	if ((t->dw2 & 0x0f) || u->resp[0] != 0x21 || u->resp[2] || u->resp[3] != lu.tag ||
+	    u->resp[6] || u->resp[7] || (u->resp[1] & 0x60) || get_be32(u->resp + 12)) {
+		printf("LILAC UFS: response op=%u lba=%u n=%u ocs=%x type=%x LUN=%x tag=%x expected=%x response=%x status=%x flags=%x residual=%u sense=%02x/%02x/%02x\n",
+		    op, lba, n, t->dw2, u->resp[0], u->resp[2], u->resp[3], lu.tag,
+		    u->resp[6], u->resp[7], u->resp[1], get_be32(u->resp + 12),
+		    u->resp[36] & 15u, u->resp[46], u->resp[47]);
+		error = EIO; goto failed;
+	}
+	if (len && op != OP_WRITE) { dma_flush(DMA_DATA, len); memcpy(buf, data, len); }
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	us.ns += ns; if (ns > us.max_ns) { us.max_ns = ns; }
+	if (op == OP_READ) { us.rd++; us.rd_bytes += len; }
+	if (op == OP_WRITE) { us.wr++; us.wr_bytes += len; }
+	return 0;
+failed:
+	lu.owned = false; /* Keep allocation wired, never reset, retry, clear or reinitialize. */
+	us.errors++;
+	printf("LILAC UFS: transport stopped op %u lba %u n %u error %d; recovery requires reboot\n", op, lba, n, error);
+	return ufs_fail(error == ETIMEDOUT ? "command timeout" : "command response", error);
+}
+
+static unsigned
+ufs_legacy_header(uint32_t lba)
+{
+	uint8_t b[UFS_BLOCK];
+	if (ufs_cmd(OP_READ, lba, 1, b)) { return 0; }
+	unsigned nib = 1;
+	if (!memcmp(b, "EFI PART", 8)) {
+		nib |= 2;
+		uint32_t size = get_le32(b + 12), sum = get_le32(b + 16);
+		if (size >= 92 && size <= 512) {
+			bzero(b + 16, 4);
+			if (crc32(0, b, size) == sum) { nib |= 4; }
+		}
+		if (get_le64(b + 24) == 1 && get_le64(b + 32) == EXP_LAST_LBA && get_le64(b + 72) == 2) { nib |= 8; }
+	}
+	return nib;
+}
+
+static int
+hex_digit(char c)
+{
+	if (c >= '0' && c <= '9') { return c - '0'; }
+	if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
+	if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
+	return -1;
+}
+static bool
+ufs_args(void)
+{
+	bool rw_present = PE_parse_boot_argn("ufsrw", &lu.rw, sizeof(lu.rw));
+	bool name_present = PE_parse_boot_argn("ufspart", lu.name, sizeof(lu.name));
+	bool guid_present = PE_parse_boot_argn("ufsguid", lu.guid_arg, sizeof(lu.guid_arg));
+	lu.name[sizeof(lu.name) - 1] = 0; lu.guid_arg[sizeof(lu.guid_arg) - 1] = 0;
+	size_t n = strlen(lu.name);
+	printf("LILAC UFS: args rw-present=%u rw=%u name-present=%u name=%s guid-present=%u guid=%s\n",
+	    rw_present, lu.rw, name_present, lu.name, guid_present, lu.guid_arg);
+	if (!n || n > 36 || strlen(lu.guid_arg) != 32) {
+		(void)ufs_fail("args name/GUID length or missing", EINVAL); return false;
+	}
+	for (size_t i = 0; i < n; i++) {
+		char c = lu.name[i];
+		if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+		    (c >= '0' && c <= '9') || c == '_' || c == '-')) {
+			(void)ufs_fail("args name character", EINVAL); return false;
+		}
+	}
+	for (unsigned i = 0; i < 16; i++) {
+		int a = hex_digit(lu.guid_arg[i * 2]), b = hex_digit(lu.guid_arg[i * 2 + 1]);
+		if (a < 0 || b < 0) { (void)ufs_fail("args GUID non-hex", EINVAL); return false; }
+		lu.guid[i] = (uint8_t)(a * 16 + b);
+	}
+	if (!nonzero_guid(lu.guid)) { (void)ufs_fail("args GUID zero", EINVAL); return false; }
+	return true;
+}
+
+/* Policy is intentionally more conservative than GPT itself [S1 section 7,S5]. */
+static bool
+ufs_denied(const char *name)
+{
+	static const char *const prefix[] = {
+		"xbl", "abl", "modem", "dsp", "bluetooth", "boot", "rpm", "tz", "hyp",
+		"devcfg", "keymaster", "cmnlib", "pmic", "splash", "mdtp", "vendor", "system", "oem"
+	};
+	static const char *const exact[] = {
+		"ta", "persist", "frp", "misc", "devinfo", "ssd", "sec", "apdp", "msadp", "dpo",
+		"qnovo", "ltalabel", "diag", "fsg", "fsc", "ddr", "limits", "logfs", "storsec", "userdata"
+	};
+	char lower[37];
+	size_t n = strlen(name);
+	if (n > 36) { return true; }
+	for (size_t i = 0; i <= n; i++) {
+		lower[i] = name[i] >= 'A' && name[i] <= 'Z' ? name[i] + ('a' - 'A') : name[i];
+	}
+	for (unsigned i = 0; i < sizeof(prefix) / sizeof(prefix[0]); i++) {
+		if (!strncmp(lower, prefix[i], strlen(prefix[i]))) { return true; }
+	}
+	for (unsigned i = 0; i < sizeof(exact) / sizeof(exact[0]); i++) {
+		if (!strcmp(lower, exact[i])) { return true; }
+	}
+	return false;
+}
+
+static bool
+ufs_name_matches(const uint8_t *entry)
+{
+	size_t n = strlen(lu.name);
+	for (unsigned i = 0; i < 36; i++) {
+		unsigned c = entry[56 + i * 2] | (unsigned)entry[57 + i * 2] << 8;
+		if (c != (i < n ? (uint8_t)lu.name[i] : 0)) { return false; }
+	}
+	return true;
+}
+
+/* Bounded GPT 1.0: up to 128 standard 128-byte entries. Refuse unsupported
+ * layouts, never guess or repair them. Header fields decoded without casts. */
+static bool
+ufs_header(uint8_t *h, uint32_t my, uint32_t alt, uint32_t *entries, uint32_t *array)
+{
+	uint32_t size = get_le32(h + 12), sum = get_le32(h + 16);
+	printf("LILAC UFS: GPT header read-LBA=%u block=%u signature=%08x%08x revision=%x size=%u reserved=%x self=%llu alternate=%llu usable=%llu..%llu array=%llu entries=%u entry-size=%u header-crc=%08x array-crc=%08x\n",
+	    my, UFS_BLOCK, get_be32(h), get_be32(h + 4), get_le32(h + 8), size, get_le32(h + 20),
+	    get_le64(h + 24), get_le64(h + 32), get_le64(h + 40), get_le64(h + 48),
+	    get_le64(h + 72), get_le32(h + 80), get_le32(h + 84), sum, get_le32(h + 88));
+	if (memcmp(h, "EFI PART", 8)) { (void)ufs_fail("GPT signature", EINVAL); return false; }
+	if (get_le32(h + 8) != 0x10000 || size < 92 || size > UFS_BLOCK || get_le32(h + 20)) {
+		(void)ufs_fail("GPT revision/header-size/reserved", EINVAL); return false;
+	}
+	bzero(h + 16, 4);
+	uint32_t actual = crc32(0, h, size);
+	memcpy(h + 16, &sum, 4);
+	printf("LILAC UFS: GPT header LBA=%u CRC stored=%08x calculated=%08x\n", my, sum, actual);
+	if (actual != sum) { (void)ufs_fail("GPT header CRC", EINVAL); return false; }
+	if (get_le64(h + 24) != my || get_le64(h + 32) != alt) {
+		(void)ufs_fail("GPT self/alternate LBA", EINVAL); return false;
+	}
+	if (get_le64(h + 40) < 6 || get_le64(h + 40) > get_le64(h + 48) ||
+	    get_le64(h + 48) >= EXP_LAST_LBA || !nonzero_guid(h + 56)) {
+		(void)ufs_fail("GPT usable geometry/disk GUID", EINVAL); return false;
+	}
+	*entries = get_le32(h + 80);
+	if (!*entries || *entries > GPT_ENTRIES || get_le32(h + 84) != GPT_ENTRY_SIZE ||
+	    get_le64(h + 72) > EXP_LAST_LBA) {
+		(void)ufs_fail("GPT array count/entry-size/LBA bounds", EINVAL); return false;
+	}
+	*array = (uint32_t)get_le64(h + 72);
+	uint32_t blocks = (*entries * GPT_ENTRY_SIZE + UFS_BLOCK - 1) / UFS_BLOCK;
+	uint64_t end = (uint64_t)*array + blocks; /* exclusive end, no wrap */
+	/* Real lilac GPT: 66*128 bytes consume 3 blocks of a 4-block reserved
+	 * area (backup array 7810043, header 7810047). UEFI 2.10 section 5.3
+	 * permits padding; adjacency is NOT a validity condition. CRC covers
+	 * exactly the advertised entries, never the padding. All of the backup
+	 * reservation remains excluded from writes by lu.last < lu.backup. */
+	bool valid = my == 1 ? *array == 2 && end <= get_le64(h + 40) :
+	    *array > get_le64(h + 48) && end <= my;
+	printf("LILAC UFS: GPT array LBA=%u blocks=%u end-exclusive=%llu header-LBA=%u bounded=%u\n",
+	    *array, blocks, end, my, valid);
+	if (!valid) { (void)ufs_fail("GPT array overlaps header/usable region", EINVAL); }
+	return valid;
+}
+
+static int
+ufs_validate_gpt(void)
+{
+	static uint8_t p[UFS_BLOCK], b[UFS_BLOCK]; /* serialized, not 8 KiB on the kernel stack */
+	uint32_t pn, bn, pa, ba;
+	lu.gpt = lu.selected = lu.policy = false;
+	int error = ufs_cmd(OP_READ, 1, 1, p);
+	if (error) { return ufs_fail("GPT primary header read", error); }
+	error = ufs_cmd(OP_READ, EXP_LAST_LBA, 1, b);
+	if (error) { return ufs_fail("GPT backup header read", error); }
+	if (!ufs_header(p, 1, EXP_LAST_LBA, &pn, &pa)) { return ufs_fail("GPT primary header rejected", EINVAL); }
+	if (!ufs_header(b, EXP_LAST_LBA, 1, &bn, &ba)) { return ufs_fail("GPT backup header rejected", EINVAL); }
+	if (pn != bn || memcmp(p + 40, b + 40, 32) || get_le32(p + 88) != get_le32(b + 88)) {
+		return ufs_fail("GPT headers disagree (count/geometry/disk GUID/array CRC)", EINVAL);
+	}
+	uint32_t bytes = pn * GPT_ENTRY_SIZE, blocks = (bytes + UFS_BLOCK - 1) / UFS_BLOCK;
+	error = ufs_cmd(OP_READ, pa, blocks, gpt_primary);
+	if (error) { return ufs_fail("GPT primary array read", error); }
+	error = ufs_cmd(OP_READ, ba, blocks, gpt_backup);
+	if (error) { return ufs_fail("GPT backup array read", error); }
+	uint32_t pc = crc32(0, gpt_primary, bytes), bc = crc32(0, gpt_backup, bytes);
+	printf("LILAC UFS: GPT arrays exact-bytes=%u primary-LBA=%u CRC=%08x expected=%08x backup-LBA=%u CRC=%08x expected=%08x entries-match=%u\n",
+	    bytes, pa, pc, get_le32(p + 88), ba, bc, get_le32(b + 88), !memcmp(gpt_primary, gpt_backup, bytes));
+	if (pc != get_le32(p + 88) || bc != get_le32(b + 88)) { return ufs_fail("GPT array CRC", EINVAL); }
+	if (memcmp(gpt_primary, gpt_backup, bytes)) { return ufs_fail("GPT entries differ", EINVAL); }
+	int target = -1;
+	unsigned names = 0, guids = 0;
+	for (unsigned i = 0; i < pn; i++) {
+		const uint8_t *e = gpt_primary + i * GPT_ENTRY_SIZE;
+		if (!nonzero_guid(e)) { continue; }
+		uint64_t first = get_le64(e + 32), last = get_le64(e + 40);
+		if (!nonzero_guid(e + 16) || first > last || first < get_le64(p + 40) ||
+		    last > get_le64(p + 48) || first <= 5 || last >= ba) {
+			printf("LILAC UFS: GPT entry=%u first=%llu last=%llu GUID-nonzero=%u\n", i, first, last, nonzero_guid(e + 16));
+			return ufs_fail("GPT entry GUID/extent", EINVAL);
+		}
+		for (unsigned j = 0; j < i; j++) {
+			const uint8_t *o = gpt_primary + j * GPT_ENTRY_SIZE;
+			if (nonzero_guid(o) && (!memcmp(e + 16, o + 16, 16) ||
+			    (first <= get_le64(o + 40) && last >= get_le64(o + 32)))) {
+				printf("LILAC UFS: GPT entry=%u conflicts with entry=%u\n", i, j);
+				return ufs_fail("GPT duplicate GUID/overlapping extents", EINVAL);
+			}
+		}
+		bool name = ufs_name_matches(e), guid = !memcmp(e + 16, lu.guid, 16);
+		if (name || guid) {
+			printf("LILAC UFS: GPT target candidate entry=%u name-match=%u GUID-match=%u first=%llu last=%llu\n",
+			    i, name, guid, first, last);
+		}
+		names += name; guids += guid;
+		if (name && guid) { target = (int)i; }
+	}
+	lu.gpt = true;
+	lu.backup = ba;
+	printf("LILAC UFS: GPT selection name=%s GUID=%s name-matches=%u GUID-matches=%u target=%d\n",
+	    lu.name, lu.guid_arg, names, guids, target);
+	if (target < 0 || names != 1 || guids != 1) { return ufs_fail("GPT exact unique name+GUID selection", ENOENT); }
+	const uint8_t *e = gpt_primary + (unsigned)target * GPT_ENTRY_SIZE;
+	lu.first = (uint32_t)get_le64(e + 32); lu.last = (uint32_t)get_le64(e + 40);
+	lu.selected = true;
+	/* GPT bit0 required, bit60 read-only; never arm either [S5]. */
+	bool denied = ufs_denied(lu.name);
+	uint64_t attributes = get_le64(e + 48);
+	lu.policy = !denied && !(attributes & (1ull | (1ull << 60)));
+	printf("LILAC UFS: GPT policy denied-name=%u attributes=%llx required=%u read-only=%u\n",
+	    denied, attributes, !!(attributes & 1), !!(attributes & (1ull << 60)));
+	if (denied) { (void)ufs_fail("target deny-list", EPERM); }
+	if (attributes & (1ull | (1ull << 60))) { (void)ufs_fail("target required/read-only attribute", EPERM); }
+	printf("LILAC UFS: target %s guid %s first %u last %u GPT matched policy %u rw %u\n",
+	    lu.name, lu.guid_arg, lu.first, lu.last, lu.policy, lu.rw);
+	return 0;
+}
+
+static unsigned
+ufs_identify(void)
+{
+	uint8_t b[36];
+	unsigned nib = 0;
+	int e = ufs_cmd(OP_INQUIRY, 0, 0, b);
+	if (!e) {
+		nib |= 1;
+		printf("LILAC UFS: INQUIRY vendor=%.8s product=%.16s\n", b + 8, b + 16);
+		if (!memcmp(b + 8, "TOSHIBA ", 8) && !memcmp(b + 16, "THGAF4G8N2LBAIRB", 16)) { nib |= 2; }
+		else { (void)ufs_fail("INQUIRY model mismatch", ENXIO); }
+	} else { (void)ufs_fail("INQUIRY command", e); }
+	e = ufs_cmd(OP_CAPACITY, 0, 0, b);
+	if (!e) {
+		nib |= 4;
+		printf("LILAC UFS: capacity last-LBA=%u expected=%u block-size=%u expected=%u\n",
+		    get_be32(b), EXP_LAST_LBA, get_be32(b + 4), UFS_BLOCK);
+		if (get_be32(b) == EXP_LAST_LBA && get_be32(b + 4) == UFS_BLOCK) { nib |= 8; }
+		else { (void)ufs_fail("capacity geometry mismatch", ENXIO); }
+	} else { (void)ufs_fail("capacity command", e); }
+	lu.geometry = nib == 15; /* also pin the observed card model */
+	printf("LILAC UFS: identify nibble=%x geometry=%u\n", nib, lu.geometry);
+	return nib;
+}
+
+/* Single attempt per boot: never reinitialize after a failed/uncertain request. */
+static int
+ufs_init(void)
+{
+	if (lu.attempted) { return lu.selected && lu.owned ? 0 : ufs_fail("init already attempted", ENXIO); }
+	lu.attempted = true;
+	printf("LILAC UFS: init begin (inherited link; no HCE/UIC/PHY/power writes)\n");
+	if (!ufs_args()) { return EINVAL; }
+	/* Same PA windows, power/HCE/HCS/IE checks and list-base/run-stop
+	 * write/readback sequence as RO stages 80/81 (12340e7). Added checks:
+	 * idle task list and every DMA page (256 KiB rather than 4 KiB data).
+	 * The old RO stage 82 checked only the primary header, not the backup
+	 * array placement; its success cannot validate the latter. Unlike the
+	 * old read-only UNIT ATTENTION retry, this transport stops on any error
+	 * and now logs response/sense. No inherited-link gates are weakened. */
+	lu.gcc = ml_io_map(GCC_UFS_PA, PAGE_SIZE); lu.regs = ml_io_map(UFS_PA, PAGE_SIZE);
+	printf("LILAC UFS: map GCC=%llx UFS=%llx bytes=%u GCC-ok=%u UFS-ok=%u\n",
+	    (uint64_t)GCC_UFS_PA, (uint64_t)UFS_PA, (unsigned)PAGE_SIZE, !!lu.gcc, !!lu.regs);
+	if (!lu.gcc || !lu.regs) { return ufs_fail("MMIO map", ENXIO); }
+	if (ufs_gate() != 15) { return ufs_fail("inherited controller gate", ENXIO); }
+	int e = ufs_take_list();
+	if (e) { return e; }
+	ufs_registers("owned list");
+	if (ufs_identify() != 15) { return ufs_fail("identity/geometry gate", ENXIO); }
+	e = ufs_validate_gpt();
+	printf("LILAC UFS: init result=%d owned=%u geometry=%u GPT=%u selected=%u policy=%u rw=%u\n",
+	    e, lu.owned, lu.geometry, lu.gpt, lu.selected, lu.policy, lu.rw);
+	return e;
+}
+
+/* Successful return means FUA WRITE + scoped SYNCHRONIZE + identical readback. */
+static int
+ufs_write_verify(uint32_t n, uint8_t *data)
+{
+	int e = ufs_cmd(OP_WRITE, lu.first, n, data);
+	if (!e) { e = ufs_cmd(OP_SYNC, lu.first, n, NULL); }
+	if (!e) { e = ufs_cmd(OP_READ, lu.first, n, phase_back); }
+	if (!e && memcmp(data, phase_back, n * UFS_BLOCK)) { e = ufs_fail("write readback comparison", EIO); }
+	return e;
+}
+
+static unsigned
+ufs_phase(unsigned stage)
+{
+	int init = ufs_init();
+	unsigned nib = 0;
+	if (stage == 87) {
+		if (lu.rw == 1) { nib |= 1; }
+		if (lu.geometry && lu.gpt) { nib |= 2; }
+		if (lu.selected && lu.policy) { nib |= 4; }
+		uint32_t bytes = 0;
+		if (!init && !ufs_prepare(OP_WRITE, lu.first, 1, &bytes)) {
+			nib |= 8;
+			printf("LILAC UFS W0: DRY WRITE10 FUA LU0 lba %u bytes %u dw0 %x prdt %x NO DOORBELL\n",
+			    lu.first, bytes, ((struct utrd *)lu.dma)->dw0, ((struct utrd *)lu.dma)->prdt);
+		}
+		return nib;
+	}
+	if (init) { return 0; }
+	if (stage == 88) {
+		/* N=4 MiB; no write gate needed for this read-only regression. */
+		const uint32_t blocks = (4u << 20) / UFS_BLOCK;
+		if (!ufs_range(lu.first, lu.last, lu.first, blocks)) {
+			(void)ufs_fail("W1 extent smaller than 4 MiB", EINVAL); return 0;
+		}
+		nib = 1;
+		uint32_t crc = 0;
+		uint64_t start = mach_absolute_time(), ns;
+		for (uint32_t off = 0; off < blocks; off += UFS_MAX_BLOCKS) {
+			if (ufs_cmd(OP_READ, lu.first + off, UFS_MAX_BLOCKS, phase_back)) { return nib; }
+			crc = crc32(crc, phase_back, UFS_BYTES);
+		}
+		nib |= 2;
+		absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+		printf("LILAC UFS W1: 4 MiB %llu us %llu KiB/s crc32 %08x\n",
+		    ns / 1000, ns ? 4096ull * NSEC_PER_SEC / ns : 0, crc);
+		if (ufs_cmd(OP_READ, lu.first, UFS_MAX_BLOCKS, phase_saved)) { return nib; }
+		for (unsigned i = 0; i < UFS_MAX_BLOCKS; i++) {
+			if (ufs_cmd(OP_READ, lu.first + i, 1, phase_back + i * UFS_BLOCK)) { return nib; }
+		}
+		nib |= 4;
+		if (!memcmp(phase_saved, phase_back, UFS_BYTES)) { nib |= 8; }
+		else { (void)ufs_fail("W1 multi/single-block comparison", EIO); }
+		return nib;
+	}
+	if (!ufs_writable()) { (void)ufs_refuse(lu.first, 1, false); return 0; }
+	nib = 1;
+	if (stage == 89) {
+		if (!ufs_range(lu.first, lu.last, lu.first, UFS_MAX_BLOCKS)) {
+			(void)ufs_fail("W2 extent smaller than test transfer", EINVAL); return nib;
+		}
+		if (ufs_cmd(OP_READ, lu.first, 1, phase_saved) || ufs_write_verify(1, phase_saved)) { return nib; }
+		nib |= 2;
+		if (ufs_cmd(OP_READ, lu.first, UFS_MAX_BLOCKS, phase_saved) ||
+		    ufs_write_verify(UFS_MAX_BLOCKS, phase_saved)) { return nib; }
+		nib |= 4 | 8; /* both sizes verified, both explicit cache synchronizations completed */
+	} else if (stage == 90) {
+		if (ufs_cmd(OP_READ, lu.first, 1, phase_saved)) { return nib; }
+		for (unsigned i = 0; i < UFS_BLOCK; i++) { phase_back[i] = (uint8_t)~phase_saved[i]; }
+		int e = ufs_cmd(OP_WRITE, lu.first, 1, phase_back);
+		if (!e) { e = ufs_cmd(OP_SYNC, lu.first, 1, NULL); }
+		if (!e) { nib |= 2; e = ufs_cmd(OP_READ, lu.first, 1, phase_back); }
+		if (!e) {
+			bool same = true;
+			for (unsigned i = 0; i < UFS_BLOCK; i++) {
+				if (phase_back[i] != (uint8_t)(phase_saved[i] ^ 0xffu)) { same = false; }
+			}
+			if (same) { nib |= 4; }
+			else { (void)ufs_fail("W3 pattern readback comparison", EIO); }
+		}
+		/* Attempt restore even after a compare mismatch, but NEVER after a
+		 * poisoned transport. Original bytes retained until reboot, not DMA. */
+		if (lu.owned && !ufs_write_verify(1, phase_saved)) { nib |= 8; }
+		else { printf("LILAC UFS W3: RESTORE NOT VERIFIED; operator backup recovery required\n"); }
+	}
+	return nib;
+}
+
+static int
+lilac_ufs_open(dev_t dev, int flags, __unused int type, __unused struct proc *p)
+{
+	lck_mtx_lock(&lilac_ufs_lock);
+	int e = (minor(dev) || !lu.ready || !lu.owned) ? ENXIO :
+	    (flags & FWRITE) && !ufs_writable() ? ufs_refuse(lu.first, 1, false) : 0;
+	lck_mtx_unlock(&lilac_ufs_lock);
+	return e;
+}
+static int
+lilac_ufs_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+static void
+lilac_ufs_strategy(buf_t bp)
+{
+	caddr_t vaddr = NULL;
+	uint32_t count = buf_count(bp);
+	bool rd = (buf_flags(bp) & B_READ) != 0;
+	int e = 0;
+	buf_setresid(bp, count);
+	lck_mtx_lock(&lilac_ufs_lock);
+	uint64_t part = ((uint64_t)lu.last - lu.first + 1) * UFS_BLOCK;
+	uint64_t blk = (uint64_t)buf_blkno(bp), off = 0;
+	if (!lu.ready || !lu.owned || minor(buf_device(bp))) { e = ENXIO; goto done; }
+	/* Divide BEFORE multiplying so hostile blkno cannot wrap into the target. */
+	if (buf_blkno(bp) < 0 || blk > part / lu.secsize) { e = rd ? EINVAL : ufs_refuse(0, count / UFS_BLOCK, true); goto done; }
+	off = blk * lu.secsize;
+	if ((off % UFS_BLOCK) || (count % UFS_BLOCK) || count > part - off) {
+		e = rd ? EINVAL : ufs_refuse(0, count / UFS_BLOCK, true); goto done;
+	}
+	if (!rd && !ufs_writable()) { e = ufs_refuse(lu.first, count / UFS_BLOCK, false); goto done; }
+	if (!count) { goto done; }
+	if (buf_map(bp, &vaddr)) { e = EIO; goto done; }
+	for (uint32_t done = 0; done < count;) {
+		uint32_t n = MIN((count - done) / UFS_BLOCK, UFS_MAX_BLOCKS);
+		e = ufs_cmd(rd ? OP_READ : OP_WRITE, lu.first + (uint32_t)((off + done) / UFS_BLOCK), n, vaddr + done);
+		if (e) { break; }
+		done += n * UFS_BLOCK; buf_setresid(bp, count - done);
+	}
+	buf_unmap(bp);
+done:
+	lck_mtx_unlock(&lilac_ufs_lock);
+	if (e) { buf_seterror(bp, e); }
+	buf_biodone(bp);
+}
+
+static int
+lilac_ufs_ioctl(dev_t dev, u_long cmd, caddr_t data, __unused int flags, __unused struct proc *p)
+{
+	uint32_t v = 0;
+	uint64_t q = 0;
+	unsigned outsize = 0;
+	int e = 0;
+	lck_mtx_lock(&lilac_ufs_lock);
+	if (minor(dev) || !lu.ready || !lu.owned) { e = ENXIO; goto done; }
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE: v = lu.secsize; outsize = 4; break;
+	case DKIOCSETBLOCKSIZE:
+		/* hfs_mountfs temporarily selects 512 to measure the disk, then
+		 * restores 4096 before I/O. Only logical numbering changes; strategy
+		 * still rejects non-native-aligned I/O, never sub-block write RMW. */
+		memcpy(&v, data, sizeof(v));
+		if (v < 512 || v > UFS_BLOCK || (v & (v - 1))) { e = EINVAL; }
+		else { lu.secsize = v; }
+		break;
+	case DKIOCGETPHYSICALBLOCKSIZE: v = UFS_BLOCK; outsize = 4; break;
+	case DKIOCGETBLOCKCOUNT: q = ((uint64_t)lu.last - lu.first + 1) * UFS_BLOCK / lu.secsize; outsize = 8; break;
+	case DKIOCISWRITABLE: v = ufs_writable(); outsize = 4; break;
+	case DKIOCISSOLIDSTATE: v = 1; outsize = 4; break;
+	case DKIOCISVIRTUAL: v = 0; outsize = 4; break;
+	case DKIOCGETFEATURES: v = 0; outsize = 4; break; /* no UNMAP, trim, erase or passthrough */
+	case DKIOCGETMAXBLOCKCOUNTREAD: q = UFS_BYTES / lu.secsize; outsize = 8; break;
+	case DKIOCGETMAXBLOCKCOUNTWRITE: q = ufs_writable() ? UFS_BYTES / lu.secsize : 0; outsize = 8; break;
+	case DKIOCGETMAXBYTECOUNTREAD: case DKIOCGETMAXSEGMENTBYTECOUNTREAD:
+		q = UFS_BYTES; outsize = 8; break;
+	case DKIOCGETMAXBYTECOUNTWRITE: case DKIOCGETMAXSEGMENTBYTECOUNTWRITE:
+		q = ufs_writable() ? UFS_BYTES : 0; outsize = 8; break;
+	/* CPU pages are copied into the contiguous bounce allocation; they are
+	 * not hardware PRDT segments. Reporting 1 caps HFS journal I/O at PAGE_SIZE. */
+	case DKIOCGETMAXSEGMENTCOUNTREAD: case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		q = UFS_BYTES / PAGE_SIZE; outsize = 8; break;
+	case DKIOCSYNCHRONIZE: case DKIOCSYNCHRONIZECACHE: {
+		/* Journal flushes are synchronous, target-scoped and nonzero-count.
+		 * Validate byte extents before rounding out to native blocks. */
+		uint64_t size = ((uint64_t)lu.last - lu.first + 1) * UFS_BLOCK;
+		dk_synchronize_t sync = { 0 };
+		if (!ufs_writable()) { e = ufs_refuse(lu.first, 1, false); break; }
+		if (cmd == DKIOCSYNCHRONIZE) { memcpy(&sync, data, sizeof(sync)); }
+		if (sync.options & ~DK_SYNCHRONIZE_OPTION_BARRIER) { e = EINVAL; break; }
+		if (sync.offset >= size || sync.length > size - sync.offset) {
+			e = ufs_refuse(0, 0, true); break;
+		}
+		uint64_t end = sync.length ? sync.offset + sync.length : size;
+		uint32_t last = lu.first + (uint32_t)((end - 1) / UFS_BLOCK);
+		for (uint32_t lba = lu.first + (uint32_t)(sync.offset / UFS_BLOCK); lba <= last;) {
+			uint32_t n = MIN(last - lba + 1, 65535u);
+			e = ufs_cmd(OP_SYNC, lba, n, NULL); if (e) { break; } lba += n;
+		}
+		break;
+	}
+	default: e = ENOTTY; break;
+	}
+done:
+	if (!e && outsize == 4) { memcpy(data, &v, sizeof(v)); }
+	if (!e && outsize == 8) { memcpy(data, &q, sizeof(q)); }
+	lck_mtx_unlock(&lilac_ufs_lock);
+	return e;
+}
+static int
+lilac_ufs_psize(__unused dev_t dev)
+{
+	return lu.ready ? (int)(((uint64_t)lu.last - lu.first + 1) * UFS_BLOCK / lu.secsize) : -1;
+}
+static int
+lilac_ufs_read(dev_t dev, struct uio *uio, __unused int flag)
+{
+	return physio(lilac_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)lu.secsize);
+}
+static int
+lilac_ufs_write(dev_t dev, struct uio *uio, __unused int flag)
+{
+	lck_mtx_lock(&lilac_ufs_lock);
+	int e = ufs_writable() ? 0 : ufs_refuse(lu.first, 1, false);
+	lck_mtx_unlock(&lilac_ufs_lock);
+	if (e) { return e; }
+	return physio(lilac_ufs_strategy, NULL, dev, B_WRITE, minphys, uio, (int)lu.secsize);
+}
+static const struct bdevsw lilac_ufs_bdevsw = {
+	.d_open = lilac_ufs_open, .d_close = lilac_ufs_close, .d_strategy = lilac_ufs_strategy,
+	.d_ioctl = lilac_ufs_ioctl, .d_dump = eno_dump, .d_psize = lilac_ufs_psize, .d_type = D_DISK,
+};
+static const struct cdevsw lilac_ufs_cdevsw = {
+	.d_open = lilac_ufs_open, .d_close = lilac_ufs_close, .d_read = lilac_ufs_read,
+	.d_write = lilac_ufs_write, .d_ioctl = lilac_ufs_ioctl, .d_stop = eno_stop,
+	.d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = D_DISK,
+};
+static int
+ufs_publish(void)
+{
+	if (lu.ready) { return 0; }
+	/* A diagnostic boot must not fall through to a filesystem writer if
+	 * SDLOG failed to arm (nor publish if a model's reset hook returns). */
+	for (unsigned s = 87; s <= 90; s++) {
+		if (lilac_stop_is(s)) { return ufs_fail("phase boot cannot publish; requires armed SDLOG", ENXIO); }
+	}
+	int e = ufs_init(); if (e) { return e; }
+	int bmajor = bdevsw_add(-1, &lilac_ufs_bdevsw);
+	if (bmajor < 0) { return ENXIO; }
+	int cmajor = cdevsw_add_with_bdev(-1, &lilac_ufs_cdevsw, bmajor);
+	if (cmajor < 0) { return ENXIO; }
+	lu.bdev = makedev(bmajor, 0); lu.secsize = UFS_BLOCK;
+	int mode = ufs_writable() ? 0640 : 0440;
+	if (!devfs_make_node(lu.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, mode, "ufsroot0") ||
+	    !devfs_make_node(makedev(cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, mode, "rufsroot0")) { return ENXIO; }
+	lu.ready = true;
+	printf("LILAC UFS: ufsroot0 %s partition %s %u blocks (4096 bytes)\n",
+	    ufs_writable() ? "read-write" : "read-only", lu.name, lu.last - lu.first + 1);
+	return 0;
+}
+int lilac_ufs_rootdev(dev_t *dev);
+int
+lilac_ufs_rootdev(dev_t *dev)
+{
+	lck_mtx_lock(&lilac_ufs_lock);
+	int e = ufs_publish(); if (!e) { *dev = lu.bdev; }
+	lck_mtx_unlock(&lilac_ufs_lock);
+	return e;
+}
+void lilac_ufs_report(void);
+void
+lilac_ufs_report(void)
+{
+	lck_mtx_lock(&lilac_ufs_lock);
+	if (!lu.attempted) { lck_mtx_unlock(&lilac_ufs_lock); return; }
+	printf("LILAC UFSSTAT rd %llu req %llu KiB | wr %llu req %llu KiB | time %llu ms max %llu us naps %llu | err %llu refused %llu range %llu reg %llu\n",
+	    us.rd, us.rd_bytes / 1024, us.wr, us.wr_bytes / 1024, us.ns / NSEC_PER_MSEC,
+	    us.max_ns / 1000, us.naps, us.errors, us.refused, us.range_refused, us.reg_refused);
+	lck_mtx_unlock(&lilac_ufs_lock);
+}
+/* Called only after vfsinit has created the devfs blueprint root. Diagnostic
+ * phases run earlier and never publish nodes or expose a filesystem writer. */
+void lilac_ufs_attach(void);
+void
+lilac_ufs_attach(void)
+{
+	char name[38] = { 0 };
+	if (!PE_parse_boot_argn("ufspart", name, sizeof(name))) { return; }
+	lck_mtx_lock(&lilac_ufs_lock);
+	int e = ufs_publish();
+	if (e) { printf("LILAC UFS: attach refused %d\n", e); }
+	lck_mtx_unlock(&lilac_ufs_lock);
+}
+
+void lilac_ufs_probe(void);
+void
+lilac_ufs_probe(void)
+{
+	unsigned stage = 0;
+	for (unsigned s = 80; s <= 83; s++) {
+		if (lilac_stop_is(s)) { stage = s; }
+	}
+	if (!stage) { return; } /* W0-W3 run only from the successful SDLOG arm hook. */
+	lck_mtx_lock(&lilac_ufs_lock);
+	unsigned nib = 0;
+	lu.gcc = ml_io_map(GCC_UFS_PA, PAGE_SIZE); lu.regs = ml_io_map(UFS_PA, PAGE_SIZE);
+	if (lu.gcc && lu.regs) {
+		nib = ufs_gate();
+		if (stage != 80) {
+			if (nib != 15 || ufs_take_list()) { nib = 0; }
+			else if (stage == 81) { nib = ufs_identify(); }
+			else { nib = ufs_legacy_header(stage == 82 ? 1 : 0); }
+		}
+	} else { (void)ufs_fail("RO probe MMIO map", ENXIO); }
+	if (lu.owned) { ufs_wr(REG_UTRLRSR, 0); lu.owned = false; }
+	lck_mtx_unlock(&lilac_ufs_lock);
+	lilac_report(stage, nib);
+}
+
+/* Called ONLY after sl.armed and lilac_reset_hook are installed. The hook's
+ * one-shot report/flush now necessarily follows a successful SDLOG arm. */
+void lilac_ufs_sdlog_ready(void);
+void
+lilac_ufs_sdlog_ready(void)
+{
+	unsigned stage = 0;
+	for (unsigned s = 87; s <= 90; s++) {
+		if (lilac_stop_is(s)) { stage = s; }
+	}
+	if (!stage) { return; } /* Default/no-UFS-argument boot: zero UFS MMIO. */
+	lck_mtx_lock(&lilac_ufs_lock);
+	if (lu.phase_ran) { lck_mtx_unlock(&lilac_ufs_lock); return; }
+	lu.phase_ran = true;
+	printf("LILAC UFS W%u: start after SDLOG armed and reset hook installed\n", stage - 87);
+	unsigned nib = ufs_phase(stage);
+	printf("LILAC UFS W%u: nibble 0x%x\n", stage - 87, nib);
+	if (lu.owned) { ufs_wr(REG_UTRLRSR, 0); lu.owned = false; }
+	lck_mtx_unlock(&lilac_ufs_lock);
+	lilac_ufs_report();
+	lilac_report(stage, nib);
+}
+#endif
