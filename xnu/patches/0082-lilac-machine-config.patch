 }
 
+#if defined(LILAC)
+/*
+ * LILAC's panel memory is 24 bpp, so it cannot be handed out as the BGRA
+ * default surface: the framebuffer publishes this buffer instead and scales
+ * it into the panel. Same memory as IOSurfaceRootUserClient::create (wired,
+ * kernel_task, user-shareable, default cache mode): the CPU renderer and the
+ * kernel copy both access it cached, with no mismatched-attribute alias.
+ */
+SweetSurface *
+sweet_surface_create_buffer(uint32_t width, uint32_t height, uint32_t bytesPerRow,
+    uint32_t pixelFormat)
+{
+	if (width == 0 || height == 0 || width > SWEET_SURFACE_MAX_DIM || height > SWEET_SURFACE_MAX_DIM ||
+	    bytesPerRow < (uint64_t)width * 4 || round_page((uint64_t)bytesPerRow * height) > SWEET_SURFACE_MAX_ALLOC) {
+		return NULL;
+	}
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page((uint64_t)bytesPerRow * height);
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+	if (mem == NULL) {
+		s->release();
+		return NULL;
+	}
+	bzero(mem->getBytesNoCopy(), s->allocSize);
+	s->memory = mem;
+	OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired);     /* free() subtracts it */
+	s->mapCache = kIOMapDefaultCache;
+	if (!sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
+#endif /* LILAC */
