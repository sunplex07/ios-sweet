+		gicr_write32(GICR_ISENABLER0, 1u << 18);
+		__builtin_arm_dsb(DSB_SY);
+		n |= LILAC_BIT(gicr_read32(GICR_ISENABLER0), 18) << 1;
+		gicr_write32(GICR_ISENABLER0, 1u << 1);
+		__builtin_arm_dsb(DSB_SY);
+		n |= LILAC_BIT(gicr_read32(GICR_ISENABLER0), 1) << 2;
+		n |= (LILAC_BIT(gicr_read32(0x0), 3) == 0) << 3;
+		lilac_report(77, n);
+	}
+}
+
+static void
+lilac_gic_probe(vm_offset_t gicr_pe_base)
+{
+	static bool done;
+	unsigned int n = 0;
+	if (done) {
+		return;
+	}
+	done = true;
+	if (lilac_stop_is(70)) {
+		uint32_t en = gicr_read32(GICR_ISENABLER0);
+		n = ((en >> 19) & 1) | (((en >> 1) & 1) << 1) |
+		    (((gicd_read32(GICD_CTLR) & GICD_CTLR_ENABLEGRP1A) != 0) << 2) |
+		    (((gicr_read32(GICR_IGROUPR0) >> 19) & 1) << 3);
+		lilac_report(70, n);
+	}
+	if (lilac_stop_is(71)) {
+		__builtin_arm_wsr64("CNTV_CVAL_EL0", __builtin_arm_rsr64("CNTVCT_EL0"));
+		__builtin_arm_wsr64("CNTV_CTL_EL0", 1);
+		__builtin_arm_isb(ISB_SY);
+		LILAC_SPIN_MS(10);
+		n = ((__builtin_arm_rsr64("CNTV_CTL_EL0") >> 2) & 1) |
+		    (((gicr_read32(LILAC_GICR_ISPENDR0) >> 19) & 1) << 1) |
+		    (((__builtin_arm_rsr64("S3_0_C12_C12_2") & 0xFFFFFF) == 19) << 2) |
+		    (((__builtin_arm_rsr64("ISR_EL1") >> 7) & 1) << 3);
+		lilac_report(71, n);
+	}
+	if (lilac_stop_is(72)) {
+		uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+		uint64_t sgi = (((mpidr >> 16) & 0xff) << 32) | (((mpidr >> 8) & 0xff) << 16) |
+		    ((uint64_t)SWEET_IPI_SGI << 24) | (1ULL << (mpidr & 0xf));
+		__builtin_arm_dsb(DSB_ISHST);
+		__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+		__builtin_arm_isb(ISB_SY);
+		LILAC_SPIN_MS(10);
+		n = ((gicr_read32(LILAC_GICR_ISPENDR0) >> SWEET_IPI_SGI) & 1) |
+		    (((__builtin_arm_rsr64("S3_0_C12_C12_2") & 0xFFFFFF) == SWEET_IPI_SGI) << 1) |
+		    (((__builtin_arm_rsr64("ISR_EL1") >> 7) & 1) << 2) |
+		    (((__builtin_arm_rsr64("S3_0_C12_C11_3") & 0xFF) == 0xFF) << 3);
+		lilac_report(72, n);
+	}
+	if (lilac_stop_is(73)) {
+		__asm__ volatile ("at s1e1r, %0\n\tisb" :: "r"(gicd_base) : "memory");
+		uint64_t par = __builtin_arm_rsr64("PAR_EL1");
+		n = (((par & 1) == 0 && (par >> 56) == 0) ? 1 : 0) |
+		    (((__builtin_arm_rsr64("S3_0_C4_C6_0") & 0xFF) >= 0xF0) << 1) |
+		    (((__builtin_arm_rsr64("S3_0_C12_C12_7") & 1) == 1) << 2) |
+		    (((gicr_read32(GICR_WAKER) & GICR_WAKER_CHILDRENASLEEP) == 0) << 3);
+		lilac_report(73, n);
+	}
+	if (lilac_stop_is(74)) {
+		n = (unsigned int)((gicr_pe_base - gicr_base) / GICR_PE_SIZE) & 7;
+		n |= ((gicd_read32(GICD_CTLR) & GICD_CTLR_ARE_NS) != 0) << 3;
+		lilac_report(74, n);
+	}
+}
+#endif
+
