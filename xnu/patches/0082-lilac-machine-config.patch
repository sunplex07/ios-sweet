+#define TOUCH_T1 92u
+#define TOUCH_T8 99u
+#define TOUCH_T6 97u
+#define TOUCH_T7 98u
+
+/* TLMM tiled addressing (EAST 0x03d00000, WEST 0x03500000). */
+#define TLMM_EAST 0x03d00000ull
+#define TLMM_WEST 0x03500000ull
+#define TLMM_CFG_OFF(gpio) ((gpio) * 0x1000u)
+#define TLMM_MUX_MASK 0x3cu           /* pinctrl-msm.c: mux field at bit 2 */
+#define TLMM_MUX_FUNC_I2C5 3u          /* pinctrl-msm8998.c:1429-1431 */
+#define TLMM_OUT_BIT 0x2u              /* io reg bit1 = output value */
+
+#define GCC_BASE 0x00100000ull
+#define GCC_AHB_CBCR 0x17004u          /* gcc_blsp1_ahb_clk halt_reg */
+#define GCC_AHB_VOTE 0x52004u          /* gcc_blsp1_ahb_clk enable_reg */
+#define GCC_AHB_VOTE_BIT (1u << 17)
+#define GCC_QUP5_CBCR 0x21008u         /* gcc_blsp1_qup5_i2c_apps_clk */
+#define GCC_QUP5_CMD 0x21020u          /* cmd_rcgr */
+#define GCC_QUP5_CFG 0x21024u          /* rcg CFG: src_sel << 3, src_div bits 4:0 */
+#define CLK_OFF 0x80000000u
+#define CMD_UPDATE 0x1u
+
+#define QUP5_BASE 0x0c179000ull
+#define Q_CONFIG 0x000u
+#define Q_STATE 0x004u
+#define Q_IO 0x008u
+#define Q_RESET 0x00cu
+#define Q_OP 0x018u
+#define Q_ERR 0x01cu
+#define Q_ERR_EN 0x020u
+#define Q_MASK 0x028u
+#define Q_HW 0x030u
+#define Q_OUT_CNT 0x100u
+#define Q_OUT 0x110u
+#define Q_WRITE_CNT 0x150u
+#define Q_IN_CNT 0x200u
+#define Q_READ_CNT 0x208u
+#define Q_IN 0x218u
+#define Q_CLK 0x400u
+#define Q_STATUS 0x404u
+#define Q_GEN 0x408u
