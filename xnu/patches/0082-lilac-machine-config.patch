+/* Host-only test; no device access. Run with a native C11 compiler, -Wall -Wextra -Werror. */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include "../bsd/dev/lilac_sd_adma.h"
+
+static uint32_t le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void check(bool wide, uint64_t pa, uint32_t bytes, uint32_t page, size_t expected)
+{
+	uint8_t table[4096];
+	memset(table, 0xa5, sizeof(table));
+	size_t stride = wide ? 12 : 8;
+	size_t used = sd_adma_build(table, sizeof(table), 0xa0000000, pa, bytes, page, wide);
+	assert(used == expected * stride);
+	uint32_t total = 0;
+	for (size_t off = 0; off < used; off += stride) {
+		const uint8_t *d = table + off;
+		assert(d[0] == (off + stride == used ? 0x23 : 0x21));
+		assert(d[1] == 0);
+		uint32_t len = (uint32_t)d[2] | (uint32_t)d[3] << 8;
+		if (!len) len = 65536;
+		uint64_t addr = le32(d + 4);
+		if (wide) addr |= (uint64_t)le32(d + 8) << 32;
+		assert(addr == pa + total);
+		assert(len <= 65536 && len <= page - (addr & (page - 1)));
+		assert((addr & (wide ? 7u : 3u)) == 0);
+		total += len;
+	}
+	assert(total == bytes);
+	for (size_t i = used; i < sizeof(table); i++) assert(table[i] == 0xa5);
+}
+
+int main(void)
+{
+	uint8_t t[4096];
+	for (unsigned wide = 0; wide < 2; wide++) {
+		check(wide != 0, 0xa0010000, 65536, 16384, 4); /* XNU VM pages */
+		check(wide != 0, 0xa0010000, 65536, 4096, 16); /* not assumed VM size */
+		check(wide != 0, 0xa0013ff8, 32768, 16384, 3); /* partial first/last */
+		check(wide != 0, 0xa0020000, 131072, 131072, 2); /* length 0 = 64K */
+		check(wide != 0, 0xa0020000, 65544, 131072, 2);
+		check(wide != 0, 0xa0020000, 512, 16384, 1);
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2000, 0, 16384, wide));
+		assert(!sd_adma_build(t, 7, 0x1000, 0x2000, 512, 16384, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1001, 0x2000, 512, 16384, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2001, 512, 16384, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2000, 512, 0, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2000, 512, 12288, wide));
+		assert(!sd_adma_build(t, sizeof(t), 0x1000, UINT64_MAX - 7, 512, 16384, wide));
+		/* Capacity failures must not overrun the table. */
+		memset(t, 0xa5, sizeof(t));
+		assert(!sd_adma_build(t, 16, 0x1000, 0x2000, 65536, 4096, wide));
+		for (size_t i = 16; i < sizeof(t); i++) assert(t[i] == 0xa5);
+	}
+	assert(sd_adma_build(t, sizeof(t), 0x1004, 0x2004, 512, 16384, false) == 8);
+	assert(!sd_adma_build(t, sizeof(t), 0x1004, 0x2000, 512, 16384, true));
+	assert(!sd_adma_build(t, sizeof(t), 0x1000, 0x2004, 512, 16384, true));
+	assert(!sd_adma_build(t, sizeof(t), 0x1000, 0xffffff00, 512, 16384, false));
+	assert(!sd_adma_build(t, sizeof(t), 0x100000000ull, 0x2000, 512, 16384, false));
+	assert(!sd_adma_build(t, sizeof(t), 0xfffffffc, 0x2000, 512, 16384, false));
+	check(true, 0x12345678000ull, 65536, 16384, 4);
+	/* No zero/LBA0, arithmetic wrap, cross-partition or boundary overrun. */
+	assert(sd_adma_range(2048, 8192, 2048, 8192));
+	assert(sd_adma_range(2048, 8192, 10239, 1));
+	assert(!sd_adma_range(0, 8192, 0, 1));
+	assert(!sd_adma_range(2048, 8192, 0, 1));
+	assert(!sd_adma_range(2048, 8192, 2047, 1));
+	assert(!sd_adma_range(2048, 8192, 10239, 2));
+	assert(!sd_adma_range(2048, 8192, 10240, 1));
+	assert(!sd_adma_range(2048, 8192, 2048, 0));
+	assert(!sd_adma_range(UINT32_MAX - 8, 16, UINT32_MAX - 8, 1));
+	puts("PASS: ADMA32/64 page splits, 64KiB lengths, LE/END/VALID/TRAN, alignment, bounds, LBA guards");
+	return 0;
+}
