diff --git a/tests/lilac_input_probe_test.py b/tests/lilac_input_probe_test.py
new file mode 100644
index 0000000..1e79896
--- /dev/null
+++ b/tests/lilac_input_probe_test.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Host control/failure tests of the real phase-a C code with modeled MMIO.
+
+This tests software bounds and fail-closed behavior, not the QUP/RMI protocol or
+physical hardware. Only includes/MMIO barriers are substituted. Generated code
+and executable live in a temporary directory in this worktree and are removed.
+"""
+import pathlib
+import re
+import subprocess
+import tempfile
+
+root = pathlib.Path(__file__).resolve().parents[1]
+source = (root / "bsd/dev/lilac_input.c").read_text()
+source = re.sub(r"^#include .*\n", "", source, flags=re.M)
+a = source.index("static uint32_t\ninput_rd")
+b = source.index("static bool\nqup_wait_state", a)
+source = source[:a] + source[b:]
+headers = r'''
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <assert.h>
+typedef uintptr_t vm_offset_t;
+typedef size_t vm_size_t;
+#define ARM64_BOARD_CONFIG_LILAC 1
+static unsigned scenario, maps, stores, reads, transfers, final_bits, rx_pos, ntx;
+static unsigned qregs[0x500/4];
+static unsigned char txbytes[12], rxbytes[20], rmi[256];
+static uint32_t input_rd(vm_offset_t, uint32_t);
+static void input_wr(vm_offset_t, uint32_t, uint32_t);
+static void delay(unsigned us) { (void)us; }
+static int lilac_stop_is(unsigned stage) { return scenario != 9 && stage == 86; }
+static void lilac_report(unsigned stage, unsigned bits) { assert(stage == 86); final_bits = bits; }
+'''
+model = r'''
+vm_offset_t ml_io_map(vm_offset_t p, vm_size_t size) {
+    (void)size; maps++; return p;
+}
+static uint32_t input_rd(vm_offset_t b, uint32_t o) {
+    assert(++reads < 1000000); /* malformed PDT must not wrap forever */
+    if (b == 0x00100000) {
+        if (o == 0x17004 || o == 0x21008) return scenario == 1 ? 0x80000000 : 0;
+        return 0;
+    }
+    if (b == 0x03d00000 || b == 0x03500000) {
+        if (o == 87*0x1000 || o == 88*0x1000) return 3 << 2;
+        return 1;
+    }
+    if (b == 0x0800f000) {
+        if (!o) return 0x30000000;
+        if (o >= 0x800 && o < 0x814) {
+            unsigned k = (o-0x800)/4;
+            if (scenario == 6 && k == 4) return 0;
+            return (uint32_t)(key_regs[k] >> 8) << 8;
+        }
+        return 0;
+    }
+    if (b >= 0x09400000 && b < 0x0a400000) {
+        assert((b-0x09400000)%0x8000 == 0);
+        if (o == 8) return 1;
+        if (o == 0x18) return 0;
+        abort();
+    }
+    assert(b == 0x0c179000);
+    if (o == Q_STATUS && (scenario == 3 || (scenario == 8 && transfers == 5))) return transfers ? 8 : 0;
+    if (o == Q_IN) {
+        uint32_t w = 0;
+        assert(rx_pos < qregs[Q_READ_CNT/4]);
+        for (unsigned j=0; j<4 && rx_pos<qregs[Q_READ_CNT/4]; j++) w |= (uint32_t)rxbytes[rx_pos++] << (j*8);
+        if (rx_pos == qregs[Q_READ_CNT/4]) qregs[Q_OP/4] &= ~0x20u;
+        return w;
+    }
+    return qregs[o/4];
+}
+static void input_wr(vm_offset_t b, uint32_t o, uint32_t v) {
+    stores++;
+    if (b >= 0x09400000 && b < 0x0a400000) {
+        /* Every PMIC access must be EXT_READL on observer CMD, count one. */
+        assert(o == 0 && (v >> 27) == 1 && (v & 7) == 0);
+        assert((b-0x09400000)%0x8000 == 0);
+        return;
+    }
+    assert(b == 0x0c179000); /* catches GPIO, GCC and PMIC command-channel writes */
+    switch(o) {
+    case Q_RESET:
+        assert(v == 1);
+        memset(qregs, 0, sizeof(qregs)); qregs[Q_STATE/4] = 4; qregs[Q_IO/4] = 0x21;
+        ntx=0; rx_pos=0; return;
+    case Q_STATE:
+        assert(v == 0 || v == 1 || v == 3);
+        qregs[o/4] = v | 0x14;
+        if (v == 1 && ntx >= 9) {
+            assert(txbytes[0] == 0x81 && txbytes[1] == 0x58);
+            assert(txbytes[2] == 0x82 && txbytes[3] == 1);
+            assert(txbytes[5] == 0x81 && txbytes[6] == 0x59 && txbytes[7] == 0x87);
+            assert(qregs[Q_WRITE_CNT/4] == 9 && qregs[Q_READ_CNT/4] == (unsigned)txbytes[8]+2);
+            assert(txbytes[8] <= 16 && txbytes[4]+txbytes[8] <= 256);
+            transfers++;
+            rxbytes[0] = 0x85; rxbytes[1] = txbytes[8];
+            memcpy(rxbytes+2, rmi+txbytes[4], txbytes[8]);
+            qregs[Q_OP/4] = scenario == 5 ? 0 : 0xc20;
+        }
+        return;
+    case Q_GEN: qregs[Q_STATE/4] |= 0x10; break;
+    case Q_IO: v |= 0x21; break; /* read-only FIFO geometry */
+    case Q_OUT:
+        assert(ntx+4 <= sizeof(txbytes));
+        for (unsigned j=0; j<4; j++) txbytes[ntx++] = v >> (j*8);
+        return;
+    case Q_OP: assert(!(v & ~0x300)); return;
+    case Q_CONFIG: case Q_ERR_EN: case Q_MASK: case Q_OUT_CNT: case Q_IN_CNT:
+    case Q_WRITE_CNT: case Q_READ_CNT: case Q_CLK: break;
+    default: abort();
+    }
+    qregs[o/4] = v;
+}
+int main(int argc, char **argv) {
+    assert(argc == 2); scenario = strtoul(argv[1], 0, 10);
+    qregs[Q_STATE/4]=4; qregs[Q_CONFIG/4]=0x207; qregs[Q_GEN/4]=1;
+    qregs[Q_CLK/4]=0x35d; qregs[Q_IO/4]=scenario == 7 ? 0 : 0x21;
+    unsigned char f01[] = {0x20,0x38,0x40,0x50,1,1};
+    unsigned char f12[] = {0x60,0x78,0x80,0x90,1,0x12};
+    memcpy(rmi+0xe9, f01, 6); memcpy(rmi+0xe3, f12, 6);
+    memcpy(rmi+0x2b, "S3330TEST00", 10);
+    if (scenario == 2) rmi[255]=1;
+    if (scenario == 4) for (int a=0xe9; a>=5; a-=6) memcpy(rmi+a, f12, 6);
+    lilac_input_probe();
+    const unsigned expected[] = {15,1,3,3,3,3,14,1,3,0};
+    assert(scenario < sizeof(expected)/sizeof(expected[0]));
+    assert(final_bits == expected[scenario]);
+    if (scenario == 9) assert(maps == 0 && stores == 0 && reads == 0);
+    if (scenario == 1 || scenario == 7) assert(transfers == 0);
+    if (scenario == 3 || scenario == 5) assert(transfers == 1);
+    if (scenario == 4) assert(transfers == 40); /* page + exactly 39 descriptors */
+    printf("HOST PASS scenario=%u bits=%x maps=%u stores=%u reads=%u transfers=%u\n", scenario, final_bits, maps, stores, reads, transfers);
+}
+'''
+with tempfile.TemporaryDirectory(prefix=".input-host-", dir=root) as tmp:
+    c = pathlib.Path(tmp) / "probe.c"
+    exe = pathlib.Path(tmp) / "probe"
+    c.write_text(headers + source + model)
+    subprocess.run(["cc", "-std=c11", "-O1", "-Wall", "-Wextra", "-Werror",
+                    "-fsanitize=address,undefined", str(c), "-o", str(exe)], check=True)
+    for scenario in range(10):
+        subprocess.run([str(exe), str(scenario)], check=True)
diff --git a/tests/lilac_keys_poll_test.py b/tests/lilac_keys_poll_test.py
new file mode 100644
index 0000000..40802a5
--- /dev/null
+++ b/tests/lilac_keys_poll_test.py
@@ -0,0 +1,244 @@
+#!/usr/bin/env python3
+"""Host control/failure tests of the real key-polling C code with modeled MMIO.
+
+Tests software behaviour (gating, debounce, event pairing, error retention and
+that every PMIC-region store is an EXT_READL command word), not the physical
+SPMI protocol. Only includes and the kernel-scheduler calls are substituted;
+the executable is built in a temporary directory and removed afterwards.
+"""
+import pathlib
+import re
+import subprocess
+import tempfile
+
+root = pathlib.Path(__file__).resolve().parents[1]
+source = (root / "bsd/dev/lilac_keys.c").read_text()
