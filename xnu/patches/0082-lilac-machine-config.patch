diff --git a/pexpert/pexpert/arm64/LILAC.h b/pexpert/pexpert/arm64/LILAC.h
new file mode 100644
index 0000000..6ec709e
--- /dev/null
+++ b/pexpert/pexpert/arm64/LILAC.h
@@ -0,0 +1,89 @@
+/*
+ * Board config for the Sony Xperia XZ1 Compact ("lilac", Qualcomm MSM8998 /
+ * Snapdragon 835): Kryo 280 = 4x Silver (MPIDR 0x000-0x003) + 4x Gold
+ * (0x100-0x103), ARMv8.0 + crypto/CRC, no LSE atomics, no PAN, no PAC
+ * (measured on device, G0: ISAR0=0x11120, MMFR1=0, MIDR 0x51AF8014/8001).
+ *
+ * LILAC is a member of the SWEET family: it reuses SWEET's software
+ * adaptations (no corecrypto, built-in AMFI/HFS/pthread, IOMedia-less boot,
+ * GICv3 with two security states, PSCI CPU_ON). It differs in hardware:
+ *  - 4K pages. The boot CPU (Silver) has ID_AA64MMFR0.TGran16 = 0, so
+ *    __ARM_16K_PG__ is not defined here.
+ *  - No SWEET_EARLY_FB: the SM7150 splash framebuffer at 0x9c000000 does
+ *    not exist; lilac's DSI panel runs in command mode, so plain
+ *    framebuffer stores are not scanned out without an MDP kick.
+ *  - None of SWEET's SM7150 peripheral drivers (UFS, USB, touch, keys,
+ *    SPMI, RPMh) are reachable on LILAC.
+ */
+
+#ifndef _PEXPERT_ARM64_LILAC_H
+#define _PEXPERT_ARM64_LILAC_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define SWEET                     1
+#define LILAC                     1
+
+/* 4 Silver + 4 Gold; SMP stays opt-in through cpus=N (default 1). */
+#define SWEET_SMP_MAX_CPUS         8
+
+/* Kryo 280 has no LSE: refuse any compiler setup that would emit CAS/LDADD. */
+#if defined(__ARM_FEATURE_ATOMICS) || defined(__ARM_ARCH_8_1__) || defined(__ARM_ARCH_8_2__)
+#error "LILAC must be built for ARMv8.0 without LSE (MACHINE_FLAGS_ARM64_LILAC)"
+#endif
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * MSM8998 uses the same Qualcomm PPI numbering 1/2/3/0 (msm8998.dtsi timer) (secure phys, phys,
+ * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
+ * (CNTV) is INTID 16 + 3 = 19.
+ */
+#define SWEET_VTIMER_INTID        19
+#define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_LILAC_H */
