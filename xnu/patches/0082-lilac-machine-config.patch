+
+/*
+ * ---- step 3: kernel console log on a dedicated SD partition ("sdlog") ----
+ *
+ * All console output is kept in the 4 MiB ring of sweet_ufs.c (_cnputs). It
+ * is copied to an MBR partition of type 0xDA, but only if the host armed that
+ * partition: its block 0 must hold "LILAC-SDLOG-ARM1" and the partition's own
+ * first LBA and length (u32 LE at bytes 16 and 20). The partition must not
+ * overlap the MBR area or any other partition. Layout:
+ *   block 0  arm block (written by the host, never by the kernel)
+ *   block 1  header: "LILACLOG", u32 version 1, u32 ring size, u64 bytes
+ *            written, u64 flush sequence, u64 boot UTC seconds, u32 boot
+ *            microseconds, u32 reason (0 periodic, 1 at reset)
+ *   block 2+ ring; console byte n is at ring offset n % ring size
+ * Every write goes through sd_write_block_hw(), which refuses any LBA outside
+ * blocks 1.. of the armed partition. A thread flushes every 5 s and
+ * lilac_diag.c calls a final flush inside every timed reset (stage report,
+ * fatal reset, panic). Boot-arg sdlog=0 disables it.
+ */
+#define SDLOG_TYPE      0xDA
+#define SDLOG_SECS      5
+#define SDLOG_RING_LBA  2u
+
+extern uint32_t sweet_log_ring_size(void);
+extern void sweet_log_ring_read(uint32_t off, char *out, uint32_t n);
+extern uint64_t sweet_log_position(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+
+static struct {
+	bool     armed;
+	uint32_t first, nblocks, ring_size;
+	uint64_t flushed, seq;
+	clock_sec_t boot_sec;
+	clock_usec_t boot_usec;
+	uint8_t  buf[SD_BLOCK], hook_buf[SD_BLOCK];
+} sl;
+
+struct sdlog_header {
+	char     magic[8];
+	uint32_t version, ring_size;
+	uint64_t total, seq, boot_sec;
+	uint32_t boot_usec, reason;
+};
+
+/*
+ * After a failed CMD24 the card may still be receiving (a partly filled
+ * buffer) or programming. Reset the host CMD/DAT lines, send CMD12 (valid in
+ * the card's rcv state; an illegal command, and so harmless, in tran), and
+ * wait for the card to release DAT0. The log is then stopped for this boot
+ * (sdlog_thread), so no further write is ever issued.
+ */
+static void
+sd_write_abort(void)
+{
+	uint32_t st;
+	sd_reset_lines();
+	uint64_t end = sd_deadline(100000);
+	while ((sd_rd(HC_PRESENT) & PS_CMD_INHIBIT) && mach_absolute_time() < end) {
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_ARG, 0);
+	sd_wr(HC_XFER_CMD, (12u << 8 | CMD_TYPE_ABORT | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48_BUSY) << 16);
+	if (sd_wait_int(INT_CMD_DONE, 100000, &st) == 0) {
+		(void)sd_wait_int(INT_XFER_DONE, 1000000, &st);
+	}
+	sd_reset_lines();
+	end = sd_deadline(1000000);
+	while (!(sd_rd(HC_PRESENT) & PS_DAT0) && mach_absolute_time() < end) {
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+}
+
+/*
+ * The only LBAs the kernel may ever write: blocks 1.. of the armed log
+ * partition, and, with sdrw=1, the selected sdroot0 partition (which then
+ * overlaps no other MBR entry, so never LBA 0, partition 1 or the log).
+ */
+static bool
+sd_lba_writable(uint32_t lba)
+{
+	if (sl.armed && lba > sl.first && lba - sl.first < sl.nblocks) {
+		return true;
+	}
+	return sdd.writable && lba >= sdd.first && lba - sdd.first < sdd.nblocks;
+}
+
+/* CMD24 for one 512-byte block, polled PIO; only LBAs allowed by sd_lba_writable(). */
+static int
+sd_write_block_hw(uint32_t lba, const uint8_t *buf, uint32_t *stp)
+{
+	uint32_t st = 0;
+	*stp = 0;
+	if (!sd_lba_writable(lba)) {
+		return EPERM;
+	}
+	if (!(sd_rd(HC_PRESENT) & PS_WRITABLE)) {
+		return EROFS;
+	}
+	if (sd_wait_present_clear(PS_CMD_INHIBIT | PS_DAT_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	if ((sd_rd(HC_INT_ENABLE) & (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_WR)) != (INT_CMD_DONE | INT_XFER_DONE | INT_BUF_WR)) {
+		sd_wr(HC_INT_ENABLE, INT_ENABLE_UEFI);
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	sd_wr(HC_BLKSZ_CNT, (1u << 16) | SD_BLOCK);
+	sd_wr(HC_ARG, lba);
+	/* Transfer mode 0: single block, host to card, no DMA. */
+	sd_wr(HC_XFER_CMD, (24u << 8 | CMD_DATA | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48) << 16);
+
+	int error = sd_wait_int(INT_CMD_DONE, 100000, &st);
+	if (!error && (sd_rd(HC_RESP0) & R1_ERRORS)) {
+		st = sd_rd(HC_RESP0);
+		error = ERANGE;
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_CMD_DONE);
+		error = sd_wait_int(INT_BUF_WR, 500000, &st);
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_BUF_WR);
+		for (uint32_t i = 0; i < SD_BLOCK; i += 4) {
+			sd_wr(HC_BUFFER, buf[i] | buf[i + 1] << 8 | buf[i + 2] << 16 | (uint32_t)buf[i + 3] << 24);
+		}
+		/* Transfer complete for a write is signalled after the card's busy ends. */
+		error = sd_wait_int(INT_XFER_DONE, 1000000, &st);
+	}
+	if (error) {
+		*stp = st;
+		sd_write_abort();
+		return error;
+	}
+	sd_wr(HC_INT_STATUS, 0xFFFFFFFFu);
+	return 0;
+}
+
+static int
+sd_write_block(uint32_t lba, const uint8_t *buf, bool wait)
+{
+	uint32_t st;
+	if (!sd_claim(wait)) {
+		return EBUSY;
+	}
+	int error = sd_write_block_hw(lba, buf, &st);
+	sd_release();
+	if (error && wait) {
+		printf("LILAC SDLOG: CMD24 lba 0x%x failed %d, int 0x%08x\n", lba, error, st);
+	}
+	return error;
+}
+
+/* sdroot0 writes: n blocks, one CMD24 each, claiming the controller per block. */
+static int
+sd_write_blocks(uint32_t lba, uint32_t n, const uint8_t *buf)
+{
+	uint32_t st;
+	for (uint32_t i = 0; i < n; i++) {
+		(void)sd_claim(true);
+		int error = sd_write_block_hw(lba + i, buf + i * SD_BLOCK, &st);
+		sd_release();
+		if (error) {
+			printf("LILAC SD: CMD24 lba 0x%x failed %d, int 0x%08x\n", lba + i, error, st);
+			return error;
+		}
+	}
+	return 0;
+}
+
+/*
+ * ADMA design/source audit (paths relative to the named Linux trees):
+ * downstream 4.14 arch/arm64/boot/dts/qcom/msm8998.dtsi:1617-1658 and
+ * msm8998-yoshino-common.dtsi:3223-3227; mainline 6.18.58 msm8998.dtsi:
+ * 2268-2283 and msm8998-sony-xperia-yoshino.dtsi:661-671: no iommus and
+ * no dma-coherent for SDCC2. This is a physical-address DMA master, not an
+ * SMMU stream requiring an unproven UEFI bypass assumption.
+ *
+ * downstream drivers/mmc/host/sdhci-msm.c:4993-5014: preserve HC mode,
+ * enable length-error reporting only (VENDOR_SPEC bit7); do NOT replay POR,
+ * clock, power, DLL or capability overrides. Offsets: :258-264, HC_MODE :67.
+ * :5061 requires END on TRAN, :4613-4618 reset workaround is 8916/8992 only.
+ * mainline sdhci-msm.c:2493-2494 broken 64-bit DMA is 8916 only, not 8998;
+ * :2140-2181 distinguishes 12-byte legacy ADMA from 16-byte CQE descriptors.
+ * We do not enable CQE or SDHCI v4 mode. :2474 requests auto-CMD12 reads.
+ *
+ * One wired, contiguous allocation: a whole VM page for descriptors, then
+ * 64 KiB of data, serialized by sd_claim. Copying normal RAM once is simpler
+ * than DMA into arbitrary buf pages (unaligned cache lines, 16K VM/4K MMU
+ * granules). No CPU touches these cache lines while hardware owns them.
+ * flush_dcache64 is clean+invalidate to PoC plus dsb sy (arm64/caches_asm.s:
+ * 363-448), before both directions and after reads. This also cleans table
+ * fetches. No coherency assumption, no virtual addresses given to hardware.
+ *
+ * Completion: at most 20 us initial spin, then 150 us delay, which blocks
+ * with interrupts/preemption enabled (kern/clock.c:1584-1600); panic spins.
+ * Expected saving is removal of 16384 MMIO loads/stores per 64 KiB plus
+ * per-block polling; actual CPU-time/throughput savings require an A/B boot.
+ */
+static void
+sd_dma_init(void)
+{
+	uint32_t on = 1, caps, mode;
+	uint16_t host_version, ctrl2;
+	vm_size_t size = PAGE_SIZE + SD_DMA_BYTES;
+	ppnum_t pn, max_pnum;
+	if (sda.initialized) {
+		return;
+	}
+	sda.initialized = true;
+	PE_parse_boot_argn("sddma", &on, sizeof(on));
+	if (!on) {
+		printf("LILAC SD: ADMA disabled (sddma=0)\n");
+		return;
+	}
+	host_version = *(volatile uint16_t *)(sd_regs + SD_HC + HC_VERSION);
+	caps = sd_rd(HC_CAPS);
+	mode = *(volatile uint32_t *)(sd_regs + 0x78);
+	/* Refuse unsupported modes rather than change firmware's bus setup.
+	 * Mainline sdhci.h:246,384: v4 mode needs a different descriptor format.
+	 */
+	ctrl2 = *(volatile uint16_t *)(sd_regs + SD_HC + 0x3e);
+	if (!(caps & CAP_ADMA2) || (host_version & 0xff) < 2 || !(mode & 1) || (ctrl2 & (1u << 12))) {
+		printf("LILAC SD: ADMA unavailable cap 0x%x ver 0x%x hc 0x%x\n", caps, host_version, mode);
+		return;
+	}
+	sda.wide = (caps & CAP_64BIT) != 0;
+	/* max_pnum is in VM pages, not 4K hardware granules. */
+	max_pnum = sda.wide ? 0 : (ppnum_t)(UINT32_MAX >> PAGE_SHIFT);
+	if (kmem_alloc_contig(kernel_map, &sda.mem, size, PAGE_MASK, max_pnum, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("LILAC SD: ADMA allocation failed, PIO only\n");
+		return;
+	}
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)sda.mem);
+	sda.pa = ptoa_64(pn);
+	if (!pn || (sda.pa & PAGE_MASK) ||
+	    (!sda.wide && sda.pa + size - 1 > UINT32_MAX)) {
+		printf("LILAC SD: ADMA physical address rejected, PIO only\n");
+		return;
+	}
+	/* Assert the allocator's contiguity at VM-page increments, not MMU PFNs. */
+	for (vm_size_t off = 0; off < size; off += PAGE_SIZE) {
+		if (ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)(sda.mem + off))) != sda.pa + off) {
+			printf("LILAC SD: ADMA noncontiguous allocation, PIO only\n");
+			return;
+		}
+	}
+	sda.enabled = sda.writes = sda.cmd25 = true;
+	printf("LILAC SD: ADMA%u ready cap 0x%x ver 0x%x pa 0x%llx, 64 KiB bounce\n",
+	    sda.wide ? 64u : 32u, caps, host_version, sda.pa);
+}
+
+static int
+sd_dma_wait(uint32_t want, uint32_t usec, uint32_t *stp)
+{
+	uint64_t end = sd_deadline(usec), spin_end = sd_deadline(SD_SPIN_US);
+	for (;;) {
+		uint32_t st = sd_rd(HC_INT_STATUS);
+		*stp = st;
+		if (st & (INT_ERROR | INT_ERR_MASK)) {
+			return EIO;
+		}
+		if (st & want) {
+			return 0;
+		}
+		if (mach_absolute_time() > end) {
+			return ETIMEDOUT;
+		}
+		if (mach_absolute_time() > spin_end && !panic_active()) {
+			uint64_t t0 = mach_absolute_time();
+			delay(SD_DMA_NAP_US);
+			os_atomic_inc(&sds.naps, relaxed);
+			os_atomic_add(&sds.nap_abs, mach_absolute_time() - t0, relaxed);
+		}
+	}
+}
+
+/* sd_claim held. Range and write guards precede ALL commands, including STOP.
+ * Read range is either sdd or the MBR-validated p2 extent at stage 69.
+ * Only strategy/write-check callers reach DMA; the log never does.
+ */
+static int
+sd_dma_hw(bool rd, uint32_t first, uint32_t count, uint32_t lba,
+    uint32_t n, uint8_t *buf, uint32_t *stp)
+{
+	*stp = 0;
+	if (!sda.enabled || (!rd && !sda.writes) || sd_dma_fatal) {
+		return ENXIO;
+	}
+	if (n > SD_MULTI_MAX || !sd_adma_range(first, count, lba, n)) {
+		return EINVAL;
+	}
+	if (!rd) {
+		if (!sdd.writable || !sd_adma_range(sdd.first, sdd.nblocks, lba, n)) {
+			return EPERM;
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			if (lba + i == 0 || !sd_lba_writable(lba + i)) {
+				return EPERM;
+			}
+		}
+		if (!(sd_rd(HC_PRESENT) & PS_WRITABLE)) {
+			return EROFS;
+		}
+	}
+	if (sd_wait_present_clear(PS_CMD_INHIBIT | PS_DAT_INHIBIT, 100000)) {
+		return EBUSY;
+	}
+	uint32_t bytes = n * SD_BLOCK;
+	uint8_t *data = (uint8_t *)(sda.mem + PAGE_SIZE);
+	size_t table_bytes = sd_adma_build((uint8_t *)sda.mem, PAGE_SIZE, sda.pa,
+	    sda.pa + PAGE_SIZE, bytes, PAGE_SIZE, sda.wide);
+	if (!table_bytes) {
+		return EINVAL;
+	}
+	if (!rd) {
+		memcpy(data, buf, bytes);
+	}
+	flush_dcache64(sda.pa + PAGE_SIZE, bytes, TRUE);
+	flush_dcache64(sda.pa, (unsigned int)table_bytes, TRUE);
+
+	volatile uint8_t *ctrl = (volatile uint8_t *)(sd_regs + SD_HC + HC_CONTROL);
+	uint8_t old_ctrl = *ctrl;
+	uint32_t old_enable = sd_rd(HC_INT_ENABLE);
+	uint32_t old_vendor = sd_rd(0x10c);
+	*ctrl = (uint8_t)((old_ctrl & ~CTRL_DMA_MASK) | (sda.wide ? CTRL_ADMA64 : CTRL_ADMA32));
+	sd_wr(0x10c, old_vendor | (1u << 7)); /* length-mismatch ADMA error */
+	/* Status latching only; never enable IRQ signals at 0x38. */
+	sd_wr(HC_INT_ENABLE, old_enable | INT_CMD_DONE | INT_XFER_DONE | INT_ERROR | 0x03ff0000u);
+	sd_wr(HC_INT_STATUS, 0xffffffffu);
+	sd_wr(HC_ADMA_LO, (uint32_t)sda.pa);
+	if (sda.wide) {
+		sd_wr(HC_ADMA_HI, (uint32_t)(sda.pa >> 32));
+	}
+	/* Linux 4.14 sdhci.c:926-934: ADMA uses SDMA boundary bits = 0. */
+	sd_wr(HC_BLKSZ_CNT, n << 16 | SD_BLOCK);
+	sd_wr(HC_ARG, lba);
+	uint32_t cmd = rd ? (n == 1 ? 17u : 18u) : (n == 1 ? 24u : 25u);
+	uint32_t xfer = XFER_DMA | XFER_BLKCNT_EN | (rd ? XFER_READ : 0u);
+	if (n > 1) {
+		xfer |= XFER_MULTI | XFER_AUTO12;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	sd_wr(HC_XFER_CMD, ((cmd << 8 | CMD_DATA | CMD_IDX_CHECK | CMD_CRC_CHECK | CMD_RESP48) << 16) | xfer);
+	int error = sd_dma_wait(INT_CMD_DONE, 100000, stp);
+	if (!error) {
+		uint32_t r1 = sd_rd(HC_RESP0);
+		if (r1 & R1_ERRORS) {
+			*stp = r1;
+			error = (!rd && n > 1 && (r1 & R1_ERRORS) == R1_ILLEGAL_CMD) ? ENOTSUP : EIO;
+		}
+	}
+	if (!error) {
+		sd_wr(HC_INT_STATUS, INT_CMD_DONE);
+		error = sd_dma_wait(INT_XFER_DONE, 1000000, stp);
+	}
+	if (!error && !rd) {
+		/* Also require DAT0 high and the host out of DATA inhibit. */
+		uint64_t end = sd_deadline(1000000);
+		while (!(sd_rd(HC_PRESENT) & PS_DAT0) || (sd_rd(HC_PRESENT) & PS_DAT_INHIBIT)) {
+			if (mach_absolute_time() > end) {
+				error = ETIMEDOUT;
+				break;
+			}
+			if (!panic_active()) {
+				delay(SD_DMA_NAP_US);
+			}
+		}
+	}
+	if (error) {
+		uint32_t adma = sd_rd(HC_ADMA_ERROR), status = sd_rd(HC_INT_STATUS);
+		/* Quiesce DMA before any PIO retry or touching the bounce buffer. */
+		bool reset = sd_reset_lines();
+		if (reset) {
+			uint32_t stop_st = 0;
+			/* An interrupted transfer may leave the card in data/rcv state. */
+			int stop = sd_stop_transmission(&stop_st);
+			reset = sd_reset_lines();
+			/* Never retry a write while the card is still programming. */
+			reset = reset && stop == 0 && (sd_rd(HC_PRESENT) & PS_DAT0) != 0;
+		}
+		if (!reset) {
+			sd_dma_fatal = true; /* Permanent allocation quarantined; no new I/O. */
+			sda.enabled = false;
+		}
+		printf("LILAC SD: ADMA err %d CMD%u lba 0x%x n %u int 0x%x resp 0x%x adma 0x%x reset %s\n",
+		    error, cmd, lba, n, status, *stp, adma, reset ? "ok" : "FAILED");
+	}
+	/* PIO selection restored before releasing sd_claim (including panic log). */
+	*ctrl = (uint8_t)(old_ctrl & ~CTRL_DMA_MASK);
+	sd_wr(0x10c, old_vendor);
+	sd_wr(HC_INT_ENABLE, old_enable);
+	sd_wr(HC_INT_STATUS, 0xffffffffu);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (!error && rd) {
+		flush_dcache64(sda.pa + PAGE_SIZE, bytes, TRUE);
+		memcpy(buf, data, bytes);
+	}
+	return error;
+}
+
+/* Called with lilac_sd_lock held, except single-threaded boot write check. */
+static int
+sd_strategy_transfer(bool rd, uint32_t lba, uint32_t n, uint8_t *buf,
+    bool *used_dma, bool *used_pio)
+{
+	if (!sd_adma_range(sdd.first, sdd.nblocks, lba, n)) {
+		return EINVAL;
+	}
+	if (!rd && !sdd.writable) {
+		return EROFS;
+	}
+	int error = 0;
+	bool dma = sda.enabled && (rd || sda.writes) && !panic_active();
+	if (dma) {
+		uint32_t st = 0;
+		*used_dma = true;
+		(void)sd_claim(true);
+		if (rd || n == 1 || sda.cmd25) {
+			error = sd_dma_hw(rd, sdd.first, sdd.nblocks, lba, n, buf, &st);
+			if (error == ENOTSUP && !rd && n > 1) {
+				sda.cmd25 = false;
+				printf("LILAC SD: CMD25 rejected, future DMA writes use CMD24 batches\n");
+			}
+		} else {
+			for (uint32_t i = 0; i < n && !error; i++) {
+				error = sd_dma_hw(false, sdd.first, sdd.nblocks, lba + i, 1, buf + i * SD_BLOCK, &st);
+			}
+		}
+		if (!error && !rd && !sda.verified) {
+			/* PIO, still owning controller: no log write can interleave. */
+			error = n == 1 ? sd_read_block_hw(lba, sdd.bounce, &st) :
+			    sd_read_multi_hw(lba, n, sdd.bounce, &st);
+			if (!error && memcmp(buf, sdd.bounce, n * SD_BLOCK)) {
+				error = EIO;
+			}
+			sda.verified = !error;
+			if (error) {
+				sda.writes = false;
+			}
+			printf("LILAC SD: DMA write verify: %s%s\n", error ? "MISMATCH/error" : "match",
+			    error ? ", DMA writes disabled" : "");
+		}
+		sd_release();
+		if (!error) {
+			return 0;
+		}
+		sds.err++;
+		if (sd_dma_fatal) {
+			return EIO;
+		}
+	}
+	/* Exactly one PIO retry; its own error propagates. No recursive DMA. */
+	*used_pio = true;
+	return rd ? sd_read_blocks(lba, n, buf) : sd_write_blocks(lba, n, buf);
+}
+
+/*
+ * Stage 84 (sdrw=1, lilac_stop=84): write path self-check on the last block of
+ * the selected partition (outside HFS+ structures: the alternate volume header
+ * is the second-to-last 512-byte block). bit0 the guard (sd_lba_writable)
+ * allows the partition's first and last block and refuses LBA 0 and the
+ * blocks just before and after it; bit1 rewriting the block's own data succeeds and reads back equal; bit2 a
+ * complemented pattern written there reads back; bit3 the original data is
+ * restored and reads back.
+ */
+static void
+lilac_sd_write_check(void)
+{
+	static uint8_t orig[SD_BLOCK], pat[SD_BLOCK], back[SD_BLOCK];
+	uint32_t lba = sdd.first + sdd.nblocks - 1;
+	unsigned int nib = 0;
+
+	/*
+	 * The guard alone, without issuing any command. A neighbour block may
+	 * still be writable through the log path when the armed log partition is
+	 * adjacent (on the G20 card p4 ends where p3 starts), so test it against
+	 * that range rather than expect a refusal.
+	 */
+	uint32_t before = sdd.first - 1, after = sdd.first + sdd.nblocks;
+	bool before_log = sl.armed && before > sl.first && before - sl.first < sl.nblocks;
+	bool after_log = sl.armed && after > sl.first && after - sl.first < sl.nblocks;
+	if (sdd.writable && sd_lba_writable(sdd.first) && sd_lba_writable(lba) && !sd_lba_writable(0) &&
+	    sd_lba_writable(before) == before_log && sd_lba_writable(after) == after_log) {
+		nib |= 1;
+	}
+	if (sdd.writable && sd_read_blocks(lba, 1, orig) == 0) {
+		bool used_dma = false, used_pio = false;
+		if (sd_strategy_transfer(false, lba, 1, orig, &used_dma, &used_pio) == 0 && sd_read_blocks(lba, 1, back) == 0 &&
+		    memcmp(orig, back, SD_BLOCK) == 0) {
+			nib |= 2;
+		}
+		for (uint32_t i = 0; i < SD_BLOCK; i++) {
+			pat[i] = (uint8_t)~orig[i];
+		}
+		if ((nib & 2) && sd_write_blocks(lba, 1, pat) == 0 && sd_read_blocks(lba, 1, back) == 0 &&
+		    memcmp(pat, back, SD_BLOCK) == 0) {
+			nib |= 4;
+		}
+		if (sd_write_blocks(lba, 1, orig) == 0 && sd_read_blocks(lba, 1, back) == 0 &&
+		    memcmp(orig, back, SD_BLOCK) == 0) {
+			nib |= 8;
+		}
+	}
+	printf("LILAC SD: write check lba 0x%x nibble 0x%x\n", lba, nib);
+	lilac_report(84, nib);
+}
+
+/* Copy console bytes not yet on the card, then the header. */
+static int
+sdlog_flush(uint8_t *buf, uint64_t deadline, uint32_t reason)
+{
+	bool wait = (reason == 0);
+	uint64_t total = sweet_log_position();
+	uint64_t pos = (total - sl.flushed > sl.ring_size) ? total - sl.ring_size : sl.flushed;
+	int error = 0;
+
+	while (pos < total) {
+		if (deadline && mach_absolute_time() > deadline) {
+			break;
+		}
+		uint32_t off = (uint32_t)(pos % sl.ring_size);
+		off -= off % SD_BLOCK;
+		sweet_log_ring_read(off, (char *)buf, SD_BLOCK);
+		error = sd_write_block(sl.first + SDLOG_RING_LBA + off / SD_BLOCK, buf, wait);
+		if (error) {
+			return error;
+		}
+		pos = pos - pos % SD_BLOCK + SD_BLOCK;
+	}
+	uint64_t done = MIN(pos, total);
+	struct sdlog_header h = {
+		.magic = { 'L', 'I', 'L', 'A', 'C', 'L', 'O', 'G' },
+		.version = 1, .ring_size = sl.ring_size, .total = done, .seq = sl.seq + 1,
+		.boot_sec = (uint64_t)sl.boot_sec, .boot_usec = (uint32_t)sl.boot_usec, .reason = reason,
+	};
+	bzero(buf, SD_BLOCK);
+	memcpy(buf, &h, sizeof(h));
+	error = sd_write_block(sl.first + 1, buf, wait);
+	if (!error) {
+		sl.seq++;
+		sl.flushed = done;
+	}
+	return error;
+}
+
+static void
+sdlog_reset_hook(uint32_t budget_secs)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime((uint64_t)budget_secs * NSEC_PER_SEC, &deadline);
+	(void)sdlog_flush(sl.hook_buf, mach_absolute_time() + deadline, 1);
+}
+
+static int sdlog_chan;
+
+static void
+sdlog_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		int error = sdlog_flush(sl.buf, 0, 0);
+		if (error) {
+			lilac_reset_hook = 0;
+			sl.armed = false;
+			printf("LILAC SDLOG: write failed (%d), log stopped\n", error);
+			return;
+		}
+		(void)tsleep(&sdlog_chan, PZERO, "sdlog", hz * SDLOG_SECS);
+	}
+}
+
+static inline uint32_t
+le32(const uint8_t *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+void lilac_sd_log_init(void);
+
+void
+lilac_sd_log_init(void)
+{
+	uint32_t on = 1;
+	int found = -1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sdlog", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	sd_map();
+	if (sd_read_block(0, sl.buf) || sl.buf[510] != 0x55 || sl.buf[511] != 0xAA) {
+		return;
+	}
+	for (int i = 0; i < 4; i++) {
+		if (sl.buf[446 + 16 * i + 4] == SDLOG_TYPE) {
+			if (found >= 0) {
+				return;                 /* more than one log partition: refuse */
+			}
+			found = i;
+		}
+	}
+	if (found != 3) { /* Only p4 may be armed for SD logging. */
+		return;
+	}
+	uint32_t first = le32(sl.buf + 446 + 16 * found + 8), n = le32(sl.buf + 446 + 16 * found + 12);
+	uint32_t ring = sweet_log_ring_size();
+	if (first < 2048 || ring % SD_BLOCK || n < SDLOG_RING_LBA + ring / SD_BLOCK ||
+	    (uint64_t)first + n > UINT32_MAX) {
+		return;
+	}
+	for (int i = 0; i < 4; i++) {
+		const uint8_t *e = sl.buf + 446 + 16 * i;
+		uint32_t f = le32(e + 8), m = le32(e + 12);
+		if (i != found && e[4] != 0 && m != 0 && (uint64_t)f < (uint64_t)first + n && (uint64_t)first < (uint64_t)f + m) {
+			return;                         /* overlaps another partition */
+		}
+	}
+	if (sd_read_block(first, sl.buf) || memcmp(sl.buf, "LILAC-SDLOG-ARM1", 16) != 0 ||
+	    le32(sl.buf + 16) != first || le32(sl.buf + 20) != n) {
+		printf("LILAC SDLOG: partition %d at 0x%x is not armed\n", found + 1, first);
+		return;
+	}
+	sl.first = first;
+	sl.nblocks = n;
+	sl.ring_size = ring;
+	clock_get_calendar_microtime(&sl.boot_sec, &sl.boot_usec);
+	sl.armed = true;
+	printf("LILAC SDLOG: console log to SD partition %d (LBA 0x%x, %u blocks), ring %u KiB\n",
+	    found + 1, first, n, ring >> 10);
+	printf("LILAC VM: page size %u (hardware granule 4096)\n", (unsigned)PAGE_SIZE);
+	lilac_reset_hook = sdlog_reset_hook;
+	/* W0-W3 must not run if any SDLOG arm check above failed. Install the
+	 * synchronous reset flush first; run before the periodic thread can
+	 * disable a failed logger. No UFS stage: the callback is a no-op. */
+	extern void lilac_ufs_sdlog_ready(void);
+	lilac_ufs_sdlog_ready();
+	if (kernel_thread_start(sdlog_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_LILAC */
diff --git a/bsd/dev/lilac_sd_adma.h b/bsd/dev/lilac_sd_adma.h
new file mode 100644
index 0000000..d9a6dae
--- /dev/null
+++ b/bsd/dev/lilac_sd_adma.h
@@ -0,0 +1,61 @@
+/* Pure ADMA2 encoder, shared with tools/lilac_sd_adma_test.c.
+ * Caller supplies uint*_t, bool and size_t. All descriptor fields are LE.
+ * Linux 4.14 drivers/mmc/host/sdhci.h:299-325: 8/12-byte strides;
+ * sdhci.c:665-767 and sdhci-msm.c:5061: END on final TRAN, not a NOP.
+ */
+#ifndef LILAC_SD_ADMA_H
+#define LILAC_SD_ADMA_H
+
+static bool
+sd_adma_range(uint32_t first, uint32_t count, uint32_t lba, uint32_t n)
+{
+	return first != 0 && count != 0 && n != 0 &&
+	       (uint64_t)first + count <= UINT32_MAX &&
+	       lba >= first && lba - first < count && n <= count - (lba - first);
+}
+
+/* Contiguous data, split at VM page boundaries and at 64 KiB. Zero means
+ * invalid input/capacity; callers must NEVER publish a failed table.
+ * A 64-bit table base must be 8-aligned, but its standard stride is 12,
+ * NOT 16 (CQE/v4 mode is deliberately not enabled by this driver).
+ */
+static size_t
+sd_adma_build(uint8_t *table, size_t capacity, uint64_t table_pa,
+    uint64_t data_pa, uint32_t bytes, uint32_t vm_page_bytes, bool wide)
+{
+	uint32_t align = wide ? 8u : 4u;
+	size_t stride = wide ? 12u : 8u, used = 0;
+	if (!bytes || vm_page_bytes < align || (vm_page_bytes & (vm_page_bytes - 1)) ||
+	    (table_pa & (align - 1)) || (data_pa & (align - 1)) ||
+	    data_pa > UINT64_MAX - (bytes - 1u) ||
+	    (!wide && (data_pa + bytes - 1u > UINT32_MAX || table_pa > UINT32_MAX))) {
+		return 0;
+	}
+	while (bytes) {
+		uint8_t *d = table + used;
+		uint32_t len = vm_page_bytes - (uint32_t)(data_pa & (vm_page_bytes - 1));
+		if (len > 65536u) {
+			len = 65536u;
+		}
+		if (len > bytes) {
+			len = bytes;
+		}
+		if (used > capacity || stride > capacity - used ||
+		    table_pa > UINT64_MAX - used - (stride - 1) ||
+		    (!wide && table_pa + used + stride - 1 > UINT32_MAX)) {
+			return 0;
+		}
+		d[0] = (uint8_t)(0x21u | (len == bytes ? 2u : 0u)); /* VALID | TRAN | END */
+		d[1] = 0;
+		d[2] = (uint8_t)len; /* 0 encodes 65536 */
+		d[3] = (uint8_t)(len >> 8);
+		for (uint32_t i = 0; i < (wide ? 8u : 4u); i++) {
+			d[4 + i] = (uint8_t)(data_pa >> (8 * i));
+		}
+		used += stride;
+		bytes -= len;
+		data_pa += len;
+	}
+	return used;
+}
+#endif
diff --git a/bsd/dev/lilac_touch.c b/bsd/dev/lilac_touch.c
new file mode 100644
index 0000000..3a66ac5
--- /dev/null
+++ b/bsd/dev/lilac_touch.c
@@ -0,0 +1,1846 @@
+/*
+ * LILAC touch power-up, SAFE subset only, opt-in per stage: T1-T5 map to
+ * lilac_stop=92..96 (86 is the phase-a probe, 87-91 reserved). Each stage
+ * performs every earlier stage's steps and then its own, reads back after
+ * every write, logs every register before and after, and stops at the first
+ * mismatch (no repairs, no retries past a failed read-back; the single T5
+ * re-read is the explicitly planned one). The reported nibble encodes the
+ * SELECTED stage's own steps (each sets its bits from zero); earlier steps
+ * gate execution and are logged, and bit3 is added only when the stage ran
+ * to its end without stopping:
+ *   T1 92: bit0 all reads, bit1 87/88 still func0, bit2 89/133 still low,
+ *          bit3 GCC still gated as INPUT86
+ *   T2 93 = W1: bit0+1 both muxed with other bits kept, bit2 io readable
+ *   T3 94 = W2+W3+W4: bit0 vote+AHB on, bit1 RCG CFG+UPDATE, bit2 branch on
+ *          + QUP plausible
+ *   T4 95 = W8: bit0 init ran, bit1 NACK verdict (I2C_STATUS bit3), bit2
+ *          clean return to reset
+ *   T5 96 = NO WRITE (W5 removed): bit0 VIO133 verified GPIO output driving
+ *          the inherited 0, bit1 SCL/SDA high, bit2 RESET89 likewise at 0
+ *   T6 97 = W6: bit0 L28+L14 status read back, bit1 L28 already on or enable
+ *          verified (read-back bit7 + 3.0 V decode), bit2 voltage untouched
+ *          at 3.0 V or written+verified, bit3 ran to the end
+ *   T7 98: bit0 89/133 verified at inherited 0 (+ the opt-in Sony reset
+ *          release, boot-arg lilactouchrst=1, only after a NACK), bit1 0x2c
+ *          ACK + PDT walked + F01 product, bit2 F12 extents decoded
+ *          (ctrl8/23/28), bit3 ran to the end
+ * Touch pins (EXPERIMENTS.md T7b): VIO133 is ACTIVE-LOW, 0 = touch VIO on
+ * (K44 mdss_dsi_panel_driver.c:705 power-on drives 0, :513 power-off drives
+ * 1; mainline yoshino.dtsi:74-81 touch-vddio-vreg lacks enable-active-high,
+ * so gpiolib-of.c:300-301 + :168-171 force it active-low too). UEFI leaves it
+ * 0, so it is never written. RESET89 is the active-low controller reset:
+ * Sony drives it 1 to release (mdss_dsi_panel_driver.c:1007-1008, called
+ * unconditionally after panel-on at mdss_dsi_panel.c:1070) and 0 to hold
+ * (:1010-1011). The Android debugfs line "gpio89 : out 0" prints the MUX
+ * FUNCTION, not the level (K44 pinctrl-msm.c:494,498), so it does not show
+ * 89 low. UEFI leaves 89 driven 0 (T1: io 0), i.e. reset held. By default
+ * nothing writes 89; boot-arg lilactouchrst=1 lets T7, after a NACK with
+ * the inherited pins, run Sony's release: low >= 11 ms (hybrid
+ * pw-wait-after-off-touch-reset, dsi-panel-lilac.dtsi:371/:619), high
+ * (pw-wait-after-on-touch-reset 0, :367/:615), then 220 ms before the first
+ * I2C access (hwreset_delay_for_powerup_ms, msm8998-yoshino-common.dtsi:200;
+ * clearpad_core.c:2753-2754).
+ *   T8 99 = phase b: bit0 poller window ran, bit1 F12 frames parsed,
+ *          bit2 contacts injected through sweet_hid_touch, bit3 clean end
+ * PMIC writes (T6/W6 only, user-authorized 2026-10-26): the single writable
+ * PMIC peripheral is PM8998 SID1 LDO28 (touch AVDD): VOLTAGE_RANGE +0x40,
+ * VOLTAGE_SET +0x41, EN_CTL +0x46 bit7 (ML qcom_spmi-regulator.c enum
+ * spmi_common_regulator_registers). Nothing else is ever written: L14 is
+ * read-only here (the lit display already owns it), no PON/GPIO/IRQ/charge
+ * peripheral is touched. The LDO28 base 0x4000+0x100*(28-1)=0x5b00 follows
+ * the LDO convention shared by every tabled PMIC in ML qcom_spmi-regulator.c
+ * (pm8994/pm8950/pm660 l1@0x4000, l2@0x4100, ...), while the buck convention
+ * 0x1400+0x300*(n-1) is confirmed for this phone's own PM8998 by the firmware
+ * DT nodes regulator@2f00 (s10) and regulator@3800 (s13); the TYPE(0x04)/
+ * SUBTYPE(+5) registers are read and must say LDO before any write, and the
+ * LDO28 APID owner (v2 PERIPH2OWNER at cnfg+0x700+4*apid, spmi-pmic-arb.c
+ * :1561-1563, SPMI_OWNERSHIP_PERIPH2OWNER :59) must be EE0 before any write
+ * (the v2 owner field "specifies the EE which is allowed to write to the
+ * APID", spmi-pmic-arb.c:1175-1177). Voltage policy: never write an unknown
+ * voltage - the decoded state must be exactly 3000000 uV (PLDO range 3:
+ * 1550000+25000*sel, sel 58; ML qcom_spmi-regulator.c:495-500) either by
+ * inheritance or after a verified range/set write, and only then is EN_CTL
+ * enabled with read-back; a denied owner or failed read-back stops the stage.
+ * Called from bsd_init after the stage-86 probe; a selected stage 92..99 ends
+ * in lilac_report(), i.e. a device reset, so the key poller never runs
+ * alongside. Normal boots (no lilac_stop) instead run T1-T7 once inside the
+ * touch thread started by lilac_touch_start() and then poll F12 only while
+ * IRQ125 is asserted; boot-arg lilactouch=1 gates that thread (kill switch).
+ *
+ * Register facts (Linux citations, local trees):
+ * - TLMM tiles EAST +0x900000 / WEST +0x100000 over 0x03400000, ctl at
+ *   tile+0x1000*gpio, io at ctl+4, mux bits 5:2 (mask 0x3c), pull bits 1:0
+ *   (MSM_NO_PULL=0), drv bits 8:6 (2 mA -> 0), oe bit 9, io in bit0/out bit1:
+ *   ML drivers/pinctrl/qcom/pinctrl-msm8998.c:12-44,1429-1431,1467,1475 and
+ *   pinctrl-msm.c:209-213,311-315,460-465,574. gpio87/88 are EAST and
+ *   function index 3 is blsp_i2c5 (pinctrl-msm8998.c:1429-1431).
+ * - GCC: gcc_blsp1_ahb_clk enable_reg 0x52004 bit17, halt_reg 0x17004
+ *   (BRANCH_HALT_VOTED, bit31 CLK_OFF); blsp1_qup5_i2c_apps_clk_src cmd_rcgr
+ *   0x21020 (CFG +4, hid_width 5), parent XO = index 0, F(19200000,P_XO,1,0,0)
+ *   so CFG=0; gcc_blsp1_qup5_i2c_apps_clk enable/halt 0x21008 bit0/bit31:
+ *   ML drivers/clk/qcom/gcc-msm8998.c:411-419,469-473,598-609,1448-1458,
+ *   1605-1620; CMD_UPDATE bit0 write+poll ML clk-rcg2.c:27,121-122.
+ * - QUP5 at 0x0c179000; bus 355 kHz (K44 msm8998-yoshino-common.dtsi:138,
+ *   ML yoshino.dtsi:202) is above I2C_MAX_STANDARD_MODE_FREQ, so CLK_CTL takes
+ *   the fast-mode branch of ML i2c-qup.c:1894-1902: see QUP_CLK_CTL_355K.
+ * - QUP v2 transfer = ML i2c-qup.c qup_i2c_xfer_v2/_msg/conf_xfer_v2 (see
+ *   touch_i2c_xfer).
+ * Baseline: EXPERIMENTS.md INPUT86 (TLMM87/88 cfg 0, TLMM89/133 cfg 0x203 io
+ * 0, ahb 0x8000c220, qup5 0x80000000, rcg 0x80000000, cfg 0, vote 0x80889d80).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <arm64/sweet_early.h>
