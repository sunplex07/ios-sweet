+ * boot for each named process, to find out what a daemon looks for before
+ * it gives up. The budget is per name (indexed by position in the boot-arg),
+ * so a chatty process (backboardd's IOAcceleratorES "0 found" polls) cannot
+ * exhaust another one's share: SpringBoard gets its own 400 lines.
  */
 static char sweet_iolog_names[128];
 static int sweet_iolog_parsed;
-static uint32_t sweet_iolog_lines;
+static uint32_t sweet_iolog_lines[16];
 
 static bool
 sweet_iolog(char *name, size_t len)
 {
+	int idx = 0;
 	if (!sweet_iolog_parsed) {
 		if (!PE_parse_boot_argn("sweetiolog", sweet_iolog_names, sizeof(sweet_iolog_names))) {
 			strlcpy(sweet_iolog_names, "backboardd,SpringBoard", sizeof(sweet_iolog_names));
 		}
 		sweet_iolog_parsed = 1;
 	}
-	if (sweet_iolog_lines >= 400) {
-		return false;
-	}
 	proc_selfname(name, (int)len);
 	size_t n = strlen(name);
 	for (const char *t = sweet_iolog_names; *t;) {
 		const char *end = strchr(t, ',');
 		size_t tl = end ? (size_t)(end - t) : strlen(t);
 		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
-			sweet_iolog_lines++;
+			if (idx >= 16 || sweet_iolog_lines[idx] >= 400) {
+				return false;
+			}
+			sweet_iolog_lines[idx]++;
 			return true;
 		}
 		if (!end) {
 			break;
 		}
 		t = end + 1;
+		idx++;
 	}
 	return false;
 }
